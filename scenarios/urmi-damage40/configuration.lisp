(in-package :cl-mpm/scenario/urmi-damage40)
(defparameter +fixed-inputs+
  '(("height" . 10d0) ("crestLength" . 12d0) ("slope" . 40d0) ("baseHeight" . 4d0)
    ("domainWidth" . 60d0) ("domainHeight" . 20d0) ("meshSize" . .5d0)
    ("mpsPerCell" . 2) ("workers" . 1) ("timeStepScale" . .2d0)
    ("gravity" . -9.80665d0) ("unitWeightNPerM3" . 17000d0)
    ("gravityRampDuration" . 2d0) ("settleDampingAlpha" . .4d0)
    ("forceTolerance" . 1d-4) ("kineticTolerance" . 1d-8)
    ("consecutiveChecks" . 50) ("consecutiveDurationS" . 1d0)
    ("undampedHoldUpdates" . 100) ("undampedHoldDurationS" . 1d0)
    ("maxPreparationUpdates" . 60000) ("maxPreparationTimeS" . 20d0)
    ("duration" . 60d0) ("frames" . 301) ("maxDynamicUpdates" . 200000)
    ("drainedE" . 10773000d0) ("drainedNu" . .33d0)
    ("drainedCohesionPa" . 3700d0) ("drainedFrictionDeg" . 30.6d0) ("drainedDilationDeg" . 0d0)))
(defun drained-law ()
  (mc:make-evolution-law :variant :perfect :points '((0d0 30.6d0)) :cohesion 3700d0
    :psi 0d0 :stress-measure :cauchy
    :strain-assumption "Owned Urmi-inspired S1 constant drained MC initialization; psi0 is an explicit numerical assumption"))
(defun compile-configuration (case)
  (let ((input (fw:simulation-parameters case)) (config (make-hash-table :test #'equal))
        (material (fw:simulation-material case)) (geometry (fw:simulation-geometry case))
        (solver (fw:simulation-solver case)))
    (unless (= (hash-table-count input) (length +fixed-inputs+)) (error "Owned case requires its exact declared parameter set."))
    (dolist (entry +fixed-inputs+)
      (let ((actual (gethash (car entry) input)))
        (unless (and (gs::finite-p actual) (= actual (cdr entry)))
          (error "Owned case parameter ~A must remain ~S." (car entry) (cdr entry)))
        (setf (gethash (car entry) config) actual)))
    (dolist (pair (list (list material :native) (list geometry :slope) (list solver :explicit)
                       (list (fw:simulation-boundary case) :rollers) (list (fw:simulation-loading case) :gravity)))
      (fw::check-kind (first pair) (list (second pair))))
    (let* ((args (fw:material-particle-initargs material)) (rho (/ 17000d0 9.80665d0))
           (toe (+ 12d0 (/ 10d0 (tan (* pi (/ 40d0 180d0)))))))
      (unless (and (eq (fw:material-particle-class material) 'mc:particle-mc-evolution)
                   (equalp (getf args :evolution-law) (drained-law))
                   (= (getf args :E) 10773000d0) (= (getf args :nu) .33d0)
                   (eq (getf args :enable-plasticity) t) (= (fw:option material :density) rho))
        (error "Owned case requires exact drained S1 native MC inputs."))
      (loop for key in args by #'cddr do
        (unless (member key '(:E :nu :evolution-law :enable-plasticity)) (error "Undeclared material initarg ~S" key)))
      (dolist (entry '((:height . 10d0) (:crest-length . 12d0) (:slope . 40d0) (:base-height . 4d0)))
        (unless (= (fw:option geometry (car entry)) (cdr entry)) (error "Geometry component disagrees with owned inputs.")))
      (unless (= (fw:option geometry :width) toe) (error "Owned geometry toe disagrees."))
      (dolist (entry '((:mesh-size . .5d0) (:mps-per-cell . 2) (:workers . 1) (:time-step-scale . .2d0)
                       (:frames . 301) (:max-updates . 200000) (:damping . 0d0)))
        (unless (= (fw:option solver (car entry)) (cdr entry)) (error "Solver component disagrees with owned inputs.")))
      (setf (gethash "density" config) rho (gethash "toeX" config) toe
            (gethash "settleDamping" config) (* .4d0 (/ (sqrt (/ 10773000d0 rho)) .5d0))
            (gethash "undrainedE" config) usd:+youngs-modulus-pa+
            (gethash "undrainedNu" config) usd:+poisson-ratio+))
    config))
