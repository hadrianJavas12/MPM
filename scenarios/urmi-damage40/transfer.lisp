;;;; Clone/validate all material points before one sim-mps replacement.
;;;; No grid mapping, physical clock update, MPM step or change to shared defaults.
(in-package :cl-mpm/scenario/urmi-damage40/transfer)

(defstruct (transfer-batch (:constructor %make-transfer-batch))
  originals original-signatures candidates candidate-signatures records (committed-p nil))

(defun %fail (message &rest values) (apply #'mc::integration-fail message values))
(defun %object (&rest pairs)
  (let ((record (make-hash-table :test #'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key record) value)) record))
(defun %slots (mp)
  (mapcar #'sb-mop:slot-definition-name (sb-mop:class-slots (class-of mp))))
(defun %copy (value)
  ;; The existing copier rejects unrecognized mutable objects/structs.
  (let ((copy (mc::%copy-state-value value)))
    (labels ((finite (item)
               (typecase item
                 (number (unless (mc::finite-real-p item) (%fail "Nonfinite transfer slot")))
                 (magicl:matrix/double-float (map nil #'finite (cl-mpm/utils:fast-storage item)))
                 (cons (finite (car item)) (finite (cdr item)))
                 (structure-object
                  (dolist (slot (sb-mop:class-slots (class-of item)))
                    (finite (slot-value item (sb-mop:slot-definition-name slot)))))
                 (array (dotimes (i (array-total-size item)) (finite (row-major-aref item i)))))))
      (finite copy)) copy))
(defun %fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value)) (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (%fingerprint (car value)) (%fingerprint (cdr value))))
        ((arrayp value) (list :array (array-dimensions value)
                             (loop for i below (array-total-size value) collect (%fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
               (loop for slot in (sb-mop:class-slots (class-of value))
                     for name = (sb-mop:slot-definition-name slot)
                     collect (list name (%fingerprint (slot-value value name))))))
        (t (%fail "Unsupported transfer signature value" (type-of value)))))
(defun particle-signature (mp)
  "Owned complete slot signature; inactive node-cache backing is deliberately excluded."
  (loop for name in (%slots mp) collect
    (list name (slot-boundp mp name)
          (when (slot-boundp mp name)
            (if (eq name 'cl-mpm/particle::cached-nodes)
                (let ((cache (slot-value mp name)))
                  (unless (and (vectorp cache) (array-has-fill-pointer-p cache)
                               (zerop (fill-pointer cache)))
                    (%fail "Transfer requires an accepted boundary with an inactive node cache"))
                  (list :inactive-node-cache (array-total-size cache)))
                (%fingerprint (%copy (slot-value mp name))))))))

(defun elastic-strain-from-stress (stress j e nu)
  "Full 3D engineering-Voigt compliance of tau=J*sigma, including out-of-plane strain."
  (unless (and (typep stress 'magicl:matrix/double-float)
               (= (length (cl-mpm/utils:fast-storage stress)) 6)
               (every #'mc::finite-real-p (cl-mpm/utils:fast-storage stress))
               (mc::finite-real-p j) (> j 0d0) (mc::finite-real-p e) (> e 0d0)
               (mc::finite-real-p nu) (< -1d0 nu .5d0))
    (%fail "Invalid transfer compliance inputs"))
  (let* ((s (cl-mpm/utils:fast-storage stress)) (g (/ e (* 2d0 (+ 1d0 nu))))
         (trace (* j (+ (aref s 0) (aref s 1) (aref s 2)))))
    (cl-mpm/utils:voigt-from-list
     (append (loop for i below 3 collect (/ (- (* (+ 1d0 nu) j (aref s i)) (* nu trace)) e))
             (loop for i from 3 below 6 collect (/ (* j (aref s i)) g))))))
(defun %near (a b &optional (relative 1d-12))
  (and (mc::finite-real-p a) (mc::finite-real-p b)
       (<= (abs (- a b)) (* relative (max 1d0 (abs a) (abs b))))))
(defun %matrix-equal (a b)
  (equalp (cl-mpm/utils:fast-storage a) (cl-mpm/utils:fast-storage b)))
(defun %proxy (mp)
  (* .5d0 (cl-mpm/particle:mp-volume mp)
     (loop for s across (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress mp))
           for e across (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-strain mp)) sum (* s e))))
(defun %vector (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
(defun %validate-source (mp)
  ;; Exact source class makes unknown subclass slots/dispatch fail closed.
  (unless (eq (class-name (class-of mp)) 'mc:particle-mc-evolution)
    (%fail "Transfer source must be the exact native drained MC class"))
  (particle-signature mp)
  (let ((law (mc:particle-evolution-law mp)))
    (unless (and (= (cl-mpm/particle::mp-E mp) 10773000d0)
                 (= (cl-mpm/particle::mp-nu mp) .33d0)
                 (eq (mc:evolution-law-variant law) :perfect)
                 (eq (mc:evolution-law-stress-measure law) :cauchy)
                 (= (length (mc:evolution-law-points law)) 1)
                 (= (length (mc:evolution-law-cohesion-points law)) 1)
                 (cl-mpm/particle::mp-enable-plasticity mp))
      (%fail "Transfer source is not the declared constant drained S1 material"))
    (multiple-value-bind (c phi psi) (mc:law-values law (mc:particle-kappa mp))
      (unless (and (= c 3700d0) (%near phi (* pi (/ 30.6d0 180d0))) (zerop psi))
        (%fail "Unexpected drained strength/dilation" c phi psi))))
  (unless (and (= (mc:particle-kappa mp) (mc:particle-kappa-committed mp))
               (= (mc:particle-plastic-work mp) (mc:particle-plastic-work-committed mp))
               (= (mc:particle-plastic-volume mp) (mc:particle-plastic-volume-committed mp))
               (%matrix-equal (cl-mpm/particle:mp-deformation-gradient mp)
                              (cl-mpm/particle::mp-deformation-gradient-0 mp))
               (= (cl-mpm/particle:mp-volume mp) (cl-mpm/particle::mp-volume-n mp))
               (> (cl-mpm/particle:mp-mass mp) 0d0) (> (cl-mpm/particle:mp-volume mp) 0d0))
    (%fail "Transfer requires a committed positive drained material state"))
  (let ((j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp))))
    (unless (and (mc::finite-real-p j) (> j 0d0)) (%fail "Invalid drained transfer J"))
    (dotimes (i 6)
      (unless (%near (aref (cl-mpm/utils:fast-storage (cl-mpm/particle::mp-stress-kirchoff mp)) i)
                     (* j (aref (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress mp)) i)))
        (%fail "Drained Cauchy/Kirchhoff state disagrees")))
    j))
(defun %clone-source (source origin)
  (let ((target (make-instance 'usd:particle-urmi-strength-damage
                              :kappa origin :kappa-origin origin)))
    (dolist (name (%slots source))
      (unless (slot-exists-p target name) (%fail "Unmapped transfer source slot" name))
      (if (slot-boundp source name)
          (setf (slot-value target name)
                (if (eq name 'cl-mpm/particle::cached-nodes)
                    ;; Accepted-boundary cache has zero active entries. Its old
                    ;; backing can contain grid node references and is not state.
                    (make-array (array-total-size (slot-value source name))
                                :fill-pointer 0 :element-type 'cl-mpm/particle::node-cache
                                :initial-contents
                                (loop repeat (array-total-size (slot-value source name))
                                      collect (cl-mpm/particle::make-empty-node-cache)))
                    (%copy (slot-value source name))))
          (slot-makunbound target name)))
    target))
(defun %preserved-physical-p (a b)
  (every (lambda (name) (equalp (%fingerprint (slot-value a name)) (%fingerprint (slot-value b name))))
         '(cl-mpm/particle::position cl-mpm/particle::size cl-mpm/particle::size-0
           cl-mpm/particle::true-domain cl-mpm/particle::mass cl-mpm/particle::volume
           cl-mpm/particle::volume-0 cl-mpm/particle::velocity cl-mpm/particle::acceleration
           cl-mpm/particle::displacement cl-mpm/particle::deformation-gradient
           cl-mpm/particle::index cl-mpm/particle::unique-index cl-mpm/particle::mpi-index)))
(defun %validate-candidate (source target)
  (let ((j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient target))))
    (particle-signature target)
    (unless (and (%preserved-physical-p source target)
                 (= (usd:particle-kappa-origin target) (mc:particle-kappa source))
                 (>= (mc:particle-kappa target) (mc:particle-kappa source))
                 (= (mc:particle-kappa target) (mc:particle-kappa-committed target))
                 (>= (mc:particle-plastic-work target) (- (mc:particle-plastic-work source) 1d-8))
                 (= (cl-mpm/particle::mp-E target) usd:+youngs-modulus-pa+)
                 (= (cl-mpm/particle::mp-nu target) usd:+poisson-ratio+)
                 (equalp (mc:particle-evolution-law target)
                         (usd:make-strength-damage-law :kappa-origin (mc:particle-kappa source)))
                 (> (cl-mpm/particle::mp-p-modulus target) 0d0)
                 (> (cl-mpm/particle::mp-p-modulus-0 target) 0d0)
                 (<= 0d0 (usd:particle-strength-damage target)
                     (- 1d0 (/ usd:+remolded-strength-pa+ usd:+peak-strength-pa+))))
      (%fail "Candidate violated transfer identity, history, stiffness or damage bounds"))
    (let* ((sigma (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress target)))
           (tolerance (+ mc::+stress-atol+
                         (* mc::+stress-rtol+ (max 1d0 (* j (reduce #'max sigma :key #'abs)))))))
      (unless (<= (mc:particle-yield-residual-kirchhoff target) tolerance)
        (%fail "Candidate failed independent post-return MC residual")))
    (dotimes (i 6)
      (unless (%near (aref (cl-mpm/utils:fast-storage (cl-mpm/particle::mp-stress-kirchoff target)) i)
                     (* j (aref (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress target)) i)))
        (%fail "Candidate stress measures disagree"))))
  t)
(defun %candidate (source index)
  (let* ((j (%validate-source source)) (origin (mc:particle-kappa source))
         (target (%clone-source source origin)) (before-energy (%proxy source))
         (before-stress (%vector (cl-mpm/particle:mp-stress source)))
         (strain (elastic-strain-from-stress (cl-mpm/particle:mp-stress source) j
                                            usd:+youngs-modulus-pa+ usd:+poisson-ratio+)))
    (setf (mc:particle-evolution-law target) (usd:make-strength-damage-law :kappa-origin origin)
          (mc:particle-cohesion target) usd:+peak-strength-pa+
          (mc:particle-phi target) 0d0 (mc:particle-psi target) 0d0
          (mc:particle-last-projection target) nil
          (cl-mpm/particle::mp-E target) usd:+youngs-modulus-pa+
          (cl-mpm/particle::mp-nu target) usd:+poisson-ratio+)
    (dolist (matrix (list (cl-mpm/particle:mp-strain target) (cl-mpm/particle:mp-strain-n target)
                          (cl-mpm/particle::mp-trial-elastic-strain target)))
      (cl-mpm/utils:voigt-copy-into strain matrix))
    (let ((predictor-energy (%proxy target))
          (predictor-residual (mc:particle-yield-residual-kirchhoff target)))
      ;; This is ONE actual instantaneous native MATERIAL return, dt=0. It may
      ;; relax stress and advance history; it is not an MPM/clock update.
      (let ((tau (cl-mpm/particle:constitutive-model target (%copy strain) 0d0)))
        (cl-mpm/utils:voigt-copy-into tau (cl-mpm/particle:mp-stress target))
        (cl-mpm/fastmaths:fast-scale! (cl-mpm/particle:mp-stress target) (/ 1d0 j)))
      ;; The copied drained baseline has no owned kappa-origin entry. Force a
      ;; fresh complete baseline rather than synchronizing its shorter slot set.
      (setf (slot-value target 'mc::committed-state) nil)
      (cl-mpm/particle::new-loadstep-mp target)
      (%validate-candidate source target)
      (values target
              (%object "particleIndex" index "J" j "kappaOrigin" origin
                       "kappaBefore" origin "kappaAfter" (mc:particle-kappa target)
                       "damageAfter" (usd:particle-strength-damage target)
                       "cohesionAfterPa" (mc:particle-cohesion target)
                       "cauchyBeforePa" before-stress "cauchyPredictorPa" (copy-seq before-stress)
                       "cauchyAfterReleasePa" (%vector (cl-mpm/particle:mp-stress target))
                       "predictorResidualKirchhoffPa" predictor-residual
                       "acceptedResidualKirchhoffPa" (mc:particle-yield-residual-kirchhoff target)
                       "elasticProxyBeforeJPerM" before-energy
                       "elasticProxyPredictorJPerM" predictor-energy
                       "elasticProxyAfterReleaseJPerM" (%proxy target)
                       "materialSwitchProxyDifferenceJPerM" (- predictor-energy before-energy)
                       "instantaneousReleaseProxyDifferenceJPerM" (- (%proxy target) predictor-energy)
                       "plasticWorkBeforePa" (mc:particle-plastic-work source)
                       "plasticWorkAfterPa" (mc:particle-plastic-work target)
                       "nativeMaterialCalls" 1 "mpmUpdates" 0 "physicalTimeAdvancedS" 0d0
                       "clearedCacheSlots" (vector "cl-mpm/particle::cached-nodes backing and active fill-pointer (native validity flag)=0")
                       "scope" "Cauchy predictor preserved; actual dt0 native material return may release stress; energy proxies are not a closed budget or fracture energy")))))

(defun prepare-transfer (particles &key candidate-validator)
  "Return a complete candidate batch; no original slot/vector is mutated.
CANDIDATE-VALIDATOR is a trusted test/review hook, receiving only clone and index."
  (unless (and (vectorp particles) (> (length particles) 0)) (%fail "Nonempty particle vector required"))
  (let* ((before (map 'vector #'particle-signature particles))
         (candidates (make-array (length particles) :adjustable t :fill-pointer (length particles)))
         (records (make-array (length particles))))
    (dotimes (i (length particles))
      (multiple-value-bind (target record) (%candidate (aref particles i) i)
        (when candidate-validator (funcall candidate-validator target i))
        (%validate-candidate (aref particles i) target)
        (setf (aref candidates i) target (aref records i) record)))
    (unless (equalp before (map 'vector #'particle-signature particles))
      (%fail "Preparation changed original particle state"))
    (%make-transfer-batch :originals particles :original-signatures before
                         :candidates candidates :candidate-signatures (map 'vector #'particle-signature candidates)
                         :records records)))
(defun commit-transfer (sim batch)
  "Validate frozen source/candidate identities, then replace sim-mps exactly once."
  (check-type batch transfer-batch)
  (when (transfer-batch-committed-p batch) (%fail "Transfer batch already committed"))
  (let ((originals (transfer-batch-originals batch)) (candidates (transfer-batch-candidates batch)))
    (unless (and (eq (cl-mpm:sim-mps sim) originals)
                 (equalp (transfer-batch-original-signatures batch) (map 'vector #'particle-signature originals))
                 (equalp (transfer-batch-candidate-signatures batch) (map 'vector #'particle-signature candidates)))
      (%fail "Transfer source/candidate changed after preparation"))
    (dotimes (i (length originals)) (%validate-candidate (aref originals i) (aref candidates i)))
    (handler-case (setf (cl-mpm:sim-mps sim) candidates)
      (error (condition) (setf (cl-mpm:sim-mps sim) originals) (error condition)))
    (setf (transfer-batch-committed-p batch) t)
    (values candidates (transfer-batch-records batch))))

(defun transfer! (sim)
  "Prepare/validate all clones, replace the particle vector once, return the per-MP ledger."
  (let ((time (cl-mpm::sim-time sim)) (batch (prepare-transfer (cl-mpm:sim-mps sim))))
    (multiple-value-bind (candidates records) (commit-transfer sim batch)
      (declare (ignore candidates))
      (unless (= time (cl-mpm::sim-time sim)) (%fail "Material transfer changed the native clock"))
      records)))
