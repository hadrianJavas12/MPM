(in-package :cl-mpm/scenario/urmi-damage40)
(defclass urmi-damage40-sim (cl-mpm::mpm-sim-usf)
  ((force-ratio :initform nil :accessor force-ratio)
   (force-numerator2 :initform 0d0 :accessor force-numerator2)
   (force-denominator2 :initform 0d0 :accessor force-denominator2)
   (free-ke :initform 0d0 :accessor free-ke) (free-nodal-mass :initform 0d0 :accessor free-nodal-mass)))
(defun free-axis-p (node axis)
  (let ((mask (cl-mpm/mesh::node-bcs node))) (or (null mask) (> (component mask axis) .5d0))))
(defun node-loop (sim function)
  (let ((nodes (cl-mpm/mesh::mesh-nodes (cl-mpm:sim-mesh sim))))
    (dotimes (i (array-total-size nodes))
      (let ((node (row-major-aref nodes i)))
        (when (cl-mpm/mesh:node-active node)
          (unless (gs::finite-p (cl-mpm/mesh:node-mass node)) (error "Nonfinite active nodal mass."))
          (when (> (cl-mpm/mesh:node-mass node) 0d0) (funcall function node)))))))
(defun force-measures (sim)
  "Serial undamped physical force ratio; constrained components excluded from BOTH sums."
  (let ((residual2 0d0) (external2 0d0))
    (node-loop sim (lambda (node)
      (dotimes (axis 2) (when (free-axis-p node axis)
        (let ((external (component (cl-mpm/mesh::node-external-force node) axis))
              (internal (component (cl-mpm/mesh::node-internal-force node) axis)))
          (incf external2 (* external external)) (incf residual2 (expt (+ external internal) 2)))))))
    (unless (and (gs::finite-p residual2) (gs::finite-p external2)) (error "Nonfinite raw free-force measures."))
    (setf (force-numerator2 sim) residual2 (force-denominator2 sim) external2
          (force-ratio sim) (when (> external2 0d0) (sqrt (/ residual2 external2))))
    (values (force-ratio sim) residual2 external2)))
(defmethod cl-mpm::update-node-forces :after ((sim urmi-damage40-sim)) (force-measures sim))
(defun kinetic-measures (sim)
  "After velocity BCs: free-component nodal KE and mass counted once per eligible node."
  (let ((ke 0d0) (mass 0d0))
    (node-loop sim (lambda (node)
      (when (or (free-axis-p node 0) (free-axis-p node 1))
        (incf mass (cl-mpm/mesh:node-mass node))
        (dotimes (axis 2) (when (free-axis-p node axis)
          (incf ke (* .5d0 (cl-mpm/mesh:node-mass node)
                      (expt (component (cl-mpm/mesh:node-velocity node) axis) 2))))))))
    (unless (and (gs::finite-p ke) (gs::finite-p mass)) (error "Nonfinite free kinetic measures."))
    (setf (free-ke sim) ke (free-nodal-mass sim) mass) (values ke mass)))
(defmethod cl-mpm::update-dynamic-stats :after ((sim urmi-damage40-sim)) (kinetic-measures sim))
;; The reused read-only gravity observer expects this generic accessor, but the
;; buggy legacy force hook does not apply to our direct USF subclass.
(defmethod cl-mpm/scenario/slope-descent::free-residual ((sim urmi-damage40-sim)) (or (force-ratio sim) 0d0))
(defun surface-height (config x)
  (+ (value config "baseHeight")
     (max 0d0 (- (value config "height") (* (tan (* pi (/ (value config "slope") 180d0)))
                                                    (max 0d0 (- x (value config "crestLength"))))))))
(defun build-slope (material config)
  (let* ((h (value config "meshSize")) (width (value config "domainWidth"))
         (top (+ (value config "baseHeight") (value config "height")))
         (ppc (value config "mpsPerCell"))
         (sim (cl-mpm/setup:make-simple-sim h (list (round width h) (round (value config "domainHeight") h))
                :sim-type 'urmi-damage40-sim :args-list (list :enable-fbar nil :enable-damage nil
                  :ghost-factor nil :enable-split nil :mp-removal-size nil)))
         (mps (apply #'cl-mpm/setup:make-block-mps '(0d0 0d0) (list width top)
                (list (* (round width h) ppc) (* (round top h) ppc)) (value config "density")
                (fw:material-particle-class material) :gravity 0d0
                :gravity-axis (cl-mpm/utils:vector-from-list '(0d0 1d0 0d0))
                :body-force (cl-mpm/utils:vector-from-list '(0d0 0d0 0d0))
                :clip-func (lambda (x y z) (declare (ignore z)) (<= y (surface-height config x)))
                (fw:material-particle-initargs material))))
    (cl-mpm:add-mps sim (remove-if-not (lambda (mp) (typep mp 'cl-mpm/particle:particle)) mps))
    (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do (setf (cl-mpm/particle::mp-unique-index mp) id))
    (setf (cl-mpm:sim-gravity sim) 0d0 (cl-mpm::sim-mass-scale sim) 1d0
          (cl-mpm::sim-mass-filter sim) 1d-15 (cl-mpm::sim-mp-removal-size sim) nil
          (cl-mpm:sim-allow-mp-split sim) nil (cl-mpm::sim-velocity-algorithm sim) :FLIP
          (cl-mpm:sim-damping-factor sim) (value config "settleDamping")
          (cl-mpm::sim-bcs-force-list sim) nil)
    (setf (cl-mpm:sim-bcs sim) (cl-mpm/bc::make-outside-bc-var (cl-mpm:sim-mesh sim)
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(0 nil nil)))
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(0 nil nil)))
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(nil nil nil)))
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(0 0 nil)))
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(nil nil 0)))
      (lambda (i) (cl-mpm/bc:make-bc-fixed i '(nil nil 0)))))
    sim))
