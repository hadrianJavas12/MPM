(in-package :cl-mpm/scenario/slope-descent)

(defparameter +parameter-defaults+
  '(("settleMaxUpdates" . 20000) ("settleMinUpdates" . 200)
    ("settleTolerance" . 1d-3) ("settleHoldChecks" . 5)
    ("penaltyScale" . 10d0) ("settleDamping" . 100d0)
    ("dynamicDamping" . 0d0)))

(defun compile-configuration (case)
  "Consume every public component and reject unknown backend parameters. SI units."
  (let* ((config (make-hash-table :test 'equal))
         (material (cl-mpm/framework:simulation-material case))
         (geometry (cl-mpm/framework:simulation-geometry case))
         (loading (cl-mpm/framework:simulation-loading case))
         (solver (cl-mpm/framework:simulation-solver case))
         (boundary (cl-mpm/framework:simulation-boundary case)))
    (loop for (item kind) in (list (list material :native) (list geometry :slope)
                                  (list loading :prescribed-descent) (list solver :explicit)
                                  (list boundary :rollers)) do
      (cl-mpm/framework::check-kind item (list kind)))
    (let* ((type (cl-mpm/framework:material-particle-class material))
           (soil2 (eq type 'cl-mpm/models/wang2017-native:particle-wang2017-soil2))
           (args (cl-mpm/framework:material-particle-initargs material))
           (law (getf args :evolution-law)))
      (unless (or soil2 (eq type 'cl-mpm/models/mc-evolution:particle-mc-evolution))
        (error "Slope descent requires the perfect-MC control or explicit Wang Soil2 class."))
      (unless (and (typep law 'cl-mpm/models/mc-evolution:evolution-law)
                   (eq (cl-mpm/models/mc-evolution:evolution-law-variant law)
                       (if soil2 :hs :perfect))
                   (getf args :enable-plasticity))
        (error "Slope descent requires enabled plasticity and the selected model's law."))
      (when (and soil2 (not (cl-mpm/models/wang2017-native:soil2-law-p law)))
        (error "Wang Soil2 requires its declared paper cohesion/friction/dilation law.")))
    (dolist (entry +parameter-defaults+)
      (setf (gethash (car entry) config) (cdr entry)))
    (maphash (lambda (key value)
               (unless (assoc key +parameter-defaults+ :test #'equal)
                 (error "Unknown slope-descent parameter ~S." key))
               (setf (gethash key config) value))
             (cl-mpm/framework:simulation-parameters case))
    (setf (gethash "E" config) (getf (cl-mpm/framework:material-particle-initargs material) :E)
          (gethash "nu" config) (getf (cl-mpm/framework:material-particle-initargs material) :nu)
          (gethash "density" config) (cl-mpm/framework:option material :density (/ 20d3 9.80665d0)))
    (flet ((copy-options (item mappings)
             (dolist (mapping mappings)
               (destructuring-bind (key name default) mapping
                 (setf (gethash name config) (cl-mpm/framework:option item key default))))))
      (copy-options geometry '((:width "width" 20d0) (:height "height" 10d0)
                              (:crest-length "crestLength" 10d0) (:slope "slope" 60d0)
                              (:base-height "baseHeight" 5d0)))
      (copy-options loading '((:velocity "velocity" 1d-4) (:target-displacement "targetDisplacement" .1d0)
                             (:patch-start "patchStart" 7d0) (:patch-length "patchLength" 3d0)))
      (copy-options solver '((:mesh-size "meshSize" .5d0) (:mps-per-cell "mpsPerCell" 2)
                            (:workers "workers" 1) (:time-step-scale "timeStepScale" .25d0)
                            (:frames "frames" 51) (:max-updates "maxUpdates" 2000000)))
      (let ((given (getf (cl-mpm/framework:component-options solver) :damping :missing)))
        (unless (eq given :missing)
          (multiple-value-bind (value present)
              (gethash "dynamicDamping" (cl-mpm/framework:simulation-parameters case))
            (when (and present (not (eql value given)))
              (error "Solver damping disagrees with dynamicDamping.")))
          (setf (gethash "dynamicDamping" config) given))))
    (maphash (lambda (key value)
               (unless (finite-p value) (error "~A must be finite." key))) config)
    (dolist (key '("E" "density" "width" "height" "crestLength" "baseHeight" "velocity"
                   "targetDisplacement" "patchLength" "meshSize" "penaltyScale"
                   "settleTolerance" "timeStepScale"))
      (unless (> (gethash key config) 0d0) (error "~A must be positive." key)))
    (dolist (key '("patchStart" "settleDamping" "dynamicDamping"))
      (unless (>= (gethash key config) 0d0) (error "~A must be nonnegative." key)))
    (dolist (key '("mpsPerCell" "workers" "frames" "maxUpdates" "settleMaxUpdates"
                   "settleMinUpdates" "settleHoldChecks"))
      (unless (and (integerp (gethash key config)) (> (gethash key config) 0))
        (error "~A must be a positive integer." key)))
    (unless (and (< -1d0 (gethash "nu" config) .5d0)
                 (< 0d0 (gethash "slope" config) 90d0)
                 (<= (gethash "timeStepScale" config) .5d0)
                 (>= (gethash "frames" config) 2)
                 (<= (gethash "settleMinUpdates" config) (gethash "settleMaxUpdates" config))
                 (<= (+ (gethash "patchStart" config) (gethash "patchLength" config))
                     (gethash "crestLength" config))
                 (< (+ (gethash "crestLength" config)
                       (/ (gethash "height" config)
                          (tan (* pi (/ (gethash "slope" config) 180d0)))))
                    (gethash "width" config)))
      (error "Invalid slope, loading patch, timestep or settling bounds."))
    ;; Real DOFs are 2D, with unit out-of-plane thickness and no mass scaling.
    (setf (gethash "gravity" config) -9.80665d0
          (gethash "duration" config) (/ (gethash "targetDisplacement" config)
                                         (gethash "velocity" config)))
    ;; Add model metadata only for the explicit opt-in. Legacy control JSON stays unchanged.
    (when (eq (cl-mpm/framework:material-particle-class material)
              'cl-mpm/models/wang2017-native:particle-wang2017-soil2)
      (setf (gethash "materialModel" config) "wang2017-soil2"
            (gethash "paperHistoryFrame" config) "spatial-corotated-incremental-polar"
            (gethash "historyPolicy" config) "monotonic-scope-reject"))
    config))
