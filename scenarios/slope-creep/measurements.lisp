(in-package :cl-mpm/scenario/slope-creep)

(defun internal-signature (sim)
  "State which a reporting-origin reset must preserve exactly."
  (map 'vector
       (lambda (mp)
         (list (mapcar (lambda (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
                       (list (cl-mpm/particle:mp-stress mp) (cl-mpm/particle:mp-strain mp)
                             (cl-mpm/particle::mp-strain-n mp)
                             (cl-mpm/particle::mp-stress-kirchoff mp)
                             (cl-mpm/particle:mp-deformation-gradient mp)
                             (cl-mpm/particle::mp-deformation-gradient-0 mp)))
               (cl-mpm/particle:mp-volume mp)
               (cl-mpm/models/clay-creep:particle-kappa mp)
               (cl-mpm/models/clay-creep:particle-work mp)))
       (cl-mpm:sim-mps sim)))

(defun reset-reporting-origin (sim)
  (let ((before (internal-signature sim)))
    (loop for mp across (cl-mpm:sim-mps sim) do
      (dolist (matrix (list (cl-mpm/particle:mp-velocity mp)
                           (cl-mpm/particle::mp-acceleration mp)
                           (cl-mpm/particle::mp-displacement mp)))
        (cl-mpm/fastmaths:fast-zero matrix)))
    (cl-mpm:iterate-over-nodes (cl-mpm:sim-mesh sim)
      (lambda (node)
        (cl-mpm/fastmaths:fast-zero (cl-mpm/mesh:node-velocity node))
        (cl-mpm/fastmaths:fast-zero (cl-mpm/mesh:node-acceleration node))))
    (setf (cl-mpm::sim-time sim) 0d0)
    (unless (equalp before (internal-signature sim))
      (error "Creep reporting reset changed internal state."))))

(defun statistics (sim initial-mass initial-count config crest)
  "Raw measurements; no fabricated phase labels or collapse triggers."
  (let ((mass 0d0) (ke 0d0) (max-speed 0d0) (max-u 0d0)
        (max-kappa 0d0) (max-rate 0d0) (sum-kappa 0d0)
        (min-strength most-positive-double-float) (min-j most-positive-double-float))
    (unless (= (length (cl-mpm:sim-mps sim)) initial-count)
      (error "Unexpected particle count change."))
    (loop for mp across (cl-mpm:sim-mps sim) do
      (dolist (matrix (list (cl-mpm/particle:mp-position mp) (cl-mpm/particle:mp-velocity mp)
                            (cl-mpm/particle:mp-stress mp) (cl-mpm/particle:mp-strain mp)
                            (cl-mpm/particle:mp-deformation-gradient mp)))
        (unless (matrix-finite-p matrix) (error "Nonfinite creep particle field.")))
      (let* ((m (cl-mpm/particle:mp-mass mp))
             (speed (sqrt (loop for i below 3 sum (expt (component (cl-mpm/particle:mp-velocity mp) i) 2))))
             (u (sqrt (loop for i below 3 sum (expt (component (cl-mpm/particle::mp-displacement mp) i) 2))))
             (j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))
             (kappa (cl-mpm/models/clay-creep:particle-kappa mp))
             (rate (cl-mpm/models/clay-creep:particle-rate mp))
             (strength (cl-mpm/models/clay-creep:particle-current-yield mp)))
        (unless (and (> m 0d0) (> (cl-mpm/particle:mp-volume mp) 0d0) (> j 0d0)
                     (every #'finite-p (list j kappa rate strength))
                     (>= kappa 0d0) (>= rate 0d0) (> strength 0d0))
          (error "Invalid native creep state."))
        (incf mass m) (incf ke (* .5d0 m speed speed)) (incf sum-kappa kappa)
        (setf max-speed (max max-speed speed) max-u (max max-u u)
              max-kappa (max max-kappa kappa) max-rate (max max-rate rate)
              min-strength (min min-strength strength) min-j (min min-j j))))
    (let ((mass-error (/ (- mass initial-mass) initial-mass)))
      (unless (< (abs mass-error) 1d-12) (error "Creep mass conservation failure."))
      (list (cl-mpm::sim-time sim) mass initial-count ke
            (/ ke (* mass (- (gethash "gravity" config)) (gethash "height" config)))
            (free-residual sim) mass-error max-u max-speed
            (- (/ (loop for mp in crest sum (component (cl-mpm/particle::mp-displacement mp) 1)) (length crest)))
            (/ (loop for mp in crest sum (sqrt (loop for i below 3 sum
                  (expt (component (cl-mpm/particle:mp-velocity mp) i) 2)))) (length crest))
            max-kappa (/ sum-kappa initial-count) max-rate min-strength min-j))))

(defun configure-creep-output (sim)
  "Keep native fields but remove incompatible legacy VM output interpretations."
  (setf (cl-mpm::sim-output-list-scalar sim)
        (append (remove-if (lambda (field) (member (first field) '("yield-function" "plastic-strain")
                                                  :test #'string=))
                           (copy-list (cl-mpm::sim-output-list-scalar sim)))
                (list (list "creep-kappa" #'cl-mpm/models/clay-creep:particle-kappa)
                      (list "creep-rate" #'cl-mpm/models/clay-creep:particle-rate)
                      (list "creep-yield-kirchhoff-pa" #'cl-mpm/models/clay-creep:particle-current-yield)))))

