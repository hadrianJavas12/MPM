(in-package :cl-mpm/scenario/slope-creep)

(defparameter +defaults+
  '(("duration" . 30d0) ("settleMaxUpdates" . 20000)
    ("settleMinUpdates" . 1000) ("settleTolerance" . 1d-3)
    ("settleHoldChecks" . 5) ("settleDamping" . 100d0)))

(defun compile-configuration (case)
  "Compile a declared total-stress clay demonstration, never Wang Soil1."
  (let* ((config (make-hash-table :test 'equal))
         (material (cl-mpm/framework:simulation-material case))
         (geometry (cl-mpm/framework:simulation-geometry case))
         (loading (cl-mpm/framework:simulation-loading case))
         (solver (cl-mpm/framework:simulation-solver case))
         (args (cl-mpm/framework:material-particle-initargs material))
         (law (getf args :creep-law)))
    (loop for (item kind) in
      (list (list material :native) (list geometry :slope) (list solver :explicit)
            (list (cl-mpm/framework:simulation-boundary case) :rollers)) do
        (cl-mpm/framework::check-kind item (list kind)))
    (cl-mpm/framework::check-kind loading '(:gravity :crest-pusher))
    (unless (and (eq (cl-mpm/framework:material-particle-class material)
                     'cl-mpm/models/clay-creep:particle-clay-creep)
                 (typep law 'cl-mpm/models/clay-creep:clay-creep-law))
      (error "Slope creep requires the explicit clay-creep native material."))
    (dolist (entry +defaults+) (setf (gethash (car entry) config) (cdr entry)))
    (maphash (lambda (key value)
               (unless (assoc key +defaults+ :test #'equal)
                 (error "Unknown slope-creep parameter ~S" key))
               (setf (gethash key config) value))
             (cl-mpm/framework:simulation-parameters case))
    (flet ((copy-options (item mappings)
             (dolist (entry mappings)
               (destructuring-bind (key name default) entry
                 (setf (gethash name config) (cl-mpm/framework:option item key default))))))
      (copy-options geometry '((:width "width" 20d0) (:height "height" 10d0)
                              (:crest-length "crestLength" 10d0) (:slope "slope" 60d0)
                              (:base-height "baseHeight" 5d0)))
      (copy-options solver '((:mesh-size "meshSize" 1d0) (:mps-per-cell "mpsPerCell" 2)
                            (:workers "workers" 1) (:time-step-scale "timeStepScale" .2d0)
                            (:frames "frames" 61) (:max-updates "maxUpdates" 200000))))
    (setf (gethash "E" config) (getf args :E)
          (gethash "nu" config) (getf args :nu)
          (gethash "density" config) (cl-mpm/framework:option material :density 1800d0)
          (gethash "gravity" config) -9.80665d0
          (gethash "yieldPeakPa" config) (cl-mpm/models/clay-creep:clay-creep-law-yield-peak law)
          (gethash "yieldResidualPa" config) (cl-mpm/models/clay-creep:clay-creep-law-yield-residual law)
          (gethash "softeningKappa" config) (cl-mpm/models/clay-creep:clay-creep-law-softening-kappa law)
          (gethash "viscosityPaS" config) (cl-mpm/models/clay-creep:clay-creep-law-viscosity law))
    (dolist (key '("duration" "E" "density" "width" "height" "crestLength"
                   "baseHeight" "meshSize" "settleTolerance"))
      (unless (and (finite-p (gethash key config)) (> (gethash key config) 0d0))
        (error "~A must be finite and positive." key)))
    (unless (and (finite-p (gethash "nu" config)) (< -1d0 (gethash "nu" config) .5d0)
                 (< 0d0 (gethash "slope" config) 90d0)
                 (< 0d0 (gethash "timeStepScale" config) 1d0)
                 (<= (gethash "crestLength" config) (gethash "width" config))
                 (finite-p (gethash "settleDamping" config))
                 (>= (gethash "settleDamping" config) 0d0))
      (error "Invalid elasticity, geometry, timestep or settling damping."))
    (dolist (key '("workers" "mpsPerCell" "frames" "maxUpdates" "settleMaxUpdates"
                   "settleMinUpdates" "settleHoldChecks"))
      (unless (and (integerp (gethash key config)) (plusp (gethash key config)))
        (error "~A must be a positive integer." key)))
    (unless (and (>= (gethash "frames" config) 2)
                 (<= (gethash "settleMinUpdates" config) (gethash "settleMaxUpdates" config)))
      (error "Invalid frame or initialization budget."))
    ;; Leave the historical gravity-only compiled config byte behavior unchanged.
    (when (eq (cl-mpm/framework:component-kind loading) :crest-pusher)
      (setf (gethash "loadingKind" config) "crest-pusher"
            (gethash "pusherVelocity" config) (cl-mpm/framework:option loading :velocity .005d0)
            (gethash "patchStart" config) (cl-mpm/framework:option loading :patch-start 7d0)
            (gethash "patchLength" config) (cl-mpm/framework:option loading :patch-length 3d0)
            (gethash "penaltyScale" config) (cl-mpm/framework:option loading :penalty-scale 5d0))
      (dolist (key '("pusherVelocity" "patchLength" "penaltyScale"))
        (unless (and (finite-p (gethash key config)) (> (gethash key config) 0d0))
          (error "~A must be positive and finite." key)))
      (unless (and (finite-p (gethash "patchStart" config))
                   (>= (gethash "patchStart" config) 0d0)
                   (<= (+ (gethash "patchStart" config) (gethash "patchLength" config))
                       (gethash "crestLength" config)))
        (error "Pusher patch must lie on the original crest.")))
    config))

