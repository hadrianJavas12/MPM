(in-package :cl-mpm/scenario/gravity-slope)

(defparameter +parameter-keys+
  '("domainWidth" "domainHeight" "duration" "gravityRampDuration" "gravity"
    "strengthReductionFactor" "referenceCohesionPa" "referenceFrictionDeg"
    "geometryProvenance"))

(defun required-option (item key)
  (let* ((missing (gensym)) (value (cl-mpm/framework:option item key missing)))
    (when (eq value missing) (error "Gravity slope requires explicit ~S." key))
    value))

(defun check-material (material config)
  "Bind the independently reduced perfect Cauchy law to its declared SRF."
  (unless (eq (cl-mpm/framework:material-particle-class material)
              'cl-mpm/models/mc-evolution:particle-mc-evolution)
    (error "Gravity slope requires the exact native MC-evolution particle class."))
  (let* ((args (cl-mpm/framework:material-particle-initargs material))
         (law (getf args :evolution-law))
         (srf (gethash "strengthReductionFactor" config))
         (cohesion (/ (gethash "referenceCohesionPa" config) srf))
         (phi (atan (/ (tan (* pi (/ (gethash "referenceFrictionDeg" config) 180d0))) srf))))
    ;; Reject hidden initial state, body forces or kinematic initargs for this
    ;; first recipe. Other material classes may get their own reviewed adapter.
    (loop for key in args by #'cddr do
      (unless (member key '(:E :nu :evolution-law :enable-plasticity))
        (error "Unsupported gravity-slope material initarg ~S." key)))
    (unless (and (typep law 'cl-mpm/models/mc-evolution:evolution-law)
                 (eq (cl-mpm/models/mc-evolution:evolution-law-variant law) :perfect)
                 (eq (cl-mpm/models/mc-evolution:evolution-law-stress-measure law) :cauchy)
                 (eq (getf args :enable-plasticity) t))
      (error "Gravity slope requires an enabled perfect-plastic Cauchy MC law."))
    (unless (and (= (length (cl-mpm/models/mc-evolution:evolution-law-points law)) 1)
                 (= (length (cl-mpm/models/mc-evolution::evolution-law-cohesion-points law)) 1))
      (error "Gravity-slope perfect law must have one constant cohesion/friction point."))
    (multiple-value-bind (actual-c actual-phi actual-psi)
        (cl-mpm/models/mc-evolution:law-values law 0d0)
      (unless (and (<= (abs (- actual-c cohesion)) (* 1d-12 (max 1d0 cohesion)))
                   (<= (abs (- actual-phi phi)) 1d-12) (zerop actual-psi))
        (error "Material law disagrees with c/SRF, atan(tan(phi)/SRF), or psi=0.")))
    (setf (gethash "cohesionPa" config) cohesion
          (gethash "frictionRad" config) phi
          (gethash "dilationRad" config) 0d0
          (gethash "E" config) (getf args :E)
          (gethash "nu" config) (getf args :nu)
          (gethash "density" config) (required-option material :density))))

(defun compile-configuration (case)
  "Compile explicit SI inputs without settling, a driver or a hidden ramp."
  (let* ((config (make-hash-table :test 'equal))
         (material (cl-mpm/framework:simulation-material case))
         (geometry (cl-mpm/framework:simulation-geometry case))
         (boundary (cl-mpm/framework:simulation-boundary case))
         (loading (cl-mpm/framework:simulation-loading case))
         (solver (cl-mpm/framework:simulation-solver case))
         (parameters (cl-mpm/framework:simulation-parameters case)))
    (loop for (item kind) in (list (list material :native) (list geometry :slope)
                                  (list boundary :rollers) (list loading :gravity)
                                  (list solver :explicit))
          do (cl-mpm/framework::check-kind item (list kind)))
    (maphash (lambda (key value)
               (unless (member key +parameter-keys+ :test #'equal)
                 (error "Unknown gravity-slope parameter ~S." key))
               (setf (gethash key config) value)) parameters)
    (dolist (key +parameter-keys+)
      (unless (nth-value 1 (gethash key config))
        (error "Gravity slope requires explicit parameter ~A." key)))
    (unless (and (stringp (gethash "geometryProvenance" config))
                 (plusp (length (string-trim '(#\Space #\Tab #\Newline #\Return)
                                            (gethash "geometryProvenance" config)))))
      (error "geometryProvenance must explicitly describe the polygon's source and limits."))
    (flet ((copy-options (item mappings)
             (dolist (mapping mappings)
               (setf (gethash (second mapping) config)
                     (required-option item (first mapping))))))
      (copy-options geometry '((:width "width") (:height "height")
                              (:crest-length "crestLength") (:slope "slope")
                              (:base-height "baseHeight")))
      (copy-options solver '((:mesh-size "meshSize") (:mps-per-cell "mpsPerCell")
                            (:workers "workers") (:time-step-scale "timeStepScale")
                            (:frames "frames") (:max-updates "maxUpdates")
                            (:damping "damping"))))
    (maphash (lambda (key value)
               (unless (or (equal key "geometryProvenance") (finite-p value))
                 (error "~A must be finite." key))) config)
    (dolist (key '("domainWidth" "domainHeight" "duration" "gravityRampDuration"
                   "referenceCohesionPa" "width" "height" "crestLength" "meshSize"
                   "timeStepScale"))
      (unless (> (gethash key config) 0d0) (error "~A must be positive." key)))
    (dolist (key '("mpsPerCell" "workers" "frames" "maxUpdates"))
      (unless (and (integerp (gethash key config)) (> (gethash key config) 0))
        (error "~A must be a positive integer." key)))
    (unless (and (>= (gethash "frames" config) 2)
                 (>= (gethash "strengthReductionFactor" config) 1d0)
                 (< 0d0 (gethash "referenceFrictionDeg" config) 90d0)
                 (< 0d0 (gethash "slope" config) 90d0)
                 (zerop (gethash "baseHeight" config))
                 (zerop (gethash "damping" config))
                 (< (gethash "gravity" config) 0d0)
                 (<= (gethash "gravityRampDuration" config) (gethash "duration" config))
                 (<= (gethash "timeStepScale" config) .5d0)
                 (> (gethash "domainWidth" config) (gethash "width" config))
                 (>= (gethash "domainHeight" config)
                     (+ (gethash "height" config) (gethash "meshSize" config))))
      (error "Invalid gravity-slope ramp, domain, D1 base, damping or solver bounds."))
    (let ((toe (+ (gethash "crestLength" config)
                  (/ (gethash "height" config)
                     (tan (* pi (/ (gethash "slope" config) 180d0)))))))
      (unless (<= (abs (- toe (gethash "width" config))) 1d-10)
        (error "Soil width must end at the declared unnotched slope toe."))
      (setf (gethash "toeX" config) toe))
    ;; No ceil-expanded dimensions concealed in the domain or particle spacing.
    (dolist (key '("domainWidth" "domainHeight" "width" "height"))
      (let ((cells (/ (gethash key config) (gethash "meshSize" config))))
        (unless (<= (abs (- cells (round cells))) 1d-10)
          (error "~A must be an integer multiple of meshSize." key))))
    (check-material material config)
    (unless (and (finite-p (gethash "E" config)) (> (gethash "E" config) 0d0)
                 (finite-p (gethash "nu" config)) (< -1d0 (gethash "nu" config) .5d0)
                 (finite-p (gethash "density" config)) (> (gethash "density" config) 0d0))
      (error "Invalid elastic constants or density."))
    config))
