(in-package :cl-mpm/scenario/residual-clay-slope)
(defstruct (observation-context (:constructor %context))
  reference initial-kappa initial-work switch-positions switch-kappa switch-work switch-native-time ledger (preparation-updates 0) failure-directory)
(defun capture-reference (sim config)
  (let* ((reference (gs::capture-reference-state sim config))
         (mask (map 'vector (lambda (p) (and (> (component p 0) (or (gethash "observerInitialXGreater" config) 2d0))
                                             (> (component p 1) (or (gethash "observerInitialYGreater" config) 6d0))))
                    (gs::reference-state-positions reference)))
         (masses (gs::reference-state-masses reference)))
    (setf (gs::reference-state-upper-p reference) mask
          (gs::reference-state-upper-mass reference) (loop for m across masses for use across mask when use sum m)
          ;; This is material V0, NEVER a compressed volume at a later phase.
          (gs::reference-state-volumes reference) (map 'vector #'cl-mpm/particle::mp-volume-0 (cl-mpm:sim-mps sim)))
    (unless (> (gs::reference-state-upper-mass reference) 0d0) (error "Empty declared upper cohort."))
    (%context :reference reference :initial-kappa (map 'vector #'mc:particle-kappa (cl-mpm:sim-mps sim))
              :initial-work (map 'vector #'mc:particle-plastic-work (cl-mpm:sim-mps sim)))))
(defun rebind-reference-after-transfer (sim context ledger)
  "Authorize only the declared order-preserving clone swap; retain original material V0 and origins."
  (let* ((reference (observation-context-reference context)) (mps (cl-mpm:sim-mps sim)))
    (unless (and (= (length mps) (length ledger) (length (gs::reference-state-particles reference)))
                 (null (observation-context-switch-native-time context))) (error "Invalid/repeated transfer reference swap."))
    (dotimes (id (length mps))
      (unless (and (= (gethash "particleIndex" (aref ledger id)) id)
                   (= (cl-mpm/particle:mp-mass (aref mps id)) (aref (gs::reference-state-masses reference) id))
                   (= (cl-mpm/particle::mp-volume-0 (aref mps id)) (aref (gs::reference-state-volumes reference) id)))
        (error "Transfer changed logical ID, mass or material reference volume.")))
    (setf (gs::reference-state-particles reference) (copy-seq mps)
          (observation-context-switch-positions context) (map 'vector (lambda (mp) (cl-mpm/utils:vector-copy (cl-mpm/particle:mp-position mp))) mps)
          (observation-context-switch-kappa context) (map 'vector #'mc:particle-kappa mps)
          (observation-context-switch-work context) (map 'vector #'mc:particle-plastic-work mps)
          (observation-context-switch-native-time context) (cl-mpm::sim-time sim)
          (observation-context-ledger context) ledger))
  context)
(defun damage-active-p (mp) (typep mp 'mc:particle-mc-evolution))
(defun damage-value (mp)
  "Frictional strength loss at the same positive normal stress; NOT cohesion damage."
  (- 1d0 (/ (tan (mc:particle-phi mp)) (tan (* pi (/ 33.99d0 180d0))))))
(defun projection-trial-scale (mp)
  "Recover actual principal trial tau from accepted tau+D:delta-eps-p at fixed current E/nu."
  (let ((projection (mc:particle-last-projection mp)))
    (if projection
        (mc::max-abs3 (map 'vector #'+ (mc:projection-tau projection)
          (mc::d-times (mc:projection-plastic-increment projection)
            (/ (cl-mpm/particle::mp-E mp) (* 2d0 (+ 1d0 (cl-mpm/particle::mp-nu mp))))
            (/ (cl-mpm/particle::mp-E mp) (* 3d0 (- 1d0 (* 2d0 (cl-mpm/particle::mp-nu mp))))))))
        (let ((stress (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress mp))))
          (unless (every #'zerop stress) (error "Owned nonzero state lacks an accepted projection scale.")) 0d0))))
(defun native-yield-tolerance (mp)
  (+ mc::+stress-atol+ (* mc::+stress-rtol+ (max 1d0 (projection-trial-scale mp)))))
(defun configure-output (sim)
  (let ((diagnostics (make-instance 'fw::mc-evolution-material-diagnostics)))
    (fw:configure-material-output diagnostics sim)
    (dolist (field (list (list "mc-strength-damage" #'damage-value)
                         (list "mc-damage-active" (lambda (mp) (if (damage-active-p mp) 1d0 0d0)))
                         (list "mc-kappa-origin" (lambda (mp) (if (damage-active-p mp) 0d0 0d0)))
                         (list "mc-native-yield-tolerance-pa" #'native-yield-tolerance)
                         (list "mc-projection-trial-scale-pa" #'projection-trial-scale)
                         (list "mc-logical-id" #'cl-mpm/particle::mp-unique-index)))
      (when (find (first field) (cl-mpm::sim-output-list-scalar sim) :key #'first :test #'string=)
        (error "Owned output field already present: ~A" (first field)))
      (setf (cl-mpm::sim-output-list-scalar sim) (append (cl-mpm::sim-output-list-scalar sim) (list field)))))
  sim)
(defun dynamic-time (sim context)
  (if (observation-context-switch-native-time context)
      (- (cl-mpm::sim-time sim) (observation-context-switch-native-time context)) 0d0))
(defun kinetic-ratio (sim config)
  (when (> (free-nodal-mass sim) 0d0)
    (/ (free-ke sim) (* (free-nodal-mass sim) (- (value config "gravity")) (value config "height")))))
(defun capture-output-failure (mp id context config j volume v0 size residual)
  "Failure-only raw output guard values; neither a restart nor a material replay capsule."
  (when (observation-context-failure-directory context)
    (handler-case
      (let* ((initial-kappa (aref (observation-context-initial-kappa context) id))
             (initial-work (aref (observation-context-initial-work context) id))
             (kappa (mc:particle-kappa mp)) (work (mc:particle-plastic-work mp))
             (tol (native-yield-tolerance mp)) (volume-error (abs (- volume (* j v0))))
             (bound (* 1d-10 (max 1d0 volume))))
        (write-json (merge-pathnames "output-state-failure.json" (observation-context-failure-directory context))
          (obj "schema" "cl-mpm.owned-output-guard.v1"
            "scope" "Actual output-state values captured on failure; NOT a restart or constitutive trial capsule"
            "particleId" id "config" config "position" (copy-seq (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-position mp)))
            "F" (copy-seq (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-deformation-gradient mp)))
            "volume" volume "J" j "originalV0" v0 "volumeError" volume-error "volumeErrorBound" bound
            "domainSize" (copy-seq (cl-mpm/utils:fast-storage size))
            "kappa" kappa "initialKappa" initial-kappa "work" work "initialWork" initial-work
            "yieldResidual" residual "nativeYieldTolerance" tol
            "checks" (obj
              "logicalId" (if (= (cl-mpm/particle::mp-unique-index mp) id) t 'yason:false)
              "volumeIdentity" (if (<= volume-error bound) t 'yason:false)
              "domainXPositive" (if (> (component size 0) 0d0) t 'yason:false)
              "domainYPositive" (if (> (component size 1) 0d0) t 'yason:false)
              "kappaAtLeastInitial" (if (>= kappa initial-kappa) t 'yason:false)
              "workAtLeastInitial" (if (>= work (- initial-work 1d-8)) t 'yason:false)
              "yieldWithinNativeTolerance" (if (<= residual tol) t 'yason:false)))))
      (error (condition)
        (ignore-errors (format *error-output* "~&Output failure capture unavailable: ~A~%" condition))))))
(defun audit-state (sim context config)
  (let* ((reference (observation-context-reference context))
         (stats (gs::measure-state sim (make-instance 'fw::mc-evolution-material-diagnostics) reference config))
         (max-damage 0d0) (sum-damage 0d0) (work 0d0) (max-dynamic 0d0)
         (min-domain most-positive-double-float) (touch-mass 0d0))
    (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
      (let* ((volume (cl-mpm/particle:mp-volume mp))
             (j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))
             (v0 (aref (gs::reference-state-volumes reference) id))
             (p (cl-mpm/particle:mp-position mp)) (size (cl-mpm/particle::mp-domain-size mp))
             (margin (min (- (component p 0) (* .5d0 (component size 0)))
                          (- (value config "domainWidth") (component p 0) (* .5d0 (component size 0)))
                          (- (component p 1) (* .5d0 (component size 1)))
                          (- (value config "domainHeight") (component p 1) (* .5d0 (component size 1)))))
             (d (damage-value mp)) (residual (mc:particle-yield-residual-kirchhoff mp)))
        (unless (and (= (cl-mpm/particle::mp-unique-index mp) id)
                     (<= (abs (- volume (* j v0))) (* 1d-10 (max 1d0 volume)))
                     (> (component size 0) 0d0) (> (component size 1) 0d0)
                     (>= (mc:particle-kappa mp) (aref (observation-context-initial-kappa context) id))
                     (>= (mc:particle-plastic-work mp) (- (aref (observation-context-initial-work context) id) 1d-8))
                     (<= residual (native-yield-tolerance mp)))
          (capture-output-failure mp id context config j volume v0 size residual)
          (error "Owned frame violates V=J*V0, domain/history/work/yield at ID~D." id))
        (multiple-value-bind (expected-c expected-phi expected-psi)
            (mc:law-values (mc:particle-evolution-law mp) (mc:particle-kappa mp))
          (unless (and (= (mc:particle-cohesion mp) expected-c)
                       (< (abs (- (mc:particle-phi mp) expected-phi)) 1d-12)
                       (< (abs (- (mc:particle-psi mp) expected-psi)) 1d-12)
                       (<= -1d-12 d (+ .75d0 1d-12)))
            (error "Residual-clay accepted law/strength-floor mismatch at ID~D." id)))
        (setf max-damage (max max-damage d) min-domain (min min-domain margin))
        (when (<= margin 0d0) (incf touch-mass (cl-mpm/particle:mp-mass mp)))
        (incf sum-damage (* (cl-mpm/particle:mp-mass mp) d))
        (incf work (* volume (mc:particle-plastic-work mp)))
        (when (observation-context-switch-positions context)
          (let ((p0 (aref (observation-context-switch-positions context) id)))
            (setf max-dynamic (max max-dynamic (sqrt (+ (expt (- (component p 0) (component p0 0)) 2)
                                                                       (expt (- (component p 1) (component p0 1)) 2)))))))))
    (setf (gethash "max_strength_damage" stats) max-damage
          (gethash "mass_weighted_strength_damage" stats) (/ sum-damage (gs::reference-state-mass reference))
          (gethash "plastic_work_current_volume_proxy_j_per_m" stats) work
          (gethash "max_dynamic_displacement_m" stats) max-dynamic
          (gethash "min_particle_domain_margin_m" stats) min-domain
          (gethash "touching_domain_mass_fraction" stats) (/ touch-mass (gs::reference-state-mass reference)))
    stats))
(defparameter +extra-history-columns+
  '("native_time_s" "preparation_time_s" "phase_code" "force_ratio_defined" "free_force_numerator2" "free_force_denominator2"
    "free_ke_j_per_m" "free_nodal_mass_kg_per_m" "free_ke_ratio" "free_ke_ratio_defined"
    "max_strength_damage" "mass_weighted_strength_damage" "plastic_work_current_volume_proxy_j_per_m"
    "max_dynamic_displacement_m" "touching_domain_mass_fraction" "dynamic_updates" "preparation_updates"))
(defparameter +history-columns+ (append gs::+history-columns+ +extra-history-columns+))
(defparameter +particle-columns+ (append gs::+particle-columns+
  '("native_time_s" "phase_code" "damage_active" "strength_damage" "kappa_origin"
    "transfer_x_m" "transfer_y_m" "dynamic_dx_m" "dynamic_dy_m"
    "initial_kappa" "transfer_kappa" "plastic_work_since_initial_pa" "plastic_work_since_transfer_pa"
    "particle_domain_margin_m" "E_pa" "nu" "native_yield_tolerance_pa" "native_projection_trial_scale_pa")))
(defun write-headers (history particles)
  (format history "~{~A~^,~}~%" +history-columns+) (format particles "~{~A~^,~}~%" +particle-columns+))
(defun save-state (sim context config path frame phase-code updates history particles)
  "Read-only numeric CSV+real VTK snapshot; time_s is dynamic time, native clock is explicit."
  (let* ((stats (audit-state sim context config)) (time (dynamic-time sim context))
         (reference (observation-context-reference context)) (kr (kinetic-ratio sim config)))
    (setf (gethash "dynamic_updates" stats) (if (observation-context-switch-native-time context)
                                               (- updates (observation-context-preparation-updates context)) 0)
          (gethash "preparation_updates" stats) (if (observation-context-switch-native-time context)
                                                   (observation-context-preparation-updates context) updates))
    (cl-mpm/output:save-vtk path sim)
    (gs::write-csv-row history (append
      (list frame time updates (gs:ramp-factor (cl-mpm::sim-time sim) (value config "gravityRampDuration")) (cl-mpm:sim-gravity sim))
      (mapcar (lambda (key) (gethash key stats)) (nthcdr 5 gs::+history-columns+))
      (list (cl-mpm::sim-time sim) (or (observation-context-switch-native-time context) (cl-mpm::sim-time sim)) phase-code
            (if (force-ratio sim) 1 0) (force-numerator2 sim) (force-denominator2 sim)
            (free-ke sim) (free-nodal-mass sim) (or kr 0d0) (if kr 1 0))
      (mapcar (lambda (key) (gethash key stats)) (nthcdr 10 +extra-history-columns+))) +history-columns+)
    (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
      (let* ((p (cl-mpm/particle:mp-position mp))
             (switch (and (observation-context-switch-positions context) (aref (observation-context-switch-positions context) id)))
             (work (mc:particle-plastic-work mp)) (size (cl-mpm/particle::mp-domain-size mp)))
        (gs::write-csv-row particles (append (gs::particle-row mp reference id frame time)
          (list (cl-mpm::sim-time sim) phase-code (if (damage-active-p mp) 1 0) (damage-value mp)
                (if (damage-active-p mp) 0d0 0d0)
                (if switch (component switch 0) 0d0) (if switch (component switch 1) 0d0)
                (if switch (- (component p 0) (component switch 0)) 0d0)
                (if switch (- (component p 1) (component switch 1)) 0d0)
                (aref (observation-context-initial-kappa context) id)
                (if switch (aref (observation-context-switch-kappa context) id) 0d0)
                (- work (aref (observation-context-initial-work context) id))
                (if switch (- work (aref (observation-context-switch-work context) id)) 0d0)
                (min (- (component p 0) (* .5d0 (component size 0)))
                     (- (value config "domainWidth") (component p 0) (* .5d0 (component size 0)))
                     (- (component p 1) (* .5d0 (component size 1)))
                     (- (value config "domainHeight") (component p 1) (* .5d0 (component size 1))))
                (cl-mpm/particle::mp-E mp) (cl-mpm/particle::mp-nu mp)
                (native-yield-tolerance mp) (projection-trial-scale mp))) +particle-columns+)))
    (finish-output history) (finish-output particles) stats))
