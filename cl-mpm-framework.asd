(asdf:defsystem "cl-mpm-framework"
  :description "Composable, headless native CL-MPM simulation recipes"
  :depends-on ("cl-mpm" "cl-mpm/setup" "cl-mpm/damage" "cl-mpm/models/chalk"
               "cl-mpm/output" "cl-mpm/penalty" "cl-mpm/plotter" "vgplot"
               "jonathan" "yason" "alexandria" "uiop")
  :serial t
  :components
  (
   (:file "config/package" :pathname "src/simulation/config/package")
   (:file "config/parameters" :pathname "src/simulation/config/parameters")
   (:file "package" :pathname "src/simulation/package")
   (:file "components/base" :pathname "src/simulation/components/base")
   (:file "components/material-definition" :pathname "materials/core/definition")
   (:file "components/specifications" :pathname "src/simulation/components/specifications")
   (:file "components/materials" :pathname "materials/adapters/native")
   (:file "components/diagnostics" :pathname "materials/core/diagnostics-interface")
   (:file "components/native-diagnostics" :pathname "materials/diagnostics/native")
   (:file "components/material-output" :pathname "src/measurements/material-output")
   (:file "components/geometry" :pathname "src/simulation/components/geometry")
   (:file "simulation" :pathname "src/simulation/lifecycle")
   (:file "scenarios/cliff/settings" :pathname "scenarios/cliff/settings")
   (:file "scenarios/cliff/settings-p4-owner-2" :pathname "src/numerics/angles")
   (:file "scenarios/cliff/settings-p4-owner-3" :pathname "scenarios/cliff/solver")
   (:file "materials/chalk" :pathname "materials/models/chalk/joss-reference")
   (:file "materials/chalk-p4-owner-2" :pathname "materials/adapters/chalk")
   (:file "scenarios/cliff/geometry" :pathname "scenarios/cliff/geometry")
   (:file "scenarios/cliff/build" :pathname "scenarios/cliff/build")
   (:file "output/plotting" :pathname "src/output/plotting/legacy-particle")
   (:file "scenarios/joss/classes" :pathname "scenarios/joss/classes")
   (:file "scenarios/joss/statistics" :pathname "scenarios/joss/statistics")
   (:file "scenarios/joss/phases" :pathname "scenarios/joss/phases")
   (:file "scenarios/joss/geometry" :pathname "scenarios/joss/geometry")
   (:file "scenarios/joss/build" :pathname "scenarios/joss/build")
   (:file "scenarios/joss/measurements" :pathname "scenarios/joss/measurements")
   (:file "scenarios/joss/measurements-p4-owner-2" :pathname "materials/diagnostics/chalk-reference")
   (:file "scenarios/joss/measurements-p4-owner-3" :pathname "scenarios/joss/validation")
   (:file "scenarios/joss/output" :pathname "scenarios/joss/output")
   (:file "scenarios/joss/run" :pathname "scenarios/joss/run")
   (:file "scenarios/cliff/run" :pathname "scenarios/cliff/run")
   (:file "scenarios/triaxial/package" :pathname "src/simulation/compatibility/triaxial-package")
   (:file "scenarios/triaxial/package-p4-owner-2" :pathname "scenarios/triaxial/state")
   (:file "scenarios/triaxial/config" :pathname "src/simulation/config/legacy-triaxial-values")
   (:file "scenarios/triaxial/config-p4-owner-2" :pathname "scenarios/triaxial/config")
   (:file "scenarios/triaxial/config-p4-owner-3" :pathname "src/output/legacy-triaxial-json")
   (:file "scenarios/triaxial/config-p4-owner-4" :pathname "materials/adapters/diagnostics-call")
   (:file "scenarios/triaxial/tensors" :pathname "src/numerics/legacy-tensors")
   (:file "scenarios/triaxial/tensors-p4-owner-2" :pathname "src/measurements/legacy-particle")
   (:file "scenarios/triaxial/tensors-p4-owner-3" :pathname "scenarios/triaxial/stress-measures")
   (:file "scenarios/triaxial/tensors-p4-owner-4" :pathname "src/measurements/legacy-stress")
   (:file "scenarios/triaxial/material" :pathname "materials/adapters/triaxial")
   (:file "scenarios/triaxial/material-p4-owner-2" :pathname "materials/adapters/legacy-triaxial")
   (:file "scenarios/triaxial/geometry" :pathname "scenarios/triaxial/geometry")
   (:file "scenarios/triaxial/boundaries" :pathname "src/boundaries/pressure/isotropic")
   (:file "scenarios/triaxial/measurements" :pathname "scenarios/triaxial/measurements")
   (:file "scenarios/triaxial/mpm" :pathname "scenarios/triaxial/mpm")
   (:file "scenarios/triaxial/homogeneous" :pathname "scenarios/triaxial/homogeneous")
   (:file "scenarios/triaxial/controls" :pathname "scenarios/triaxial/controls")
   (:file "scenarios/triaxial/runner" :pathname "scenarios/triaxial/runner")
   (:file "scenarios/triaxial/adapter" :pathname "scenarios/triaxial/adapter")
   (:file "scenarios/cliff/adapter" :pathname "scenarios/cliff/adapter")
   (:file "scenarios/cliff/adapter-p4-owner-2" :pathname "materials/adapters/cliff")
   (:file "scenarios/cliff/adapter-p4-owner-3" :pathname "scenarios/cliff/execute")))
