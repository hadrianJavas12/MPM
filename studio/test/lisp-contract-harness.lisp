;;;; Dependency-free SBCL contract tests, NOT a CL-MPM solver or benchmark.
;;;; Only dependency packages/matrices are stubbed. Production config and custom loader are loaded.
(require :asdf)
(defpackage :magicl (:use :cl) (:export #:matrix/double-float #:shape))
(in-package :magicl)
(defclass matrix/double-float ()
  ((shape :initarg :shape :initform '(6 1) :accessor shape)
   (storage :initarg :storage :initform (make-array 6 :element-type 'double-float :initial-element 0d0) :accessor storage)))
(defpackage :cl-mpm/utils (:use :cl) (:export #:voigt-copy-into))
(in-package :cl-mpm/utils)
(defun fast-storage (matrix) (magicl::storage matrix))
(defun voigt-copy-into (source target)
  (replace (fast-storage target) (fast-storage source)) target)
(defpackage :cl-mpm/constitutive (:use :cl))
(in-package :cl-mpm/constitutive)
(defun linear-elastic-mat (strain elastic &optional (result (make-instance 'magicl:matrix/double-float)))
  ;; A diagonal test fixture, not MAGICL/OpenBLAS or the physical constitutive law.
  (map-into (cl-mpm/utils::fast-storage result) #'*
            (cl-mpm/utils::fast-storage strain) (cl-mpm/utils::fast-storage elastic)) result)
(defpackage :cl-mpm/particle (:use :cl) (:export #:constitutive-model #:mp-damage))
(in-package :cl-mpm/particle)
(defclass particle-chalk-delayed ()
  ((stress :initform (make-instance 'magicl:matrix/double-float) :accessor mp-stress)
   (stress-kirchoff :initform (make-instance 'magicl:matrix/double-float) :accessor mp-stress-kirchoff)
   (undamaged-stress :initform (make-instance 'magicl:matrix/double-float) :accessor mp-undamaged-stress)
   (elastic-matrix :initform (make-instance 'magicl:matrix/double-float :storage (make-array 6 :element-type 'double-float :initial-element 2d0)) :accessor mp-elastic-matrix)
   (enable-plasticity :initarg :enable-plasticity :initform nil :accessor mp-enable-plasticity)
   (enable-damage :initarg :enable-damage :initform nil :accessor mp-enable-damage)
   (damage :initarg :damage :initform 0d0 :accessor mp-damage)))
(defgeneric constitutive-model (mp strain dt))
(defvar *base-calls* 0)
(defmethod constitutive-model ((mp particle-chalk-delayed) strain dt)
  (declare (ignore dt)) (incf *base-calls*)
  (cl-mpm/constitutive::linear-elastic-mat strain (mp-elastic-matrix mp) (mp-stress-kirchoff mp)))
(defpackage :jonathan (:use :cl) (:export #:parse))
(in-package :jonathan)
(defvar *schema-fixture*)
(defun parse (text &key as) (declare (ignore text as)) *schema-fixture*)
(defpackage :ql (:use :cl) (:export #:quickload))
(in-package :ql)
(defun quickload (&rest args) (declare (ignore args)))
(in-package :cl-user)
(defvar *expected-config*)
(defvar *input-config*)
(defvar *run-count* 0)

(defun expect-error (thunk &optional message)
  (let ((error (handler-case (progn (funcall thunk) nil) (error (e) e))))
    (assert error () "Expected an error")
    (when message (assert (search message (princ-to-string error)) () "Unexpected error: ~A" error))))

(defun assert-config (config)
  (assert (= (hash-table-count config) (hash-table-count *expected-config*)))
  (maphash (lambda (key expected)
             (let ((actual (gethash key config)))
               (assert (if (numberp expected)
                           (<= (abs (- actual expected)) (* 1d-12 (max 1d0 (abs expected))))
                           (equal actual expected)) () "Config mismatch: ~A: ~S vs ~S" key actual expected)))
           *expected-config*))

(defun load-compiled (source output)
  (multiple-value-bind (fasl warnings failure) (compile-file source :output-file output)
    (declare (ignore warnings))
    (assert (not failure) () "Compilation failed for ~A" source)
    (load fasl)))

;; Establish the production package before the reader encounters its qualified symbols.
(load (merge-pathnames "studio/lisp/package.lisp"
                       (uiop:ensure-directory-pathname (second sb-ext:*posix-argv*))))

(let* ((args (rest sb-ext:*posix-argv*))
       (root (uiop:ensure-directory-pathname (first args)))
       (fixtures (uiop:ensure-directory-pathname (second args)))
       (mode (third args)))
  (load (merge-pathnames "registry/lisp/cl-mpm-studio.asd" fixtures))
  (load (merge-pathnames "fixture.lisp" fixtures))
  (load (merge-pathnames "studio/lisp/package.lisp" root))
  (load-compiled (merge-pathnames "studio/lisp/config.lisp" root) (merge-pathnames "config.fasl" fixtures))
  (load-compiled (merge-pathnames "studio/lisp/custom-model.lisp" root) (merge-pathnames "custom-model.fasl" fixtures))
  (cond
    ((string= mode "config")
     (let ((result (make-hash-table :test #'equal)))
       (maphash (lambda (key spec)
                  (multiple-value-bind (value present) (gethash key *input-config*)
                    (setf (gethash key result) (cl-mpm-studio::coerce-param spec (if present value (gethash "default" spec))))))
                (cl-mpm-studio::schema))
       (assert-config result))
     (assert (null (cl-mpm-studio::decimal-input "#.(error \"reader evaluation\")")))
     (format t "~&CONFIG PARITY PASSED~%"))
    ((string= mode "export")
     (setf (symbol-function 'cl-mpm-studio:run)
           (lambda (config output)
             (declare (ignore output))
             (when (eq (gethash "constitutiveModel" config) :custom) (cl-mpm-studio::ensure-custom-model))
             (assert-config config) (incf *run-count*)))
     (load (merge-pathnames "simulation.lisp" fixtures))
     (assert (= *run-count* 1))
     (format t "~&EXPORT EVALUATION PASSED~%"))
    ((string= mode "model")
     (let ((mp (make-instance 'cl-mpm-studio::studio-custom-chalk))
           (strain (make-instance 'magicl:matrix/double-float :storage (make-array 6 :element-type 'double-float :initial-element 0.25d0))))
       (expect-error (lambda () (cl-mpm-studio:load-custom-model nil)) "Missing")
       (cl-mpm-studio:load-custom-model (merge-pathnames "delegate.lisp" fixtures))
       (cl-mpm/particle:constitutive-model mp strain 0.1d0)
       (assert (= cl-mpm/particle::*base-calls* 1))
       (cl-mpm/particle:constitutive-model (make-instance 'cl-mpm/particle::particle-chalk-delayed) strain 0.1d0)
       (assert (= cl-mpm/particle::*base-calls* 2))
       (dolist (file '("missing.lisp" "auxiliary.lisp" "wrong-signature.lisp" "partial.lisp"))
         (expect-error (lambda () (cl-mpm-studio:load-custom-model (merge-pathnames file fixtures))))
         (expect-error #'cl-mpm-studio::ensure-custom-model))
       (dolist (file '("invalid-stress.lisp" "wrong-shape.lisp" "infinite-stress.lisp" "nan-stress.lisp"))
         (cl-mpm-studio:load-custom-model (merge-pathnames file fixtures))
         (expect-error (lambda () (cl-mpm/particle:constitutive-model mp strain 0.1d0))))
       (cl-mpm-studio:load-custom-model (merge-pathnames "elastic.lisp" fixtures))
       (let ((stress (cl-mpm/particle:constitutive-model mp strain 0.1d0)))
         (assert (every (lambda (x) (= x 0.5d0)) (cl-mpm/utils::fast-storage stress)))
         (assert (equalp (cl-mpm/utils::fast-storage stress) (cl-mpm/utils::fast-storage (cl-mpm/particle::mp-undamaged-stress mp))))
         (assert (every #'zerop (cl-mpm/utils::fast-storage (cl-mpm/particle::mp-stress mp)))))
       (setf (cl-mpm/particle::mp-enable-damage mp) t)
       (expect-error (lambda () (cl-mpm/particle:constitutive-model mp strain 0.1d0)) "requires")
       (setf (cl-mpm/particle::mp-enable-damage mp) nil (cl-mpm/particle::mp-enable-plasticity mp) t)
       (expect-error (lambda () (cl-mpm/particle:constitutive-model mp strain 0.1d0)) "requires"))
     (format t "~&CLOS CONTRACT PASSED~%"))
    (t (error "Unknown harness mode: ~A" mode))))
