;;;; Explicit residual-strength history policy controls; zero old-variant capsule replays.
;;;; windows\cl-mpm.cmd tests\materials\wang2017-residual-history.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *rh-frozen* nil)
(defvar *rh-output* nil)
(defvar *rh-exit* 1)
;; Separate top-level load establishes the helper's dynamic DEFVAR before use.
(unless *rh-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *rh-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh apex-control output directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output is not fresh: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((original (cl-mpm-path "output/wang2017-soil2-2026-10-24/apex-100mm-001/mc-integration-failure.json"))
             (bytes (case-source-bytes original))
             (to (merge-pathnames "source/residual-policy-captured-input.json" directory)))
        (unless (string= (snapshot-sha256-bytes bytes) "3ad314d3416df31122a2a628056b847cbe46e687cb89c90b349964ee892da926")
          (error "Actual input fixture differs from immutable original capsule."))
        (ensure-directories-exist to)
        (with-open-file (stream to :direction :output :if-exists :error :element-type '(unsigned-byte 8)) (write-sequence bytes stream))
        (push to copied)
        (push (snapshot-object "path" "source/residual-policy-captured-input.json" "originalPath" (namestring original)
                               "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records))
      (dolist (required '("source/materials/models/plastic/wang2017/apex-package.lisp"
                          "source/materials/models/plastic/wang2017/apex-residual-history.lisp"
                          "source/materials/models/plastic/wang2017/apex-projection.lisp"
                          "source/materials/models/plastic/wang2017/apex-native.lisp"
                          "source/materials/models/plastic/wang2017/point-projection.lisp"
                          "source/materials/models/plastic/wang2017/material.lisp" "source/cl-mpm.asd"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required apex source was not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Selected source and actual-input fixture copied before first-party load" "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records)) (*rh-frozen* t) (*rh-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/wang2017-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory) (merge-pathnames "source-provenance-before.json" directory))
        (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                             (snapshot-object "files" (coerce (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))
        (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
        (load (merge-pathnames "source/case.lisp" directory))
        (dolist (path copied) (snapshot-verify-file path))
        (write-case-source-provenance directory copied nil)
        (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                             (snapshot-object "files" (coerce (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector))))))
  (uiop:quit *rh-exit*))

(defpackage :cl-mpm/tests/wang2017-residual-history (:use :cl))
(in-package :cl-mpm/tests/wang2017-residual-history)
(defvar *rh-passed* nil)
(defvar *rh-failures* nil)
(defvar *rh-skipped* nil)
(defparameter *rh-constructor-only*
  (equal (second (cl-user::cl-mpm-script-args)) "constructor-only"))
(defvar *rh-point-calls* 0)
(defvar *rh-native-calls* 0)
(defconstant +rh-e+ 20d6)
(defconstant +rh-nu+ .25d0)
(defparameter *rh-phi* (* 35d0 (/ pi 180d0)))
(defmacro rh-control (name &body body)
  `(if (and *rh-constructor-only*
            (not (equal ,name "Residual history class is explicit and keeps exact Soil2 law and owned constructor storage")))
       (push ,name *rh-skipped*)
       (handler-case (progn ,@body (push ,name *rh-passed*) (format t "~&PASS: ~A~%" ,name))
         (error (condition) (push (list ,name (princ-to-string condition)) *rh-failures*)
           (format t "~&FAIL: ~A: ~A~%" ,name condition)))))
(defun rh-near (actual expected &optional (tolerance 1d-11))
  (unless (and (= actual actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G actual ~,17G tolerance ~G" expected actual tolerance)))
(defun rh-near-vector (actual expected &optional (tolerance 1d-11))
  (assert (= (length actual) (length expected)))
  (dotimes (i (length expected)) (rh-near (elt actual i) (elt expected i) tolerance)))
(defun rh-eye () #2A((1d0 0d0 0d0) (0d0 1d0 0d0) (0d0 0d0 1d0)))
(defun rh-rows (rows)
  (let ((a (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3) (setf (aref a i j) (elt (elt rows i) j)))) a))
(defun rh-multiply (a b)
  (let ((r (make-array '(3 3) :initial-element 0d0)))
    (dotimes (i 3) (dotimes (j 3) (dotimes (k 3) (incf (aref r i j) (* (aref a i k) (aref b k j)))))) r))
(defun rh-transpose (a)
  (let ((r (make-array '(3 3)))) (dotimes (i 3) (dotimes (j 3) (setf (aref r i j) (aref a j i)))) r))
(defun rh-tensor (v)
  (make-array '(3 3) :initial-contents (list (list (elt v 0) (elt v 5) (elt v 4))
                                           (list (elt v 5) (elt v 1) (elt v 3))
                                           (list (elt v 4) (elt v 3) (elt v 2)))))
(defun rh-six (m)
  (vector (aref m 0 0) (aref m 1 1) (aref m 2 2) (aref m 1 2) (aref m 2 0) (aref m 0 1)))
(defun rh-principal (values basis)
  (let ((d (make-array '(3 3) :initial-element 0d0)))
    (dotimes (i 3) (setf (aref d i i) (elt values i)))
    (rh-six (rh-multiply (rh-multiply basis d) (rh-transpose basis)))))
(defun rh-rotate (v r) (rh-six (rh-multiply (rh-multiply r (rh-tensor v)) (rh-transpose r))))
(defun rh-rotation ()
  (let* ((a (* .37d0 pi)) (b (* -.19d0 pi))
         (z (make-array '(3 3) :initial-contents (list (list (cos a) (- (sin a)) 0d0) (list (sin a) (cos a) 0d0) '(0d0 0d0 1d0))))
         (x (make-array '(3 3) :initial-contents (list '(1d0 0d0 0d0) (list 0d0 (cos b) (- (sin b))) (list 0d0 (sin b) (cos b))))))
    (rh-multiply z x)))
(defun rh-kps (v)
  (let ((m (/ (+ (elt v 0) (elt v 1) (elt v 2)) 3d0)))
    (sqrt (* .5d0 (+ (loop for i below 3 sum (expt (- (elt v i) m) 2))
                       (* 2d0 (loop for i from 3 below 6 sum (expt (elt v i) 2))))))))
(defun rh-cohesion (k) (- 30000d0 (* 15000d0 (min 1d0 (/ k .02d0)))))
(defun rh-project (trial old q &optional (e +rh-e+) (nu +rh-nu+) (j 1d0))
  (incf *rh-point-calls*)
  (cl-mpm/models/wang2017-native:project-point-variant
   :composite-apex-residual trial e nu j (cl-mpm/models/wang2017:make-paper-history old) q))
(defvar *rh-capsule* nil)
(defun rh-captured (name) (gethash name *rh-capsule*))
(defparameter *rh-capsule*
  (with-open-file (stream (merge-pathnames "source/residual-policy-captured-input.json" cl-user::*rh-output*))
    (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *rh-trial* (rh-captured "trialKirchhoffPa"))
(defparameter *rh-old* (rh-captured "rotatedPlasticTensor"))
(defparameter *rh-q* (rh-rows (rh-captured "principalToSpatialBasis")))
(defparameter *rh-j* (rh-captured "deformationJacobian"))
(defvar *rh-actual-result* nil)

(defun rh-independent-apex (trial old basis e nu j)
  "Independent compliance + signed deviator norm, no production projector helpers."
  (let* ((g (/ e (* 2d0 (+ 1d0 nu)))) (bulk (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
         (mean (/ (reduce #'+ trial) 3d0))
         (dev-increment (map 'vector (lambda (x) (/ (- x mean) (* 2d0 g))) trial))
         (fixed-dev (rh-principal dev-increment basis))
         (k (rh-kps (map 'vector #'+ old fixed-dev)))
         (c (rh-cohesion k)) (a (* j c (/ (cos *rh-phi*) (sin *rh-phi*))))
         (q (/ (- mean a) bulk))
         (full (map 'vector (lambda (x) (+ x (/ q 3d0))) dev-increment)))
    (values (vector a a a) full k c q (rh-principal full basis))))
(defun rh-verify-apex (result trial old basis &optional (e +rh-e+) (nu +rh-nu+) (j 1d0))
  (multiple-value-bind (expected-tau expected-delta expected-k expected-c expected-q expected-fixed)
      (rh-independent-apex trial old basis e nu j)
    (let* ((tau (cl-mpm/models/wang2017-point:paper-projection-tau result))
           (delta (cl-mpm/models/wang2017-point:paper-projection-plastic-increment result))
           (fixed (cl-mpm/models/wang2017-point:paper-projection-fixed-increment result))
           (history (cl-mpm/models/wang2017:history-tensor (cl-mpm/models/wang2017-point:paper-projection-history result)))
           (q (cl-mpm/models/wang2017-apex:paper-projection-apex-multiplier result)))
      (assert (eq (cl-mpm/models/wang2017-point:paper-projection-branch result) :hydrostatic-apex))
      (rh-near-vector tau expected-tau 1d-6)
      (rh-near-vector delta expected-delta 1d-12)
      (rh-near-vector fixed expected-fixed 1d-12)
      (rh-near-vector history (map 'vector #'+ old fixed) 1d-12)
      (rh-near q expected-q 1d-13) (assert (> q 0d0))
      (rh-near (reduce #'+ delta) q 1d-13)
      (rh-near (cl-mpm/models/wang2017-point:paper-projection-kps result) expected-k 1d-13)
      (rh-near (cl-mpm/models/wang2017-point:paper-projection-cohesion result) expected-c 1d-7)
      (rh-near (rh-kps history) expected-k 1d-13)
      (rh-near (cl-mpm/models/wang2017-point:paper-projection-history-residual result) 0d0 1d-13)
      ;; Full compliance includes the added hydrostatic part, not only2G*dev.
      (dotimes (i 3)
        (rh-near (aref delta i)
                 (/ (- (- (aref trial i) (aref tau i))
                       (* nu (loop for k below 3 unless (= k i) sum (- (aref trial k) (aref tau k))))) e) 1d-12))
      (dotimes (i 3) (dotimes (k 3)
        (unless (= i k)
          (rh-near (- (* (+ 1d0 (sin *rh-phi*)) (aref tau i))
                      (* (- 1d0 (sin *rh-phi*)) (aref tau k))
                      (* 2d0 j expected-c (cos *rh-phi*))) 0d0 1d-6))))
      (let ((work (loop for i below 3 sum (* (aref tau i) (aref delta i)))))
        (assert (> work 0d0))
        (rh-near (cl-mpm/models/wang2017-point:paper-projection-work result) work 1d-7))) result))

(defun rh-native-values (m) (copy-seq (magicl::matrix/double-float-storage m)))
(defun rh-native-compliance (tau e nu)
  (let ((result (make-array 6 :initial-element 0d0)))
    (dotimes (i 3) (setf (aref result i) (/ (- (elt tau i) (* nu (loop for k below 3 unless (= i k) sum (elt tau k)))) e)))
    (loop for i from 3 below 6 do (setf (aref result i) (/ (elt tau i) (/ e (* 2d0 (+ 1d0 nu)))))) result))
(defun rh-native-trial (mp tau)
  (let* ((strain (cl-mpm/utils:voigt-from-list (coerce (rh-native-compliance tau (cl-mpm/particle::mp-E mp) (cl-mpm/particle::mp-nu mp)) 'list)))
         (before (rh-native-values strain)))
    (incf *rh-native-calls*)
    (unwind-protect
         (rh-native-values (cl-mpm/particle:constitutive-model mp strain 1d-4))
      (rh-near-vector (rh-native-values strain) before 0d0))))
(defun rh-particle (&optional (tensor #(0d0 0d0 0d0 0d0 0d0 0d0)))
  (make-instance 'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex-residual :paper-tensor tensor :enable-plasticity t))
(defun rh-install-increment (mp a)
  (dotimes (i 3) (dotimes (j 3) (setf (magicl:tref (cl-mpm/particle::mp-deformation-gradient-strain-increment mp) i j) (aref a i j)))))
(defun rh-install-actual (mp)
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 0) *rh-j*)
  (rh-install-increment mp (rh-rows (rh-captured "transportIncrement"))) mp)
(defun rh-fingerprint (value &optional seen)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float) (list :matrix (copy-list (magicl:shape value)) (coerce (rh-native-values value) 'list)))
        ((consp value) (cons (rh-fingerprint (car value) seen) (rh-fingerprint (cdr value) seen)))
        ((arrayp value) (list :array (array-dimensions value) (loop for i below (array-total-size value) collect (rh-fingerprint (row-major-aref value i) seen))))
        ((or (typep value 'standard-object) (typep value 'structure-object))
         (if (member value seen :test #'eq) :cycle
             (list (class-name (class-of value))
                   (loop for slot in (sb-mop:class-slots (class-of value)) for name = (sb-mop:slot-definition-name slot)
                         unless (string= (symbol-name name) "OUTER-TRIAL-STATE")
                         collect (list name (if (slot-boundp value name) (rh-fingerprint (slot-value value name) (cons value seen)) :unbound))))))
        (t (error "Unhandled fingerprint type ~S" (type-of value)))))
(defun rh-mutate-state (mp)
  (dolist (slot (sb-mop:class-slots (class-of mp)))
    (let ((name (sb-mop:slot-definition-name slot)))
      (when (and (slot-boundp mp name)
                 (member (symbol-name name) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED" "PAPER-ROTATION" "STRESS" "STRAIN" "STRESS-KIRCHOFF") :test #'string=))
        (let ((value (slot-value mp name)))
          (if (typep value 'magicl:matrix/double-float)
              (incf (aref (magicl::matrix/double-float-storage value) 0) .125d0)
              (incf (aref value 0) .125d0)))))) mp)

(defun rh-error (thunk)
  (handler-case (progn (funcall thunk) nil)
    (cl-mpm/models/mc-evolution:material-integration-error (condition) condition)))
(defun rh-transition (variant old new)
  (cl-mpm/models/wang2017-native:validate-history-transition variant old new))
(defun rh-reverse-trial (increment next-k)
  (let ((a (+ (* 16d6 increment) (* (rh-cohesion next-k) (cos *rh-phi*)))))
    (vector (- a) 0d0 a 0d0 0d0 0d0)))
(defun rh-mutate-baseline (mp)
  (let ((baseline (slot-value mp 'cl-mpm/models/mc-evolution::committed-state)))
    (dolist (entry (cl-mpm/models/mc-evolution::particle-state-slots baseline))
      (when (member (symbol-name (first entry)) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED") :test #'string=)
        (incf (aref (third entry) 0) .125d0)))))
(defun rh-slot (mp name)
  (or (loop for slot in (sb-mop:class-slots (class-of mp)) for symbol = (sb-mop:slot-definition-name slot)
            when (string= (symbol-name symbol) name) return symbol)
      (error "Expected native slot missing: ~A" name)))
(defvar *rh-actual-native* nil)
(defvar *rh-observations* (make-hash-table :test #'equal))

(rh-control "Residual history class is explicit and keeps exact Soil2 law and owned constructor storage"
  (let* ((input (vector .03d0 0d0 -.03d0 0d0 0d0 0d0)) (expected (copy-seq input))
         (mp (rh-particle input)) (law (cl-mpm/models/mc-evolution:particle-evolution-law mp)))
    (assert (equal (cl-mpm/models/wang2017-native:native-material-variant mp) "composite-apex-residual"))
    (assert (equal (multiple-value-list (cl-mpm/models/mc-evolution:law-values law .03d0)) (list 15000d0 *rh-phi* 0d0)))
    (rh-near (cl-mpm/particle::mp-E mp) +rh-e+ 0d0)
    (rh-near (cl-mpm/particle::mp-nu mp) +rh-nu+ 0d0)
    (setf (aref input 0) 99d0)
    (rh-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp) expected 0d0)
    (setf (aref (cl-mpm/models/wang2017-native:particle-paper-tensor mp) 1) 99d0)
    (rh-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp) expected 0d0)))

(rh-control "Only explicit residual policy accepts material signed norm decrease beyond the original guard"
  (rh-transition :composite-apex-residual .03187108863369348d0 .03187108746386819d0)
  (rh-transition :composite-apex-residual .03d0 .02d0)
  (dolist (variant '(:strict :composite-apex :synthetic-unknown-variant))
    (assert (rh-error (lambda () (rh-transition variant .03d0 .029d0)))))
  (assert (rh-error (lambda () (cl-mpm/models/wang2017-native::%guard-history .03d0 .029d0)))))

(rh-control "Softening recovery and crossing or remaining below exact residual boundary reject"
  (dolist (pair '((.019d0 .018d0) (.020001d0 .019999d0) (.02d0 .019999999999d0)))
    (assert (> (rh-cohesion (second pair)) (rh-cohesion (first pair))))
    (assert (rh-error (lambda () (rh-transition :composite-apex-residual (first pair) (second pair)))))))

(rh-control "Original one-e-minus-thirteen roundoff boundary remains shared without relaxation"
  (dolist (variant '(:strict :composite-apex :composite-apex-residual :synthetic-unknown-variant))
    (rh-transition variant .01d0 (- .01d0 .5d-13))
    (rh-transition variant .01d0 .010001d0)
    (assert (rh-error (lambda () (rh-transition variant .01d0 (- .01d0 2d-13)))))))

;; This is a declared NEW model control using captured numerical inputs.
;; It neither invokes replay-native-diagnostic nor executes the original variant.
(rh-control "New variant point retains unique signed apex compliance positive work and exact residual strength"
  (setf *rh-actual-result* (rh-project *rh-trial* *rh-old* *rh-q* +rh-e+ +rh-nu+ *rh-j*))
  (rh-verify-apex *rh-actual-result* *rh-trial* *rh-old* *rh-q* +rh-e+ +rh-nu+ *rh-j*)
  (let ((old (rh-kps (rh-captured "committedPlasticTensor")))
        (new (cl-mpm/models/wang2017-point:paper-projection-kps *rh-actual-result*)))
    (assert (< new (- old 1d-13)))
    (rh-transition :composite-apex-residual old new)
    (rh-near (cl-mpm/models/wang2017-point:paper-projection-cohesion *rh-actual-result*) 15000d0 0d0)
    (setf (gethash "capturedPointOldKps" *rh-observations*) old
          (gethash "capturedPointNewKps" *rh-observations*) new
          (gethash "capturedPointSignedDecrease" *rh-observations*) (- new old))))

(rh-control "New native captured-input dispatch retains literal smaller k full compliance positive volume work and J2"
  (let* ((mp (rh-install-actual (rh-particle (rh-captured "committedPlasticTensor"))))
         (tau (rh-native-trial mp (rh-principal *rh-trial* *rh-q*))))
    (multiple-value-bind (principal delta k c q fixed) (rh-independent-apex *rh-trial* *rh-old* *rh-q* +rh-e+ +rh-nu+ *rh-j*)
      (rh-near-vector tau (rh-principal principal *rh-q*) 1d-6)
      (rh-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp) (map 'vector #'+ *rh-old* fixed) 1d-12)
      (rh-near (cl-mpm/models/wang2017-native:particle-paper-kps mp) k 1d-13)
      (rh-near (cl-mpm/models/mc-evolution:particle-kappa mp) k 1d-13)
      (assert (< k (- (rh-kps (rh-captured "committedPlasticTensor")) 1d-13)))
      (assert (cl-mpm/models/wang2017-native:particle-history-decrease-p mp))
      (rh-near (cl-mpm/models/wang2017-native:particle-paper-cohesion mp) c 0d0)
      (rh-near (cl-mpm/models/mc-evolution:particle-plastic-volume mp) q 1d-13)
      (rh-near (cl-mpm/models/mc-evolution:particle-plastic-work mp) (/ (* (aref principal 0) q) *rh-j*) 1d-7)
      (assert (> (cl-mpm/models/mc-evolution:particle-plastic-work mp) 0d0))
      (let* ((mean (/ (reduce #'+ delta) 3d0))
             (j2 (sqrt (* (/ 2d0 3d0) (loop for i below 3 sum (expt (- (aref delta i) mean) 2))))))
        (rh-near (cl-mpm/models/wang2017-native:particle-legacy-j2 mp) j2 1d-12)
        (rh-near (cl-mpm/particle::mp-strain-plastic-vm-inc mp) (* 1.5d0 j2) 1d-12))
      (assert (eq (getf (cl-mpm/models/wang2017-native:particle-last-paper-diagnostic mp) :branch) :hydrostatic-apex))
      (setf *rh-actual-native* mp
            (gethash "capturedNativeKps" *rh-observations*) (cl-mpm/models/wang2017-native:particle-paper-kps mp)
            (gethash "capturedNativeCohesionPa" *rh-observations*) c
            (gethash "capturedNativePlasticVolume" *rh-observations*) q
            (gethash "capturedNativePlasticWorkPa" *rh-observations*) (cl-mpm/models/mc-evolution:particle-plastic-work mp)))))

(rh-control "Native regular residual reversal stores smaller signed history rather than a hidden maximum"
  (let* ((mp (rh-particle #(.03d0 0d0 -.03d0 0d0 0d0 0d0)))
         (answer (rh-native-trial mp (rh-reverse-trial .001d0 .029d0)))
         (a (* 15000d0 (cos *rh-phi*))))
    (rh-near-vector answer (vector (- a) 0d0 a 0d0 0d0 0d0) 1d-6)
    (rh-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp) #(.029d0 0d0 -.029d0 0d0 0d0 0d0) 1d-12)
    (rh-near (cl-mpm/models/wang2017-native:particle-paper-kps mp) .029d0 1d-13)
    (rh-near (cl-mpm/models/mc-evolution:particle-kappa mp) .029d0 1d-13)
    (assert (cl-mpm/models/wang2017-native:particle-history-decrease-p mp))
    (assert (> (cl-mpm/models/mc-evolution:particle-plastic-work mp) 0d0))
    (rh-near (cl-mpm/models/mc-evolution:particle-plastic-volume mp) 0d0 1d-13)))

(rh-control "New native residual apex return is covariant under proper 3D observer rotation"
  (assert *rh-actual-native*)
  (let* ((r (rh-rotation))
         (mp (rh-particle (rh-rotate (rh-captured "committedPlasticTensor") r)))
         (increment (rh-multiply (rh-multiply r (rh-rows (rh-captured "transportIncrement"))) (rh-transpose r)))
         (trial (rh-rotate (rh-principal *rh-trial* *rh-q*) r)))
    (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 0) *rh-j*)
    (rh-install-increment mp increment)
    (rh-near-vector (rh-native-trial mp trial)
                    (rh-rotate (rh-native-values (cl-mpm/particle::mp-stress-kirchoff *rh-actual-native*)) r) 1d-6)
    (rh-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp)
                    (rh-rotate (cl-mpm/models/wang2017-native:particle-paper-tensor *rh-actual-native*) r) 1d-12)
    (rh-near (cl-mpm/models/wang2017-native:particle-paper-kps mp)
             (cl-mpm/models/wang2017-native:particle-paper-kps *rh-actual-native*) 1d-13)
    (rh-near (cl-mpm/models/mc-evolution:particle-plastic-work mp)
             (cl-mpm/models/mc-evolution:particle-plastic-work *rh-actual-native*) 1d-7)))

(rh-control "Repeated uncommitted residual native trials do not accumulate volume work or history twice"
  (let* ((mp (rh-install-actual (rh-particle (rh-captured "committedPlasticTensor"))))
         (trial (rh-principal *rh-trial* *rh-q*)))
    (rh-native-trial mp trial)
    (let ((before (rh-fingerprint mp)))
      (rh-native-trial mp trial)
      (assert (equalp before (rh-fingerprint mp))))))

(rh-control "New native softening recovery still rejects atomically with owned failure diagnostic"
  (let* ((mp (rh-particle #(.004d0 0d0 -.004d0 0d0 0d0 0d0)))
         (before (rh-fingerprint mp))
         (condition (rh-error (lambda () (rh-native-trial mp (rh-reverse-trial .001d0 .003d0))))))
    (assert condition)
    (assert (search "decreas" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal))
    (assert (equalp before (rh-fingerprint mp)))
    (assert (not (cl-mpm/models/wang2017-native:particle-history-decrease-p mp)))
    (assert (equal (gethash "materialVariant" (cl-mpm/models/mc-evolution:integration-error-diagnostic condition)) "composite-apex-residual"))))

(rh-control "New history policy preserves distinct-root ambiguity rejection and entire native state"
  (let* ((mp (make-instance 'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex-residual
                            :E .5d6 :nu .25d0 :paper-tensor #(-.0035d0 .0015d0 .002d0 0d0 0d0 0d0) :enable-plasticity t))
         (before (rh-fingerprint mp))
         (condition (rh-error (lambda () (rh-native-trial mp #(33000d0 27000d0 6000d0 0d0 0d0 0d0))))))
    (assert condition)
    (assert (or (search "ambig" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal)
                (search "distinct" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal)))
    (assert (equalp before (rh-fingerprint mp)))))

(rh-control "Residual class reusable snapshot copy reinitialize commit and reset preserve independent ownership"
  (let ((source (rh-install-actual (rh-particle (rh-captured "committedPlasticTensor")))) (target (rh-particle)))
    (rh-native-trial source (rh-principal *rh-trial* *rh-q*))
    (cl-mpm/particle::new-loadstep-mp source)
    (let ((snapshot (cl-mpm/models/wang2017-native:snapshot-particle source)) (before (rh-fingerprint source)))
      (loop repeat 2 do
        (rh-mutate-state source) (rh-mutate-baseline source)
        (cl-mpm/models/wang2017-native:restore-particle source snapshot)
        (assert (equalp before (rh-fingerprint source))))
      (cl-mpm/models/wang2017-native:copy-particle-state source target)
      (rh-mutate-state source) (rh-mutate-baseline source)
      (assert (equalp before (rh-fingerprint target)))
      (let ((held (slot-value target (rh-slot target "PAPER-TENSOR")))
            (held-committed (slot-value target (rh-slot target "PAPER-TENSOR-COMMITTED")))
            (held-baseline (slot-value target 'cl-mpm/models/mc-evolution::committed-state)))
        (reinitialize-instance target)
        (incf (aref held 0) .125d0) (incf (aref held-committed 0) .125d0)
        (dolist (entry (cl-mpm/models/mc-evolution::particle-state-slots held-baseline))
          (when (member (symbol-name (first entry)) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED") :test #'string=)
            (incf (aref (third entry) 0) .125d0)))
        (assert (equalp before (rh-fingerprint target))))
      (rh-mutate-state target)
      (cl-mpm/particle::reset-loadstep-mp target)
      (assert (equalp before (rh-fingerprint target))))))

;; Test-only outer primary dispatch; this is not a grid or solver update.
(defclass residual-outer-failure-probe () ())
(defmethod cl-mpm::update-stress-mp ((mesh residual-outer-failure-probe)
                                   (mp cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex-residual) dt fbar)
  (declare (ignore mesh dt fbar))
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 1) .125d0
        (magicl:tref (cl-mpm/particle:mp-stress mp) 0 0) 123456d0)
  (rh-native-trial mp (rh-reverse-trial .001d0 .003d0)))
(rh-control "Inherited production outer transaction rolls back new-class probe kinematics stress and failed history"
  (let* ((mp (rh-particle #(.004d0 0d0 -.004d0 0d0 0d0 0d0))) (before (rh-fingerprint mp))
         (condition (rh-error (lambda () (cl-mpm::update-stress-mp (make-instance 'residual-outer-failure-probe) mp 1d-4 nil)))))
    (assert condition)
    (assert (search "decreas" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal))
    (assert (equalp before (rh-fingerprint mp)))))

(let ((record (make-hash-table :test 'equal)))
  (setf (gethash "passed" record) (if *rh-failures* 'yason:false t)
        (gethash "controlsCount" record) (length *rh-passed*)
        (gethash "controlLabels" record) (coerce (reverse *rh-passed*) 'vector)
        (gethash "failures" record) (coerce (reverse *rh-failures*) 'vector)
        (gethash "skippedControlLabels" record) (coerce (reverse *rh-skipped*) 'vector)
        (gethash "selection" record) (if *rh-constructor-only* "constructor-only" "all")
        (gethash "newModelPointCalls" record) *rh-point-calls*
        (gethash "newModelNativeConstitutiveCalls" record) *rh-native-calls*
        (gethash "originalVariantActualCapsuleReplayCalls" record) 0
        (gethash "physicalUpdatesExecuted" record) 0
        (gethash "outerFailureProbeIsActualMeshStep" record) 'yason:false
        (gethash "observations" record) *rh-observations*
        (gethash "scope" record) "Explicit residual-only history-scope extension with literal signed tensor norm, exactly unchanged residual strength and unchanged composite apex projector; captured inputs used only with the NEW variant. No old capsule replay, MPM run, paper agreement or landslide validation.")
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*rh-output*) :direction :output :if-exists :error) (yason:encode record stream)))
(setf cl-user::*rh-exit* (if *rh-failures* 1 0))
(format t "~&WANG RESIDUAL HISTORY: ~D PASS, ~D FAIL; ~D new point/~D native calls; zero old replay/MPM updates.~%"
        (length *rh-passed*) (length *rh-failures*) *rh-point-calls* *rh-native-calls*)
