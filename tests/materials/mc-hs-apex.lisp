;;;; New scoped controls; no repeated old suites, no whole slope.
(in-package :cl-user)
(ql:quickload '(:cl-mpm/models/mc-hs-apex :yason) :silent t)
(defpackage :cl-mpm/tests/hs-apex (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution) (:hs :cl-mpm/models/mc-hs-apex)))
(in-package :cl-mpm/tests/hs-apex)
(let* ((law (mc:make-evolution-law :variant :hs :points '((0d0 33.99d0) (.037d0 33.99d0) (.1d0 25.353762870428053d0) (.2d0 9.568041272839212d0))
             :cohesion 0d0 :psi 0d0 :stress-measure :cauchy :strain-assumption "Scoped HS apex control; no preload"))
       (captured #(-12.955315666960626d0 -1.1433208400756665d0 17.134711588252358d0))
       (calls 0))
  (flet ((check-apex (trial k j)
           (let* ((p (hs:project-principal trial 20d6 .2d0 j law k))
                  (plastic (mc:projection-plastic-increment p))
                  (returned (map 'vector #'- trial (mc::d-times plastic (/ 20d6 2.4d0) (/ 20d6 1.8d0)))))
             (incf calls)
             (assert (every #'zerop (mc:projection-tau p)))
             (assert (< (mc::max-abs3 returned) 1d-6))
             (assert (>= (mc:projection-kappa p) k))
             (assert (= (mc:projection-work p) 0d0))
             (assert (> (reduce #'+ plastic) 0d0))
             (multiple-value-bind (c phi psi) (mc:law-values law (mc:projection-kappa p))
               (assert (= c (mc:projection-cohesion p)))
               (assert (= phi (mc:projection-phi p)))
               (assert (= psi (mc:projection-psi p)))))))
    ;; Actual failed trial, permutations, crossing a softening knot, residual,
    ;; hydrostatic tension and scales. Every guard/compliance check is active.
    (dolist (trial (list captured (reverse captured) #(1000d0 2000d0 3000d0)
                        #(10d0 10d0 10d0) #(-1d6 0d0 2d6)))
      (dolist (k '(0d0 .036999d0 .099999d0 .199999d0 .3d0))
        (check-apex trial k 1.03d0)))
    ;; Below-cap states delegate EXACTLY, including nonzero HS history.
    (dolist (trial '(#(-3000d0 -2000d0 -1800d0) #(-1000d0 -1000d0 -1000d0) #(0d0 0d0 0d0)))
      (let ((a (hs:project-principal trial 20d6 .2d0 1d0 law .04d0))
            (b (mc:project-principal trial 20d6 .2d0 1d0 law .04d0)))
        (incf calls) (assert (equalp a b))))
    (dolist (invalid (list (mc:make-evolution-law :variant :hs :points '((0d0 30d0)) :cohesion 1d0 :psi 0d0 :strain-assumption "invalid c")
                           (mc:make-evolution-law :variant :hs :points '((0d0 0d0)) :cohesion 0d0 :psi 0d0 :strain-assumption "invalid phi")))
      (assert (handler-case (progn (hs:project-principal captured 20d6 .2d0 1d0 invalid 0d0) nil)
                (mc:material-integration-error () t)))))
  (format t "~&HS-APEX PASS: ~D accepted pure calls, two rejected unsupported laws; no MPM updates.~%" calls))
(uiop:quit 0)
