;;;; Focused post-fix MC complementarity controls; no old-baseline replay or MPM.
;;;; windows\cl-mpm.cmd tests\materials\mc-complementarity-stress-bound.lisp output\FRESH [GROUPS]
;;;; GROUPS defaults to all, otherwise comma-separated labels printed in result.
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *cb-frozen* nil)
(defvar *cb-output* nil)
(defvar *cb-exit* 1)
(unless *cb-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *cb-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh MC control output directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output is not fresh: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      ;; The failed source is immutable DATA for form comparison, never LOADed.
      (dolist (fixture
                '(("output/unnotched-gravity-2026-10-24/srf1p4-001/mc-integration-failure.json"
                   "source/inputs/mc-failed-state.json"
                   "d0fa089970adf81178ca486f00423d53e0dffa98ba963823e822037e6e5f15bb")
                  ("output/unnotched-gravity-2026-10-24/srf1p4-001/source/materials/models/plastic/mohr-coulomb-evolution/projection.lisp"
                   "source/inputs/failed-projection-baseline.lisp"
                   "01c73c007726118fa40908cb7de929b8d17900c94b1f2fe3596d7afe81b2ce79")))
        (destructuring-bind (relative destination sha) fixture
          (let* ((original (cl-mpm-path relative)) (bytes (case-source-bytes original))
                 (target (merge-pathnames destination directory)))
            (unless (string= sha (snapshot-sha256-bytes bytes)) (error "Immutable fixture changed: ~A" original))
            (ensure-directories-exist target)
            (with-open-file (stream target :direction :output :if-exists :error :element-type '(unsigned-byte 8))
              (write-sequence bytes stream))
            (push target copied)
            (push (snapshot-object "path" destination "originalPath" (namestring original)
                                   "bytes" (length bytes) "sha256" sha) records))))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "Current fixed sources/DLL and exact failed-state/baseline data copied before first-party load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*cb-frozen* t) (*cb-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/mc-evolution"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory)
                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *cb-exit*))

(defpackage :cl-mpm/tests/mc-complementarity (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/mc-complementarity)
(defparameter *labels* '("source-contract" "actual" "permutations" "transitions"
                         "backward-error" "scaling" "ambiguity" "native-rollback"))
(defparameter *selection*
  (let ((argument (second (cl-user::cl-mpm-script-args))))
    (if (or (null argument) (string= argument "all")) *labels*
        (uiop:split-string argument :separator ","))))
(unless (and *selection* (every (lambda (name) (member name *labels* :test #'string=)) *selection*))
  (error "Unknown group selection: ~S" *selection*))
(defvar *passed* nil)
(defvar *failures* nil)
(defvar *skipped* nil)
(defvar *point-calls* 0)
(defvar *native-calls* 0)
(defvar *actual-identity-calls* 0)
(defvar *actual-permutation-calls* 0)
(defvar *observations* (make-hash-table :test #'equal))
(defparameter *pairs* '((0 1) (0 2) (1 0) (1 2) (2 0) (2 1)))
(defparameter *permutations* '((0 1 2) (0 2 1) (1 0 2) (1 2 0) (2 0 1) (2 1 0)))
(defmacro control (label &body body)
  `(if (member ,label *selection* :test #'string=)
       (handler-case (progn ,@body (push ,label *passed*) (format t "~&PASS: ~A~%" ,label))
         (error (condition) (push (list ,label (princ-to-string condition)) *failures*)
           (format t "~&FAIL: ~A: ~A~%" ,label condition)))
       (push ,label *skipped*)))
(defun near (a b &optional (tol 1d-11))
  (unless (and (mc::finite-real-p a) (<= (abs (- a b)) tol))
    (error "Expected ~,17G got ~,17G tolerance ~G" b a tol)))
(defun near-vector (a b tolerance)
  (assert (= (length a) (length b)))
  (dotimes (i (length a)) (near (elt a i) (elt b i) tolerance)))
(defun maxabs (v) (reduce #'max v :key #'abs))
(defun shear (e nu) (/ e (* 2d0 (+ 1d0 nu))))
(defun bulk (e nu) (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
(defun stress-tolerance (trial) (+ 1d-6 (* 1d-11 (max 1d0 (maxabs trial)))))
(defun equivalent (b)
  (let ((mean (/ (reduce #'+ b) 3d0)))
    (sqrt (* (/ 2d0 3d0) (loop for x across b sum (expt (- x mean) 2))))))
(defun elastic-response (b e nu)
  "Independent isotropic Hooke response, no production d-times."
  (let ((g (shear e nu)) (lame (/ (* e nu) (* (+ 1d0 nu) (- 1d0 (* 2d0 nu)))))
        (trace (reduce #'+ b)))
    (map 'vector (lambda (x) (+ (* 2d0 g x) (* lame trace))) b)))
(defun residues (tau c phi j &optional (measure :cauchy))
  (map 'vector (lambda (pair)
                (- (* (+ 1d0 (sin phi)) (elt tau (first pair)))
                   (* (- 1d0 (sin phi)) (elt tau (second pair)))
                   (* 2d0 (if (eq measure :cauchy) j 1d0) c (cos phi)))) *pairs*))
(defun perfect-law (c phi)
  (mc:make-evolution-law :variant :perfect :points (list (list 0d0 phi))
   :cohesion c :psi 0d0 :stress-measure :cauchy
   :strain-assumption "Focused constant-law complementarity numerical fixture; no fitted soil data"))
(defun project (trial e nu j law old)
  (incf *point-calls*) (mc:project-principal trial e nu j law old))
(defun fingerprint (x)
  (cond ((or (null x) (numberp x) (symbolp x) (characterp x)) x)
        ((stringp x) (copy-seq x))
        ((typep x 'magicl:matrix/double-float)
         (list (copy-list (magicl:shape x)) (coerce (cl-mpm/utils:fast-storage x) 'list)))
        ((consp x) (cons (fingerprint (car x)) (fingerprint (cdr x))))
        ((arrayp x) (list (array-dimensions x) (loop for i below (array-total-size x)
                                                   collect (fingerprint (row-major-aref x i)))))
        ((typep x 'structure-object)
         (list (class-name (class-of x)) (loop for slot in (sb-mop:class-slots (class-of x))
              for name = (sb-mop:slot-definition-name slot) collect (list name (fingerprint (slot-value x name))))))
        (t (error "Unsupported snapshot value ~S" (type-of x)))))
(defun source-function (path name)
  (let ((*read-eval* nil) (*package* (find-package :cl-mpm/tests/mc-complementarity)))
    (with-open-file (stream path)
      (loop for form = (read stream nil :eof) until (eq form :eof)
            when (and (consp form) (eq (first form) 'defun)
                      (string= (symbol-name (second form)) name)) return form))))
(defparameter *capsule*
  (with-open-file (stream (merge-pathnames "source/inputs/mc-failed-state.json" cl-user::*cb-output*))
    (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defun captured (key) (gethash key *capsule*))
(defparameter *trial* (captured "trialKirchhoffPa"))
(defparameter *e* (captured "youngsModulusPa"))
(defparameter *nu* (captured "poissonRatio"))
(defparameter *j* (captured "deformationJacobian"))
(defparameter *old* (captured "oldKappa"))
(defparameter *c* (aref (aref (gethash "cohesionPoints" (captured "law")) 0) 1))
(defparameter *phi-deg* (aref (aref (gethash "points" (captured "law")) 0) 1))
(defparameter *law* (perfect-law *c* *phi-deg*))

(defun analytic (trial e nu j c phi old &optional force-edge)
  "Closed-form psi=0 face/edge return; sorted inputs only; no production solve."
  (let* ((g (shear e nu)) (s (sin phi)) (q (* 2d0 j c (cos phi)))
         (f1 (- (* (+ 1d0 s) (aref trial 0)) (* (- 1d0 s) (aref trial 2)) q))
         (a (* 4d0 g)) (lambda1 (/ f1 a))
         (face (vector (- (aref trial 0) (* 2d0 g lambda1)) (aref trial 1)
                       (+ (aref trial 2) (* 2d0 g lambda1))))
         (rho (residues face c phi j))
         (edge (or force-edge (cond ((> (aref rho 3) 1d-8) :upper)
                                    ((> (aref rho 0) 1d-8) :lower))))
         (multipliers (make-array 6 :initial-element 0d0)) (active '(1)))
    (setf (aref multipliers 1) lambda1)
    (when edge
      (let* ((index (ecase edge (:upper 3) (:lower 0)))
             (b (* 2d0 g (if (eq edge :upper) (- 1d0 s) (+ 1d0 s))))
             (f2 (aref (residues trial c phi j) index))
             (lambda2 (/ (- f2 (* b (/ f1 a))) (- a (/ (* b b) a)))))
        (setf (aref multipliers index) lambda2
              (aref multipliers 1) (/ (- f1 (* b lambda2)) a)
              active (if (eq edge :upper) '(1 3) '(0 1)))))
    (let ((flow (make-array 3 :initial-element 0d0)))
      (loop for pair in *pairs* for value across multipliers do
        (incf (aref flow (first pair)) value) (decf (aref flow (second pair)) value))
      (let* ((tau (map 'vector #'- trial (elastic-response flow e nu)))
             (residuals (residues tau c phi j)))
        (mc::%make-projection :tau tau :plastic-increment flow :kappa (+ old (equivalent flow))
          :cohesion c :phi phi :psi 0d0 :max-residual (reduce #'max residuals)
          :residuals residuals :work (loop for x across tau for b across flow sum (* x b))
          :active active :multipliers multipliers :iterations 0)))))
(defun verify (answer expected trial e nu j old)
  (let ((tol (stress-tolerance trial)))
    (near-vector (mc:projection-tau answer) (mc:projection-tau expected) (* 2d0 tol))
    (near-vector (mc:projection-plastic-increment answer) (mc:projection-plastic-increment expected)
                 (+ 1d-13 (/ (* 2d0 tol) (shear e nu))))
    (near (mc:projection-kappa answer) (+ old (equivalent (mc:projection-plastic-increment answer))) 1d-13)
    (near-vector (map 'vector #'- trial (elastic-response (mc:projection-plastic-increment answer) e nu))
                 (mc:projection-tau answer) tol)
    (assert (<= (reduce #'max (residues (mc:projection-tau answer) (mc:projection-cohesion answer)
                                             (mc:projection-phi answer) j)) tol))
    (assert (<= (mc::negative-multiplier-backward-error answer (shear e nu) (bulk e nu)) tol))
    (assert (every (lambda (x) (>= x -1d-12)) (mc:projection-multipliers answer)))
    (assert (>= (mc:projection-work answer) 0d0))) answer)
(defun transition-trial (edge delta e nu j &optional (c 10000d0) (phi (* 20d0 (/ pi 180d0))))
  "Target face lies DELTA inside its chosen edge; fixed20Pa elastic correction."
  (declare (ignore e nu))
  (let* ((s (sin phi)) (q (* 2d0 j c (cos phi)))
         (high (if (eq edge :upper) (/ (+ q (* (- 1d0 s) -100000d0)) (+ 1d0 s)) -10000d0))
         (low (if (eq edge :upper) -100000d0 (/ (- (* (+ 1d0 s) high) q) (- 1d0 s))))
         (middle (if (eq edge :upper) (- high delta) (+ low delta))))
    (vector (+ high 20d0) middle (- low 20d0))))
(defun independent-bound (candidate e nu)
  (let ((phi (mc:projection-phi candidate)) (psi (mc:projection-psi candidate)) (total 0d0))
    (loop for multiplier across (mc:projection-multipliers candidate) for pair in *pairs*
          when (< multiplier 0d0) do
      (let ((flow (make-array 3 :initial-element 0d0)))
        (setf (aref flow (first pair)) (+ 1d0 (sin psi))
              (aref flow (second pair)) (- (sin psi) 1d0))
        (let* ((response (elastic-response flow e nu))
               (planes (map 'vector (lambda (n)
                    (- (* (+ 1d0 (sin phi)) (aref response (first n)))
                       (* (- 1d0 (sin phi)) (aref response (second n))))) *pairs*)))
          (incf total (* (- multiplier) (max (maxabs response) (maxabs planes))))))) total))
(defun new-admissible (candidate e nu tolerance)
  (and (mc::admissible-candidate-p candidate 0d0 tolerance)
       (<= (mc::negative-multiplier-backward-error candidate (shear e nu) (bulk e nu)) tolerance)))

(control "source-contract"
  (let ((baseline (merge-pathnames "source/inputs/failed-projection-baseline.lisp" cl-user::*cb-output*))
        (current (merge-pathnames "source/materials/models/plastic/mohr-coulomb-evolution/projection.lisp" cl-user::*cb-output*)))
    (assert (equal (source-function baseline "ADMISSIBLE-CANDIDATE-P") (source-function current "ADMISSIBLE-CANDIDATE-P")))
    (assert (equal (source-function baseline "SAME-PROJECTION-P") (source-function current "SAME-PROJECTION-P")))
    (assert (not (string= (cl-user::snapshot-sha256 baseline) (cl-user::snapshot-sha256 current))))
    (near mc::+stress-atol+ 1d-6 0d0) (near mc::+stress-rtol+ 1d-11 0d0)
    (near mc::+kappa-tol+ 1d-13 0d0) (near mc::+multiplier-tol+ 1d-12 0d0)))
(control "actual"
  (let* ((sorted (sort (copy-seq *trial*) #'>)) (phi (* *phi-deg* (/ pi 180d0)))
         (expected (analytic sorted *e* *nu* *j* *c* phi *old*))
         (original (copy-seq *trial*)))
    (incf *actual-identity-calls*)
    (let ((answer (project *trial* *e* *nu* *j* *law* *old*)))
      ;; Actual supplied axis order is ascending, the opposite of this sorted case.
      (verify answer (mc::%make-projection
                       :tau (reverse (mc:projection-tau expected))
                       :plastic-increment (reverse (mc:projection-plastic-increment expected)))
              *trial* *e* *nu* *j* *old*)
      (near-vector *trial* original 0d0)
      (setf (gethash "actualFixedTauPa" *observations*) (mc:projection-tau answer)
            (gethash "actualFixedKappa" *observations*) (mc:projection-kappa answer)
            (gethash "actualCapsuleStatus" *observations*) "NEW_FIXED_CODE_REGRESSION_NOT_OLD_BASELINE_REPLAY"))))
(control "permutations"
  (let* ((phi (* *phi-deg* (/ pi 180d0))) (sorted (sort (copy-seq *trial*) #'>))
         (expected (analytic sorted *e* *nu* *j* *c* phi *old*)))
    ;; Five permutations plus the supplied original above cover all six orders.
    ;; Exclude ascending(2,1,0), include sorted identity(0,1,2).
    (dolist (permutation (remove '(2 1 0) *permutations* :test #'equal))
      (let* ((trial (map 'vector (lambda (i) (aref sorted i)) permutation))
             (reference (mc::%make-projection
                          :tau (map 'vector (lambda (i) (aref (mc:projection-tau expected) i)) permutation)
                          :plastic-increment (map 'vector (lambda (i) (aref (mc:projection-plastic-increment expected) i)) permutation))))
        (incf *actual-permutation-calls*)
        (verify (project trial *e* *nu* *j* *law* *old*) reference trial *e* *nu* *j* *old*)))))
(control "transitions"
  (let ((law (perfect-law 10000d0 20d0)) (count 0))
    (dolist (e '(1d5 1d8 1d10))
      (dolist (j '(.7d0 1d0 1.3d0))
        (dolist (edge '(:upper :lower))
          (dolist (delta '(-.001d0 0d0 .001d0))
            (let* ((trial (transition-trial edge delta e .3d0 j))
                   (expected (analytic trial e .3d0 j 10000d0 (* 20d0 (/ pi 180d0)) 0d0
                                       (and (< delta 0d0) edge))))
              (verify (project trial e .3d0 j law 0d0) expected trial e .3d0 j 0d0)
              (incf count))))))
    (setf (gethash "transitionPointCalls" *observations*) count)))
(control "backward-error"
  (let* ((trial (sort (copy-seq *trial*) #'>)) (tol (stress-tolerance trial))
         (bad (analytic trial *e* *nu* *j* *c* (* *phi-deg* (/ pi 180d0)) *old* :upper))
         (before (fingerprint bad)))
    (assert (mc::admissible-candidate-p bad 0d0 tol))
    (assert (> (mc::negative-multiplier-backward-error bad (shear *e* *nu*) (bulk *e* *nu*)) (* 32d0 tol)))
    (assert (not (new-admissible bad *e* *nu* tol)))
    (assert (equalp before (fingerprint bad)))
    (setf (gethash "falseEdgeNegativeMultiplier" *observations*) (aref (mc:projection-multipliers bad) 3)
          (gethash "falseEdgeBackwardErrorPa" *observations*) (independent-bound bad *e* *nu*)
          (gethash "actualStressTolerancePa" *observations*) tol))
  (dolist (case '((1d8 1d-9 :roundoff) (1d5 3d-7 :absolute-limit) (1d8 -.001d0 :positive)))
    (destructuring-bind (e delta kind) case
      (let* ((trial (transition-trial :upper delta e .3d0 1d0))
             (candidate (analytic trial e .3d0 1d0 10000d0 (* 20d0 (/ pi 180d0)) 0d0 :upper))
             (before (fingerprint candidate)) (tol (stress-tolerance trial))
             (error (mc::negative-multiplier-backward-error candidate (shear e .3d0) (bulk e .3d0))))
        (near error (independent-bound candidate e .3d0) 1d-12)
        (ecase kind
          (:roundoff (assert (< (aref (mc:projection-multipliers candidate) 3) 0d0))
                     (assert (new-admissible candidate e .3d0 tol)))
          (:absolute-limit (assert (< error tol))
                           (assert (< (aref (mc:projection-multipliers candidate) 3) -1d-12))
                           (assert (not (new-admissible candidate e .3d0 tol))))
          (:positive (near error 0d0 0d0) (assert (new-admissible candidate e .3d0 tol))))
        (assert (equalp before (fingerprint candidate)))))))
(control "scaling"
  (let* ((trial (sort (copy-seq *trial*) #'>))
         (candidate (analytic trial *e* *nu* *j* *c* (* *phi-deg* (/ pi 180d0)) *old* :upper))
         (base (independent-bound candidate *e* *nu*)))
    (dolist (factor '(1d-3 1d0 1d2))
      (near (mc::negative-multiplier-backward-error candidate (shear (* factor *e*) *nu*) (bulk (* factor *e*) *nu*))
            (* factor base) (* 1d-11 (max 1d0 (* factor base)))))
    ;; Nonzero dilation/bulk response and opposing negative flows cannot cancel
    ;; in a conservative sum. These are private guard containers, not solver states.
    (let ((probe (copy-structure candidate)))
      (setf (mc::projection-psi probe) (* 10d0 (/ pi 180d0))
            (mc::projection-multipliers probe) #(-2d-14 0d0 -2d-14 0d0 0d0 0d0))
      (dolist (nu '(.1d0 .49d0))
        (let ((actual (mc::negative-multiplier-backward-error probe (shear 1d8 nu) (bulk 1d8 nu))))
          (assert (> actual 0d0)) (near actual (independent-bound probe 1d8 nu) 1d-10))))))
(defun ambiguous-law ()
  (mc:make-evolution-law :variant :hs :points '((0d0 0d0))
   :cohesion-points '((0d0 1000d0) (.001d0 5000d0) (.002d0 500d0))
   :psi 0d0 :stress-measure :cauchy :strain-assumption "Focused genuine three-positive-root ambiguity fixture"))
(defun assert-ambiguity (thunk)
  (let ((condition (handler-case (progn (funcall thunk) nil) (mc:material-integration-error (x) x))))
    (assert condition)
    (assert (search "Multiple distinct admissible" (mc:integration-error-reason condition))) condition))
(control "ambiguity"
  (let* ((g (shear 1d6 .3d0)) (a (* (sqrt 3d0) g))
         (roots (list (/ 1000d0 (+ a 4d6)) (/ 7500d0 (- 4.5d6 a)) (/ 1500d0 a)))
         (law (ambiguous-law)) (trial #(2000d0 0d0 -2000d0)))
    (assert (< 0d0 (first roots) .001d0 (second roots) .002d0 (third roots)))
    (dolist (k roots)
      (multiple-value-bind (c phi psi) (mc:law-values law k)
        (near phi 0d0) (near psi 0d0)
        (near (- 2000d0 (* a k) c) 0d0 1d-9)
        (assert (> (* 2d0 c (* .5d0 (sqrt 3d0) k)) 0d0))))
    (assert-ambiguity (lambda () (project trial 1d6 .3d0 1d0 law 0d0)))
    (near-vector trial #(2000d0 0d0 -2000d0) 0d0)
    (setf (gethash "genuinePositiveMultiplierRoots" *observations*) (coerce roots 'vector))))
(control "native-rollback"
  (let* ((mp (make-instance 'mc:particle-mc-evolution :E 1d6 :nu .3d0 :evolution-law (ambiguous-law) :enable-plasticity t))
         (strain (cl-mpm/utils:voigt-from-list '(.0026d0 0d0 -.0026d0 0d0 0d0 0d0)))
         (before (fingerprint (mc:snapshot-particle mp)))
         (external (copy-seq (cl-mpm/utils:fast-storage strain))))
    (assert-ambiguity (lambda () (incf *native-calls*) (cl-mpm/particle:constitutive-model mp strain 1d-4)))
    (assert (equalp before (fingerprint (mc:snapshot-particle mp))))
    (near-vector (cl-mpm/utils:fast-storage strain) external 0d0)))

(let ((report (make-hash-table :test #'equal)))
  (setf (gethash "passed" report) (if *failures* 'yason:false t)
        (gethash "passedGroups" report) (coerce (reverse *passed*) 'vector)
        (gethash "failedGroups" report) (coerce (reverse *failures*) 'vector)
        (gethash "skippedGroups" report) (coerce (reverse *skipped*) 'vector)
        (gethash "explicitNewFixedPointCalls" report) *point-calls*
        (gethash "newFixedActualIdentityCalls" report) *actual-identity-calls*
        (gethash "newFixedActualPermutationCalls" report) *actual-permutation-calls*
        (gethash "nativeConstitutiveCalls" report) *native-calls*
        (gethash "oldBaselineReplayCalls" report) 0
        (gethash "physicalUpdatesExecuted" report) 0
        (gethash "nativeBackend" report) (cl-user::snapshot-native-proof)
        (gethash "observations" report) *observations*
        (gethash "scope" report) "New fixed-code regression and focused complementarity/scale/positive-root ambiguity controls; shared Wang/apex admissibility form unchanged; no old baseline replay, full MPM or landslide validation")
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*cb-output*) :direction :output :if-exists :error)
    (yason:encode report stream)))
(setf cl-user::*cb-exit* (if *failures* 1 0))
