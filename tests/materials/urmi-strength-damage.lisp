;;;; FIRST owned point controls only; no MPM, old suites or physical validation.
;;;; windows\cl-mpm.cmd tests\materials\urmi-strength-damage.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *usd-frozen* nil) (defvar *usd-directory* nil) (defvar *usd-exit* 1)
(unless *usd-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *usd-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide fresh point-control output."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve existing point evidence."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((relative "research/notes/urmi-mc-damage40-2026-10-26/constitutive-plan.md")
             (from (cl-mpm-path relative)) (to (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
             (bytes (case-source-bytes from)))
        (ensure-directories-exist to) (uiop:copy-file from to)
        (assert (equalp bytes (case-source-bytes to)))
        (push to copied)
        (push (snapshot-object "path" (enough-namestring to directory) "originalPath" (namestring (truename from))
               "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records))
      (dolist (required '("source/materials/models/plastic/urmi-strength-damage/package.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/law.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/particle.lisp"))
        (assert (find required records :key (lambda (row) (gethash "path" row)) :test #'string=)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "New optional S1 strength-damage point controls and plan; all selected first-party/DLL bytes frozen before load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*usd-frozen* t) (*usd-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/urmi-strength-damage"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *usd-exit*))

(defpackage :cl-mpm/tests/urmi-strength-damage
  (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution) (:usd :cl-mpm/models/urmi-strength-damage)))
(in-package :cl-mpm/tests/urmi-strength-damage)
(defvar *passed* nil) (defvar *failures* nil) (defvar *pure-calls* 0)
(defvar *native-attempted* 0) (defvar *native-accepted* 0) (defvar *mpm-attempts* 0)
(defvar *owned-replay-attempts* 0)
(defvar *native-context* nil) (defvar *owned-replay-context* nil)
(defvar *native-projector-entries* 0) (defvar *owned-replay-projector-entries* 0)
(defvar *cases* nil) (defvar *observations* (make-hash-table :test #'equal))
(defparameter +permutations+ '((0 1 2) (0 2 1) (1 0 2) (1 2 0) (2 0 1) (2 1 0)))
(defparameter +groups+ '("fixed-units-continuous-endpoints-owned-zero-peak"
                        "deterministic-table-error-budget-and-ownership"
                        "pure-face-two-edges-six-permutations-four-current-J"
                        "native-history-origin-strength-damage-read-only-and-rollback"
                        "large-J-outcomes-and-owned-synthetic-principal-replay"))
(defmacro control (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (push (list ,name (princ-to-string condition)) *failures*)
       (format t "~&FAIL: ~A: ~A~%" ,name condition))))
(defun obj (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*usd-directory*) :direction :output :if-exists :error)
    (yason:encode value stream)))
(defun near (a b &optional (tolerance 1d-9))
  (assert (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tolerance))))
(defun near-vector (a b &optional (tolerance 1d-7))
  (assert (= (length a) (length b))) (dotimes (i (length a)) (near (elt a i) (elt b i) tolerance)))
(defun rejects (function)
  (let ((condition nil))
    (handler-case (funcall function) (error (error) (setf condition error)))
    (assert condition) condition))
(defun fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value)) (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value)) (fingerprint (cdr value))))
        ((arrayp value) (list :array (array-dimensions value)
                         (loop for i below (array-total-size value) collect (fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
           (loop for slot in (sb-mop:class-slots (class-of value)) for name = (sb-mop:slot-definition-name slot)
                 collect (list name (fingerprint (slot-value value name))))))
        (t (error "Unsupported point snapshot value ~S" (type-of value)))))
(defmethod cl-mpm/particle:constitutive-model :around ((mp usd:particle-urmi-strength-damage) strain dt)
  (incf *native-attempted*)
  (let ((*native-context* t))
    (multiple-value-prog1 (call-next-method) (incf *native-accepted*))))
(defun permute (values order) (map 'vector (lambda (i) (elt values i)) order))
(defun reverse-trial (branch law old target j)
  "Independently prescribe trace-free plastic principal increment and valid returned Tresca stress."
  (let* ((c (nth-value 0 (mc:law-values law target))) (dk (- target old))
         (strength (* j c))
         (b (ecase branch
              (:face (let ((a (* .5d0 (sqrt 3d0) dk))) (vector a 0d0 (- a))))
              (:top-edge (let ((a (* .5d0 dk))) (vector a a (* -2d0 a))))
              (:bottom-edge (let ((a (* .5d0 dk))) (vector (* 2d0 a) (- a) (- a))))))
         (tau (ecase branch
                (:face (vector strength 0d0 (- strength)))
                (:top-edge (vector (* (/ 2d0 3d0) strength) (* (/ 2d0 3d0) strength)
                                   (* (/ -4d0 3d0) strength)))
                (:bottom-edge (vector (* (/ 4d0 3d0) strength) (* (/ -2d0 3d0) strength)
                                      (* (/ -2d0 3d0) strength)))))
         (trial (map 'vector (lambda (s eps) (+ s (* 2d0 usd:+shear-modulus-pa+ eps))) tau b)))
    (values trial tau b)))
(defun verify-result (result trial law old j &optional expected-k expected-tau expected-b)
  (let* ((tau (mc:projection-tau result)) (b (mc:projection-plastic-increment result))
         (k (mc:projection-kappa result)) (c (mc:projection-cohesion result))
         (mean (/ (reduce #'+ b) 3d0))
         (dk (sqrt (* (/ 2d0 3d0) (loop for v across b sum (expt (- v mean) 2))))))
    (assert (every #'mc::finite-real-p tau)) (assert (every #'mc::finite-real-p b))
    (assert (>= k old))
    (near k (+ old dk) 2d-11) (near c (nth-value 0 (mc:law-values law k)) 1d-6)
    (near (mc:projection-phi result) 0d0 0d0) (near (mc:projection-psi result) 0d0 0d0)
    (assert (<= usd:+remolded-strength-pa+ c usd:+peak-strength-pa+))
    (near (- (reduce #'max tau) (reduce #'min tau)) (* 2d0 j c) 1d-5)
    (dotimes (i 3)
      (near (- (aref trial i) (aref tau i))
            (+ (* 2d0 usd:+shear-modulus-pa+ (aref b i))
               (* (- (/ usd:+youngs-modulus-pa+ (* 3d0 (- 1d0 (* 2d0 usd:+poisson-ratio+))))
                     (* (/ 2d0 3d0) usd:+shear-modulus-pa+)) (reduce #'+ b))) 1d-5))
    (let ((work (loop for s across tau for eps across b sum (* s eps))))
      (near (mc:projection-work result) work 1d-5) (assert (>= work -1d-8)))
    (assert (every (lambda (r) (and (mc::finite-real-p r) (<= r 1d-5))) (mc:projection-residuals result)))
    (when expected-k (near k expected-k 2d-11))
    (when expected-tau (near-vector tau expected-tau 1d-5))
    (when expected-b (near-vector b expected-b 2d-11))
    result))
(defun pure-return (trial j law old)
  (mc:project-principal trial usd:+youngs-modulus-pa+ usd:+poisson-ratio+ j law old))
(defun native-trial (particle trial j)
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient particle) 0 0) j)
  (let* ((trace (reduce #'+ trial))
         (strain (cl-mpm/utils:voigt-from-list
                  (append (loop for tau across trial collect
                            (/ (- (* (+ 1d0 usd:+poisson-ratio+) tau) (* usd:+poisson-ratio+ trace))
                               usd:+youngs-modulus-pa+)) '(0d0 0d0 0d0))))
         (before (copy-seq (cl-mpm/utils:fast-storage strain))))
    (let ((answer (cl-mpm/particle:constitutive-model particle strain 1d-4)))
      (near-vector (cl-mpm/utils:fast-storage strain) before 0d0)
      (subseq (cl-mpm/utils:fast-storage answer) 0 3))))

(defun controls ()
  (let* ((law (usd:make-strength-damage-law)) (info (usd:strength-damage-reference))
         (nodes (gethash "tableNodes_s_kappa_cPa" info)))
    (control "fixed-units-continuous-endpoints-owned-zero-peak"
      (near usd:+youngs-modulus-pa+ (* 2d0 usd:+shear-modulus-pa+ (+ 1d0 usd:+poisson-ratio+)) 1d-8)
      (near usd:+gamma-peak+ (/ usd:+peak-strength-pa+ usd:+shear-modulus-pa+) 0d0)
      (near (mc:evolution-law-peak-kappa law) 0d0 0d0)
      (assert (= (nth-value 0 (mc:law-values law 0d0)) 40500d0))
      (assert (= (usd:reference-strength (- 1.8d0 .01d0)) 3847.5d0))
      (assert (= (usd:reference-strength (- 9.477d0 .01d0)) 1000d0))
      (dolist (gamma '(1.8d0 9.477d0))
        (let* ((node (usd:reference-node (- gamma .01d0))) (c (third node)))
          (near (+ (* (sqrt 3d0) (second node)) (/ c usd:+shear-modulus-pa+)) gamma)))
      (rejects (lambda () (mc:make-evolution-law :variant :hs :points '((0d0 0d0))
                          :cohesion 40500d0 :psi 0d0 :stress-measure :cauchy :peak-kappa 0d0
                          :strain-assumption "Baseline positive peak contract must remain unchanged")))
      (rejects (lambda () (usd:make-strength-damage-law :kappa-origin -.1d0)))
      (rejects (lambda () (make-instance 'usd:particle-urmi-strength-damage :E 1d8)))
      (rejects (lambda () (make-instance 'usd:particle-urmi-strength-damage :kappa-origin .1d0))))
    (control "deterministic-table-error-budget-and-ownership"
      (assert (<= (gethash "actualSegments" info) 64))
      (assert (<= (gethash "maximumErrorBoundPa" info) 101.25d0))
      (assert (equalp usd::*reference-table* (usd::%build-reference-table)))
      (rejects (lambda () (usd::%build-reference-table :maximum-segments 2)))
      (let ((maximum 0d0) (bounds (gethash "intervalErrorBoundsPa" info)))
        (loop for index below (1- (length nodes))
              for a = (aref nodes index) for b = (aref nodes (1+ index)) do
          (assert (< (aref a 1) (aref b 1))) (assert (>= (aref a 2) (aref b 2)))
          (dotimes (sample 17)
            (let* ((s (+ (aref a 0) (* (/ sample 16d0) (- (aref b 0) (aref a 0)))))
                   (node (usd:reference-node s)) (k (second node)) (c (third node))
                   (chord (+ (aref a 2) (* (/ (- k (aref a 1)) (- (aref b 1) (aref a 1)))
                                           (- (aref b 2) (aref a 2)))))
                   (error (abs (- c chord))))
              (setf maximum (max maximum error))
              (assert (<= error (+ (aref bounds index) 1d-7))))))
        (setf (gethash "maximumSampledInterpolationErrorPa" *observations*) maximum))
      (let ((clone (usd:make-strength-damage-law)))
        (setf (second (first (mc:evolution-law-cohesion-points clone))) 1d0)
        (assert (= (nth-value 0 (mc:law-values law 0d0)) 40500d0)))
      (setf (gethash "reference" *observations*) (usd:strength-damage-reference)))
    ;; Freeze every finite principal fixture before the first projector call.
    (let ((fixtures nil))
      (dolist (j '(.8d0 1d0 1.2d0 1.7d0))
        (dolist (branch '(:face :top-edge :bottom-edge))
          (multiple-value-bind (trial tau b) (reverse-trial branch law 0d0 1d-6 j)
            (dolist (perm +permutations+)
              (push (obj "j" j "branch" (string-downcase branch) "permutation" (coerce perm 'vector)
                         "trial" (permute trial perm) "expectedTau" (permute tau perm)
                         "expectedPlastic" (permute b perm) "expectedKappa" 1d-6) fixtures)))))
      (setf fixtures (nreverse fixtures))
      (write-json "planned-point-fixtures.json" (obj "fixtures" (coerce fixtures 'vector)
        "largeJDiagnosticSet" #(2d0 4d0 10d0) "largeJExcessPa" 1d0))
      (control "pure-face-two-edges-six-permutations-four-current-J"
        (assert (= (length fixtures) 72))
        (dolist (fixture fixtures)
          (let* ((trial (gethash "trial" fixture)) (before (copy-seq trial)) (law-before (fingerprint law))
                 (j (gethash "j" fixture)) (result (pure-return trial j law 0d0)))
            (verify-result result trial law 0d0 j (gethash "expectedKappa" fixture)
                           (gethash "expectedTau" fixture) (gethash "expectedPlastic" fixture))
            (assert (equalp trial before)) (assert (equalp (fingerprint law) law-before))
            (push (obj "j" j "branch" (gethash "branch" fixture) "permutation" (gethash "permutation" fixture)
                       "kappa" (mc:projection-kappa result) "cohesionPa" (mc:projection-cohesion result)
                       "maximumResidualPa" (mc:projection-max-residual result)) *cases*)))))
    (control "native-history-origin-strength-damage-read-only-and-rollback"
      (let* ((origin .025d0) (particle (make-instance 'usd:particle-urmi-strength-damage
                                    :kappa-origin origin :kappa origin :enable-plasticity t))
             (shifted (mc:particle-evolution-law particle)))
        (near (mc:particle-kappa particle) origin 0d0)
        (near (usd:particle-kappa-origin particle) origin 0d0)
        (near (mc:evolution-law-peak-kappa shifted) origin 0d0)
        (near (usd:particle-strength-damage particle) 0d0 0d0)
        (near (nth-value 0 (mc:law-values shifted (* .5d0 origin))) 40500d0 0d0)
        (multiple-value-bind (trial tau b) (reverse-trial :face shifted origin (+ origin .002d0) 1.2d0)
          (declare (ignore b)) (near-vector (native-trial particle trial 1.2d0) tau 1d-5))
        (near (mc:particle-kappa particle) (+ origin .002d0) 2d-11)
        (near (usd:particle-strength-damage particle)
              (- 1d0 (/ (mc:particle-cohesion particle) 40500d0)) 0d0)
        (cl-mpm/particle::new-loadstep-mp particle)
        (let* ((saved (mc:snapshot-particle particle)) (before (fingerprint saved))
               (d (usd:particle-strength-damage particle)) (metadata (usd:particle-reference-info particle)))
          (setf (aref (aref (gethash "cohesionKnots_kappa_cPa" metadata) 0) 1) -999d0)
          (dotimes (i 5) (usd:particle-strength-damage particle) (usd:particle-reference-info particle))
          (assert (equalp (fingerprint (mc:snapshot-particle particle)) before))
          (multiple-value-bind (trial tau b)
              (reverse-trial :face shifted (+ origin .002d0) (+ origin .005d0) 1.2d0)
            (declare (ignore b)) (near-vector (native-trial particle trial 1.2d0) tau 1d-5))
          (assert (> (usd:particle-strength-damage particle) d))
          (cl-mpm/particle::reset-loadstep-mp particle)
          (assert (equalp (fingerprint (mc:snapshot-particle particle)) before))
          (near (usd:particle-strength-damage particle) d 0d0)
          (setf (slot-value particle 'usd::kappa-origin) .5d0)
          (mc:restore-particle particle saved)
          (near (usd:particle-kappa-origin particle) origin 0d0)
          (assert (equalp (fingerprint (mc:snapshot-particle particle)) before)))
        (let* ((snapshot (mc:snapshot-particle particle))
               (strain (cl-mpm/utils:voigt-zeros)))
          (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient particle) 0 0) -1d0)
          (let ((before (fingerprint (mc:snapshot-particle particle))))
            (rejects (lambda () (cl-mpm/particle:constitutive-model particle strain 1d-4)))
            (assert (equalp (fingerprint (mc:snapshot-particle particle)) before)))
          (mc:restore-particle particle snapshot))
        (let ((residual (make-instance 'usd:particle-urmi-strength-damage :kappa 10d0)))
          (near (usd:particle-strength-damage residual) (- 1d0 (/ 1000d0 40500d0)) 0d0))
        (setf (gethash "nativePreservedKappaOrigin" *observations*) origin)))
    (control "large-J-outcomes-and-owned-synthetic-principal-replay"
      (let ((outcomes nil))
        (dolist (j '(2d0 4d0 10d0))
          (dolist (branch '(:face :top-edge :bottom-edge))
            (let* ((a (+ (* j 40500d0) 1d0))
                   (trial (ecase branch (:face (vector a 0d0 (- a)))
                            (:top-edge (vector (* (/ 2d0 3d0) a) (* (/ 2d0 3d0) a) (* (/ -4d0 3d0) a)))
                            (:bottom-edge (vector (* (/ 4d0 3d0) a) (* (/ -2d0 3d0) a) (* (/ -2d0 3d0) a))))))
              (handler-case
                  (let ((result (pure-return trial j law 0d0)))
                    (verify-result result trial law 0d0 j)
                    (push (obj "j" j "branch" (string-downcase branch) "status" "accepted"
                               "kappa" (mc:projection-kappa result) "cohesionPa" (mc:projection-cohesion result)
                               "maximumResidualPa" (mc:projection-max-residual result)
                               "workKirchhoffPa" (mc:projection-work result)) outcomes))
                (mc:material-integration-error (condition)
                  (push (obj "j" j "branch" (string-downcase branch) "status" "original-strict-rejection"
                             "reason" (mc:integration-error-reason condition)
                             "diagnostic" (mc:integration-error-diagnostic condition)) outcomes))))))
        (setf (gethash "largeJDiagnosticOutcomes" *observations*) (coerce (nreverse outcomes) 'vector)))
      (let* ((condition (rejects (lambda () (pure-return #(1d0 0d0 -1d0) 0d0 law 0d0))))
             (diagnostic (mc:integration-error-diagnostic condition)))
        (assert (typep condition 'mc:material-integration-error))
        (assert (= (gethash "peakKappa" (gethash "law" diagnostic)) 0d0))
        (rejects (lambda () (mc:replay-integration-diagnostic diagnostic)))
        (setf (gethash "zeroPeakCapsuleBaselineReplayReady" *observations*) 'yason:false))
      (multiple-value-bind (trial tau b) (reverse-trial :face law 0d0 .002d0 1.2d0)
        (let* ((diagnostic (mc::%principal-failure-diagnostic
                            "SYNTHETIC valid replay fixture; no actual production failure"
                            trial usd:+youngs-modulus-pa+ usd:+poisson-ratio+ 1.2d0 law 0d0))
               (original (pure-return trial 1.2d0 law 0d0)))
          (write-json "SYNTHETIC-owned-replay-input.json" diagnostic)
          (setf diagnostic
                (with-open-file (stream (merge-pathnames "SYNTHETIC-owned-replay-input.json" cl-user::*usd-directory*))
                  (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
          (incf *owned-replay-attempts*)
          (let* ((*owned-replay-context* t) (replayed (usd:replay-strength-damage-diagnostic diagnostic)))
            (verify-result replayed trial law 0d0 1.2d0 .002d0 tau b)
            (near-vector (mc:projection-tau replayed) (mc:projection-tau original) 0d0)
            (near (mc:projection-kappa replayed) (mc:projection-kappa original) 0d0))
          ;; Altered payloads must be rejected before projector entry.
          (setf (aref (aref (gethash "cohesionPoints" (gethash "law" diagnostic)) 0) 1) 40499d0)
          (incf *owned-replay-attempts*)
          (rejects (lambda () (usd:replay-strength-damage-diagnostic diagnostic)))
          (setf (gethash "schema" diagnostic) "unowned")
          (incf *owned-replay-attempts*)
          (rejects (lambda () (usd:replay-strength-damage-diagnostic diagnostic)))
          (setf (gethash "ownedReplayScope" *observations*)
                "One synthetic exact-input principal replay; no actual failure/whole-MPM replay claim"))))))

(let ((original (symbol-function 'cl-mpm:update-sim))
      (projector (symbol-function 'mc:project-principal)))
  (unwind-protect
       (progn (setf (symbol-function 'cl-mpm:update-sim)
                    (lambda (&rest args) (declare (ignore args))
                      (incf *mpm-attempts*) (error "Owned point controls forbid all MPM updates.")))
              (setf (symbol-function 'mc:project-principal)
                    (lambda (&rest args)
                      (if *native-context* (incf *native-projector-entries*) (incf *pure-calls*))
                      (when *owned-replay-context* (incf *owned-replay-projector-entries*))
                      (apply projector args)))
              (handler-case (controls)
                (error (condition) (push (list "harness" (princ-to-string condition)) *failures*))))
    (setf (symbol-function 'mc:project-principal) projector
          (symbol-function 'cl-mpm:update-sim) original)))
(let ((passed (and (null *failures*) (zerop *mpm-attempts*) (= (length *passed*) (length +groups+))
                    (= *pure-calls* 84) (= *owned-replay-attempts* 3)
                    (= *owned-replay-projector-entries* 1) (= *native-projector-entries* 2)
                    (= *native-attempted* 3) (= *native-accepted* 2))))
  (write-json "result.json"
    (obj "passed" (if passed t 'yason:false) "passedGroups" (coerce (reverse *passed*) 'vector)
         "failures" (coerce (reverse *failures*) 'vector) "purePrincipalCallsAttempted" *pure-calls*
         "nativeConstitutiveCallsAttempted" *native-attempted* "nativeConstitutiveCallsAccepted" *native-accepted*
         "ownedReplayAttempts" *owned-replay-attempts* "syntheticValidOwnedReplayProjectorCalls" *owned-replay-projector-entries*
         "nativeProjectorCalls" *native-projector-entries*
         "physicalUpdateAttempts" *mpm-attempts* "oldControlsCalled" 0
         "cases" (coerce (reverse *cases*) 'vector) "observations" *observations*
         "nativeBackend" (cl-user::snapshot-native-proof)
         "scope" "New optional uncalibrated Urmi-inspired S1 MC strength-damage point controls; zero MPM, no drained transfer/full slope/fracture/scientific validation; current-J outcomes are not global root uniqueness"))
  (setf cl-user::*usd-exit* (if passed 0 1)))
