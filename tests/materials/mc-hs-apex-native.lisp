(in-package :cl-user)
(ql:quickload '(:cl-mpm :cl-mpm/models/mc-hs-apex) :silent t)
(defpackage :cl-mpm/tests/hs-apex-native (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution) (:hs :cl-mpm/models/mc-hs-apex)))
(in-package :cl-mpm/tests/hs-apex-native)
(let* ((law (mc:make-evolution-law :variant :hs :points '((0d0 33.99d0) (.037d0 33.99d0) (.1d0 25.353762870428053d0) (.2d0 9.568041272839212d0))
              :cohesion 0d0 :psi 0d0 :strain-assumption "Native HS apex controls"))
       (calls 0))
  (dolist (k '(0d0 .036999d0 .199999d0))
    (let ((mp (make-instance 'hs:particle-mc-hs-apex :E 20d6 :nu .2d0
                             :evolution-law law :kappa k :enable-plasticity t)))
      (dotimes (repeat 2)
        (declare (ignore repeat))
        (let* ((trial #(-1d6 0d0 2d6))
               (strain (cl-mpm/utils:voigt-from-list
                         (append (loop for i below 3 collect
                           (/ (- (aref trial i) (* .2d0 (loop for n below 3 unless (= n i) sum (aref trial n)))) 20d6))
                                 '(0d0 0d0 0d0))))
               (tau (cl-mpm/particle:constitutive-model mp strain 1d-4)))
          (incf calls)
          (assert (< (reduce #'max (map 'vector #'abs (cl-mpm/utils:fast-storage tau))) 1d-6))
          (assert (> (mc:particle-kappa mp) (mc:particle-kappa-committed mp)))
          (assert (> (mc:particle-plastic-volume mp) (mc:particle-plastic-volume-committed mp)))
          (multiple-value-bind (c phi psi) (mc:law-values law (mc:particle-kappa mp))
            (assert (= phi (mc:particle-phi mp))) (assert (= c 0d0)) (assert (= psi 0d0)))
        (cl-mpm/particle::new-loadstep-mp mp)
        (assert (= (mc:particle-kappa mp) (mc:particle-kappa-committed mp))))))
  (format t "~&HS-APEX NATIVE PASS: ~D constitutive calls with tensor reconstruction, evolved law and loadstep commit; no MPM updates.~%" calls)))
(uiop:quit 0)
