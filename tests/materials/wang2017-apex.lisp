;;;; Opt-in composite-apex controls; strict actual failure is NOT replayed here.
;;;; windows\cl-mpm.cmd tests\materials\wang2017-apex.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *wa-frozen* nil)
(defvar *wa-output* nil)
(defvar *wa-exit* 1)
;; Separate top-level load establishes the helper's dynamic DEFVAR before use.
(unless *wa-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *wa-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh apex-control output directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output is not fresh: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((original (cl-mpm-path "docs/evidence/wang2017-soil2-2026-10-24/failure-replay/original-mc-integration-failure.json"))
             (bytes (case-source-bytes original))
             (to (merge-pathnames "source/actual-strict-failure-input.json" directory)))
        (unless (string= (snapshot-sha256-bytes bytes) "05835d5429292da0b95190232c0d3fb4d6228d6fd08d975ee1346434ba99242d")
          (error "Actual input fixture differs from immutable original capsule."))
        (ensure-directories-exist to)
        (with-open-file (stream to :direction :output :if-exists :error :element-type '(unsigned-byte 8)) (write-sequence bytes stream))
        (push to copied)
        (push (snapshot-object "path" "source/actual-strict-failure-input.json" "originalPath" (namestring original)
                               "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records))
      (dolist (required '("source/materials/models/plastic/wang2017/apex-package.lisp"
                          "source/materials/models/plastic/wang2017/apex-projection.lisp"
                          "source/materials/models/plastic/wang2017/apex-native.lisp"
                          "source/materials/models/plastic/wang2017/point-projection.lisp"
                          "source/materials/models/plastic/wang2017/material.lisp" "source/cl-mpm.asd"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required apex source was not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Selected source and actual-input fixture copied before first-party load" "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records)) (*wa-frozen* t) (*wa-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/wang2017-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory) (merge-pathnames "source-provenance-before.json" directory))
        (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                             (snapshot-object "files" (coerce (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))
        (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
        (load (merge-pathnames "source/case.lisp" directory))
        (dolist (path copied) (snapshot-verify-file path))
        (write-case-source-provenance directory copied nil)
        (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                             (snapshot-object "files" (coerce (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector))))))
  (uiop:quit *wa-exit*))

(defpackage :cl-mpm/tests/wang2017-apex (:use :cl))
(in-package :cl-mpm/tests/wang2017-apex)
(defvar *wa-passed* nil)
(defvar *wa-failures* nil)
(defvar *wa-point-calls* 0)
(defvar *wa-native-calls* 0)
(defconstant +wa-e+ 20d6)
(defconstant +wa-nu+ .25d0)
(defparameter *wa-phi* (* 35d0 (/ pi 180d0)))
(defmacro wa-control (name &body body)
  `(handler-case (progn ,@body (push ,name *wa-passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (push (list ,name (princ-to-string condition)) *wa-failures*)
       (format t "~&FAIL: ~A: ~A~%" ,name condition))))
(defun wa-near (actual expected &optional (tolerance 1d-11))
  (unless (and (= actual actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G actual ~,17G tolerance ~G" expected actual tolerance)))
(defun wa-near-vector (actual expected &optional (tolerance 1d-11))
  (assert (= (length actual) (length expected)))
  (dotimes (i (length expected)) (wa-near (elt actual i) (elt expected i) tolerance)))
(defun wa-eye () #2A((1d0 0d0 0d0) (0d0 1d0 0d0) (0d0 0d0 1d0)))
(defun wa-rows (rows)
  (let ((a (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3) (setf (aref a i j) (elt (elt rows i) j)))) a))
(defun wa-multiply (a b)
  (let ((r (make-array '(3 3) :initial-element 0d0)))
    (dotimes (i 3) (dotimes (j 3) (dotimes (k 3) (incf (aref r i j) (* (aref a i k) (aref b k j)))))) r))
(defun wa-transpose (a)
  (let ((r (make-array '(3 3)))) (dotimes (i 3) (dotimes (j 3) (setf (aref r i j) (aref a j i)))) r))
(defun wa-tensor (v)
  (make-array '(3 3) :initial-contents (list (list (elt v 0) (elt v 5) (elt v 4))
                                           (list (elt v 5) (elt v 1) (elt v 3))
                                           (list (elt v 4) (elt v 3) (elt v 2)))))
(defun wa-six (m)
  (vector (aref m 0 0) (aref m 1 1) (aref m 2 2) (aref m 1 2) (aref m 2 0) (aref m 0 1)))
(defun wa-principal (values basis)
  (let ((d (make-array '(3 3) :initial-element 0d0)))
    (dotimes (i 3) (setf (aref d i i) (elt values i)))
    (wa-six (wa-multiply (wa-multiply basis d) (wa-transpose basis)))))
(defun wa-rotate (v r) (wa-six (wa-multiply (wa-multiply r (wa-tensor v)) (wa-transpose r))))
(defun wa-rotation ()
  (let* ((a (* .37d0 pi)) (b (* -.19d0 pi))
         (z (make-array '(3 3) :initial-contents (list (list (cos a) (- (sin a)) 0d0) (list (sin a) (cos a) 0d0) '(0d0 0d0 1d0))))
         (x (make-array '(3 3) :initial-contents (list '(1d0 0d0 0d0) (list 0d0 (cos b) (- (sin b))) (list 0d0 (sin b) (cos b))))))
    (wa-multiply z x)))
(defun wa-kps (v)
  (let ((m (/ (+ (elt v 0) (elt v 1) (elt v 2)) 3d0)))
    (sqrt (* .5d0 (+ (loop for i below 3 sum (expt (- (elt v i) m) 2))
                       (* 2d0 (loop for i from 3 below 6 sum (expt (elt v i) 2))))))))
(defun wa-cohesion (k) (- 30000d0 (* 15000d0 (min 1d0 (/ k .02d0)))))
(defun wa-project (trial old q &optional (e +wa-e+) (nu +wa-nu+) (j 1d0))
  (incf *wa-point-calls*)
  (cl-mpm/models/wang2017-apex:project-paper-principal-with-apex
   trial e nu j (cl-mpm/models/wang2017:make-paper-history old) q))
(defvar *wa-capsule* nil)
(defun wa-captured (name) (gethash name *wa-capsule*))
(defparameter *wa-capsule*
  (with-open-file (stream (merge-pathnames "source/actual-strict-failure-input.json" cl-user::*wa-output*))
    (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *wa-trial* (wa-captured "trialKirchhoffPa"))
(defparameter *wa-old* (wa-captured "rotatedPlasticTensor"))
(defparameter *wa-q* (wa-rows (wa-captured "principalToSpatialBasis")))
(defparameter *wa-j* (wa-captured "deformationJacobian"))
(defvar *wa-actual-result* nil)

(defun wa-independent-apex (trial old basis e nu j)
  "Independent compliance + signed deviator norm, no production projector helpers."
  (let* ((g (/ e (* 2d0 (+ 1d0 nu)))) (bulk (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
         (mean (/ (reduce #'+ trial) 3d0))
         (dev-increment (map 'vector (lambda (x) (/ (- x mean) (* 2d0 g))) trial))
         (fixed-dev (wa-principal dev-increment basis))
         (k (wa-kps (map 'vector #'+ old fixed-dev)))
         (c (wa-cohesion k)) (a (* j c (/ (cos *wa-phi*) (sin *wa-phi*))))
         (q (/ (- mean a) bulk))
         (full (map 'vector (lambda (x) (+ x (/ q 3d0))) dev-increment)))
    (values (vector a a a) full k c q (wa-principal full basis))))
(defun wa-verify-apex (result trial old basis &optional (e +wa-e+) (nu +wa-nu+) (j 1d0))
  (multiple-value-bind (expected-tau expected-delta expected-k expected-c expected-q expected-fixed)
      (wa-independent-apex trial old basis e nu j)
    (let* ((tau (cl-mpm/models/wang2017-point:paper-projection-tau result))
           (delta (cl-mpm/models/wang2017-point:paper-projection-plastic-increment result))
           (fixed (cl-mpm/models/wang2017-point:paper-projection-fixed-increment result))
           (history (cl-mpm/models/wang2017:history-tensor (cl-mpm/models/wang2017-point:paper-projection-history result)))
           (q (cl-mpm/models/wang2017-apex:paper-projection-apex-multiplier result)))
      (assert (eq (cl-mpm/models/wang2017-point:paper-projection-branch result) :hydrostatic-apex))
      (wa-near-vector tau expected-tau 1d-6)
      (wa-near-vector delta expected-delta 1d-12)
      (wa-near-vector fixed expected-fixed 1d-12)
      (wa-near-vector history (map 'vector #'+ old fixed) 1d-12)
      (wa-near q expected-q 1d-13) (assert (> q 0d0))
      (wa-near (reduce #'+ delta) q 1d-13)
      (wa-near (cl-mpm/models/wang2017-point:paper-projection-kps result) expected-k 1d-13)
      (wa-near (cl-mpm/models/wang2017-point:paper-projection-cohesion result) expected-c 1d-7)
      (wa-near (wa-kps history) expected-k 1d-13)
      (wa-near (cl-mpm/models/wang2017-point:paper-projection-history-residual result) 0d0 1d-13)
      ;; Full compliance includes the added hydrostatic part, not only2G*dev.
      (dotimes (i 3)
        (wa-near (aref delta i)
                 (/ (- (- (aref trial i) (aref tau i))
                       (* nu (loop for k below 3 unless (= k i) sum (- (aref trial k) (aref tau k))))) e) 1d-12))
      (dotimes (i 3) (dotimes (k 3)
        (unless (= i k)
          (wa-near (- (* (+ 1d0 (sin *wa-phi*)) (aref tau i))
                      (* (- 1d0 (sin *wa-phi*)) (aref tau k))
                      (* 2d0 j expected-c (cos *wa-phi*))) 0d0 1d-6))))
      (let ((work (loop for i below 3 sum (* (aref tau i) (aref delta i)))))
        (assert (> work 0d0))
        (wa-near (cl-mpm/models/wang2017-point:paper-projection-work result) work 1d-7))) result))

(wa-control "Opt-in point accepts actual strict failed input with declared positive apex flow"
  (setf *wa-actual-result* (wa-project *wa-trial* *wa-old* *wa-q* +wa-e+ +wa-nu+ *wa-j*))
  (wa-verify-apex *wa-actual-result* *wa-trial* *wa-old* *wa-q* +wa-e+ +wa-nu+ *wa-j*))

(wa-control "Hydrostatic extension preserves deviatoric k while scaling Cauchy strength exactly once"
  (dolist (j '(.75d0 1d0 1.4d0))
    (let* ((old #(.005d0 0d0 -.005d0 0d0 0d0 0d0))
           (a (* j (wa-cohesion .005d0) (/ (cos *wa-phi*) (sin *wa-phi*))))
           (trial (make-array 3 :initial-element (+ a 2000d0))) (result (wa-project trial old (wa-eye) +wa-e+ +wa-nu+ j)))
      (wa-verify-apex result trial old (wa-eye) +wa-e+ +wa-nu+ j)
      (wa-near (cl-mpm/models/wang2017-point:paper-projection-kps result) .005d0)
      (wa-near (/ (aref (cl-mpm/models/wang2017-point:paper-projection-tau result) 0) j)
               (* (wa-cohesion .005d0) (/ (cos *wa-phi*) (sin *wa-phi*))) 1d-6))))

(wa-control "Opt-in actual apex result is covariant under arbitrary proper spatial rotation"
  (let* ((r (wa-rotation)) (old (wa-rotate *wa-old* r)) (basis (wa-multiply r *wa-q*))
         (result (wa-project *wa-trial* old basis +wa-e+ +wa-nu+ *wa-j*)))
    (wa-verify-apex result *wa-trial* old basis +wa-e+ +wa-nu+ *wa-j*)
    (wa-near-vector (cl-mpm/models/wang2017-point:paper-projection-fixed-increment result)
                    (wa-rotate (cl-mpm/models/wang2017-point:paper-projection-fixed-increment *wa-actual-result*) r) 1d-12)))

(wa-control "All five nonidentity trial eigenbasis permutations preserve the actual apex increment"
  (dolist (permutation '((0 2 1) (1 0 2) (1 2 0) (2 0 1) (2 1 0)))
    (let ((trial (make-array 3)) (basis (make-array '(3 3))))
      (loop for original in permutation for column from 0 do
        (setf (aref trial column) (aref *wa-trial* original))
        (dotimes (row 3) (setf (aref basis row column) (aref *wa-q* row original))))
      (let ((result (wa-project trial *wa-old* basis +wa-e+ +wa-nu+ *wa-j*)))
        (wa-verify-apex result trial *wa-old* basis +wa-e+ +wa-nu+ *wa-j*)
        (wa-near-vector (cl-mpm/models/wang2017-point:paper-projection-fixed-increment result)
                        (cl-mpm/models/wang2017-point:paper-projection-fixed-increment *wa-actual-result*) 1d-12)))))

(wa-control "Apex projection vector and history readers retain independent owned storage"
  (let* ((expected (cl-mpm/models/wang2017-point:paper-projection-fixed-increment *wa-actual-result*))
         (exposed (cl-mpm/models/wang2017-point:paper-projection-fixed-increment *wa-actual-result*))
         (tau (cl-mpm/models/wang2017-point:paper-projection-tau *wa-actual-result*)))
    (setf (aref exposed 0) 99d0 (aref tau 0) 99d0)
    (wa-near-vector (cl-mpm/models/wang2017-point:paper-projection-fixed-increment *wa-actual-result*) expected 0d0)
    (assert (> (aref (cl-mpm/models/wang2017-point:paper-projection-tau *wa-actual-result*) 0) 1000d0))))

(wa-control "Regular plastic compression keeps analytic zero dilation return and excludes negative apex multiplier"
  (let* ((p .003d0) (mean -50000d0) (c (wa-cohesion p))
         (t-return (- (* c (cos *wa-phi*)) (* mean (sin *wa-phi*))))
         (amplitude (+ (* 16d6 p) t-return))
         (trial (vector (+ mean amplitude) mean (- mean amplitude)))
         (result (wa-project trial #(0d0 0d0 0d0 0d0 0d0 0d0) (wa-eye))))
    (multiple-value-bind (tau delta k c-apex q) (wa-independent-apex trial #(0d0 0d0 0d0 0d0 0d0 0d0) (wa-eye) +wa-e+ +wa-nu+ 1d0)
      (declare (ignore tau delta k c-apex)) (assert (< q 0d0)))
    (assert (not (eq (cl-mpm/models/wang2017-point:paper-projection-branch result) :hydrostatic-apex)))
    (wa-near-vector (cl-mpm/models/wang2017-point:paper-projection-tau result)
                    (vector (+ mean t-return) mean (- mean t-return)) 1d-6)
    (wa-near-vector (cl-mpm/models/wang2017-point:paper-projection-plastic-increment result) (vector p 0d0 (- p)))
    (wa-near (cl-mpm/models/wang2017-apex:paper-projection-apex-multiplier result) 0d0 0d0)))

(defun wa-error (thunk)
  (handler-case (progn (funcall thunk) nil)
    (cl-mpm/models/mc-evolution:material-integration-error (condition) condition)))
(wa-control "Soft elastic coexistence fixture rejects distinct regular and positive-volume apex solutions"
  (let* ((e .5d6) (nu .25d0) (j 1d0) (old #(-.0035d0 .0015d0 .002d0 0d0 0d0 0d0))
         (trial #(33000d0 27000d0 6000d0))
         (regular #(.006782620950781165d0 0d0 -.006782620950781165d0))
         (tau #(30286.951619687534d0 27000d0 8713.048380312466d0))
         (next-k (wa-kps (map 'vector #'+ old (wa-principal regular (wa-eye))))))
    ;; Supplied regular candidate verified independently against compliance,
    ;; current MC equality and signed history before the public rejection call.
    (dotimes (i 3)
      (wa-near (- (aref trial i) (aref tau i)) (* (/ e (+ 1d0 nu)) (aref regular i)) 1d-6))
    (wa-near next-k .004236688769862515d0 1d-13)
    (wa-near (- (* (+ 1d0 (sin *wa-phi*)) (aref tau 0))
                (* (- 1d0 (sin *wa-phi*)) (aref tau 2))
                (* 2d0 j (wa-cohesion next-k) (cos *wa-phi*))) 0d0 1d-6)
    (assert (> (loop for i below 3 sum (* (aref tau i) (aref regular i))) 0d0))
    (multiple-value-bind (apex-tau delta apex-k c q) (wa-independent-apex trial old (wa-eye) e nu j)
      (declare (ignore delta c))
      (assert (> q 0d0)) (assert (> apex-k (wa-kps old)))
      (assert (> (abs (- (aref tau 0) (aref apex-tau 0))) 1000d0)))
    (let ((condition (wa-error (lambda () (wa-project trial old (wa-eye) e nu j)))))
      (assert condition)
      (assert (or (search "ambig" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal)
                  (search "distinct" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal)))
      (let ((candidates (first (cl-mpm/models/mc-evolution:integration-error-details condition))))
        (assert (> (length candidates) 1))
        (assert (some (lambda (candidate) (eq (getf candidate :branch) :hydrostatic-apex)) candidates))
        (assert (some (lambda (candidate) (not (eq (getf candidate :branch) :hydrostatic-apex))) candidates))))))

(defun wa-native-values (m) (copy-seq (magicl::matrix/double-float-storage m)))
(defun wa-native-compliance (tau e nu)
  (let ((result (make-array 6 :initial-element 0d0)))
    (dotimes (i 3) (setf (aref result i) (/ (- (elt tau i) (* nu (loop for k below 3 unless (= i k) sum (elt tau k)))) e)))
    (loop for i from 3 below 6 do (setf (aref result i) (/ (elt tau i) (/ e (* 2d0 (+ 1d0 nu)))))) result))
(defun wa-native-trial (mp tau)
  (let* ((strain (cl-mpm/utils:voigt-from-list (coerce (wa-native-compliance tau (cl-mpm/particle::mp-E mp) (cl-mpm/particle::mp-nu mp)) 'list)))
         (before (wa-native-values strain)))
    (incf *wa-native-calls*)
    (let ((result (wa-native-values (cl-mpm/particle:constitutive-model mp strain 1d-4))))
      (wa-near-vector (wa-native-values strain) before 0d0) result)))
(defun wa-particle (&optional (tensor #(0d0 0d0 0d0 0d0 0d0 0d0)))
  (make-instance 'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex :paper-tensor tensor :enable-plasticity t))
(defun wa-install-increment (mp a)
  (dotimes (i 3) (dotimes (j 3) (setf (magicl:tref (cl-mpm/particle::mp-deformation-gradient-strain-increment mp) i j) (aref a i j)))))
(defun wa-install-actual (mp)
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 0) *wa-j*)
  (wa-install-increment mp (wa-rows (wa-captured "transportIncrement"))) mp)
(defun wa-fingerprint (value &optional seen)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float) (list :matrix (copy-list (magicl:shape value)) (coerce (wa-native-values value) 'list)))
        ((consp value) (cons (wa-fingerprint (car value) seen) (wa-fingerprint (cdr value) seen)))
        ((arrayp value) (list :array (array-dimensions value) (loop for i below (array-total-size value) collect (wa-fingerprint (row-major-aref value i) seen))))
        ((or (typep value 'standard-object) (typep value 'structure-object))
         (if (member value seen :test #'eq) :cycle
             (list (class-name (class-of value))
                   (loop for slot in (sb-mop:class-slots (class-of value)) for name = (sb-mop:slot-definition-name slot)
                         unless (string= (symbol-name name) "OUTER-TRIAL-STATE")
                         collect (list name (if (slot-boundp value name) (wa-fingerprint (slot-value value name) (cons value seen)) :unbound))))))
        (t (error "Unhandled fingerprint type ~S" (type-of value)))))
(defun wa-mutate-state (mp)
  (dolist (slot (sb-mop:class-slots (class-of mp)))
    (let ((name (sb-mop:slot-definition-name slot)))
      (when (and (slot-boundp mp name)
                 (member (symbol-name name) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED" "PAPER-ROTATION" "STRESS" "STRAIN" "STRESS-KIRCHOFF") :test #'string=))
        (let ((value (slot-value mp name)))
          (if (typep value 'magicl:matrix/double-float)
              (incf (aref (magicl::matrix/double-float-storage value) 0) .125d0)
              (incf (aref value 0) .125d0)))))) mp)

(wa-control "Native opt-in actual input preserves full compliance positive volume work and independent J2"
  (let* ((mp (wa-install-actual (wa-particle (wa-captured "committedPlasticTensor"))))
         (tau (wa-native-trial mp (wa-principal *wa-trial* *wa-q*))))
    (multiple-value-bind (principal delta k c q fixed) (wa-independent-apex *wa-trial* *wa-old* *wa-q* +wa-e+ +wa-nu+ *wa-j*)
      (wa-near-vector tau (wa-principal principal *wa-q*) 1d-6)
      (wa-near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor mp) (map 'vector #'+ *wa-old* fixed) 1d-12)
      (wa-near (cl-mpm/models/wang2017-native:particle-paper-kps mp) k 1d-13)
      (wa-near (cl-mpm/models/wang2017-native:particle-paper-cohesion mp) c 1d-7)
      (wa-near (cl-mpm/models/mc-evolution:particle-plastic-volume mp) q 1d-13)
      (wa-near (cl-mpm/models/mc-evolution:particle-plastic-work mp) (/ (* (aref principal 0) q) *wa-j*) 1d-7)
      (let* ((mean (/ (reduce #'+ delta) 3d0))
             (j2 (sqrt (* (/ 2d0 3d0) (loop for i below 3 sum (expt (- (aref delta i) mean) 2))))))
        (wa-near (cl-mpm/models/wang2017-native:particle-legacy-j2 mp) j2 1d-12)
        (wa-near (cl-mpm/particle::mp-strain-plastic-vm-inc mp) (* 1.5d0 j2) 1d-12))
      (assert (eq (getf (cl-mpm/models/wang2017-native:particle-last-paper-diagnostic mp) :branch) :hydrostatic-apex)))))

(wa-control "Repeated uncommitted native apex trial does not accumulate volume work or tensor twice"
  (let* ((mp (wa-install-actual (wa-particle (wa-captured "committedPlasticTensor")))) (trial (wa-principal *wa-trial* *wa-q*)))
    (wa-native-trial mp trial)
    (let ((before (wa-fingerprint mp)))
      (wa-native-trial mp trial) (assert (equalp before (wa-fingerprint mp))))))

(wa-control "Native composite ambiguity rejection retains owned state and explicit failure variant"
  (let* ((mp (make-instance 'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex
                            :E .5d6 :nu .25d0 :paper-tensor #(-.0035d0 .0015d0 .002d0 0d0 0d0 0d0)
                            :enable-plasticity t))
         (before (wa-fingerprint mp))
         (condition (wa-error (lambda () (wa-native-trial mp #(33000d0 27000d0 6000d0 0d0 0d0 0d0))))))
    (assert condition) (assert (equalp before (wa-fingerprint mp)))
    (assert (equal (gethash "materialVariant" (cl-mpm/models/mc-evolution:integration-error-diagnostic condition)) "composite-apex"))))

(wa-control "Apex snapshot copy reinitialize and loadstep reset own current and committed tensors"
  (let ((source (wa-install-actual (wa-particle (wa-captured "committedPlasticTensor")))) (target (wa-particle)))
    (wa-native-trial source (wa-principal *wa-trial* *wa-q*))
    (cl-mpm/particle::new-loadstep-mp source)
    (let ((snapshot (cl-mpm/models/wang2017-native:snapshot-particle source)) (before (wa-fingerprint source)))
      (wa-mutate-state source)
      (cl-mpm/models/wang2017-native:restore-particle source snapshot)
      (assert (equalp before (wa-fingerprint source)))
      (cl-mpm/models/wang2017-native:copy-particle-state source target)
      (wa-mutate-state source) (assert (equalp before (wa-fingerprint target)))
      (reinitialize-instance target)
      (wa-mutate-state target)
      (cl-mpm/particle::reset-loadstep-mp target)
      (assert (equalp before (wa-fingerprint target))))))

(let ((record (make-hash-table :test 'equal)))
  (setf (gethash "passed" record) (if *wa-failures* 'yason:false t)
        (gethash "controlsCount" record) (length *wa-passed*)
        (gethash "controlLabels" record) (coerce (reverse *wa-passed*) 'vector)
        (gethash "failures" record) (coerce (reverse *wa-failures*) 'vector)
        (gethash "newModelPointCalls" record) *wa-point-calls*
        (gethash "newModelNativeConstitutiveCalls" record) *wa-native-calls*
        (gethash "strictActualCapsuleReplayCalls" record) 0
        (gethash "physicalUpdatesExecuted" record) 0
        (gethash "scope" record) "Isolated opt-in composite apex model controls; positive hydrostatic plastic flow changes constitutive physics. Not paper-exact, strict-baseline recovery, all-path uniqueness or slope/scientific validation.")
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*wa-output*) :direction :output :if-exists :error) (yason:encode record stream)))
(setf cl-user::*wa-exit* (if *wa-failures* 1 0))
(format t "~&WANG APEX: ~D PASS, ~D FAIL; ~D new point/~D native calls; zero strict replay/MPM updates.~%"
        (length *wa-passed*) (length *wa-failures*) *wa-point-calls* *wa-native-calls*)
