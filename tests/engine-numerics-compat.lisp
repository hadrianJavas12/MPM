;;;; Actual native math and matrix-free solver contracts after owner relocation.
(in-package :cl-user)
(ql:quickload :cl-mpm/linear-solver :silent t)
(let* ((a (magicl:from-list '(2d0 0d0 0d0 3d0) '(2 2) :type 'double-float))
       (b (magicl:from-list '(4d0 9d0) '(2 1) :type 'double-float))
       (operator (lambda (x) (magicl:mult a x)))
       (before (cl-mpm/linear-solver:solve-conjugant-gradients operator b :max-iters 100)))
  (assert (< (abs (- (magicl:tref before 0 0) 2d0)) 1d-12))
  (assert (< (abs (- (magicl:tref before 1 0) 3d0)) 1d-12))
  (format t "~&PASS: Native matrix-free CG solves the analytical positive-definite system.~%")
  (let ((*default-pathname-defaults* (uiop:temporary-directory)))
    (load (cl-mpm-path "src/numerics/fastmaths/fastmaths.lisp"))
    (load (cl-mpm-path "src/solvers/linear-systems/linear-solver.lisp")))
  (let ((after (cl-mpm/linear-solver:solve-conjugant-gradients operator b :max-iters 100)))
    (assert (equalp (cl-mpm/utils::fast-storage before) (cl-mpm/utils::fast-storage after))))
  (format t "~&PASS: Legacy source reload retains the exact computed CG solution.~%"))
(dolist (entry '(("cl-mpm/fastmaths" "src/fastmaths" "src/numerics/fastmaths/fastmaths.lisp")
                 ("cl-mpm/linear-solver" "src/core/linear-solver" "src/solvers/linear-systems/linear-solver.lisp")))
  (assert (equal (truename (asdf:component-pathname
                           (asdf:find-component (asdf:find-system (first entry)) (second entry))))
                 (truename (cl-mpm-path (third entry))))))
(format t "~&ENGINE NUMERICS: 3 passed, including direct owner paths; no spatial simulation.~%")
(uiop:quit 0)
