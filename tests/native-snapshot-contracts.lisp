;;;; Fresh-process native source/DLL provenance contracts; no simulation timestep.
;;;; windows\cl-mpm.cmd tests\native-snapshot-contracts.lisp FRESH_OUTPUT
(in-package :cl-user)
(load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))

(defun native-snapshot-error (function &optional fragment)
  (handler-case (progn (funcall function) nil)
    (error (condition) (or (null fragment) (search fragment (princ-to-string condition))))))

(let* ((output (or (first (cl-mpm-script-args)) (error "Supply a fresh test output directory.")))
       (directory (uiop:ensure-directory-pathname (merge-pathnames output)))
       (checks 0))
  (when (and (probe-file directory)
             (or (uiop:directory-files directory) (uiop:subdirectories directory)))
    (error "Native snapshot test requires a fresh/empty directory."))
  (snapshot-require-fresh-runtime)
  (assert (string= (snapshot-sha256-bytes (make-array 0 :element-type '(unsigned-byte 8)))
                   "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
  (assert (string= (snapshot-sha256-bytes (make-array 3 :element-type '(unsigned-byte 8)
                                                    :initial-contents '(97 98 99)))
                   "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
  (incf checks) (format t "~&PASS: Windows SHA-256 matches empty and abc reference digests.~%")
  (multiple-value-bind (copied records)
      (snapshot-case-sources directory (cl-mpm-path "tests/cases/triaxial-integration.lisp"))
    (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                         (snapshot-object "files" (coerce records 'vector)))
    (let ((*native-snapshot-context* (snapshot-register-native directory records)))
      (dolist (relative '("cl-mpm.asd" "src/settings.lisp" "src/particle.lisp"
                          "config/git-commit-version.txt" "libs/kirchoff.dll"
                          "scripts/lisp/native-source-snapshot.lisp"))
        (snapshot-verify-file (merge-pathnames relative (getf *native-snapshot-context* :source))))
      (incf checks) (format t "~&PASS: Complete native payload, helper, config and DLL have pre-load byte hashes.~%")
      (let* ((system (asdf:find-system "cl-mpm/settings"))
             (operation (asdf:make-operation 'asdf:load-op))
             (escape (make-instance 'asdf:cl-source-file :name "escape" :parent system
                                    :pathname (cl-mpm-path "src/settings.lisp"))))
        (assert (native-snapshot-error (lambda () (snapshot-check-component escape operation))
                                       "escapes frozen source")))
      (incf checks) (format t "~&PASS: A selected native component escaping to the checkout rejects before load.~%")
      (let* ((path (merge-pathnames "src/settings.lisp" (getf *native-snapshot-context* :source)))
             (before (case-source-bytes path)))
        (unwind-protect
             (progn
               (with-open-file (stream path :direction :output :if-exists :append)
                 (write-line "; test-only source mutation" stream))
               (assert (native-snapshot-error (lambda () (snapshot-verify-file path)) "changed after copy")))
          (with-open-file (stream path :direction :output :if-exists :supersede
                                      :element-type '(unsigned-byte 8))
            (write-sequence before stream))))
      (incf checks) (format t "~&PASS: Post-copy source mutation rejects; original test copy restored.~%")
      (let* ((dll (merge-pathnames "libs/kirchoff.dll" (getf *native-snapshot-context* :source)))
             (absent (make-pathname :type "dll.absent" :defaults dll)))
        (unwind-protect
             (progn (rename-file dll absent)
                    (assert (native-snapshot-error #'snapshot-preload-native-dll))
                    (assert (null (snapshot-module-path "kirchoff.dll"))))
          (when (probe-file absent) (rename-file absent dll))))
      (incf checks) (format t "~&PASS: Missing copied DLL rejects without loading checkout DLL or a fallback.~%")
      (snapshot-check-plan "cl-mpm/settings")
      (ql:quickload :cl-mpm/settings :silent t)
      (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
            '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
      (snapshot-check-plan "cl-mpm-framework")
      (ql:quickload :cl-mpm-framework :silent t)
      (let ((proof (snapshot-native-proof))
            (loads (remove-if-not (lambda (action)
                                    (and (eq (gethash "firstParty" action) t)
                                         (string= (gethash "event" action) "performing")
                                         (string= (gethash "operation" action) "load-op")))
                                  (getf *native-snapshot-context* :actions))))
        (assert (plusp (length loads)))
        (assert (gethash "nativeMcEntryPresent" proof))
        (dolist (action loads)
          (assert (uiop:subpathp (pathname (gethash "source" action)) (getf *native-snapshot-context* :source)))
          (loop for input across (gethash "loadInputs" action) do
            (assert (gethash "sha256" input))
            (assert (uiop:subpathp (pathname (gethash "path" input)) (getf *native-snapshot-context* :cache)))))
        (write-case-source-provenance directory copied nil))
      (incf checks) (format t "~&PASS: Selected native sources and FASLs stay frozen; Windows maps copied native MC DLL.~%")
      (assert (native-snapshot-error #'snapshot-require-fresh-runtime "fresh process"))
      (incf checks) (format t "~&PASS: An already-loaded engine is rejected instead of relabelled as freshly frozen.~%")))
  (format t "~&NATIVE SNAPSHOT CONTRACTS: ~D passed; no solver timestep.~%" checks))
(uiop:quit 0)
