(in-package :cl-user)
(ql:quickload :cl-mpm-framework/clay-toe-profile :silent t)
(in-package :cl-mpm/scenario/residual-clay-slope)
(cl-mpm/utils:set-workers 1)
(let* ((cfg (single-slope-config 60d0))
       (mat (fw:make-material :native :youngs-modulus 20d6 :poisson-ratio .2d0 :density 2000d0
              :particle-class 'particle-clay-toe :initargs (list :evolution-law (make-law cfg) :enable-plasticity t)))
       (sim (build-toe-slope mat cfg)) (mesh (cl-mpm:sim-mesh sim))
       (mp (aref (cl-mpm:sim-mps sim) 0)) (worker-flag :unobserved)
       (tensors '((1d0 0d0 0d0 1d0) (0d0 -1d0 1d0 0d0)
                  (1d0 40d0 0d0 1d0) (2d0 0d0 0d0 3d0)
                  (43.3499714561695d0 -1.326224564967645d0 26.57524178023736d0 -.5777919713812165d0))))
  ;; Reproduce the old control-flow defect: caller special is absent on worker.
  (let ((u::*proper-volume-domain* t))
    (cl-mpm::iterate-over-mps (vector mp) (lambda (p) (declare (ignore p)) (setf worker-flag u::*proper-volume-domain*))))
  (assert (null worker-flag))
  (dolist (tensor tensors)
    (let ((f (cl-mpm/particle:mp-deformation-gradient mp)))
      (setf (magicl:tref f 0 0) (first tensor) (magicl:tref f 0 1) (second tensor)
            (magicl:tref f 1 0) (third tensor) (magicl:tref f 1 1) (fourth tensor)))
    (let* ((j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))
           (before (magicl:tref (cl-mpm/particle:mp-position mp) 0 0)))
      (setf (magicl:tref (cl-mpm/particle::mp-displacement-increment mp) 0 0) .01d0)
      (let ((u::*proper-volume-domain* nil))
        (cl-mpm::iterate-over-mps (vector mp) (lambda (p) (cl-mpm::update-particle mesh p .001d0))))
      (assert (< (abs (- (magicl:tref (cl-mpm/particle:mp-position mp) 0 0) before .01d0)) 1d-10))
      (dotimes (i 2)
        (let ((expected (* (magicl:tref (cl-mpm/particle::mp-domain-size-0 mp) i 0) (sqrt j))))
          (assert (< (abs (- (magicl:tref (cl-mpm/particle::mp-domain-size mp) i 0) expected)) 1d-10))))))
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 0) -1d0
        (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 1) 0d0
        (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 1 0) 0d0
        (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 1 1) 1d0)
  (assert (handler-case (progn (u::proper-domain-update mesh mp) nil) (error () t)))
  (let ((fresh (build-toe-slope mat cfg)))
    (setf (cl-mpm:sim-dt fresh) 1d-5 (cl-mpm:sim-gravity fresh) 1d0)
    (let ((u::*proper-volume-domain* nil))
      (dotimes (step 2) (cl-mpm:update-sim fresh)))
    (loop for p across (cl-mpm:sim-mps fresh) do
      (let ((j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient p))))
        (assert (> j 0d0))
        (dotimes (i 2)
          (assert (< (abs (- (magicl:tref (cl-mpm/particle::mp-domain-size p) i 0)
                             (* (magicl:tref (cl-mpm/particle::mp-domain-size-0 p) i 0) (sqrt j)))) 1d-10))))))
  (format t "~&WORKER DOMAIN PASS: caller flag absent on actual worker;5 tensors including failure7923;positive sqrtJ domains;position once;negativeJ rejected;2actualUSFsteps/all13517domains.~%"))
(uiop:quit 0)
