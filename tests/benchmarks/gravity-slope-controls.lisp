;;;; Focused frozen Windows-native gravity/SSR recipe and two-step output gate.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-slope-controls.lisp output\FRESH [all|input|output|saved] [EXISTING_OBSERVATIONS]
;;;; OUTPUT skips already-passed input gates, but loads the exact frozen inputs.
;;;; SAVED rechecks only saved CSV/VTK, with zero solver/material calls.
(in-package :cl-user)
(require :asdf)
(defvar *gravity-controls-frozen* nil)
(defvar *gravity-controls-output* nil)
(defvar *gravity-controls-exit* 1)
(defvar *gravity-controls-mode* (or (second (cl-mpm-script-args)) "all"))
(unless (member *gravity-controls-mode* '("all" "input" "output" "saved") :test #'string=)
  (error "Expected all, input, output or saved mode."))
(unless *gravity-controls-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *gravity-controls-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh control output directory."))
    (when (and (probe-file directory)
               (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Control output is not fresh: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      ;; Cases are executable inputs: copy and register BEFORE any project load.
      (dolist (name '("gravity-slope-mc-srf-1.lisp" "gravity-slope-mc-srf-1p4.lisp" "contract.json"))
        (let* ((contract-p (string= name "contract.json"))
               (original (cl-mpm-path (concatenate 'string
                            (if contract-p "research/references/unnotched-mc-ssr/" "cases/benchmarks/") name)))
               (target (merge-pathnames (concatenate 'string "source/inputs/"
                                          (if contract-p "unnotched-mc-ssr/" "cases/") name) directory))
               (bytes (case-source-bytes original)))
          (ensure-directories-exist target) (uiop:copy-file original target)
          (unless (equalp bytes (case-source-bytes target)) (error "Case copy changed bytes."))
          (setf copied (append copied (list target))
                records (append records
                         (list (snapshot-object "path" (enough-namestring target directory)
                                "originalPath" (namestring (truename original))
                                "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)))))))
      (dolist (required '("source/scenarios/gravity-slope/package.lisp"
                          "source/scenarios/gravity-slope/configuration.lisp"
                          "source/scenarios/gravity-slope/geometry.lisp"
                          "source/scenarios/gravity-slope/measurements.lisp"
                          "source/scenarios/gravity-slope/runner.lisp"
                          "source/scenarios/gravity-slope/adapter.lisp"
                          "source/inputs/cases/gravity-slope-mc-srf-1.lisp"
                          "source/inputs/cases/gravity-slope-mc-srf-1p4.lisp"
                          "source/inputs/unnotched-mc-ssr/contract.json"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required source was not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Complete first-party sources/DLL plus both exact executable input cases, copied before project load"
                                            "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*gravity-controls-frozen* t) (*gravity-controls-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (filename)
                 (snapshot-write-json (merge-pathnames filename directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory)
                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *gravity-controls-exit*))

(defpackage :cl-mpm/tests/gravity-slope
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework)
                    (:gravity :cl-mpm/scenario/gravity-slope)
                    (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/gravity-slope)
(defvar *passed* nil)
(defvar *failed* nil)
(defvar *updates* 0)
(defvar *material-calls* 0)
(defvar *accepted-material-calls* 0)
(defvar *count-calls* nil)
(defvar *count-lock* (sb-thread:make-mutex :name "gravity control counters"))
(defvar *observations* (make-hash-table :test #'equal))
(defparameter *groups*
  '("inputs" "invalid-inputs" "geometry" "boundary" "ramp"
    "runner" "csv" "vtk" "read-only"))

(defmethod cl-mpm:update-sim :around ((sim gravity::gravity-slope-sim))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*count-lock*) (when *count-calls* (incf *updates*)))))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (sb-thread:with-mutex (*count-lock*) (when *count-calls* (incf *material-calls*)))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*count-lock*) (when *count-calls* (incf *accepted-material-calls*)))))

(defmacro control (name &body body)
  `(handler-case
       (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition)
       (setf *failed* (list ,name (princ-to-string condition)))
       (format t "~&FAIL: ~A: ~A~%" ,name condition)
       (return-from run-controls nil))))

(defun near (actual expected &optional (tolerance 1d-11))
  (unless (and (gravity::finite-p actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G, got ~,17G (tolerance ~G)." expected actual tolerance)))
(defun rejected-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun copy-parameters (case)
  (alexandria:copy-hash-table (fw:simulation-parameters case)))
(defun clone-case (case &key (parameters (copy-parameters case))
                            (material (fw:simulation-material case))
                            (loading (fw:simulation-loading case))
                            (solver (fw:simulation-solver case)))
  (fw:make-simulation :scenario (fw:simulation-scenario case) :parameters parameters
   :material material :geometry (fw:simulation-geometry case)
   :boundary (fw:simulation-boundary case) :loading loading :solver solver))
(defun load-case (directory filename)
  (let ((path (merge-pathnames (concatenate 'string "source/inputs/cases/" filename) directory))
        (fw:*simulation* nil))
    (cl-user::snapshot-verify-file path)
    (load path)
    (unless (typep fw:*simulation* 'fw:simulation) (error "Copied input did not assign a recipe."))
    fw:*simulation*))
(defun law (case)
  (getf (fw:material-particle-initargs (fw:simulation-material case)) :evolution-law))
(defun fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value))
               (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value)) (fingerprint (cdr value))))
        ((arrayp value) (list :array (array-dimensions value)
                             (loop for i below (array-total-size value)
                                   collect (fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
               (loop for slot in (sb-mop:class-slots (class-of value))
                     for name = (sb-mop:slot-definition-name slot)
                     collect (list name (fingerprint (slot-value value name))))))
        (t (error "Unexpected fingerprint value ~S." (type-of value)))))
(defun state-fingerprint (sim)
  (loop for mp across (cl-mpm:sim-mps sim)
        collect (list (fingerprint (mc:snapshot-particle mp))
                      (fingerprint (cl-mpm/particle:mp-position mp))
                      (fingerprint (cl-mpm/particle:mp-velocity mp))
                      (fingerprint (cl-mpm/particle::mp-acceleration mp))
                      (cl-mpm/particle:mp-mass mp))))
(defun csv (path)
  (with-open-file (stream path)
    (let ((header (uiop:split-string (read-line stream) :separator ",")))
      (values header
        (loop for line = (read-line stream nil nil) while line
              collect (mapcar (lambda (text) (let ((*read-eval* nil)
                                                  (*read-default-float-format* 'double-float))
                                              (read-from-string text)))
                              (uiop:split-string line :separator ",")))))))
(defun value (header row key)
  (let ((index (position key header :test #'string=)))
    (unless index (error "Missing CSV field ~A." key)) (nth index row)))
(defun det3 (a)
  (+ (* (aref a 0 0) (- (* (aref a 1 1) (aref a 2 2)) (* (aref a 1 2) (aref a 2 1))))
     (- (* (aref a 0 1) (- (* (aref a 1 0) (aref a 2 2)) (* (aref a 1 2) (aref a 2 0)))))
     (* (aref a 0 2) (- (* (aref a 1 0) (aref a 2 1)) (* (aref a 1 1) (aref a 2 0))))))
(defun row-matrix (header row)
  (let ((matrix (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3)
      (setf (aref matrix i j) (value header row (format nil "F_~D~D" i j))))) matrix))
(defun plane-strain-yield-from-row (header row j)
  "Independent closed-form eigenvalues of the exported physical-shear stress."
  (near (value header row "sig_yz_pa") 0d0)
  (near (value header row "sig_xz_pa") 0d0)
  (let* ((xx (value header row "sig_xx_pa")) (yy (value header row "sig_yy_pa"))
         (xy (value header row "sig_xy_pa")) (zz (value header row "sig_zz_pa"))
         (mean (* .5d0 (+ xx yy)))
         (radius (sqrt (+ (expt (* .5d0 (- xx yy)) 2) (* xy xy))))
         (largest (max zz (+ mean radius))) (smallest (min zz (- mean radius)))
         (phi (value header row "friction_rad")) (c (value header row "cohesion_pa")))
    (* j (- (* (+ 1d0 (sin phi)) largest) (* (- 1d0 (sin phi)) smallest)
            (* 2d0 c (cos phi))))))

;; Independent reader for this writer's legacy binary VTK: no production reader.
(defun octet-line (stream)
  (let ((bytes (loop for byte = (read-byte stream nil nil)
                    while (and byte (/= byte 10)) collect byte)))
    (if (or bytes (not (listen stream)))
        (when bytes (string-right-trim '(#\Return) (map 'string #'code-char bytes))) "")))
(defun double-be (stream)
  (let* ((bits (loop repeat 8 for byte = (read-byte stream) for bits = byte then (+ (ash bits 8) byte)
                     finally (return bits)))
         (exponent (ldb (byte 11 52) bits)) (fraction (ldb (byte 52 0) bits))
         (sign (if (logbitp 63 bits) -1d0 1d0)))
    (when (= exponent 2047) (error "Nonfinite VTK payload."))
    (* sign (if (zerop exponent) (scale-float (float fraction 1d0) -1074)
                (scale-float (+ 1d0 (/ fraction (expt 2 52))) (- exponent 1023))))))
(defun read-vtk (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (assert (search "vtk" (octet-line stream))) (octet-line stream)
    (assert (string= "BINARY" (octet-line stream)))
    (assert (string= "DATASET UNSTRUCTURED_GRID" (octet-line stream)))
    (let* ((declaration (uiop:split-string (octet-line stream) :separator " "))
           (count (parse-integer (second declaration)))
           (points (make-array (* count 3))) (fields (make-hash-table :test #'equal)))
      (assert (equal (list (first declaration) (third declaration)) '("POINTS" "double")))
      (dotimes (i (length points)) (setf (aref points i) (double-be stream)))
      (assert (= 10 (read-byte stream)))
      (let ((data (uiop:split-string (octet-line stream) :separator " ")))
        (assert (and (string= (first data) "POINT_DATA") (= count (parse-integer (second data))))))
      (loop while (listen stream) for line = (octet-line stream) when (and line (plusp (length line))) do
        (let ((words (uiop:split-string line :separator " ")))
          (assert (and (string= (first words) "SCALARS") (string= (third words) "double")
                       (string= (fourth words) "1")))
          (assert (string= "LOOKUP_TABLE default" (octet-line stream)))
          (let ((values (make-array count)))
            (dotimes (i count) (setf (aref values i) (double-be stream)))
            (assert (not (gethash (second words) fields)))
            (setf (gethash (second words) fields) values))
          (assert (= 10 (read-byte stream)))))
      (values count points fields))))

(defun run-controls (directory)
  (let* ((saved-mode (string= cl-user::*gravity-controls-mode* "saved"))
         (input-mode (string= cl-user::*gravity-controls-mode* "input"))
         (output-mode (string= cl-user::*gravity-controls-mode* "output"))
         (observations (if saved-mode
                           (let ((argument (third (cl-user::cl-mpm-script-args))))
                             (unless argument (error "SAVED mode requires an existing observations directory."))
                             (uiop:ensure-directory-pathname (merge-pathnames argument)))
                           (merge-pathnames "observations/" directory)))
         (case1 nil) (case14 nil) (config1 nil) (config14 nil) (built nil) (final nil))
    (setf (gethash "observationsDirectory" *observations*) (namestring observations))
    (when output-mode
      ;; Loading/compilation establishes the actual fixture, not a repeat of
      ;; the five input/geometry/BC/ramp assertions that passed in attempt001.
      (setf case1 (load-case directory "gravity-slope-mc-srf-1.lisp")
            case14 (load-case directory "gravity-slope-mc-srf-1p4.lisp")
            config1 (gravity:compile-configuration case1)
            config14 (gravity:compile-configuration case14)))
    (unless (or saved-mode output-mode)
      (control "inputs"
        (setf case1 (load-case directory "gravity-slope-mc-srf-1.lisp")
              case14 (load-case directory "gravity-slope-mc-srf-1p4.lisp")
              config1 (gravity:compile-configuration case1)
              config14 (gravity:compile-configuration case14))
        (near (gethash "strengthReductionFactor" config1) 1d0)
        (near (gethash "strengthReductionFactor" config14) 1.4d0)
        (dolist (key '("domainWidth" "domainHeight" "duration" "gravityRampDuration" "gravity"
                       "referenceCohesionPa" "referenceFrictionDeg" "width" "height" "crestLength"
                       "slope" "baseHeight" "meshSize" "mpsPerCell" "workers" "timeStepScale"
                       "frames" "maxUpdates" "damping" "E" "nu" "density" "geometryProvenance"))
          (assert (equalp (gethash key config1) (gethash key config14))))
        (loop for case in (list case1 case14) for srf in '(1d0 1.4d0) do
          (let ((law (law case)))
            (assert (eq (mc:evolution-law-stress-measure law) :cauchy))
            (assert (eq (mc:evolution-law-variant law) :perfect))
            (dolist (history '(0d0 .02d0 1d0 100d0))
              (multiple-value-bind (c phi psi) (mc:law-values law history)
                (near c (/ 10000d0 srf) 1d-9)
                (near (tan phi) (/ (tan (* 20d0 (/ pi 180d0))) srf))
                (near psi 0d0)))))
        (assert (= *updates* *material-calls* 0)))
      (control "invalid-inputs"
        (let ((bad (copy-parameters case1)))
          (setf (gethash "strengthReductionFactor" bad) 1.4d0)
          (assert (rejected-p (lambda () (gravity:compile-configuration (clone-case case1 :parameters bad))))))
        (assert (rejected-p (lambda () (gravity:compile-configuration
                  (clone-case case1 :loading (fw:make-loading :prescribed-descent :velocity .01d0))))))
        (assert (rejected-p (lambda () (gravity:compile-configuration
                  (clone-case case1 :material (fw:make-material :elastic :youngs-modulus 100d6
                                                :poisson-ratio .3d0 :density 2000d0))))))
        (let* ((options (copy-list (fw:component-options (fw:simulation-material case1))))
               (args (copy-list (getf options :initargs))))
          (setf (getf args :evolution-law) (mc:make-evolution-law :variant :perfect
                 :points '((0d0 20d0)) :cohesion 9999d0 :psi 0d0 :stress-measure :cauchy
                 :strain-assumption "Deliberately inconsistent negative fixture")
                (getf options :initargs) args)
          (assert (rejected-p (lambda () (gravity:compile-configuration
                   (clone-case case1 :material (apply #'fw:make-material :native options))))))))
      (control "geometry"
        (setf built (gravity:build-slope (fw:simulation-material case1) config1))
        (assert (= (length (cl-mpm:sim-mps built)) 880))
        (near (reduce #'+ (cl-mpm:sim-mps built) :key #'cl-mpm/particle:mp-volume) 220d0)
        (near (cl-mpm:sim-gravity built) 0d0)
        (assert (null (cl-mpm::sim-bcs-force-list built)))
        (assert (not (cl-mpm::sim-allow-mp-split built)))
        (near (cl-mpm::sim-mass-scale built) 1d0)
        (let ((occupied (make-hash-table :test #'equal)))
          (loop for mp across (cl-mpm:sim-mps built) do
            (let* ((p (cl-mpm/particle:mp-position mp))
                   (x (gravity::component p 0)) (y (gravity::component p 1)))
              (setf (gethash (list x y) occupied) t)
              (assert (and (> x 0d0) (< x 32d0) (> y 0d0) (<= y 10d0)
                           (<= y (if (<= x 12d0) 10d0 (- 16d0 (* .5d0 x))))))
              (near (cl-mpm/particle:mp-volume mp) .25d0)
              (near (cl-mpm/particle:mp-mass mp) (* .25d0 (/ 20000d0 9.80665d0)))
              (assert (cl-mpm/particle::mp-enable-plasticity mp))
              (near (cl-mpm/particle::mp-gravity mp) 0d0)
              (dolist (matrix (list (cl-mpm/particle:mp-velocity mp) (cl-mpm/particle:mp-stress mp)
                                   (cl-mpm/particle::mp-body-force mp)))
                (assert (every #'zerop (cl-mpm/utils:fast-storage matrix))))))
          ;; Cover the entire prescribed polygon; no missing interior/notch MPs.
          (loop for ix below 64 for x = (+ .25d0 (* .5d0 ix)) do
            (loop for iy below 20 for y = (+ .25d0 (* .5d0 iy))
                  for inside = (<= y (if (<= x 12d0) 10d0 (- 16d0 (* .5d0 x))))
                  do (assert (eq (not (null (gethash (list x y) occupied))) inside)))))
        (setf (gethash "initialParticleCount" *observations*) 880
              (gethash "polygonAreaM2" *observations*) 220d0))
      (control "boundary"
        (let* ((mesh (cl-mpm:sim-mesh built)) (nodes (cl-mpm/mesh:mesh-nodes mesh)))
          (dotimes (i (array-total-size nodes))
            (let ((node (row-major-aref nodes i)))
              (dotimes (axis 3) (setf (magicl:tref (cl-mpm/mesh:node-velocity node) axis 0) 11d0))))
          (loop for bc across (cl-mpm:sim-bcs built) do
            (assert (eq (class-name (class-of bc)) 'cl-mpm/bc::bc-fixed))
            (let* ((index (cl-mpm/bc:bc-index bc)) (x (first index)) (y (second index))
                   (mask (cl-mpm/bc:bc-value bc)))
              (assert (every (lambda (entry) (or (null entry) (zerop entry))) mask))
              (assert (or (= x 0) (= x 80) (= y 0) (= y 15)))
              (when (= y 0) (assert (or (equal mask '(0 0 nil))
                                           (and (or (= x 0) (= x 80)) (equal mask '(0 nil nil))))))
              (cl-mpm/bc:apply-bc bc (cl-mpm/mesh::get-node mesh index) mesh 1d-5)))
          (dotimes (i (array-total-size nodes))
            (let* ((node (row-major-aref nodes i)) (p (cl-mpm/mesh::node-position node))
                   (x (gravity::component p 0)) (y (gravity::component p 1))
                   (v (cl-mpm/mesh:node-velocity node)))
              (near (gravity::component v 0) (if (or (= x 0d0) (= x 80d0) (= y 0d0)) 0d0 11d0))
              (near (gravity::component v 1) (if (= y 0d0) 0d0 11d0)))))
        (assert (= *updates* *material-calls* 0)))
      (control "ramp"
        (near (gravity:ramp-factor 0d0 2d0) 0d0)
        (near (gravity:ramp-factor 1d0 2d0) .5d0)
        (near (gravity:ramp-factor 2d0 2d0) 1d0)
        (near (gravity:ramp-factor 6d0 2d0) 1d0)
        (let ((previous 0d0))
          (loop for i from 0 to 200 for current = (gravity:ramp-factor (/ i 100d0) 2d0) do
            (assert (<= previous current 1d0)) (setf previous current)))
        (assert (rejected-p (lambda () (gravity:ramp-factor -1d0 2d0))))
        (assert (rejected-p (lambda () (gravity:ramp-factor 0d0 0d0))))
        (assert (= *updates* *material-calls* 0))))
    (when input-mode (return-from run-controls t))
    (unless saved-mode
      (control "runner"
        (let ((parameters (copy-parameters case1))
              (options (copy-list (fw:component-options (fw:simulation-solver case1)))))
          (setf (gethash "duration" parameters) 2d-5 (gethash "gravityRampDuration" parameters) 1d-5
                (getf options :frames) 3 (getf options :max-updates) 2)
          (let* ((tiny (clone-case case1 :parameters parameters :solver (apply #'fw:make-solver :explicit options)))
                 (config (gravity:compile-configuration tiny))
                 (started (get-internal-real-time)))
            ;; Worker threads do not inherit a main-thread LET binding of a
            ;; special variable. Set its shared global value under a mutex and
            ;; always restore it, without altering any numerical calculation.
            (unwind-protect
                 (progn
                   (sb-thread:with-mutex (*count-lock*) (setf *count-calls* t))
                   (setf final (gravity:run (fw:simulation-material tiny) config observations)
                         (gethash "runnerWallSeconds" *observations*)
                         (/ (- (get-internal-real-time) started)
                            (float internal-time-units-per-second 1d0))))
              (sb-thread:with-mutex (*count-lock*) (setf *count-calls* nil)))))
        (assert (= *updates* 2))
        (assert (= *material-calls* *accepted-material-calls*))
        (assert (> *material-calls* 0))
        (near (cl-mpm::sim-time final) 2d-5 1d-18)
        (let ((manifest (fw::read-parameter-json (merge-pathnames "manifest.json" observations))))
          (assert (eq (gethash "complete" manifest) t))
          (assert (= (gethash "updates" manifest) 2))
          (assert (= (gethash "savedFrames" manifest) 3))
          (assert (not (eq (gethash "landslideVerified" manifest) t)))
          (assert (not (eq (gethash "scientificallyValidated" manifest) t))))))
    (control "csv"
      (multiple-value-bind (header rows) (csv (merge-pathnames "particles.csv" observations))
        (assert (= (length rows) (* 3 880)))
        (let ((ids (make-array 3 :initial-element nil)) (masses (make-array 3 :initial-element 0d0))
              (max-j-error 0d0) (moved nil) (stress-changed nil))
          (dolist (row rows)
            (assert (every #'gravity::finite-p row))
            (let* ((frame (value header row "frame")) (id (value header row "particle_id"))
                   (j (det3 (row-matrix header row))) (volume (value header row "volume_m3_per_m")))
              (assert (and (integerp frame) (<= 0 frame 2) (integerp id) (<= 0 id 879)))
              (push id (aref ids frame)) (incf (aref masses frame) (value header row "mass_kg_per_m"))
              (assert (> j 0d0))
              (near j (value header row "J"))
              (near volume (* j (value header row "reference_volume_m3_per_m")))
              (near (value header row "cohesion_pa") 10000d0 1d-9)
              (near (value header row "friction_rad") (* 20d0 (/ pi 180d0)))
              (near (value header row "dilation_rad") 0d0)
              (near (plane-strain-yield-from-row header row j)
                    (value header row "yield_residual_kirchhoff_pa") 1d-8)
              (setf max-j-error (max max-j-error (abs (- j (value header row "J")))))
              (when (> frame 0)
                (when (/= (value header row "y_m") (value header row "initial_y_m")) (setf moved t))
                (when (not (zerop (value header row "sig_yy_pa"))) (setf stress-changed t)))
              (when (= frame 2)
                (when final
                  (let ((mp (aref (cl-mpm:sim-mps final) id)))
                    (loop for key in '("sig_xx_pa" "sig_yy_pa" "sig_zz_pa" "sig_yz_pa" "sig_xz_pa" "sig_xy_pa")
                          for axis from 0 do (near (value header row key)
                            (magicl:tref (cl-mpm/particle:mp-stress mp) axis 0))))))))
          (dotimes (frame 3)
            (assert (= (length (remove-duplicates (aref ids frame))) 880))
            (near (aref masses frame) (* 220d0 (/ 20000d0 9.80665d0)) 1d-7))
          (assert moved) (assert stress-changed)
          (setf (gethash "materialCsvRows" *observations*) (length rows)
                (gethash "maxJReadbackResidual" *observations*) max-j-error)))
      (multiple-value-bind (header rows) (csv (merge-pathnames "history.csv" observations))
        (assert (= (length rows) 3))
        (loop for row in rows for frame from 0 do
          (assert (every #'gravity::finite-p row))
          (near (value header row "time_s") (* frame 1d-5) 1d-18)
          (near (value header row "updates") frame)
          (near (value header row "gravity_m_per_s2") (if (zerop frame) 0d0 -9.80665d0))
          (near (value header row "gravity_factor") (if (zerop frame) 0d0 1d0))
          (near (value header row "mass_error_fraction") 0d0)
          (near (value header row "particle_count") 880))))
    (control "vtk"
      (let ((files (sort (directory (merge-pathnames "vtk/particles_*.vtk" observations)) #'string< :key #'namestring)))
        (assert (= (length files) 3))
        (multiple-value-bind (header rows) (csv (merge-pathnames "particles.csv" observations))
          (loop for file in files for frame from 0 do
            (multiple-value-bind (count points fields) (read-vtk file)
              (assert (= count 880))
              (let ((frame-rows (remove-if-not (lambda (row) (= (value header row "frame") frame)) rows)))
                (loop for row in frame-rows for id from 0 do
                  (near (aref points (* id 3)) (value header row "x_m"))
                  (near (aref points (+ 1 (* id 3))) (value header row "y_m"))
                  (loop for (vtk-key csv-key) in '(("mass" "mass_kg_per_m") ("volume" "volume_m3_per_m")
                         ("vel_x" "vx_m_per_s") ("vel_y" "vy_m_per_s")
                         ("sig_xx" "sig_xx_pa") ("sig_yy" "sig_yy_pa") ("sig_xy" "sig_xy_pa")
                         ("mc-kappa" "mc_kappa") ("mc-cohesion-pa" "cohesion_pa")) do
                    (let ((values (gethash vtk-key fields)))
                      (unless values (error "Missing VTK field ~A." vtk-key))
                      (near (aref values id) (value header row csv-key) 1d-9))))))))
        (setf (gethash "savedVtkStates" *observations*) 3)))
    (unless saved-mode
      (control "read-only"
        (let* ((before (state-fingerprint final))
               (config (gravity:compile-configuration case1))
               (adapter (fw:material-diagnostics (fw:simulation-material case1)))
               (reference (gravity::capture-reference-state final config)))
          (dotimes (i 2)
            (gravity::measure-state final adapter reference config)
            (loop for mp across (cl-mpm:sim-mps final) for id from 0 do
              (gravity::particle-row mp reference id 2 2d-5)))
          (cl-mpm/output:save-vtk (merge-pathnames "read-only-final.vtk" directory) final)
          (assert (equalp before (state-fingerprint final))))))))

(handler-case (run-controls cl-user::*gravity-controls-output*)
  (error (condition) (setf *failed* (list "harness" (princ-to-string condition)))))
(let ((report (make-hash-table :test #'equal)))
  (setf (gethash "passed" report) (if *failed* 'yason:false t)
        (gethash "mode" report) cl-user::*gravity-controls-mode*
        (gethash "passedCount" report) (length *passed*)
        (gethash "passedControls" report) (coerce (reverse *passed*) 'vector)
        (gethash "skippedControls" report)
        (coerce (remove-if (lambda (name) (or (member name *passed* :test #'string=)
                                             (and *failed* (string= name (first *failed*))))) *groups*) 'vector)
        (gethash "failure" report) (and *failed* (coerce *failed* 'vector))
        (gethash "physicalUpdatesExecuted" report) *updates*
        (gethash "materialCallsAttempted" report) *material-calls*
        (gethash "materialCallsAccepted" report) *accepted-material-calls*
        (gethash "pointCalls" report) 0
        (gethash "sourceProofBefore" report) "source-proof-before.json"
        (gethash "sourceProofAfter" report) "source-proof-after.json"
        (gethash "sourceManifest" report) "source/source-manifest.json"
        (gethash "sourceProvenance" report) "source-provenance.json"
        (gethash "nativeBackend" report) (cl-user::snapshot-native-proof)
        (gethash "observations" report) *observations*
        (gethash "scope" report) "Exact frozen SRF1/SRF1.40 input construction plus bounded two-update native integration; no full gravity equilibration, instability, landslide, runout or scientific validation claim")
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*gravity-controls-output*)
                          :direction :output :if-exists :error)
    (yason:encode report stream))
  (setf cl-user::*gravity-controls-exit* (if *failed* 1 0)))
