;;;; Focused optional gravity integration; no full slope or forced apex loading.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-composite-apex-controls.lisp FRESH [all|input|output|GROUPS] [SAVED_OBSERVATIONS]
;;;; GROUPS is a comma-separated subset; saved-output alone reuses retained data.
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *gravity-apex-frozen* nil)
(defvar *gravity-apex-output* nil)
(defvar *gravity-apex-exit* 1)
(defvar *gravity-apex-groups*
  (let* ((choice (or (second (cl-mpm-script-args)) "all"))
         (all '("strict-default" "optional-input" "reject-hidden-inputs"
                "short-output" "saved-output" "read-only")))
    (cond ((string= choice "all") all)
          ((string= choice "input") (subseq all 0 3))
          ((string= choice "output") (subseq all 3))
          (t (let ((selected (uiop:split-string choice :separator ",")))
               (unless (and selected (every (lambda (x) (member x all :test #'string=)) selected)
                            (= (length selected) (length (remove-duplicates selected :test #'string=))))
                 (error "Unknown or duplicate gravity-apex control group."))
               selected)))))
(unless *gravity-apex-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *gravity-apex-frozen*
  (let* ((arg (first (cl-mpm-script-args)))
         (directory (and arg (uiop:ensure-directory-pathname (merge-pathnames arg)))))
    (unless directory (error "Provide fresh control output."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve previous control output."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (mapping
               '(("cases/benchmarks/gravity-slope-mc-srf-1p6.lisp"
                  "source/inputs/cases/gravity-slope-mc-srf-1p6.lisp")
                 ("cases/benchmarks/gravity-slope-mc-composite-apex-srf-1p6.lisp"
                  "source/inputs/cases/gravity-slope-mc-composite-apex-srf-1p6.lisp")
                 ("research/references/unnotched-mc-ssr/composite-apex-srf1p6-contract.json"
                  "source/inputs/contracts/composite-apex-srf1p6-contract.json")
                 ("output/unnotched-gravity-2026-10-25/srf1p6-001/manifest.json"
                  "source/inputs/retained-strict-srf1p6-manifest.json")))
        (let* ((from (cl-mpm-path (first mapping))) (to (merge-pathnames (second mapping) directory))
               (bytes (case-source-bytes from)))
          (ensure-directories-exist to) (uiop:copy-file from to)
          (assert (equalp bytes (case-source-bytes to)))
          (push to copied)
          (push (snapshot-object "path" (second mapping) "originalPath" (namestring (truename from))
                 "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (dolist (required '("source/scenarios/gravity-slope/configuration.lisp"
                          "source/scenarios/gravity-slope/mc-composite-apex-adapter.lisp"
                          "source/materials/models/plastic/mc-composite-apex/native.lisp"
                          "source/materials/adapters/mc-composite-apex.lisp"))
        (assert (find required records :key (lambda (r) (gethash "path" r)) :test #'string=)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "Exact selected integration/test, both executable cases, variant contract and retained strict manifest copied before project load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*gravity-apex-frozen* t) (*gravity-apex-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/mc-composite-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (p)
                   (snapshot-object "path" (enough-namestring p directory) "sha256" (snapshot-sha256 p))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *gravity-apex-exit*))

(defpackage :cl-mpm/tests/gravity-composite-apex
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:gravity :cl-mpm/scenario/gravity-slope)
                    (:mc :cl-mpm/models/mc-evolution) (:ap :cl-mpm/models/mc-composite-apex)))
(in-package :cl-mpm/tests/gravity-composite-apex)
(defvar *passed* nil)
(defvar *failure* nil)
(defvar *phase* nil)
(defvar *updates* 0)
(defvar *attempted* 0)
(defvar *accepted* 0)
(defvar *outside-attempted* 0)
(defvar *outside-accepted* 0)
(defvar *standalone-constructors* 0)
(defvar *lock* (sb-thread:make-mutex :name "gravity apex counters"))
(defvar *observations* (make-hash-table :test #'equal))
(defparameter +metadata+ '("materialVariant" "materialClass" "apexConvention"
                          "apexCapBandPolicy" "apexMultiplierConvention" "strengthReduction"))
(defparameter +groups+ '("strict-default" "optional-input" "reject-hidden-inputs"
                        "short-output" "saved-output" "read-only"))
(defmethod cl-mpm:update-sim :around ((sim gravity::gravity-slope-sim))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*lock*) (when (eq *phase* :mpm) (incf *updates*)))))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (sb-thread:with-mutex (*lock*)
    (if (eq *phase* :mpm) (incf *attempted*) (incf *outside-attempted*)))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*lock*)
      (if (eq *phase* :mpm) (incf *accepted*) (incf *outside-accepted*)))))
(defmacro control (name &body body)
  `(when (member ,name cl-user::*gravity-apex-groups* :test #'string=)
     (handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
       (error (condition) (setf *failure* (list ,name (princ-to-string condition)))
         (format t "~&FAIL: ~A: ~A~%" ,name condition) (return-from controls nil)))))

;;;; Read-only helper definitions reused from the existing bounded fixture.
(defun near (actual expected &optional (tolerance 1d-11))
  (unless (and (gravity::finite-p actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G, got ~,17G (tolerance ~G)." expected actual tolerance)))
(defun rejected-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun copy-parameters (case)
  (alexandria:copy-hash-table (fw:simulation-parameters case)))
(defun clone-case (case &key (parameters (copy-parameters case))
                            (material (fw:simulation-material case))
                            (loading (fw:simulation-loading case))
                            (solver (fw:simulation-solver case)))
  (fw:make-simulation :scenario (fw:simulation-scenario case) :parameters parameters
   :material material :geometry (fw:simulation-geometry case)
   :boundary (fw:simulation-boundary case) :loading loading :solver solver))
(defun load-case (directory filename)
  (let ((path (merge-pathnames (concatenate 'string "source/inputs/cases/" filename) directory))
        (fw:*simulation* nil))
    (cl-user::snapshot-verify-file path)
    (load path)
    (unless (typep fw:*simulation* 'fw:simulation) (error "Copied input did not assign a recipe."))
    fw:*simulation*))
(defun law (case)
  (getf (fw:material-particle-initargs (fw:simulation-material case)) :evolution-law))
(defun fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value))
               (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value)) (fingerprint (cdr value))))
        ((arrayp value) (list :array (array-dimensions value)
                             (loop for i below (array-total-size value)
                                   collect (fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
               (loop for slot in (sb-mop:class-slots (class-of value))
                     for name = (sb-mop:slot-definition-name slot)
                     collect (list name (fingerprint (slot-value value name))))))
        (t (error "Unexpected fingerprint value ~S." (type-of value)))))
(defun state-fingerprint (sim)
  (loop for mp across (cl-mpm:sim-mps sim)
        collect (list (fingerprint (mc:snapshot-particle mp))
                      (fingerprint (cl-mpm/particle:mp-position mp))
                      (fingerprint (cl-mpm/particle:mp-velocity mp))
                      (fingerprint (cl-mpm/particle::mp-acceleration mp))
                      (cl-mpm/particle:mp-mass mp))))
(defun csv (path)
  (with-open-file (stream path)
    (let ((header (uiop:split-string (read-line stream) :separator ",")))
      (values header
        (loop for line = (read-line stream nil nil) while line
              collect (mapcar (lambda (text) (let ((*read-eval* nil)
                                                  (*read-default-float-format* 'double-float))
                                              (read-from-string text)))
                              (uiop:split-string line :separator ",")))))))
(defun value (header row key)
  (let ((index (position key header :test #'string=)))
    (unless index (error "Missing CSV field ~A." key)) (nth index row)))
(defun det3 (a)
  (+ (* (aref a 0 0) (- (* (aref a 1 1) (aref a 2 2)) (* (aref a 1 2) (aref a 2 1))))
     (- (* (aref a 0 1) (- (* (aref a 1 0) (aref a 2 2)) (* (aref a 1 2) (aref a 2 0)))))
     (* (aref a 0 2) (- (* (aref a 1 0) (aref a 2 1)) (* (aref a 1 1) (aref a 2 0))))))
(defun row-matrix (header row)
  (let ((matrix (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3)
      (setf (aref matrix i j) (value header row (format nil "F_~D~D" i j))))) matrix))
(defun plane-strain-yield-from-row (header row j)
  "Independent closed-form eigenvalues of the exported physical-shear stress."
  (near (value header row "sig_yz_pa") 0d0)
  (near (value header row "sig_xz_pa") 0d0)
  (let* ((xx (value header row "sig_xx_pa")) (yy (value header row "sig_yy_pa"))
         (xy (value header row "sig_xy_pa")) (zz (value header row "sig_zz_pa"))
         (mean (* .5d0 (+ xx yy)))
         (radius (sqrt (+ (expt (* .5d0 (- xx yy)) 2) (* xy xy))))
         (largest (max zz (+ mean radius))) (smallest (min zz (- mean radius)))
         (phi (value header row "friction_rad")) (c (value header row "cohesion_pa")))
    (* j (- (* (+ 1d0 (sin phi)) largest) (* (- 1d0 (sin phi)) smallest)
            (* 2d0 c (cos phi))))))

;; Independent reader for this writer's legacy binary VTK: no production reader.
(defun octet-line (stream)
  (let ((bytes (loop for byte = (read-byte stream nil nil)
                    while (and byte (/= byte 10)) collect byte)))
    (if (or bytes (not (listen stream)))
        (when bytes (string-right-trim '(#\Return) (map 'string #'code-char bytes))) "")))
(defun double-be (stream)
  (let* ((bits (loop repeat 8 for byte = (read-byte stream) for bits = byte then (+ (ash bits 8) byte)
                     finally (return bits)))
         (exponent (ldb (byte 11 52) bits)) (fraction (ldb (byte 52 0) bits))
         (sign (if (logbitp 63 bits) -1d0 1d0)))
    (when (= exponent 2047) (error "Nonfinite VTK payload."))
    (* sign (if (zerop exponent) (scale-float (float fraction 1d0) -1074)
                (scale-float (+ 1d0 (/ fraction (expt 2 52))) (- exponent 1023))))))
(defun read-vtk (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (assert (search "vtk" (octet-line stream))) (octet-line stream)
    (assert (string= "BINARY" (octet-line stream)))
    (assert (string= "DATASET UNSTRUCTURED_GRID" (octet-line stream)))
    (let* ((declaration (uiop:split-string (octet-line stream) :separator " "))
           (count (parse-integer (second declaration)))
           (points (make-array (* count 3))) (fields (make-hash-table :test #'equal)))
      (assert (equal (list (first declaration) (third declaration)) '("POINTS" "double")))
      (dotimes (i (length points)) (setf (aref points i) (double-be stream)))
      (assert (= 10 (read-byte stream)))
      (let ((data (uiop:split-string (octet-line stream) :separator " ")))
        (assert (and (string= (first data) "POINT_DATA") (= count (parse-integer (second data))))))
      (loop while (listen stream) for line = (octet-line stream) when (and line (plusp (length line))) do
        (let ((words (uiop:split-string line :separator " ")))
          (assert (and (string= (first words) "SCALARS") (string= (third words) "double")
                       (string= (fourth words) "1")))
          (assert (string= "LOOKUP_TABLE default" (octet-line stream)))
          (let ((values (make-array count)))
            (dotimes (i count) (setf (aref values i) (double-be stream)))
            (assert (not (gethash (second words) fields)))
            (setf (gethash (second words) fields) values))
          (assert (= 10 (read-byte stream)))))
      (values count points fields))))



(defun metadata (config)
  (loop for key in +metadata+ collect (cons key (gethash key config))))
(defun same-table (expected actual)
  (assert (= (hash-table-count expected) (hash-table-count actual)))
  (maphash (lambda (key value) (assert (and (nth-value 1 (gethash key actual))
                                           (equalp value (gethash key actual))))) expected))
(defun construct (material)
  (incf *standalone-constructors*)
  (apply #'make-instance (fw:material-particle-class material) (fw:material-particle-initargs material)))
(defun changed-material (case &key class extra-initargs)
  (let* ((old (fw:simulation-material case)) (options (copy-list (fw:component-options old))))
    (when class (setf (getf options :particle-class) class))
    (setf (getf options :initargs) (append extra-initargs (copy-list (getf options :initargs))))
    (apply #'fw:make-material (fw:component-kind old) options)))
(defclass unapproved-strict-child (mc:particle-mc-evolution) ())
(defclass unapproved-composite-child (ap:particle-mc-composite-apex) ())

(defun check-saved (observations)
  (let ((manifest (fw::read-parameter-json (merge-pathnames "manifest.json" observations))))
    (assert (and (eq (gethash "complete" manifest) t) (= (gethash "updates" manifest) 2)
                 (= (gethash "savedFrames" manifest) 3) (= (gethash "particleCount" manifest) 880)))
    (dolist (entry (metadata (gethash "config" manifest)))
      (assert (equalp (gethash (car entry) manifest) (cdr entry))))
    (assert (string= (gethash "materialVariant" manifest) "perfect-mc-composite-apex")))
  (multiple-value-bind (header rows) (csv (merge-pathnames "particles.csv" observations))
    (assert (= (length rows) 2640))
    (let ((ids0 nil) (moved nil) (deformed nil) (active-count 0))
      (dotimes (frame 3)
        (let ((selected (remove-if-not (lambda (row) (= (value header row "frame") frame)) rows))
              (mass 0d0))
          (multiple-value-bind (count points fields)
              (read-vtk (merge-pathnames (format nil "vtk/particles_~4,'0D.vtk" frame) observations))
            (assert (= count (length selected) 880))
            (let ((ids (coerce (gethash "unique-id" fields) 'list)))
              (assert (= (length (remove-duplicates ids :test #'=)) 880))
              (if ids0 (assert (equalp ids0 ids)) (setf ids0 ids)))
            (loop for row in selected for id from 0 do
              (assert (every #'gravity::finite-p row))
              (near (value header row "particle_id") id 0d0)
              (near (value header row "time_s") (* frame 1d-5) 1d-18)
              (incf mass (value header row "mass_kg_per_m"))
              (let* ((j (det3 (row-matrix header row)))
                     (c (value header row "cohesion_pa")) (phi (value header row "friction_rad"))
                     (q (aref (gethash "mc-apex-lambda-last" fields) id))
                     (active (aref (gethash "mc-apex-active-last" fields) id)))
                (assert (> j 0d0)) (near j (value header row "J"))
                (near (value header row "volume_m3_per_m") (* j (value header row "reference_volume_m3_per_m")))
                (near c 6250d0 1d-9) (near phi (atan (/ (tan (* 20d0 (/ pi 180d0))) 1.6d0)))
                (near (value header row "dilation_rad") 0d0 0d0)
                (if (zerop frame)
                    (progn (near (value header row "plastic_volume") 0d0 0d0)
                           (near (value header row "plastic_work_pa") 0d0 0d0))
                    ;; This tiny fixture saves EVERY actual update. Unlike a
                    ;; sparse full run, its adjacent rows isolate one return.
                    (let* ((previous (nth (+ (* (1- frame) 880) id) rows))
                           (dv (- (value header row "plastic_volume") (value header previous "plastic_volume")))
                           (dw (- (value header row "plastic_work_pa") (value header previous "plastic_work_pa"))))
                      (if (zerop active) (near dv 0d0)
                          (progn (near dv q)
                                 ;; Stored Cauchy work increment=(pA*q)/J.
                                 (near dw (* c (/ (cos phi) (sin phi)) q) 1d-9)))))
                (near (plane-strain-yield-from-row header row j)
                      (value header row "yield_residual_kirchhoff_pa") 1d-8)
                (assert (and (gravity::finite-p q) (>= q 0d0) (member active '(0d0 1d0) :test #'=)))
                (if (zerop active) (near q 0d0 0d0)
                    (let* ((p (* j c (/ (cos phi) (sin phi))))
                           (tol (+ mc::+stress-atol+ (* mc::+stress-rtol+ (max 1d0 (abs p))))))
                      (assert (> q 0d0)) (incf active-count)
                      (dolist (name '("sig_xx_pa" "sig_yy_pa" "sig_zz_pa"))
                        (near (* j (value header row name)) p tol))
                      (dolist (name '("sig_xy_pa" "sig_yz_pa" "sig_xz_pa"))
                        (near (* j (value header row name)) 0d0 tol))))
                (assert (>= (value header row "plastic_work_pa") 0d0)))
              (near (aref points (* 3 id)) (value header row "x_m"))
              (near (aref points (1+ (* 3 id))) (value header row "y_m"))
              (loop for (vtk-name csv-name) in '(("mass" "mass_kg_per_m") ("volume" "volume_m3_per_m")
                        ("vel_x" "vx_m_per_s") ("vel_y" "vy_m_per_s")
                        ("sig_xx" "sig_xx_pa") ("sig_yy" "sig_yy_pa") ("sig_zz" "sig_zz_pa")
                        ("sig_yz" "sig_yz_pa") ("sig_xz" "sig_xz_pa") ("sig_xy" "sig_xy_pa")
                        ("mc-plastic-volume" "plastic_volume") ("mc-plastic-work-j-m3" "plastic_work_pa")
                        ("mc-kappa" "mc_kappa") ("mc-cohesion-pa" "cohesion_pa")) do
                (near (aref (gethash vtk-name fields) id) (value header row csv-name) 1d-9))
              (when (> frame 0)
                (when (/= (value header row "y_m") (value header row "initial_y_m")) (setf moved t))
                (when (/= (value header row "F_11") 1d0) (setf deformed t)))))
          (near mass (* 220d0 (/ 20000d0 9.80665d0)) 1d-7)))
      (assert moved) (assert deformed)
      (setf (gethash "savedApexActiveRows" *observations*) active-count
            (gethash "savedParticleRows" *observations*) (length rows))))
  (multiple-value-bind (header rows) (csv (merge-pathnames "history.csv" observations))
    (assert (= (length rows) 3))
    (loop for row in rows for frame from 0 do
      (assert (every #'gravity::finite-p row))
      (near (value header row "updates") frame 0d0)
      (near (value header row "time_s") (* frame 1d-5) 1d-18)
      (near (value header row "particle_count") 880 0d0)
      (near (value header row "mass_error_fraction") 0d0)
      (near (value header row "gravity_m_per_s2") (if (zerop frame) 0d0 -9.80665d0))))
  (setf (gethash "savedVtkStates" *observations*) 3
        (gethash "idMappingConvention" *observations*) "VTK unique IDs stable across frames; CSV IDs are captured vector indices, not assumed equal to unique IDs"
        (gethash "apexActivationRequired" *observations*) 'yason:false))

(defun controls (directory)
  (cl-mpm/utils:set-workers 1)
  (let* ((strict (load-case directory "gravity-slope-mc-srf-1p6.lisp"))
         (optional (load-case directory "gravity-slope-mc-composite-apex-srf-1p6.lisp"))
         (strict-config (gravity:compile-configuration strict))
         (config (gravity:compile-configuration optional))
         (retained (fw::read-parameter-json (merge-pathnames "source/inputs/retained-strict-srf1p6-manifest.json" directory)))
         (contract (fw::read-parameter-json (merge-pathnames "source/inputs/contracts/composite-apex-srf1p6-contract.json" directory)))
         (observations (let ((arg (third (cl-user::cl-mpm-script-args))))
                         (if arg (uiop:ensure-directory-pathname (merge-pathnames arg))
                             (merge-pathnames "observations/" directory)))))
    (setf (gethash "observationsDirectory" *observations*) (namestring observations))
    (control "strict-default"
      (same-table (gethash "config" retained) strict-config)
      (dolist (key +metadata+) (assert (not (nth-value 1 (gethash key strict-config)))))
      (let ((mp (construct (fw:simulation-material strict))))
        (assert (eq (class-name (class-of mp)) 'mc:particle-mc-evolution))
        (near (mc:particle-kappa mp) 0d0 0d0))
      (let ((manifest (gravity::make-manifest strict-config)))
        (assert (equalp (gethash "strengthReduction" manifest) (gethash "strengthReduction" retained)))
        (assert (not (nth-value 1 (gethash "materialVariant" manifest))))))
    (control "optional-input"
      (assert (= (hash-table-count config) (+ (hash-table-count strict-config) (length +metadata+))))
      (maphash (lambda (key value) (assert (equalp value (gethash key config)))) strict-config)
      (dolist (key +metadata+)
        (assert (and (stringp (gethash key config)) (plusp (length (gethash key config)))))
        (assert (not (member key gravity::+parameter-keys+ :test #'string=))))
      (assert (string= (gethash "materialVariant" config) "perfect-mc-composite-apex"))
      (assert (string= (gethash "materialClass" config) "CL-MPM/MODELS/MC-COMPOSITE-APEX:PARTICLE-MC-COMPOSITE-APEX"))
      (assert (not (equalp (gethash "strengthReduction" config) (gethash "strengthReduction" retained))))
      (assert (string= (gethash "materialVariant" contract) (gethash "materialVariant" config)))
      (let ((manifest (gravity::make-manifest config)))
        (dolist (entry (metadata config)) (assert (equalp (gethash (car entry) manifest) (cdr entry)))))
      (let ((mp (construct (fw:simulation-material optional))))
        (assert (eq (class-name (class-of mp)) 'ap:particle-mc-composite-apex))
        (near (ap:particle-last-apex-multiplier mp) 0d0 0d0)
        (assert (not (ap:particle-last-apex-active mp))))
      (multiple-value-bind (c phi psi) (mc:law-values (law optional) .123d0)
        (near c 6250d0 1d-9) (near phi (gethash "frictionRad" strict-config)) (near psi 0d0 0d0)))
    (control "reject-hidden-inputs"
      (dolist (case (list strict optional))
        (dolist (class '(cl-mpm/particle::particle-elastic unapproved-strict-child unapproved-composite-child))
          (assert (rejected-p (lambda () (gravity:compile-configuration
                      (clone-case case :material (changed-material case :class class)))))))
        (dolist (extra '((:gravity -1d0) (:kappa .01d0) (:velocity nil)))
          (assert (rejected-p (lambda () (gravity:compile-configuration
                      (clone-case case :material (changed-material case :extra-initargs extra)))))))
        (let ((parameters (copy-parameters case)))
          (setf (gethash "materialVariant" parameters) "perfect-mc-composite-apex")
          (assert (rejected-p (lambda () (gravity:compile-configuration (clone-case case :parameters parameters)))))))
      (assert (= *updates* *attempted* *outside-attempted* 0)))
    (control "short-output"
      (when (third (cl-user::cl-mpm-script-args)) (error "Short-output requires a fresh local observations path."))
      (let ((parameters (copy-parameters optional))
            (options (copy-list (fw:component-options (fw:simulation-solver optional)))))
        (setf (gethash "duration" parameters) 2d-5 (gethash "gravityRampDuration" parameters) 1d-5
              (getf options :frames) 3 (getf options :max-updates) 2)
        (let* ((tiny (clone-case optional :parameters parameters :solver (apply #'fw:make-solver :explicit options)))
               (tiny-config (gravity:compile-configuration tiny)))
          (unwind-protect
               (progn (sb-thread:with-mutex (*lock*) (setf *phase* :mpm))
                      (gravity:run (fw:simulation-material tiny) tiny-config observations))
            (sb-thread:with-mutex (*lock*) (setf *phase* nil)))))
      (assert (= *updates* 2)) (assert (= *attempted* *accepted* 1760))
      (assert (= *outside-attempted* *outside-accepted* 0)))
    (control "saved-output"
      (unless (probe-file (merge-pathnames "manifest.json" observations))
        (error "Select short-output first, or supply existing saved observations as third argument."))
      (check-saved observations))
    (control "read-only"
      ;; Fresh actual initial state makes this group independently retryable;
      ;; it never reruns a previously passed two-update group.
      (let* ((material (fw:simulation-material optional)) (sim (gravity:build-slope material config))
             (adapter (fw:material-diagnostics material)) (reference (gravity::capture-reference-state sim config)))
        (fw:configure-material-output adapter sim)
        (let ((before (state-fingerprint sim)))
          (gravity::measure-state sim adapter reference config)
          (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
            (gravity::particle-row mp reference id 0 0d0)
            (fw:material-state adapter mp))
          (cl-mpm/output:save-vtk (merge-pathnames "read-only-initial.vtk" directory) sim)
          (assert (equalp before (state-fingerprint sim)))))))
  t)
(handler-case (controls cl-user::*gravity-apex-output*)
  (error (condition) (setf *failure* (list "harness" (princ-to-string condition)))))
(with-open-file (stream (merge-pathnames "result.json" cl-user::*gravity-apex-output*) :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object
   "passed" (if *failure* 'yason:false t) "passedGroups" (coerce (reverse *passed*) 'vector)
   "selectedGroups" (coerce cl-user::*gravity-apex-groups* 'vector)
   "skippedGroups" (coerce (set-difference +groups+ cl-user::*gravity-apex-groups* :test #'string=) 'vector)
   "failure" (and *failure* (coerce *failure* 'vector)) "physicalUpdatesExecuted" *updates*
   "materialCallsAttempted" *attempted* "materialCallsAccepted" *accepted*
   "standaloneConstitutiveCallsAttempted" *outside-attempted* "standaloneConstitutiveCallsAccepted" *outside-accepted*
   "standaloneMaterialConstructors" *standalone-constructors* "observations" *observations*
   "nativeBackend" (cl-user::snapshot-native-proof)
   "scope" "Exact strict1.6 config/constructor compatibility and explicit optional metadata; selected tiny880-MP gravity output, no forced apex/standalone constitutive call/full slope or scientific PASS") stream))
(setf cl-user::*gravity-apex-exit* (if *failure* 1 0))
