;;;; Input-only native gate for the proposed 0.01m/s / 60mm accelerated trial.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(flet ((read-case (path)
         (let ((cl-mpm/framework:*simulation* nil))
           (load (cl-mpm-path path)) cl-mpm/framework:*simulation*)))
  (let* ((reference (read-case "cases/benchmarks/wang2017-soil1.lisp"))
         (trial (read-case "cases/benchmarks/wang2017-soil1-fast-010.lisp"))
         (a (cl-mpm/scenario/slope-descent:compile-configuration reference))
         (b (cl-mpm/scenario/slope-descent:compile-configuration trial))
         (changed nil) (report (make-hash-table :test 'equal))
         (output (first (cl-mpm-script-args))))
    (maphash (lambda (key value)
               (multiple-value-bind (other present) (gethash key b)
                 (assert present)
                 (unless (equalp value other) (push key changed)))) a)
    (setf changed (sort changed #'string<))
    (assert (equal changed '("duration" "frames" "maxUpdates" "targetDisplacement" "velocity")))
    (format t "~&PASS: Only velocity/travel/derived duration/output count/computational cap differ.~%")
    (assert (= (gethash "velocity" b) .01d0))
    (assert (= (gethash "targetDisplacement" b) .06d0))
    (assert (< (abs (- (gethash "duration" b) 6d0)) 1d-12))
    (assert (< (abs (- (/ (gethash "duration" b) (1- (gethash "frames" b))) .1d0)) 1d-12))
    ;; Decimal inputs differ by7e-18 after binary floating multiplication.
    ;; This is an arithmetic-unit check, not a relaxed material/regression gate.
    (assert (< (abs (- (* 600d0 (gethash "velocity" a))
                      (gethash "targetDisplacement" b))) 1d-15))
    (format t "~&PASS: 60mm equals 600s at paper rate, or6s at trial rate; 100x paper.~%")
    (let* ((ma (cl-mpm/framework:simulation-material reference))
           (mb (cl-mpm/framework:simulation-material trial))
           (pa (apply #'make-instance (cl-mpm/framework:material-particle-class ma)
                      (cl-mpm/framework:material-particle-initargs ma)))
           (pb (apply #'make-instance (cl-mpm/framework:material-particle-class mb)
                      (cl-mpm/framework:material-particle-initargs mb))))
      (assert (eq (class-of pa) (class-of pb)))
      (assert (= (cl-mpm/particle::mp-E pa) (cl-mpm/particle::mp-E pb) 20d6))
      (assert (= (cl-mpm/particle::mp-nu pa) (cl-mpm/particle::mp-nu pb) .25d0))
      (assert (equalp (cl-mpm/models/mc-evolution:particle-evolution-law pa)
                     (cl-mpm/models/mc-evolution:particle-evolution-law pb))))
    (format t "~&PASS: Actual native class, E/nu and strict perfect-MC Cauchy law unchanged.~%")
    (setf (gethash "passed" report) t (gethash "controlsCount" report) 3
          (gethash "changedConfigKeys" report) (coerce changed 'vector)
          (gethash "referenceConfig" report) a (gethash "trialConfig" report) b
          (gethash "physicalUpdatesExecuted" report) 0
          (gethash "scope" report) "Input/control comparison only; no dynamic or paper-curve validation")
    (assert output) (ensure-directories-exist output)
    (with-open-file (stream output :direction :output :if-exists :error)
      (yason:encode report stream))))
(uiop:quit 0)
