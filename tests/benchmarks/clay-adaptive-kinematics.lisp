(in-package :cl-user)
(ql:quickload :cl-mpm-framework/clay-toe-profile :silent t)
(in-package :cl-mpm/scenario/residual-clay-slope)
(cl-mpm/utils:set-workers 1)
;; Actual failed incremental tensor, stored matrix ordering transposed does not
;; change determinant; compare the chosen infinity norm in this orientation.
(let* ((old-dt .0009414093885362295d0)
       (a (cl-mpm/utils:matrix-from-list '(1.705102463707361d0 -10.982480246462925d0 0d0
                 2.8335644057592546d0 -17.942703508923522d0 0d0 0d0 0d0 0d0)))
       (rate (/ (gradient-infinity-norm a) old-dt))
       (new-dt (kinematic-dt-bound old-dt old-dt .5d0 .2d0 30d0 rate .1d0))
       (df (cl-mpm/utils:matrix-eye 1d0)))
  (cl-mpm/fastmaths:fast-scale! a (/ new-dt old-dt))
  (cl-mpm/fastmaths::fast-.+-matrix df a df)
  (assert (< new-dt old-dt))
  (assert (<= (gradient-infinity-norm a) .100000000001d0))
  (assert (> (cl-mpm/fastmaths:det-3x3 df) 0d0))
  (format t "~&FAILED-TENSOR dtOld=~S dtNew=~S detNew=~S~%" old-dt new-dt (cl-mpm/fastmaths:det-3x3 df)))
(assert (= (kinematic-dt-bound .001d0 .001d0 .5d0 .2d0 0d0 0d0 .1d0) .001d0))
(assert (< (kinematic-dt-bound .001d0 .001d0 .5d0 .2d0 100d0 0d0 .1d0) .001d0))
(assert (handler-case (progn (kinematic-dt-bound .001d0 .001d0 .5d0 .2d0 0d0 -1d0 .1d0) nil) (error () t)))
;; Manufactured compression: forward Euler convergence under .1 -> .05 cap.
(let* ((n 10) (coarse (expt (- 1d0 (/ 1d0 n)) n))
       (fine (expt (- 1d0 (/ 1d0 (* n 2))) (* n 2))))
 (assert (< (abs (- fine (exp -1d0))) (abs (- coarse (exp -1d0))))))
(let* ((cfg (adaptive-clay-config))
       (mat (fw:make-material :native :youngs-modulus 20d6 :poisson-ratio .2d0 :density 2000d0
              :particle-class 'particle-clay-toe :initargs (list :evolution-law (make-law cfg) :enable-plasticity t)))
       (sim (build-toe-slope mat cfg)) (mesh (cl-mpm:sim-mesh sim)))
 ;; Manufacture oscillatory nodal velocities on the actual native mesh, using real
 ;; cpGIMP neighbour gradients. No stress/history/position update in this test.
 (cl-mpm::reset-grid mesh)
 (cl-mpm::p2g mesh (cl-mpm:sim-mps sim) :FLIP)
 (cl-mpm::filter-grid mesh (cl-mpm::sim-mass-filter sim))
 (cl-mpm::update-node-kinematics sim)
 (cl-mpm::iterate-over-nodes-serial mesh (lambda (node)
   (when (cl-mpm/mesh:node-active node)
     (let ((pos (cl-mpm/mesh::node-position node)) (vel (cl-mpm/mesh:node-velocity node)))
       (setf (magicl:tref vel 0 0) (if (evenp (round (/ (component pos 0) .5d0))) 100d0 -100d0)
             (magicl:tref vel 1 0) 0d0)))))
 (cl-mpm::apply-essential-bcs sim)
 (setf (cl-mpm:sim-dt sim) .001d0 (adaptive-pending sim) t)
 (cl-mpm::update-nodes sim)
 (let ((selected (cl-mpm:sim-dt sim)) (maximum 0d0))
  (assert (< selected .001d0))
  (loop for mp across (cl-mpm:sim-mps sim) do
    (cl-mpm::calculate-strain-rate-disp mesh mp selected nil)
    (setf maximum (max maximum (gradient-infinity-norm (cl-mpm/particle::mp-stretch-tensor mp)))))
  (assert (<= maximum .100000001d0))
  (cl-mpm::reset-node-displacement sim) (cl-mpm::update-nodes sim)
  (assert (= selected (cl-mpm:sim-dt sim)))
  (assert (= 1 (adaptive-limited-steps sim)))
  (format t "~&NATIVE-GRID dt=~S actualIncrementNorm=~S position/history untouched~%" selected maximum))
 ;; Two real paired native USF steps with a small requested dt should reproduce
 ;; the original profile, including end-step gravity timing.
 (let* ((plain (build-toe-slope mat (single-slope-config 60d0)))
        (fresh (build-toe-slope mat cfg)))
   (dotimes (step 2)
     (dolist (s (list plain fresh))
       (setf (cl-mpm:sim-dt s) 1d-5
             (cl-mpm:sim-gravity s) (* (value cfg "gravity") (gs:ramp-factor (+ (cl-mpm::sim-time s) 1d-5) 2d0)))
       (cl-mpm:update-sim s)))
   (assert (= (cl-mpm::sim-time plain) (cl-mpm::sim-time fresh)))
   (loop for p across (cl-mpm:sim-mps plain) for q across (cl-mpm:sim-mps fresh) do
     (assert (= (mc:particle-kappa p) (mc:particle-kappa q)))
     (dotimes (i 2)
       (assert (= (component (cl-mpm/particle:mp-position p) i) (component (cl-mpm/particle:mp-position q) i)))))))
(let* ((cfg (adaptive-clay-config))
       (mat (fw:make-material :native :youngs-modulus 20d6 :poisson-ratio .2d0 :density 2000d0
              :particle-class 'particle-clay-toe :initargs (list :evolution-law (make-law cfg) :enable-plasticity t)))
       (sim (build-toe-slope mat cfg)))
 (loop for mp across (cl-mpm:sim-mps sim) do
   (setf (magicl:tref (cl-mpm/particle:mp-velocity mp) 0 0)
         (* -10000d0 (component (cl-mpm/particle:mp-position mp) 0))))
 (dotimes (step 2)
   (let ((before (cl-mpm::sim-time sim)))
    (setf (cl-mpm:sim-dt sim) .001d0)
    (cl-mpm:update-sim sim)
    (assert (< (cl-mpm:sim-dt sim) .001d0))
    (assert (< (abs (- (cl-mpm::sim-time sim) before (cl-mpm:sim-dt sim))) 1d-12)))
   (loop for mp across (cl-mpm:sim-mps sim) do
     (let ((j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp))))
       (assert (and (gs::finite-p j) (> j 0d0)))
       (assert (<= (gradient-infinity-norm (cl-mpm/particle::mp-stretch-tensor mp)) .100000001d0))
       (assert (< (abs (- (cl-mpm/particle:mp-volume mp)
                          (* j (cl-mpm/particle::mp-volume-0 mp)))) 1d-10)))))
 (format t "~&HIGH-SPEED USF PASS:2actualsteps/13517MP/Jpositive/volumeIdentity/gradientBound/timeUsesSelectedDt~%"))
(format t "~&ADAPTIVE CLAY PASS:actual failure tensor;zero/advective/invalid bounds;manufactured halving convergence;native13517MP gradient bound;one selection per step;paired4USF parity.~%")
(uiop:quit 0)
