(in-package :cl-user)
(ql:quickload :cl-mpm-framework/clay-toe-profile :silent t)
(in-package :cl-mpm/scenario/residual-clay-slope)
(let* ((arg (first (cl-user::cl-mpm-script-args)))
       (out (uiop:ensure-directory-pathname (merge-pathnames arg)))
       (cfg (toe-config))
       (material (fw:make-material :native :youngs-modulus 20d6 :poisson-ratio .2d0 :density 2000d0
                   :particle-class 'particle-clay-toe :initargs (list :evolution-law (make-law cfg) :enable-plasticity t)))
       (kink (+ 24d0 (/ 7d0 (tan (* pi (/ 20d0 180d0))))))
       (sim nil) (calls 0) (ctx nil))
  (when (probe-file out) (error "Choose fresh control directory."))
  (assert (< (abs (- (toe-surface cfg 24d0) 18d0)) 1d-12))
  (assert (< (abs (- (toe-surface cfg kink) 11d0)) 1d-12))
  (assert (< (abs (- (toe-surface cfg (value cfg "toeX")) 8d0)) 1d-12))
  (loop for x from 0d0 to 72d0 by .125d0 do
    (let* ((dx (max 0d0 (- x 24d0))) (upper-width (/ 7d0 (tan (* pi (/ 20d0 180d0)))))
           (expected (if (<= dx upper-width)
                         (+ 8d0 (- 10d0 (* dx (tan (* pi (/ 20d0 180d0))))))
                         (+ 8d0 (max 0d0 (- 3d0 (* (- dx upper-width) (tan (* pi (/ 40d0 180d0))))))))))
      (assert (< (abs (- (toe-surface cfg x) expected)) 1d-11))))
  (cl-mpm/utils:set-workers 1)
  (setf sim (build-toe-slope material cfg))
  (setf calls (length (cl-mpm:sim-mps sim)))
  (assert (= calls 15143))
  (setf ctx (capture-reference sim cfg)
        (observation-context-switch-native-time ctx) 0d0)
  (ensure-directories-exist out)
  (configure-output sim)
  (let ((u::*proper-volume-domain* t) (*toe-failure-directory* out))
    (cl-mpm/scenario/urmi-damage40/output-streams:with-retained-output-file (history (merge-pathnames "history.csv" out))
      (cl-mpm/scenario/urmi-damage40/output-streams:with-retained-output-file (particles (merge-pathnames "material-state.csv" out))
        (write-headers history particles)
        (save-state sim ctx cfg (merge-pathnames "particles_0000.vtk" out) 0 3 0 history particles)
        (setf (cl-mpm:sim-dt sim) 1d-4 (cl-mpm:sim-gravity sim) -.01d0)
        (dotimes (i 2) (cl-mpm:update-sim sim))
        (save-state sim ctx cfg (merge-pathnames "particles_0001.vtk" out) 1 3 2 history particles)))
    (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
      (assert (= (cl-mpm/particle::mp-unique-index mp) id))
      (assert (> (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)) 0d0))
      (assert (<= 0d0 (damage-value mp) .75d0)))
    (cl-mpm/output:save-vtk (merge-pathnames "actual-two-updates.vtk" out) sim))
  ;; New failure-only observer exercised with a clearly SYNTHETIC owned tuple.
  (let* ((mp (aref (cl-mpm:sim-mps sim) 0))
         (*toe-failure-directory* (merge-pathnames "synthetic-capture/" out))
         (stretch (cl-mpm/particle::mp-stretch-tensor mp)))
    (setf (magicl:tref stretch 0 0) -2d0)
    (capture-toe-increment-failure mp 1d-4 nil "SYNTHETIC observer control; not actual old failure or replay")
    (assert (probe-file (merge-pathnames "actual-df-failure.json" *toe-failure-directory*))))
  (write-json (merge-pathnames "controls.json" out)
    (obj "geometrySamples" 577 "nativeParticleCount" calls "nativeUpdates" 2
         "finitePositiveJIdsLaw" "PASS" "syntheticFailureObserver" "PASS; not a replay of old missing failure"
         "noScientificValidation" t))
  (format t "~&TOE PROFILE PASS:577geometry samples,~DMP,2USFupdates,positiveJ/IDs/floor; syntheticobserveronly.~%" calls))
(uiop:quit 0)
