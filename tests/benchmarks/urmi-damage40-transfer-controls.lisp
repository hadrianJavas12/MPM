;;;; FIRST owned point controls only; no MPM, old suites or physical validation.
;;;; windows\cl-mpm.cmd tests\benchmarks\urmi-damage40-transfer-controls.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *ut-frozen* nil) (defvar *ut-directory* nil) (defvar *ut-exit* 1)
(unless *ut-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *ut-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide fresh point-control output."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve existing point evidence."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((relative "research/notes/urmi-mc-damage40-2026-10-26/recipe-plan.md")
             (from (cl-mpm-path relative)) (to (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
             (bytes (case-source-bytes from)))
        (ensure-directories-exist to) (uiop:copy-file from to)
        (assert (equalp bytes (case-source-bytes to)))
        (push to copied)
        (push (snapshot-object "path" (enough-namestring to directory) "originalPath" (namestring (truename from))
               "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records))
      (dolist (required '("source/materials/models/plastic/urmi-strength-damage/package.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/law.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/particle.lisp"
                          "source/scenarios/urmi-damage40/package.lisp"
                          "source/scenarios/urmi-damage40/transfer.lisp"))
        (assert (find required records :key (lambda (row) (gethash "path" row)) :test #'string=)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "New optional S1 clone-based native material transfer controls and recipe plan; all selected first-party/DLL bytes frozen before load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*ut-frozen* t) (*ut-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/urmi-strength-transfer"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *ut-exit*))

(defpackage :cl-mpm/tests/urmi-transfer
  (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution)
                    (:usd :cl-mpm/models/urmi-strength-damage)
                    (:tr :cl-mpm/scenario/urmi-damage40/transfer)))
(in-package :cl-mpm/tests/urmi-transfer)
(defvar *passed* nil) (defvar *failures* nil)
(defvar *material-attempted* 0) (defvar *material-accepted* 0) (defvar *mpm-attempted* 0)
(defvar *observations* (make-hash-table :test #'equal))
(defmethod cl-mpm:update-sim :around ((sim cl-mpm::mpm-sim))
  (incf *mpm-attempted*) (error "MPM execution is forbidden in this transfer gate."))
(defmethod cl-mpm/particle:constitutive-model :around ((mp usd:particle-urmi-strength-damage) strain dt)
  (assert (zerop dt)) (incf *material-attempted*)
  (multiple-value-prog1 (call-next-method) (incf *material-accepted*)))
(defmacro control (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (push (list ,name (princ-to-string condition)) *failures*)
       (format t "~&FAIL: ~A: ~A~%" ,name condition))))
(defun near (a b &optional (tolerance 1d-8))
  (assert (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tolerance))))
(defun near-matrix (a b &optional (tolerance 1d-8))
  (let ((av (cl-mpm/utils:fast-storage a)) (bv (cl-mpm/utils:fast-storage b)))
    (assert (= (length av) (length bv)))
    (dotimes (i (length av)) (near (aref av i) (aref bv i) tolerance))))
(defun rejects (function)
  (let ((caught nil)) (handler-case (funcall function) (error (condition) (setf caught condition)))
    (assert caught) caught))
(defun fixture (j &key (plastic nil) (kappa .02d0))
  "Declared committed drained point; all physical state is synthetic, not equilibrium evidence."
  (let* ((law (mc:make-evolution-law :variant :perfect :points '((0d0 30.6d0))
               :cohesion 3700d0 :psi 0d0 :stress-measure :cauchy
               :strain-assumption "Transfer fixture only: constant drained S1 parameters"))
         (mp (make-instance 'mc:particle-mc-evolution :E 10773000d0 :nu .33d0
               :evolution-law law :enable-plasticity t :kappa kappa
               :position (cl-mpm/utils:vector-from-list '(5d0 4d0 0d0))
               :size (cl-mpm/utils:vector-from-list '(.25d0 .25d0 1d0))
               :velocity (cl-mpm/utils:vector-from-list '(.001d0 -.002d0 0d0))
               :mass 125d0 :volume (* .0625d0 j) :volume-0 .0625d0))
         (sigma (cl-mpm/utils:voigt-from-list
                  (if plastic '(-190000d0 -250000d0 -310000d0 0d0 0d0 0d0)
                      '(-100000d0 -110000d0 -120000d0 1000d0 2000d0 3000d0)))))
    (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) 0 0) j)
    (cl-mpm/utils:voigt-copy-into sigma (cl-mpm/particle:mp-stress mp))
    (cl-mpm/utils:voigt-copy-into sigma (cl-mpm/particle::mp-stress-kirchoff mp))
    (cl-mpm/fastmaths:fast-scale! (cl-mpm/particle::mp-stress-kirchoff mp) j)
    (let ((strain (tr:elastic-strain-from-stress sigma j 10773000d0 .33d0)))
      (dolist (matrix (list (cl-mpm/particle:mp-strain mp) (cl-mpm/particle:mp-strain-n mp)
                           (cl-mpm/particle::mp-trial-elastic-strain mp)))
        (cl-mpm/utils:voigt-copy-into strain matrix)))
    (setf (mc:particle-plastic-work mp) 42d0 (mc:particle-plastic-volume mp) 0d0)
    (cl-mpm/particle::new-loadstep-mp mp)
    (assert (<= (mc:particle-yield-residual-kirchhoff mp) 1d-5))
    mp))
(defun tiny-sim (particles)
  (let ((sim (make-instance 'cl-mpm::mpm-sim-usf)))
    (setf (cl-mpm:sim-mps sim) particles) sim))
(defun unchanged (particles signatures)
  (assert (equalp signatures (map 'vector #'tr:particle-signature particles))))
(defun all-independent (a b)
  (dolist (slot (sb-mop:class-slots (class-of a)))
    (let ((name (sb-mop:slot-definition-name slot)))
      (when (and (slot-boundp a name) (slot-boundp b name)
                 (typep (slot-value a name) 'magicl:matrix/double-float))
        (assert (not (eq (slot-value a name) (slot-value b name))))
        (assert (not (eq (cl-mpm/utils:fast-storage (slot-value a name))
                        (cl-mpm/utils:fast-storage (slot-value b name)))))))))
(defun controls ()
  (control "elastic-full-compliance-current-J-origin-and-atomic-vector-commit"
    (let* ((originals (vector (fixture .8d0 :kappa 0d0) (fixture 1.1d0 :kappa .07d0)))
           (before (map 'vector #'tr:particle-signature originals))
           (sim (tiny-sim originals)) (time (cl-mpm::sim-time sim))
           (batch (tr:prepare-transfer originals)))
      (assert (eq originals (cl-mpm:sim-mps sim))) (unchanged originals before)
      (dotimes (i 2)
        (let ((a (aref originals i)) (b (aref (tr:transfer-batch-candidates batch) i)))
          (all-independent a b)
          (near-matrix (cl-mpm/particle:mp-stress a) (cl-mpm/particle:mp-stress b) 1d-6)
          (near-matrix (cl-mpm/particle:mp-position a) (cl-mpm/particle:mp-position b) 0d0)
          (near-matrix (cl-mpm/particle:mp-deformation-gradient a) (cl-mpm/particle:mp-deformation-gradient b) 0d0)
          (near (mc:particle-kappa a) (mc:particle-kappa b) 0d0)
          (near (usd:particle-kappa-origin b) (mc:particle-kappa a) 0d0)
          (near (usd:particle-strength-damage b) 0d0 0d0)
          (near (mc:particle-plastic-work b) 42d0 0d0)
          (near-matrix (cl-mpm/particle:mp-strain b) (cl-mpm/particle:mp-strain-n b) 0d0)))
      (tr:commit-transfer sim batch)
      (assert (eq (tr:transfer-batch-candidates batch) (cl-mpm:sim-mps sim)))
      (near (cl-mpm::sim-time sim) time 0d0) (unchanged originals before)
      (rejects (lambda () (tr:commit-transfer sim batch)))
      (setf (gethash "elasticRecords" *observations*) (tr:transfer-batch-records batch))))
  (control "instantaneous-native-plastic-release-law-damage-and-energy-accounting"
    (let* ((source (fixture 1d0 :plastic t :kappa .03d0))
           (before (tr:particle-signature source)) (batch (tr:prepare-transfer (vector source)))
           (target (aref (tr:transfer-batch-candidates batch) 0))
           (record (aref (tr:transfer-batch-records batch) 0)))
      (assert (equalp before (tr:particle-signature source))) (all-independent source target)
      (assert (> (gethash "predictorResidualKirchhoffPa" record) 0d0))
      (assert (> (mc:particle-kappa target) .03d0))
      (assert (> (usd:particle-strength-damage target) 0d0))
      (near (usd:particle-strength-damage target) (- 1d0 (/ (mc:particle-cohesion target) 40500d0)))
      (near (mc:particle-cohesion target)
            (nth-value 0 (mc:law-values (mc:particle-evolution-law target) (mc:particle-kappa target))))
      (assert (>= (mc:particle-plastic-work target) 42d0))
      (dolist (key '("elasticProxyBeforeJPerM" "elasticProxyPredictorJPerM"
                     "elasticProxyAfterReleaseJPerM" "materialSwitchProxyDifferenceJPerM"
                     "instantaneousReleaseProxyDifferenceJPerM"))
        (assert (mc::finite-real-p (gethash key record))))
      (setf (gethash "plasticReleaseRecords" *observations*) (tr:transfer-batch-records batch))))
  (control "late-candidate-failure-preserves-all-originals-and-simulation"
    (let* ((originals (vector (fixture 1d0) (fixture .9d0 :kappa .04d0)))
           (before (map 'vector #'tr:particle-signature originals)) (sim (tiny-sim originals))
           (time (cl-mpm::sim-time sim)))
      (rejects (lambda () (tr:prepare-transfer originals :candidate-validator
        (lambda (candidate index)
          (when (= index 1)
            (setf (magicl:tref (cl-mpm/particle:mp-position candidate) 0 0) 999d0)
            (error "Deliberate final-candidate failure"))))))
      (assert (eq originals (cl-mpm:sim-mps sim))) (unchanged originals before)
      (near time (cl-mpm::sim-time sim) 0d0))
    (let* ((source (fixture 1d0)) (unknown (make-hash-table :test #'equal)))
      (setf (cl-mpm/particle::mp-stress-eigenvalues source) unknown)
      (rejects (lambda () (tr:prepare-transfer (vector source))))
      (assert (eq unknown (cl-mpm/particle::mp-stress-eigenvalues source)))))
  (control "new-caches-committed-reset-baseline-and-stale-batch-rejection"
    (let* ((originals (vector (fixture 1d0))) (batch (tr:prepare-transfer originals))
           (candidate (aref (tr:transfer-batch-candidates batch) 0))
           (signature (tr:particle-signature candidate)))
      (assert (> (cl-mpm/particle::mp-p-modulus-0 candidate) 0d0))
      (near (cl-mpm/particle::mp-p-modulus-0 candidate)
            (cl-mpm/particle::calculate-p-wave-modulus 11745000d0 .45d0) 1d-6)
      (near-matrix (cl-mpm/particle::mp-elastic-matrix candidate)
                   (cl-mpm/constitutive::linear-elastic-matrix 11745000d0 .45d0) 0d0)
      (near-matrix (cl-mpm/particle::mp-tangent-stiffness candidate)
                   (cl-mpm/particle::mp-elastic-matrix candidate) 0d0)
      (setf (mc:particle-kappa candidate) 9d0
            (slot-value candidate 'usd::kappa-origin) 8d0
            (magicl:tref (cl-mpm/particle:mp-strain candidate) 0 0) 9d0)
      (cl-mpm/particle::reset-loadstep-mp candidate)
      (assert (equalp signature (tr:particle-signature candidate)))
      (setf (magicl:tref (cl-mpm/particle:mp-position candidate) 0 0) 999d0)
      (rejects (lambda () (tr:commit-transfer (tiny-sim originals) batch)))))
  (assert (zerop *mpm-attempted*))
  t)
(handler-case (controls)
  (error (condition) (push (list "harness" (princ-to-string condition)) *failures*)))
(with-open-file (stream (merge-pathnames "result.json" cl-user::*ut-directory*)
                        :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object "passed" (if *failures* 'yason:false t)
    "passedGroups" (coerce (reverse *passed*) 'vector)
    "failures" (coerce (mapcar (lambda (x) (coerce x 'vector)) (reverse *failures*)) 'vector)
    "nativeMaterialAttempts" *material-attempted* "nativeMaterialAccepted" *material-accepted*
    "mpmUpdatesAttempted" *mpm-attempted* "physicalTimeAdvancedS" 0d0
    "observations" *observations* "nativeBackend" (cl-user::snapshot-native-proof)
    "scope" "FIRST synthetic point/cohort transfer only; real dt0 material returns, no equilibrium/MPM/full slope/scientific validation") stream))
(setf cl-user::*ut-exit* (if *failures* 1 0))


