(in-package :cl-user)
(ql:quickload :cl-mpm-framework/clay-toe-profile :silent t)
(in-package :cl-mpm/scenario/residual-clay-slope)
(cl-mpm/utils:set-workers 1)
(defun assert-near (a b &optional (tol 1d-9)) (assert (< (abs (- a b)) tol)))
;; Independent composite trapezoids against the hat function average.
(defun quadrature-gimp (x l h)
 (let* ((n 4000) (step (/ (* 2d0 l) n)) (sum 0d0))
  (dotimes (i (1+ n))
   (let ((q (+ (- x l) (* i step))))
    (incf sum (* (if (or (= i 0) (= i n)) .5d0 1d0) (max 0d0 (- 1d0 (/ (abs q) h)))))))
  (/ (* sum step) (* 2d0 l))))
(loop for ratio in '(.01d0 .25d0 .5d0 .713d0 1d0 2d0 5d0) do
 (let ((h .5d0) (l (* ratio .5d0)))
  (dotimes (phase 21)
   (let* ((x (* .5d0 (/ phase 20d0))) (sum 0d0) (gradient 0d0) (moment 0d0))
    (loop for k from -8 to 9 do
     (let ((w (box-gimp (- x (* k h)) l h)))
      (assert (>= w -1d-14))
      (incf sum w) (incf gradient (box-gimp-gradient (- x (* k h)) l h))
      (incf moment (* k h w))))
    (assert-near sum 1d0) (assert-near gradient 0d0) (assert-near moment x)
    (assert-near (box-gimp x l h) (quadrature-gimp x l h) 2d-6)
    (when (<= ratio .5d0)
     (assert (= (box-gimp x l h) (cl-mpm/shape-function::shape-gimp x l h)))
     (assert (= (box-gimp-gradient x l h) (cl-mpm/shape-function::shape-gimp-dsvp x l h))))))))
(format t "~&SHAPE PASS:147phase/domain samples,partition/gradient/linear reproduction/nonnegative/independent quadrature/small-domain exact compatibility.~%")
(defun test-material (cfg)
 (fw:make-material :native :youngs-modulus 20d6 :poisson-ratio .2d0 :density 2000d0
  :particle-class 'particle-clay-toe :initargs (list :evolution-law (make-law cfg) :enable-plasticity t)))
(let* ((cfg (integrated-clay-config)) (sim (build-toe-slope (test-material cfg) cfg))
       (mesh (cl-mpm:sim-mesh sim)) (mp (aref (cl-mpm:sim-mps sim) 7926))
       (width (* .25d0 (sqrt 4.526118952734468d0))))
 (setf (magicl:tref (cl-mpm/particle:mp-position mp) 0 0) 54.259935747605425d0
       (magicl:tref (cl-mpm/particle:mp-position mp) 1 0) 8.57012360477069d0
       (magicl:tref (cl-mpm/particle::mp-domain-size mp) 0 0) width
       (magicl:tref (cl-mpm/particle::mp-domain-size mp) 1 0) width)
 ;; Native cache on actual saved ID7926 reproduces the current large-domain defect.
 (setf (fill-pointer (cl-mpm/particle::mp-cached-nodes mp)) 0)
 (cl-mpm::create-node-cache mesh mp (lambda (&rest ignored) (declare (ignore ignored))))
 (let ((old (loop for nc across (cl-mpm/particle::mp-cached-nodes mp) sum (cl-mpm/particle::node-cache-weight nc))))
  (assert (> (abs (- old 1d0)) .001d0))
  (multiple-value-bind (new changed) (fill-integrated-cache mesh mp)
   (assert changed) (assert-near new 1d0)
   (let ((gx 0d0) (gy 0d0))
    (loop for nc across (cl-mpm/particle::mp-cached-nodes mp) do
     (incf gx (cl-mpm/utils::gradients-dx (cl-mpm/particle::node-cache-grads nc)))
     (incf gy (cl-mpm/utils::gradients-dy (cl-mpm/particle::node-cache-grads nc))))
    (assert-near gx 0d0) (assert-near gy 0d0))
   (format t "~&ACTUAL SAVED7926 oldWeightSum=~S correctedWeightSum=~S~%" old new)))
 ;; Native transfers consume the corrected cache without changing mass/momentum.
 (setf (magicl:tref (cl-mpm/particle:mp-velocity mp) 0 0) 3d0
       (magicl:tref (cl-mpm/particle:mp-velocity mp) 1 0) -2d0
       (magicl:tref (cl-mpm/particle:mp-stress mp) 0 0) -10000d0
       (magicl:tref (cl-mpm/particle:mp-stress mp) 1 0) -10000d0
       (cl-mpm:sim-mps sim) (vector mp))
 (cl-mpm::reset-grid mesh)
 (cl-mpm::p2g mesh (cl-mpm:sim-mps sim) :FLIP)
 (let ((mass 0d0) (px 0d0) (py 0d0))
  (loop for nc across (cl-mpm/particle::mp-cached-nodes mp) for n = (cl-mpm/particle::node-cache-node nc) do
   (incf mass (cl-mpm/mesh:node-mass n))
   (incf px (component (cl-mpm/mesh:node-velocity n) 0))
   (incf py (component (cl-mpm/mesh:node-velocity n) 1)))
  (assert-near mass (cl-mpm/particle:mp-mass mp))
  (assert-near px (* 3d0 mass)) (assert-near py (* -2d0 mass)))
 (cl-mpm::p2g-force sim)
 (let ((fx 0d0) (fy 0d0))
  (loop for nc across (cl-mpm/particle::mp-cached-nodes mp) for n = (cl-mpm/particle::node-cache-node nc) do
   (incf fx (component (cl-mpm/mesh::node-internal-force n) 0))
   (incf fy (component (cl-mpm/mesh::node-internal-force n) 1)))
  (assert-near fx 0d0) (assert-near fy 0d0))
 (format t "~&NATIVE TRANSFER PASS:large-domain particle mass/momentum/internal-force balance.~%"))
(let* ((cfg (integrated-clay-config)) (plain-cfg (adaptive-clay-config))
       (plain (build-toe-slope (test-material plain-cfg) plain-cfg))
       (fresh (build-toe-slope (test-material cfg) cfg)))
 (dotimes (step 2)
  (dolist (sim (list plain fresh)) (setf (cl-mpm:sim-dt sim) 1d-5) (cl-mpm:update-sim sim)))
 (assert (= (cl-mpm::sim-time plain) (cl-mpm::sim-time fresh)))
 (loop for p across (cl-mpm:sim-mps plain) for q across (cl-mpm:sim-mps fresh) do
  (assert (= (mc:particle-kappa p) (mc:particle-kappa q)))
  (dotimes (i 2)
   (assert (= (component (cl-mpm/particle:mp-position p) i) (component (cl-mpm/particle:mp-position q) i)))))
 (assert (= (integrated-ordinal fresh) 2))
 (assert (= (length (integrated-trace fresh)) 2))
 (assert (integrated-stages fresh))
 ;; Real post-step center guard writes the actual particle tuple before rejection.
 (let* ((dir (uiop:ensure-directory-pathname (merge-pathnames (or (first (cl-user::cl-mpm-script-args)) "output/clay60-integrated-2026-11-02/controls/guard-capture-new/"))))
        (mp (aref (cl-mpm:sim-mps fresh) 7699)))
  (assert (not (probe-file (merge-pathnames "actual-step-failure.json" dir))))
  (ensure-directories-exist dir)
  (loop for p across (cl-mpm:sim-mps fresh) do (setf (toe-particle-failure-directory p) dir))
  (setf (magicl:tref (cl-mpm/particle:mp-position mp) 0 0) 73d0)
  (assert (handler-case (progn (check-integrated-centers fresh "synthetic-test-only") nil) (error () t)))
  (assert (probe-file (merge-pathnames "actual-step-failure.json" dir)))))
(defclass synthetic-force-error-sim (clay-integrated-gimp-sim) ())
(defmethod cl-mpm::update-node-forces :before ((sim synthetic-force-error-sim))
 (error "Synthetic native force error for trace test only."))
(let* ((cfg (integrated-clay-config)) (sim (build-toe-slope (test-material cfg) cfg))
       (dir (merge-pathnames "native-error/" (uiop:ensure-directory-pathname
              (merge-pathnames (first (cl-user::cl-mpm-script-args)))))))
 (change-class sim 'synthetic-force-error-sim)
 (ensure-directories-exist dir)
 (loop for p across (cl-mpm:sim-mps sim) do (setf (toe-particle-failure-directory p) dir))
 (setf (cl-mpm:sim-dt sim) 1d-5)
 (assert (handler-case (progn (cl-mpm:update-sim sim) nil) (error () t)))
 (assert (probe-file (merge-pathnames "actual-step-failure.json" dir))))
(format t "~&INTEGRATED CLAY PASS:147shape samples;actual saved native-cache defect/correction;4actualUSF parity updates/all13517MP;force-stage/rolling trace;synthetic center capsule before unchanged rejection.~%")
(uiop:quit 0)
