;;;; Actual native configurations/material construction; no solver timesteps.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(flet ((read-case (relative)
         (let ((cl-mpm/framework:*simulation* nil))
           (load (cl-mpm-path relative)) cl-mpm/framework:*simulation*)))
  (let* ((soil1 (read-case "cases/benchmarks/wang2017-soil1-fast-010.lisp"))
         (soil2 (read-case "cases/benchmarks/wang2017-soil2-fast-010.lisp"))
         (a (cl-mpm/scenario/slope-descent:compile-configuration soil1))
         (b (cl-mpm/scenario/slope-descent:compile-configuration soil2))
         (mat (cl-mpm/framework:simulation-material soil2))
         (law (getf (cl-mpm/framework:material-particle-initargs mat) :evolution-law))
         (report (make-hash-table :test 'equal))
         (output (first (cl-mpm-script-args))))
    (assert (= (- (hash-table-count b) (hash-table-count a)) 3))
    (maphash (lambda (key value)
               (multiple-value-bind (other present) (gethash key b)
                 (assert present) (assert (equalp value other)))) a)
    (assert (string= (gethash "materialModel" b) "wang2017-soil2"))
    (assert (string= (gethash "paperHistoryFrame" b) "spatial-corotated-incremental-polar"))
    (assert (string= (gethash "historyPolicy" b) "monotonic-scope-reject"))
    (format t "~&PASS: All physical/numerical configuration values match Soil1; only3declared model metadata keys added.~%")
    (assert (cl-mpm/models/wang2017-native:soil2-law-p law))
    (loop for k in '(0d0 .01d0 .02d0 .04d0)
          for expected in '(30000d0 22500d0 15000d0 15000d0) do
      (multiple-value-bind (c phi psi) (cl-mpm/models/mc-evolution:law-values law k)
        (assert (< (abs (- c expected)) 1d-8))
        (assert (< (abs (- phi (* 35d0 (/ pi 180d0)))) 1d-13))
        (assert (zerop psi))))
    (format t "~&PASS: Paper cohesion/friction/dilation and Cauchy law samples match exactly prescribed inputs.~%")
    (let* ((mp (apply #'make-instance (cl-mpm/framework:material-particle-class mat)
                      (cl-mpm/framework:material-particle-initargs mat)))
           (adapter (cl-mpm/framework:material-diagnostics mat)))
      (assert (typep mp 'cl-mpm/models/wang2017-native:particle-wang2017-soil2))
      (assert (= (cl-mpm/particle::mp-E mp) 20d6))
      (assert (= (cl-mpm/particle::mp-nu mp) .25d0))
      (cl-mpm/framework:validate-material-diagnostics adapter (vector mp) "mpm")
      (assert (find "wang-paper-kps" (cl-mpm/framework:diagnostics-fields adapter)
                    :key #'first :test #'equal))
      (assert (not (find "mc-kappa" (cl-mpm/framework:diagnostics-fields adapter)
                         :key #'first :test #'equal))))
    (format t "~&PASS: Actual native Soil2 particle and dedicated diagnostic adapter; no ambiguousJ2 field.~%")
    (setf (gethash "passed" report) t (gethash "controlsCount" report) 3
          (gethash "soil1Config" report) a (gethash "soil2Config" report) b
          (gethash "physicalUpdatesExecuted" report) 0
          (gethash "scope" report) "Native input and material construction only; not a slope/landslide result")
    (assert output) (ensure-directories-exist output)
    (with-open-file (stream output :direction :output :if-exists :error)
      (yason:encode report stream))))
(uiop:quit 0)
