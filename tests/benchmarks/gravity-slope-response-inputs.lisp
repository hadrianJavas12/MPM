;;;; ONE new input-only native gate; no constitutive or MPM update permitted.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-slope-response-inputs.lisp FRESH_OUTPUT
(in-package :cl-user)
(require :asdf)
(defvar *response-frozen* nil) (defvar *response-output* nil) (defvar *response-exit* 1)
(unless *response-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let ((directory (uiop:ensure-directory-pathname (merge-pathnames (or (first (cl-mpm-script-args)) (error "Fresh output required"))))))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve prior evidence; output must be fresh"))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (relative '("cases/benchmarks/gravity-slope-mc-srf-1p4.lisp"
                           "cases/benchmarks/gravity-slope-mc-srf-1p6.lisp"
                           "cases/benchmarks/gravity-slope-mc-srf-2.lisp"
                           "research/references/unnotched-mc-ssr/response-ladder-contract.json"
                           "research/references/unnotched-mc-ssr/response-ladder-audit-contract.json"))
        (let* ((original (cl-mpm-path relative)) (target (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
               (bytes (case-source-bytes original)))
          (ensure-directories-exist target) (uiop:copy-file original target)
          (unless (equalp bytes (case-source-bytes target)) (error "Copied input bytes differ"))
          (push target copied) (push (snapshot-object "path" (enough-namestring target directory)
            "originalPath" (namestring (truename original)) "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "Three actual cases/two preregistered contracts and all project/native sources copied before load" "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records)) (*response-frozen* t) (*response-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof) (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory) (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name) (snapshot-write-json (merge-pathnames name directory)
          (snapshot-object "files" (coerce (mapcar (lambda (p) (snapshot-object
            "path" (enough-namestring p directory) "sha256" (snapshot-sha256 p))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (p copied) (snapshot-verify-file p))
          (write-case-source-provenance directory copied nil) (proof "source-proof-after.json")))))
  (uiop:quit *response-exit*))

(defpackage :cl-mpm/tests/response-inputs
  (:use :cl) (:local-nicknames (:fw :cl-mpm/framework) (:gs :cl-mpm/scenario/gravity-slope)
                             (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/response-inputs)
(setf *read-default-float-format* 'double-float)
(defvar *updates* 0) (defvar *material-calls* 0) (defvar *passed* nil) (defvar *failure* nil)
(defvar *observations* nil)
(defmethod cl-mpm:update-sim :around ((sim cl-mpm::mpm-sim))
  (declare (ignore sim)) (incf *updates*) (error "Input-only gate prohibits MPM updates"))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (declare (ignore mp strain dt)) (incf *material-calls*) (error "Input-only gate prohibits constitutive updates"))
(defmacro group (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (e) (setf *failure* (list ,name (princ-to-string e))) (return-from controls nil))))
(defun input (relative) (merge-pathnames (concatenate 'string "source/inputs/" relative) cl-user::*response-output*))
(defun case-path (name) (input (concatenate 'string "cases/benchmarks/" name)))
(defun read-case (name)
  (let ((fw:*simulation* nil) (path (case-path name))) (cl-user::snapshot-verify-file path) (load path) fw:*simulation*))
(defun near (a b) (assert (<= (abs (- a b)) (* 1d-12 (max 1d0 (abs b))))))
(defun without-law (material)
  (alexandria:remove-from-plist (fw:material-particle-initargs material) :evolution-law))
(defun controls ()
  (let* ((names '("gravity-slope-mc-srf-1p4.lisp" "gravity-slope-mc-srf-1p6.lisp" "gravity-slope-mc-srf-2.lisp"))
         (cases (mapcar #'read-case names)) (configs (mapcar #'gs:compile-configuration cases))
         (base (first cases)) (config (first configs)))
    (group "preregistered-inputs-and-literal-only-change"
      (let* ((plan (fw::read-parameter-json (input "research/references/unnotched-mc-ssr/response-ladder-contract.json")))
             (audit (fw::read-parameter-json (input "research/references/unnotched-mc-ssr/response-ladder-audit-contract.json"))))
        (assert (equal (gethash "schema" plan) "cl-mpm.unnotched-ssr-response-ladder.v1"))
        (assert (equal (gethash "orderedFactors" (gethash "screening" plan)) '(1.6d0 2d0)))
        (assert (= (gethash "maximumFactor" (gethash "screening" plan)) 2d0))
        (assert (equal (gethash "schema" audit) "cl-mpm.unnotched-ssr-response.native-audit.v1")))
      ;; Byte substitution proves all executable text, comments and line ends
      ;; are identical apart from the one visible SRF assignment.
      (let* ((original (cl-user::case-source-bytes (case-path (first names))))
             (text (map 'string #'code-char original)) (needle "(srf 1.4d0)")
             (position (or (search needle text) (error "Original SRF assignment missing"))))
        (assert (not (search needle text :start2 (1+ position))))
        (loop for name in (rest names) for literal in '("(srf 1.6d0)" "(srf 2d0)") do
          (assert (equalp (map 'vector #'char-code
            (concatenate 'string (subseq text 0 position) literal (subseq text (+ position (length needle)))))
            (cl-user::case-source-bytes (case-path name)))))))
    (group "actual-config-and-component-differences"
      (loop for case in (rest cases) for cfg in (rest configs) do
        (assert (= (hash-table-count config) (hash-table-count cfg)))
        (maphash (lambda (key value) (unless (member key '("strengthReductionFactor" "cohesionPa" "frictionRad") :test #'equal)
                                     (assert (equalp value (gethash key cfg))))) config)
        (assert (eq (fw:simulation-scenario base) (fw:simulation-scenario case)))
        (dolist (getter (list #'fw:simulation-geometry #'fw:simulation-boundary #'fw:simulation-loading #'fw:simulation-solver))
          (assert (eq (fw:component-kind (funcall getter base)) (fw:component-kind (funcall getter case))))
          (assert (equalp (fw:component-options (funcall getter base)) (fw:component-options (funcall getter case)))))
        (assert (equalp (without-law (fw:simulation-material base)) (without-law (fw:simulation-material case))))))
    (group "native-constructor-law-values-with-zero-updates"
      (loop for case in cases for cfg in configs for srf in '(1.4d0 1.6d0 2d0) do
        (let* ((material (fw:simulation-material case)) (args (fw:material-particle-initargs material))
               (law (getf args :evolution-law)) (class (fw:material-particle-class material))
               (mp (aref (apply #'cl-mpm/setup:make-block-mps '(0d0 0d0) '(1d0 1d0) '(1 1)
                                      (gethash "density" cfg) class args) 0))
               (c (/ 10000d0 srf)) (phi (atan (/ (tan (* 20d0 (/ pi 180d0))) srf))))
          (assert (eq class 'mc:particle-mc-evolution)) (assert (eq (class-name (class-of mp)) class))
          (assert (eq (mc:evolution-law-variant law) :perfect)) (assert (eq (mc:evolution-law-stress-measure law) :cauchy))
          (multiple-value-bind (actual-c actual-phi actual-psi) (mc:law-values law 0d0)
            (near actual-c c) (near actual-phi phi) (near actual-psi 0d0))
          (near (gethash "strengthReductionFactor" cfg) srf) (near (gethash "cohesionPa" cfg) c) (near (gethash "frictionRad" cfg) phi)
          (near (mc:particle-cohesion mp) c) (near (mc:particle-phi mp) phi) (near (mc:particle-psi mp) 0d0)
          (near (cl-mpm/particle::mp-E mp) 100d6) (near (cl-mpm/particle::mp-nu mp) .3d0)
          (assert (cl-mpm/particle::mp-enable-plasticity mp)) (assert (zerop (mc:particle-kappa mp)))
          (assert (every #'zerop (cl-mpm/utils:fast-storage (cl-mpm/particle:mp-stress mp))))
          (push (cl-user::snapshot-object "srf" srf "cohesionCauchyPa" c "frictionRad" phi
                     "dilationRad" (mc:particle-psi mp) "particleClass" (string class) "constitutiveUpdates" 0) *observations*)))
      (assert (= *updates* *material-calls* 0))))
  t)
(handler-case (controls) (error (e) (setf *failure* (list "harness" (princ-to-string e)))))
(with-open-file (s (merge-pathnames "result.json" cl-user::*response-output*) :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object "passed" (if *failure* 'yason:false t) "passedGroups" (coerce (reverse *passed*) 'vector)
     "failure" (and *failure* (coerce *failure* 'vector)) "constructedParticles" (length *observations*)
     "observations" (coerce (reverse *observations*) 'vector) "physicalUpdatesExecuted" *updates* "constitutiveUpdates" *material-calls*
     "nativeBackend" (cl-user::snapshot-native-proof)
     "scope" "New preregistered input-only screen; zero material/MPM updates, no old tests, full run or scientific PASS") s))
(setf cl-user::*response-exit* (if *failure* 1 0))
