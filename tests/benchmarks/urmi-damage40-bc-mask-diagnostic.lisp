;;;; FIRST NEW native nodal classification diagnostic;0MPM/0material calls.
;;;; windows/cl-mpm.cmd tests/benchmarks/urmi-damage40-bc-mask-diagnostic.lisp FRESH_OUTPUT
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *bm-frozen* nil) (defvar *bm-directory* nil) (defvar *bm-exit* 1)
(unless *bm-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *bm-frozen*
  (let* ((arguments (cl-mpm-script-args))
         (directory (and (first arguments) (uiop:ensure-directory-pathname (merge-pathnames (first arguments))))))
    (unless (and directory (= (length arguments) 1)) (error "Provide ONE fresh diagnostic directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve previous nodal diagnostic evidence."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (pair '(("cases/benchmarks/urmi-damage40.lisp" . "cases/benchmarks/urmi-damage40.lisp")
                      ("research/notes/urmi-mc-damage40-2026-10-26/bc-mask-diagnostic-plan.md" . "bc-mask-diagnostic-plan.md")
                      ("output/urmi-mc-damage40-2026-10-27/full-001/manifest.json" . "observed-full-001-manifest.json")
                      ("output/urmi-mc-damage40-2026-10-27/full-001/source/source-manifest.json" . "observed-full-001-source-manifest.json")))
        (let* ((from (cl-mpm-path (car pair))) (to (merge-pathnames (concatenate 'string "source/inputs/" (cdr pair)) directory))
               (bytes (case-source-bytes from)))
          (ensure-directories-exist to) (uiop:copy-file from to)
          (assert (equalp bytes (case-source-bytes to))) (push to copied)
          (push (snapshot-object "path" (enough-namestring to directory) "originalPath" (namestring (truename from))
            "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "FIRST native boundary-mask diagnostic; exact case and original failed manifest frozen;0MPM/material"
                         "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records)) (*bm-frozen* t) (*bm-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/urmi-damage40"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory) (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                   (snapshot-object "files" (coerce (mapcar (lambda (path)
                     (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil) (proof "source-proof-after.json")))))
  (uiop:quit *bm-exit*))

(defpackage :cl-mpm/tests/urmi-bc-mask
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:mc :cl-mpm/models/mc-evolution)
                    (:recipe :cl-mpm/scenario/urmi-damage40)))
(in-package :cl-mpm/tests/urmi-bc-mask)
(defvar *mpm-calls* 0) (defvar *material-calls* 0) (defvar *p2g-calls* 0)
(defvar *groups* nil) (defvar *failure* nil) (defvar *observations* (make-hash-table :test #'equal))
(defmethod cl-mpm:update-sim :around ((sim recipe:urmi-damage40-sim))
  (declare (ignore sim)) (incf *mpm-calls*) (error "MPM is forbidden in nodal diagnostic."))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (declare (ignore mp strain dt)) (incf *material-calls*) (error "Material update is forbidden in nodal diagnostic."))
(defun obj (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun read-json (path) (with-open-file (stream path) (yason:parse stream)))
(defun write-json (name object)
  (with-open-file (stream (merge-pathnames name cl-user::*bm-directory*) :direction :output :if-exists :error)
    (yason:encode object stream)))
(defun mark (name) (push name *groups*) (format t "~&PASS: ~A~%" name) (finish-output))
(defun near (a b &optional (tol 1d-12))
  (assert (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tol))))
(defun vec (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
(defun resolved-node (bc mesh)
  (or (cl-mpm/bc::bc-node bc) (cl-mpm/mesh:get-node mesh (cl-mpm/bc::bc-index bc))))
(defun expected-unions (sim)
  (let ((expected (make-hash-table :test #'eq)) (members (make-hash-table :test #'eq))
        (mesh (cl-mpm:sim-mesh sim)))
    (loop for bc across (cl-mpm::sim-active-bcs sim) do
      (assert (typep bc 'cl-mpm/bc::bc-fixed))
      (let* ((node (resolved-node bc mesh))
             (mask (or (gethash node expected) (setf (gethash node expected) (vector 1d0 1d0 1d0)))))
        (assert node) (push bc (gethash node members))
        (loop for value in (cl-mpm/bc::bc-value bc) for axis below 3 do
          (when value (setf (aref mask axis) 0d0)))))
    (values expected members)))
(defun node-record (node expected)
  (obj "positionM" (vec (cl-mpm/mesh::node-position node)) "initialMappedMassKgPerM" (cl-mpm/mesh:node-mass node)
       "activeInitialP2G" (if (cl-mpm/mesh:node-active node) t 'yason:false)
       "cachedMask" (when (cl-mpm/mesh::node-bcs node) (vec (cl-mpm/mesh::node-bcs node)))
       "expectedUnionMask" (copy-seq expected) "velocityMPerS" (vec (cl-mpm/mesh:node-velocity node))))
(defun cold-masks (expected)
  (maphash (lambda (node mask)
    (declare (ignore mask)) (setf (cl-mpm/mesh::node-bcs node) nil)
    (dotimes (axis 3) (setf (magicl:tref (cl-mpm/mesh:node-velocity node) axis 0) (float (1+ axis) 1d0)))) expected))
(defun classifications (sim expected)
  (let ((bad nil) (physical nil) (free-cached 0d0) (free-union 0d0)
        (nodes (cl-mpm/mesh::mesh-nodes (cl-mpm:sim-mesh sim))))
    (maphash (lambda (node union)
      (unless (and (cl-mpm/mesh::node-bcs node) (equalp (vec (cl-mpm/mesh::node-bcs node)) union))
        (push (node-record node union) bad))
      (dotimes (axis 3)
        (when (and (= (aref union axis) 0d0) (/= (magicl:tref (cl-mpm/mesh:node-velocity node) axis 0) 0d0))
          (push (obj "node" (node-record node union) "axis" axis) physical)))) expected)
    (dotimes (i (array-total-size nodes))
      (let ((node (row-major-aref nodes i)))
        (when (and (cl-mpm/mesh:node-active node) (> (cl-mpm/mesh:node-mass node) 0d0))
          (when (or (recipe::free-axis-p node 0) (recipe::free-axis-p node 1))
            (incf free-cached (cl-mpm/mesh:node-mass node)))
          (let ((union (gethash node expected)))
            (when (or (null union) (> (aref union 0) .5d0) (> (aref union 1) .5d0))
              (incf free-union (cl-mpm/mesh:node-mass node)))))))
    (obj "cachedUnionMismatches" (coerce (nreverse bad) 'vector)
         "physicalConstraintViolations" (coerce (nreverse physical) 'vector)
         "cachedFreeMassKgPerM" free-cached "unionFreeMassKgPerM" free-union
         "cachedMinusUnionFreeMassKgPerM" (- free-cached free-union))))
(defun corner-bcs (sim node)
  (let ((all (remove-if-not (lambda (bc) (eq (resolved-node bc (cl-mpm:sim-mesh sim)) node))
                           (coerce (cl-mpm::sim-active-bcs sim) 'list))))
    (values (find-if (lambda (bc) (equal (cl-mpm/bc::bc-value bc) '(0 nil nil))) all)
            (find-if (lambda (bc) (equal (cl-mpm/bc::bc-value bc) '(0 0 nil))) all))))
(defun apply-two (sim node first second)
  (assert first) (assert second) (setf (cl-mpm/mesh::node-bcs node) nil)
  (dotimes (axis 3) (setf (magicl:tref (cl-mpm/mesh:node-velocity node) axis 0) (float (1+ axis) 1d0)))
  (cl-mpm/bc:apply-bc first node (cl-mpm:sim-mesh sim) 1d-3)
  (cl-mpm/bc:apply-bc second node (cl-mpm:sim-mesh sim) 1d-3))
(defun check-frozen-reference ()
  (let* ((current (read-json (merge-pathnames "source/source-manifest.json" cl-user::*bm-directory*)))
         (original (read-json (merge-pathnames "source/inputs/observed-full-001-source-manifest.json" cl-user::*bm-directory*)))
         (paths '("source/src/boundaries/constraints/bc.lisp" "source/src/core/simulation-base.lisp"
                  "source/src/core/mesh-base.lisp" "source/src/numerics/tensors/utils.lisp"
                  "source/scenarios/urmi-damage40/geometry.lisp" "source/scenarios/urmi-damage40/configuration.lisp")))
    (dolist (path paths)
      (let ((a (find path (gethash "files" current) :key (lambda (row) (gethash "path" row)) :test #'equal))
            (b (find path (gethash "files" original) :key (lambda (row) (gethash "path" row)) :test #'equal)))
        (assert (and a b (equal (gethash "sha256" a) (gethash "sha256" b))))))
    (setf (gethash "originalFullRelevantSourceHashIdentity" *observations*) (coerce paths 'vector))))
(defun analytic-fixture (sim config corner side bottom initial-mass)
  (let* ((nodes (cl-mpm/mesh::mesh-nodes (cl-mpm:sim-mesh sim)))
         (interior (cl-mpm/mesh:get-node (cl-mpm:sim-mesh sim) '(1 1 0))) (results nil))
    (dotimes (i (array-total-size nodes))
      (setf (cl-mpm/mesh:node-active (row-major-aref nodes i)) nil))
    (dolist (bad '(t nil))
      (apply-two sim corner (if bad side bottom) (if bad bottom side))
      (setf (cl-mpm/mesh:node-active corner) t (cl-mpm/mesh:node-active interior) t
            (cl-mpm/mesh:node-mass corner) initial-mass (cl-mpm/mesh:node-mass interior) 3d0
            (cl-mpm/mesh::node-bcs interior) nil
            (cl-mpm/mesh::node-external-force corner) (cl-mpm/utils:vector-from-list '(0d0 12d0 0d0))
            (cl-mpm/mesh::node-internal-force corner) (cl-mpm/utils:vector-from-list '(0d0 -5d0 0d0))
            (cl-mpm/mesh::node-external-force interior) (cl-mpm/utils:vector-from-list '(0d0 4d0 0d0))
            (cl-mpm/mesh::node-internal-force interior) (cl-mpm/utils:vector-from-list '(0d0 -3d0 0d0))
            (cl-mpm/mesh:node-velocity interior) (cl-mpm/utils:vector-from-list '(0d0 2d0 0d0)))
      (multiple-value-bind (rf numerator denominator) (recipe:force-measures sim)
        (multiple-value-bind (ke mass) (recipe:kinetic-measures sim)
          (let ((rk (recipe::kinetic-ratio sim config)))
            (near numerator (if bad 50d0 1d0) 0d0) (near denominator (if bad 160d0 16d0) 0d0)
            (near rf (sqrt (/ (if bad 50d0 1d0) (if bad 160d0 16d0))))
            (near ke 6d0 0d0) (near mass (+ 3d0 (if bad initial-mass 0d0)))
            (near rk (/ 6d0 (* mass (abs (gethash "gravity" config)) (gethash "height" config))))
            (push (obj "maskOrder" (if bad "side-then-bottom-cached-wrong" "bottom-then-side-union-correct")
                       "corner" (node-record corner #(0d0 0d0 1d0)) "RF" rf "numerator2" numerator "denominator2" denominator
                       "KE" ke "Mfree" mass "RK" rk) results)))))
    (setf (gethash "syntheticRawForceFixture" *observations*)
      (obj "scope" "Prescribed raw pre-essential forces and interiorvelocity; not failedfull001 forces/nodal state; actual initial-P2G corner mass only"
           "results" (coerce (nreverse results) 'vector)))))
(defun run-diagnostic ()
  (check-frozen-reference)
  (let* ((fw::*input-root* (merge-pathnames "source/inputs/" cl-user::*bm-directory*))
         (cl-mpm/framework/config::*schema-path* (merge-pathnames "studio/schema.json" fw::*input-root*))
         (fw:*simulation* nil) (case-path (merge-pathnames "cases/benchmarks/urmi-damage40.lisp" fw::*input-root*))
         (sim nil) (config nil))
    (cl-user::snapshot-verify-file case-path) (load case-path)
    (setf config (fw:compile-scenario :urmi-damage40 fw:*simulation*))
    (cl-mpm/utils:set-workers 1)
    (setf sim (recipe:build-slope (fw:simulation-material fw:*simulation*) config))
    (assert (= (length (cl-mpm:sim-mps sim)) 6714))
    (incf *p2g-calls*)
    (cl-mpm::p2g (cl-mpm:sim-mesh sim) (cl-mpm:sim-mps sim) :FLIP)
    (assert (= (cl-mpm::sim-time sim) 0d0))
    (multiple-value-bind (expected members) (expected-unions sim)
      (let* ((corner (cl-mpm/mesh:get-node (cl-mpm:sim-mesh sim) '(0 0 0)))
             (initial-mass (cl-mpm/mesh:node-mass corner)) (passes nil) (orders nil))
        (assert (> initial-mass 0d0)) (assert (equalp (gethash corner expected) #(0d0 0d0 1d0)))
        (setf (gethash "actualBCCount" *observations*) (length (cl-mpm::sim-active-bcs sim))
              (gethash "actualBoundaryNodeCount" *observations*) (hash-table-count expected)
              (gethash "actualCornerInitialMassKgPerM" *observations*) initial-mass
              (gethash "actualOverlappingBoundaryNodes" *observations*)
              (coerce (loop for node being the hash-keys of members using (hash-value bcs)
                            when (> (length bcs) 1) collect (obj "positionM" (vec (cl-mpm/mesh::node-position node))
                              "BCvalues" (map 'vector (lambda (bc) (coerce (cl-mpm/bc::bc-value bc) 'vector)) bcs)
                              "initialMappedMassKgPerM" (cl-mpm/mesh:node-mass node))) 'vector))
        (mark "exact-frozen-fullgeometry-independent-direction-union-and-one-initial-P2G")
        (multiple-value-bind (side bottom) (corner-bcs sim corner)
          (apply-two sim corner side bottom)
          (assert (equalp (vec (cl-mpm/mesh::node-bcs corner)) #(0d0 1d0 1d0)))
          (near (magicl:tref (cl-mpm/mesh:node-velocity corner) 0 0) 0d0 0d0)
          (near (magicl:tref (cl-mpm/mesh:node-velocity corner) 1 0) 0d0 0d0)
          (push (node-record corner (gethash corner expected)) orders)
          (let ((before (vec (cl-mpm/mesh::node-bcs corner))))
            (cl-mpm/mesh:reset-node corner)
            (assert (equalp before (vec (cl-mpm/mesh::node-bcs corner)))))
          ;; Restore the recorded INITIAL P2G fixture after the explicit reset.
          (setf (cl-mpm/mesh:node-active corner) t (cl-mpm/mesh:node-mass corner) initial-mass)
          (apply-two sim corner bottom side)
          (assert (equalp (vec (cl-mpm/mesh::node-bcs corner)) (gethash corner expected)))
          (push (node-record corner (gethash corner expected)) orders)
          (setf (gethash "serialOrderWitness" *observations*) (coerce (nreverse orders) 'vector)
                (gethash "resetNodeRetainsCachedMask" *observations*) t)
          (mark "native-two-BC-order-witness-physical-constraints-correct-cached-mask-wrong-and-persistent")
          (dolist (workers '(1 4))
            (cl-mpm/utils:set-workers workers)
            (dotimes (trial 16)
              (cold-masks expected)
              (cl-mpm::apply-essential-bcs sim)
              (let ((record (classifications sim expected)))
                (assert (= (length (gethash "physicalConstraintViolations" record)) 0))
                (setf (gethash "workers" record) workers (gethash "trial" record) trial)
                (push record passes))))
          (setf (gethash "boundedActualSchedulerPasses" *observations*) (coerce (nreverse passes) 'vector))
          (mark "sixteen-predeclared-cold-mask-passes-per-worker-count-all-physical-constraints-recorded")
          (cl-mpm/utils:set-workers 1)
          (analytic-fixture sim config corner side bottom initial-mass)
          (mark "synthetic-raw-RF-free-mass-and-KE-identity-versus-true-constraint-union"))))
    (assert (and (= *p2g-calls* 1) (= *mpm-calls* 0) (= *material-calls* 0) (= (length *groups*) 4)))
    (assert (= (cl-mpm::sim-time sim) 0d0))
    (setf (gethash "observedFailedFullManifest" *observations*)
      (read-json (merge-pathnames "source/inputs/observed-full-001-manifest.json" cl-user::*bm-directory*)))
    t))
(handler-case (run-diagnostic) (error (condition) (setf *failure* (princ-to-string condition))))
(write-json "result.json" (obj "passed" (if *failure* 'yason:false t) "failure" (or *failure* "")
  "passedGroups" (coerce (reverse *groups*) 'vector) "mpmCalls" *mpm-calls* "materialCalls" *material-calls* "initialP2gCalls" *p2g-calls*
  "observations" *observations* "nativeBackend" (cl-user::snapshot-native-proof)
  "scope" "FIRST new source-frozen BC/node-mask diagnostic. One initial P2G,0MPM/material; synthetic order/raw-force fixtures, not lastfull001 nodal state or proof of serial equilibrium failure cause"))
(setf cl-user::*bm-exit* (if *failure* 1 0))
