;;;; ONE actual perfect-MC failure replay; zero MPM steps; production returns unchanged.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-slope-failure-replay.lisp OUTPUT FAILED_RUN
(in-package :cl-user)
(require :asdf)
(defvar *gravity-replay-frozen* nil)
(defvar *gravity-replay-directory* nil)
(defvar *gravity-replay-records* nil)
(unless *gravity-replay-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let* ((args (cl-mpm-script-args))
         (directory (and (first args) (uiop:ensure-directory-pathname (merge-pathnames (first args)))))
         (failed (and (second args) (uiop:ensure-directory-pathname (merge-pathnames (second args))))))
    (unless (and directory failed) (error "Provide fresh OUTPUT and existing FAILED_RUN."))
    (when (and (probe-file directory)
               (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Replay output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((original (merge-pathnames "mc-integration-failure.json" failed))
             (target (merge-pathnames "source/inputs/mc-integration-failure.json" directory))
             (bytes (case-source-bytes original))
             (comparisons nil))
        (ensure-directories-exist target) (uiop:copy-file original target)
        (unless (equalp bytes (case-source-bytes target)) (error "Capsule copy changed bytes."))
        (setf copied (append copied (list target))
              records (append records (list (snapshot-object
                       "path" (enough-namestring target directory)
                       "originalPath" (namestring (truename original))
                       "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)))))
        ;; Every MC module and the mapped backend must match the actual failed
        ;; run, before any project package or first-party FASL is loaded.
        (dolist (row records)
          (let ((relative (gethash "path" row)))
            (when (or (search "source/materials/models/plastic/mohr-coulomb-evolution/" relative)
                      (equal relative "source/libs/kirchoff.dll"))
              (let* ((old (merge-pathnames relative failed))
                     (before (snapshot-sha256 old)) (after (gethash "sha256" row)))
                (unless (string= before after) (error "Replay source differs from failed bytes: ~A" relative))
                (push (snapshot-object "path" relative "failedSha256" before "replaySha256" after) comparisons)))))
        (unless (>= (length comparisons) 7) (error "Incomplete failed MC source comparison."))
        (snapshot-write-json (merge-pathnames "failed-source-comparison.json" directory)
                             (snapshot-object "allComparedBytesIdentical" t
                              "files" (coerce (nreverse comparisons) 'vector)))
        (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                             (snapshot-object "scope" "Copied before first-party load; actual failed MC bytes and DLL matched"
                                              "files" (coerce records 'vector)))
        (let ((*native-snapshot-context* (snapshot-register-native directory records))
              (*gravity-replay-frozen* t) (*gravity-replay-directory* directory)
              (*gravity-replay-records* records))
          (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
          (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
                '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
          (dolist (system '("yason" "cl-mpm" "cl-mpm/models/mc-evolution"))
            (snapshot-check-plan system) (ql:quickload system :silent t))
          (snapshot-native-proof)
          (write-case-source-provenance directory copied nil)
          (rename-file (merge-pathnames "source-provenance.json" directory)
                       (merge-pathnames "source-provenance-before.json" directory))
          (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                               (snapshot-object "files" (coerce (mapcar (lambda (path)
                                (snapshot-object "path" (enough-namestring path directory)
                                                 "sha256" (snapshot-sha256 path))) copied) 'vector)))
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (rename-file (merge-pathnames "source-provenance.json" directory)
                       (merge-pathnames "source-provenance-after.json" directory))
          (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                               (snapshot-object "files" (coerce (mapcar (lambda (path)
                                (snapshot-object "path" (enough-namestring path directory)
                                                 "sha256" (snapshot-sha256 path))) copied) 'vector)))))))
  (uiop:quit 0))

(defpackage :cl-mpm/tests/gravity-failure-replay
  (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/gravity-failure-replay)
(setf *read-default-float-format* 'double-float)
(defun object (&rest entries) (apply #'cl-user::snapshot-object entries))
(defun json-boolean (value) (if value t 'yason:false))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*gravity-replay-directory*)
                          :direction :output :if-exists :error)
    (yason:encode value stream)))
(defparameter *capsule-path* (merge-pathnames "source/inputs/mc-integration-failure.json"
                                             cl-user::*gravity-replay-directory*))
(defparameter *capsule-before* (cl-user::case-source-bytes *capsule-path*))
(defparameter *capsule* (with-open-file (stream *capsule-path*)
                        (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *calls* 0)
(defparameter *physical-updates* 0)
(defparameter *candidates* nil)
(defparameter *pairs* nil)
(defparameter *condition* nil)
(defparameter *e* (gethash "youngsModulusPa" *capsule*))
(defparameter *nu* (gethash "poissonRatio" *capsule*))
(defparameter *g* (/ *e* (* 2d0 (+ 1d0 *nu*))))
(defparameter *bulk* (/ *e* (* 3d0 (- 1d0 (* 2d0 *nu*)))))

(defmethod cl-mpm:update-sim :around ((sim cl-mpm::mpm-sim))
  (declare (ignore sim)) (incf *physical-updates*)
  (error "This diagnostic forbids MPM updates."))

(defun candidate-report (candidate residual tolerance accepted)
  (let* ((multipliers (mc:projection-multipliers candidate))
         (residuals (mc:projection-residuals candidate))
         (flows (mc::plane-vectors (mc:projection-psi candidate)))
         (negative-effects
           (loop for multiplier across multipliers for i from 0 when (< multiplier 0d0)
                 collect (let* ((dflow (mc::d-times (aref flows i) *g* *bulk*))
                                (effect (* (abs multiplier) (mc::max-abs3 dflow))))
                           (object "plane" i "multiplier" multiplier
                                   "elasticStressEffectMaxPa" effect
                                   "effectOverStressTolerance" (/ effect tolerance))))))
    (object "admissible" (json-boolean accepted) "active" (coerce (mc:projection-active candidate) 'vector)
     "tauSortedKirchhoffPa" (copy-seq (mc:projection-tau candidate))
     "plasticPrincipalIncrement" (copy-seq (mc:projection-plastic-increment candidate))
     "kappa" (mc:projection-kappa candidate) "oldKappa" (gethash "oldKappa" *capsule*)
     "kappaResidual" residual "stressTolerancePa" tolerance
     "multipliers" (copy-seq multipliers) "minimumMultiplier" (reduce #'min multipliers)
     "negativeMultiplierElasticEffects" (coerce negative-effects 'vector)
     "allPlaneResidualsPa" (copy-seq residuals)
     "maxPlaneResidualPa" (mc:projection-max-residual candidate)
     "complementarityProductsPa" (map 'vector #'* multipliers residuals)
     "maxComplementarityProductAbsPa" (reduce #'max (map 'vector (lambda (l f) (abs (* l f))) multipliers residuals))
     "workKirchhoffPa" (mc:projection-work candidate)
     "cohesionPa" (mc:projection-cohesion candidate) "phiRad" (mc:projection-phi candidate)
     "psiRad" (mc:projection-psi candidate))))

(let ((admissible (symbol-function 'mc::admissible-candidate-p))
      (same (symbol-function 'mc::same-projection-p))
      (project (symbol-function 'mc:project-principal)))
  (unwind-protect
       (progn
         (setf (symbol-function 'mc::admissible-candidate-p)
               (lambda (candidate residual tolerance)
                 (let ((answer (funcall admissible candidate residual tolerance)))
                   (when candidate (push (candidate-report candidate residual tolerance answer) *candidates*))
                   answer))
               (symbol-function 'mc::same-projection-p)
               (lambda (a b tolerance)
                 (let ((answer (funcall same a b tolerance)))
                   (push (object "sameAccordingToProduction" (json-boolean answer)
                          "activeA" (coerce (mc:projection-active a) 'vector)
                          "activeB" (coerce (mc:projection-active b) 'vector)
                          "maxStressDistancePa" (mc::max-abs3 (map 'vector #'- (mc:projection-tau a) (mc:projection-tau b)))
                          "stressDistanceThresholdPa" (* 16d0 tolerance)
                          "kappaDistance" (abs (- (mc:projection-kappa a) (mc:projection-kappa b)))
                          "kappaDistanceThreshold" 1d-10) *pairs*)
                   answer))
               (symbol-function 'mc:project-principal)
               (lambda (&rest args) (incf *calls*) (apply project args)))
         (setf *condition*
               (handler-case (progn (mc:replay-integration-diagnostic *capsule*) nil)
                 (mc:material-integration-error (condition) condition))))
    (setf (symbol-function 'mc::admissible-candidate-p) admissible
          (symbol-function 'mc::same-projection-p) same
          (symbol-function 'mc:project-principal) project)))

(assert (= *calls* 1))
(assert (zerop *physical-updates*))
(assert *condition*)
(assert (string= (gethash "reason" *capsule*) (mc:integration-error-reason *condition*)))
(assert *candidates*)
(assert *pairs*)
(assert (equalp *capsule-before* (cl-user::case-source-bytes *capsule-path*)))
(write-json "replay-result.json"
 (object "passed" t "expectedRejection" t "actualPrincipalReplayCalls" *calls*
  "physicalUpdates" *physical-updates* "productionFunctionsRestored" t
  "reason" (mc:integration-error-reason *condition*)
  "details" (prin1-to-string (mc:integration-error-details *condition*))
  "capsuleSha256" (cl-user::snapshot-sha256 *capsule-path*)
  "nativeBackend" (cl-user::snapshot-native-proof)
  "multiplierTolerance" mc::+multiplier-tol+ "kappaTolerance" mc::+kappa-tol+
  "candidateObservations" (coerce (nreverse *candidates*) 'vector)
  "rootDistanceObservations" (coerce (nreverse *pairs*) 'vector)
  "rollback" "Pure capsule input remains byte-identical. Whole-MPM/particle rollback NOT_EXECUTED; full state is absent."
  "scope" "One original production pure return with temporary observation wrappers; original booleans/results/parameters/equations and thresholds unchanged; zero MPM steps"))
(format t "~&GRAVITY ACTUAL FAILURE REPLAY: one principal call, original expected rejection, zero MPM updates.~%")
