;;;; Native input/control gate for the new rate comparison; zero solver updates.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(defun rate-case (path)
  (let ((cl-mpm/framework:*simulation* nil))
    (load (cl-mpm-path path)) cl-mpm/framework:*simulation*))
(let* ((fast (rate-case "cases/benchmarks/wang2017-soil1-fast-005.lisp"))
       (slow (rate-case "cases/benchmarks/wang2017-soil1-rate-002.lisp"))
       (a (cl-mpm/scenario/slope-descent:compile-configuration fast))
       (b (cl-mpm/scenario/slope-descent:compile-configuration slow))
       (changed nil) (report (make-hash-table :test 'equal))
       (output (first (cl-mpm-script-args))))
  (maphash (lambda (key value)
             (multiple-value-bind (other present) (gethash key b)
               (assert present)
               (unless (equalp value other) (push key changed)))) a)
  (setf changed (sort changed #'string<))
  (assert (equal changed '("duration" "frames" "maxUpdates" "velocity")))
  (format t "~&PASS: Only loading rate, derived duration/cadence count and computational cap differ.~%")
  (assert (= (gethash "velocity" b) .002d0))
  (assert (= (gethash "duration" b) 50d0))
  (assert (= (/ (gethash "duration" b) (1- (gethash "frames" b))) .2d0))
  (assert (= (* (gethash "duration" b) (gethash "velocity" b)) .1d0))
  (format t "~&PASS: Target0.1m/50s; saved cadence0.2s; reference multiplier20.~%")
  (let* ((ma (cl-mpm/framework:simulation-material fast))
         (mb (cl-mpm/framework:simulation-material slow))
         (pa (apply #'make-instance (cl-mpm/framework:material-particle-class ma)
                    (cl-mpm/framework:material-particle-initargs ma)))
         (pb (apply #'make-instance (cl-mpm/framework:material-particle-class mb)
                    (cl-mpm/framework:material-particle-initargs mb))))
    (assert (eq (class-of pa) (class-of pb)))
    (assert (= (cl-mpm/particle::mp-E pa) (cl-mpm/particle::mp-E pb) 20d6))
    (assert (= (cl-mpm/particle::mp-nu pa) (cl-mpm/particle::mp-nu pb) .25d0))
    (assert (equalp (cl-mpm/models/mc-evolution:particle-evolution-law pa)
                    (cl-mpm/models/mc-evolution:particle-evolution-law pb))))
  (format t "~&PASS: Actual native class/elasticity/perfect MC Cauchy law unchanged.~%")
  (setf (gethash "passed" report) t (gethash "controlsCount" report) 3
        (gethash "changedConfigKeys" report) (coerce changed 'vector)
        (gethash "fastConfig" report) a (gethash "slowConfig" report) b
        (gethash "physicalUpdatesExecuted" report) 0
        (gethash "scope" report) "Native input comparison and two material constructions; not rate independence or scientific validation")
  (assert output) (ensure-directories-exist output)
  (with-open-file (stream output :direction :output :if-exists :error)
    (yason:encode report stream)))
(format t "~&WANG RATE COMPARISON: 3 native controls PASS; zero physical updates.~%")
(uiop:quit 0)
