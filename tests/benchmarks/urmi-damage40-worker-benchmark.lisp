;;;; NEW bounded worker scheduling/performance experiment; never the production runner.
;;;; windows/cl-mpm.cmd tests/benchmarks/urmi-damage40-worker-benchmark.lisp FRESH_OUTPUT 1_OR_4
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *wb-frozen* nil) (defvar *wb-directory* nil) (defvar *wb-workers* nil) (defvar *wb-exit* 1)
(unless *wb-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *wb-frozen*
  (let* ((arguments (cl-mpm-script-args))
         (directory (and (first arguments) (uiop:ensure-directory-pathname (merge-pathnames (first arguments)))))
         (workers (and (second arguments) (parse-integer (second arguments) :junk-allowed nil))))
    (unless (and directory (member workers '(1 4)) (= (length arguments) 2))
      (error "Provide fresh output directory and worker count1or4."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve previous worker evidence."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (relative '("cases/benchmarks/urmi-damage40.lisp"
                           "research/notes/urmi-mc-damage40-2026-10-26/acceleration-plan.md"))
       (let* ((from (cl-mpm-path relative))
             (to (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
             (bytes (case-source-bytes from)))
        (ensure-directories-exist to) (uiop:copy-file from to)
        (assert (equalp bytes (case-source-bytes to))) (push to copied)
        (push (snapshot-object "path" (enough-namestring to directory) "originalPath" (namestring (truename from))
               "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "NEW bounded1vs4worker experiment; unchanged physicalcase; all selected source/input/DLL frozen before load"
                         "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*wb-frozen* t) (*wb-directory* directory) (*wb-workers* workers))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/urmi-damage40"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                   (snapshot-object "files" (coerce (mapcar (lambda (path)
                     (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *wb-exit*))

(defpackage :cl-mpm/tests/urmi-workers
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:mc :cl-mpm/models/mc-evolution)
                    (:usd :cl-mpm/models/urmi-strength-damage)
                    (:tr :cl-mpm/scenario/urmi-damage40/transfer)
                    (:recipe :cl-mpm/scenario/urmi-damage40)))
(in-package :cl-mpm/tests/urmi-workers)
(defvar *stage* nil) (defvar *attempted* nil) (defvar *accepted* nil)
(defvar *updates* 0) (defvar *times* nil) (defvar *groups* nil) (defvar *failure* nil)
(defvar *observations* (make-hash-table :test #'equal))
;; These globals are SETF between completed worker barriers. Main-thread dynamic
;; bindings would not propagate into the existing custom worker pool.
;; One index belongs to one MP, and each parallel traversal visits it only once.
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (declare (ignore strain dt))
  (let ((id (cl-mpm/particle::mp-unique-index mp)) (stage *stage*))
    (unless (and (integerp stage) (<= 0 stage 4) (<= 0 id) (< id (array-dimension *attempted* 0)))
      (error "Undeclared worker constitutive counter index."))
    (incf (aref *attempted* id stage))
    (multiple-value-prog1 (call-next-method) (incf (aref *accepted* id stage)))))
(defmethod cl-mpm:update-sim :around ((sim recipe:urmi-damage40-sim))
  (multiple-value-prog1 (call-next-method) (incf *updates*)))
(defun obj (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*wb-directory*) :direction :output :if-exists :error)
    (yason:encode value stream)))
(defun near (a b tolerance)
  (unless (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tolerance))
    (error "Worker fixture mismatch ~S ~S (limit~S)" a b tolerance)))
(defun near-vector (a b tolerance)
  (assert (= (length a) (length b))) (dotimes (i (length a)) (near (elt a i) (elt b i) tolerance)))
(defun gc-clock ()
  (let ((symbol (find-symbol "*GC-RUN-TIME*" "SB-EXT")))
    (if (and symbol (boundp symbol)) (symbol-value symbol) 0)))
(defmacro timed (name &body body)
  `(let ((real-start (get-internal-real-time)) (cpu-start (get-internal-run-time))
         (bytes-start (sb-ext:get-bytes-consed)) (gc-start (gc-clock)))
     (unwind-protect (progn ,@body)
       (push (obj "name" ,name
                  "realSeconds" (/ (- (get-internal-real-time) real-start) (float internal-time-units-per-second 1d0))
                  "processCpuSeconds" (/ (- (get-internal-run-time) cpu-start) (float internal-time-units-per-second 1d0))
                  "bytesConsed" (- (sb-ext:get-bytes-consed) bytes-start)
                  "gcClockDelta" (- (gc-clock) gc-start)
                  "gcClockUnits" "SBCL raw internal GC clock; zero if unavailable; do not infer thread CPU from this value") *times*))))
(defun mark (name) (push name *groups*) (format t "~&PASS: ~A~%" name) (finish-output))
(defun counters ()
  (map 'vector (lambda (stage)
    (obj "stage" (nth stage '("drained" "transfer" "undrained" "plastic-native" "expected-failure"))
         "attempted" (loop for id below (array-dimension *attempted* 0) sum (aref *attempted* id stage))
         "accepted" (loop for id below (array-dimension *accepted* 0) sum (aref *accepted* id stage)))) #(0 1 2 3 4)))
(defun native-compliance (trial e nu)
  (let ((trace (reduce #'+ trial)))
    (cl-mpm/utils:voigt-from-list
      (append (map 'list (lambda (tau) (/ (- (* (+ 1d0 nu) tau) (* nu trace)) e)) trial) '(0d0 0d0 0d0)))))
(defun extra-state (sim frame stream)
  "Expose native elastic strain/latest plastic increment too; no accumulated Ep tensor is invented."
  (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
    (format stream "~{~S~^,~}~%"
      (append (list frame id)
        (loop for matrix in (list (cl-mpm/particle:mp-strain mp) (cl-mpm/particle:mp-strain-n mp)
                                  (mc:particle-plastic-increment mp) (cl-mpm/particle::mp-stress-kirchoff mp))
              append (coerce (cl-mpm/utils:fast-storage matrix) 'list))
        (list (cl-mpm/particle::mp-p-modulus mp) (cl-mpm/particle::mp-strain-plastic-vm mp)
              (cl-mpm/particle::mp-strain-plastic-vm-inc mp) (cl-mpm/particle::mp-plastic-iterations mp))))))
(defparameter +permutations+ '((0 1 2) (0 2 1) (1 0 2) (1 2 0) (2 0 1) (2 1 0)))
(defun permute (values order) (map 'vector (lambda (i) (elt values i)) order))
(defun plastic-fixtures ()
  "Fresh compressive MC/Tresca returns and full native compliance; no old test execution."
  (let ((fixtures nil) (target 1d-6) (pressure 30000d0))
   (dolist (regime '(:drained :undrained))
    (let* ((law (if (eq regime :drained) (recipe::drained-law) (usd:make-strength-damage-law)))
           (e (if (eq regime :drained) 10773000d0 usd:+youngs-modulus-pa+))
           (nu (if (eq regime :drained) .33d0 usd:+poisson-ratio+))
           (g (/ e (* 2d0 (+ 1d0 nu)))))
     (dolist (j '(1d0 1.2d0))
      (dolist (branch '(:face :top-edge :bottom-edge))
        (let* ((c (nth-value 0 (mc:law-values law target)))
               (phi (nth-value 1 (mc:law-values law target)))
               (base (+ (* pressure (sin phi)) (* j c (cos phi))))
               (strength (/ base (ecase branch (:face 1d0) (:top-edge (- 1d0 (/ (sin phi) 3d0)))
                                                        (:bottom-edge (+ 1d0 (/ (sin phi) 3d0))))))
               (b (ecase branch
                    (:face (let ((a (* .5d0 (sqrt 3d0) target))) (vector a 0d0 (- a))))
                    (:top-edge (let ((a (* .5d0 target))) (vector a a (* -2d0 a))))
                    (:bottom-edge (let ((a (* .5d0 target))) (vector (* 2d0 a) (- a) (- a))))))
               (relative-tau (ecase branch (:face (vector strength 0d0 (- strength)))
                      (:top-edge (vector (* (/ 2d0 3d0) strength) (* (/ 2d0 3d0) strength) (* (/ -4d0 3d0) strength)))
                      (:bottom-edge (vector (* (/ 4d0 3d0) strength) (* (/ -2d0 3d0) strength) (* (/ -2d0 3d0) strength)))))
               (tau (map 'vector (lambda (s) (- s pressure)) relative-tau))
               (trial (map 'vector (lambda (s eps) (+ s (* 2d0 g eps))) tau b)))
          (dolist (order +permutations+)
            (push (obj "regime" (string-downcase regime) "e" e "nu" nu "j" j
                       "branch" (string-downcase branch) "permutation" (coerce order 'vector)
                       "trialKirchhoffPa" (permute trial order) "expectedKirchhoffPa" (permute tau order)
                       "expectedPlasticPrincipal" (permute b order) "expectedKappa" target) fixtures)))))))
    (coerce (nreverse fixtures) 'vector)))
(defun plastic-workload ()
  (let* ((fixtures (plastic-fixtures)) (particles (make-array 72)) (strains (make-array 72))
         (before-strains (make-array 72)) (answers (make-array 72)))
    (assert (= (length fixtures) 72))
    ;; All inputs are written before the first fresh native plastic call.
    (json "plastic-inputs-before.json" (obj "scope" "Synthetic independent native MP workload, not slope motion or old gate replay" "fixtures" fixtures))
    (dotimes (i 72)
      (setf (aref particles i) (if (string= (gethash "regime" (aref fixtures i)) "drained")
                                 (make-instance 'mc:particle-mc-evolution :E 10773000d0 :nu .33d0
                                   :evolution-law (recipe::drained-law) :enable-plasticity t)
                                 (make-instance 'usd:particle-urmi-strength-damage))
            (cl-mpm/particle::mp-unique-index (aref particles i)) i
            (magicl:tref (cl-mpm/particle:mp-deformation-gradient (aref particles i)) 0 0) (gethash "j" (aref fixtures i))
            (aref strains i) (native-compliance (gethash "trialKirchhoffPa" (aref fixtures i))
                               (gethash "e" (aref fixtures i)) (gethash "nu" (aref fixtures i)))
            (aref before-strains i) (copy-seq (cl-mpm/utils:fast-storage (aref strains i)))))
    (setf *stage* 3)
    (timed "seventy-two-native-plastic-points"
      (cl-mpm::iterate-over-mps particles
        (lambda (mp)
          (let ((id (cl-mpm/particle::mp-unique-index mp)))
            (setf (aref answers id) (copy-seq (cl-mpm/utils:fast-storage
              (cl-mpm/particle:constitutive-model mp (aref strains id) 1d-4))))))))
    (let ((results (make-array 72)))
      (dotimes (i 72)
        (let* ((mp (aref particles i)) (fixture (aref fixtures i)) (projection (mc:particle-last-projection mp))
               (stress-limit (+ mc::+stress-atol+ (* mc::+stress-rtol+ (max 1d0 (mc::max-abs3 (gethash "trialKirchhoffPa" fixture)))))))
          (assert (equalp (aref before-strains i) (cl-mpm/utils:fast-storage (aref strains i))))
          (near-vector (subseq (aref answers i) 0 3) (gethash "expectedKirchhoffPa" fixture) stress-limit)
          (near-vector (subseq (cl-mpm/utils:fast-storage (mc:particle-plastic-increment mp)) 0 3)
                       (gethash "expectedPlasticPrincipal" fixture) mc::+kappa-tol+)
          (near (mc:particle-kappa mp) (gethash "expectedKappa" fixture) mc::+kappa-tol+)
          (near (mc:particle-cohesion mp) (nth-value 0 (mc:law-values (mc:particle-evolution-law mp) (mc:particle-kappa mp))) stress-limit)
          (assert (every (lambda (residual) (and (mc::finite-real-p residual) (<= residual stress-limit))) (mc:projection-residuals projection)))
          (assert (> (mc:particle-kappa mp) 0d0))
          (setf (aref results i) (obj "id" i "answerKirchhoffPa" (aref answers i)
            "kappa" (mc:particle-kappa mp) "cohesionPa" (mc:particle-cohesion mp)
            "regime" (gethash "regime" fixture)
            "damageActive" (if (typep mp 'usd:particle-urmi-strength-damage) 1 0)
            "strengthDamage" (if (typep mp 'usd:particle-urmi-strength-damage) (usd:particle-strength-damage mp) 0d0)
            "workPa" (mc:particle-plastic-work mp)
            "volumePlastic" (mc:particle-plastic-volume mp) "maxResidualPa" (mc:projection-max-residual projection)
            "plasticIncrement" (copy-seq (cl-mpm/utils:fast-storage (mc:particle-plastic-increment mp)))
            "sixPlaneResidualsPa" (mc:projection-residuals projection) "nativeStressTolerancePa" stress-limit
            "active" (coerce (mc:projection-active projection) 'vector)
            "multipliers" (mc:projection-multipliers projection)))))
      (json "plastic-results.json" (obj "results" results))))
  (mark "seventy-two-new-drained-and-owned-native-plastic-points-worker-scheduling-and-readonly-input"))
(defun failure-workload ()
  (let* ((mp (make-instance 'mc:particle-mc-evolution :E 10773000d0 :nu .33d0
                :evolution-law (recipe::drained-law) :enable-plasticity t))
         (strain (native-compliance #(100000d0 100000d0 100000d0) 10773000d0 .33d0))
         (particles (vector mp))
         (before (progn (setf (cl-mpm/particle::mp-unique-index mp) 0) (tr:particle-signature mp)))
         (input (copy-seq (cl-mpm/utils:fast-storage strain))) (condition nil))
    (setf (cl-mpm/particle::mp-unique-index mp) 0 *stage* 4)
    (json "expected-rejection-input-before.json" (obj "scope" "NEW synthetic drained tensile/apex scope rejection, not actual full-run failure"
      "trialKirchhoffPa" #(100000d0 100000d0 100000d0) "j" 1d0 "e" 10773000d0 "nu" .33d0))
    (unwind-protect
        (handler-case (cl-mpm::iterate-over-mps particles
          (lambda (particle) (cl-mpm/particle:constitutive-model particle strain 1d-4)))
          (mc:material-integration-error (error) (setf condition error)))
      ;; Existing scheduler rethrows after its barrier; its exceptional nesting
      ;; flag is not a resume mechanism. Fresh pool only within this subprocess.
      (cl-mpm/utils:set-workers cl-user::*wb-workers*))
    (assert condition) (assert (hash-table-p (mc:integration-error-diagnostic condition)))
    (assert (equalp before (tr:particle-signature mp)))
    (assert (equalp input (cl-mpm/utils:fast-storage strain)))
    (json "expected-rejection-capsule.json" (obj "scope" "Captured unchanged native condition through custom worker error propagation; synthetic fixture; no replay"
      "reason" (mc:integration-error-reason condition) "diagnostic" (mc:integration-error-diagnostic condition)
      "mpUnchanged" t "inputUnchanged" t))
    (mark "native-synthetic-failure-capsule-propagates-and-particle-rolls-back")))
(defun run-benchmark ()
  (let* ((fw::*input-root* (merge-pathnames "source/inputs/" cl-user::*wb-directory*))
         (cl-mpm/framework/config::*schema-path* (merge-pathnames "studio/schema.json" fw::*input-root*))
         (fw:*simulation* nil) (case-path (merge-pathnames "cases/benchmarks/urmi-damage40.lisp" fw::*input-root*))
         (case nil) (config nil) (sim nil) (context nil) (count nil))
    (cl-user::snapshot-verify-file case-path) (load case-path)
    (setf case fw:*simulation* config (fw:compile-scenario :urmi-damage40 case))
    ;; Production compile contract/case/defaults remain worker1. Only this new
    ;; subprocess's execution pool is selected; no production runner call.
    (cl-mpm/utils:set-workers cl-user::*wb-workers*)
    (setf sim (timed "build-full-geometry" (recipe:build-slope (fw:simulation-material case) config))
          count (length (cl-mpm:sim-mps sim)) context (recipe:capture-reference sim config)
          *attempted* (make-array (list count 5) :element-type 'fixnum :initial-element 0)
          *accepted* (make-array (list count 5) :element-type 'fixnum :initial-element 0))
    (assert (= count 6714)) (assert (= cl-mpm/utils::*worker-count* cl-user::*wb-workers*))
    (assert (= (lparallel:kernel-worker-count) cl-user::*wb-workers*))
    (recipe::configure-output sim)
    (setf (gethash "physicalConfig" *observations*) config
          (gethash "materialReference" *observations*) (usd:strength-damage-reference)
          (gethash "particleCount" *observations*) count
          (gethash "actualCustomWorkers" *observations*) cl-mpm/utils::*worker-count*
          (gethash "actualLparallelWorkers" *observations*) (lparallel:kernel-worker-count))
    (mark "same-full-6714-geometry-and-physical-inputs-with-selected-execution-pool")
    (with-open-file (history (merge-pathnames "history.csv" cl-user::*wb-directory*) :direction :output :if-exists :error)
      (with-open-file (particles (merge-pathnames "material-state.csv" cl-user::*wb-directory*) :direction :output :if-exists :error)
       (with-open-file (extra (merge-pathnames "native-state-extra.csv" cl-user::*wb-directory*) :direction :output :if-exists :error)
        (format extra "frame,particle_id,~{~A~^,~},p_modulus_pa,native_eqp,native_eqp_increment,native_plastic_iterations~%"
          (loop for name in '("elastic_strain" "elastic_strain_n" "plastic_increment" "tau")
                append (loop for i below 6 collect (format nil "~A_~D" name i))))
        (recipe::write-headers history particles)
        (setf *stage* 0)
        (dotimes (i 2) (recipe::preparation-step sim config))
        (dotimes (block 2)
          (timed (format nil "drained-four-USF-block~D" block)
            (dotimes (i 4) (recipe::preparation-step sim config))))
        (recipe:save-state sim context config (merge-pathnames "drained.vtk" cl-user::*wb-directory*) 0 1 10 history particles)
        (extra-state sim 0 extra)
        (setf *stage* 1 (recipe::observation-context-preparation-updates context) 10)
        (let ((ledger (timed "clone-transfer" (tr:transfer! sim))))
          (recipe:rebind-reference-after-transfer sim context ledger))
        (setf *stage* 2 (cl-mpm:sim-damping-factor sim) 0d0 (cl-mpm:sim-gravity sim) (gethash "gravity" config))
        (flet ((step-once () (setf (cl-mpm:sim-dt sim) (recipe::stable-dt sim config)) (cl-mpm:update-sim sim)))
          (dotimes (i 2) (step-once))
          (dotimes (block 2) (timed (format nil "undrained-four-USF-block~D" block) (dotimes (i 4) (step-once)))))
        (recipe:save-state sim context config (merge-pathnames "undrained.vtk" cl-user::*wb-directory*) 1 3 20 history particles)
        (extra-state sim 1 extra))))
    (assert (= *updates* 20))
    (dotimes (id count)
      (dolist (stage '(0 1 2))
        (assert (= (aref *attempted* id stage) (aref *accepted* id stage) (if (= stage 1) 1 10)))))
    (setf (gethash "nativeTimeS" *observations*) (cl-mpm::sim-time sim)
          (gethash "dynamicTimeS" *observations*) (recipe::dynamic-time sim context))
    (mark "twenty-genuine-USF-updates-transfer-and-two-all-particle-VTK-CSV-states")
    (plastic-workload) (failure-workload)
    (dotimes (i 72) (assert (= (aref *attempted* i 3) (aref *accepted* i 3) 1)))
    (assert (= (aref *attempted* 0 4) 1)) (assert (= (aref *accepted* 0 4) 0))
    (assert (= (length *groups*) 4))
    t))
(handler-case (run-benchmark)
  (error (condition)
    (setf *failure* (princ-to-string condition))
    (when (typep condition 'mc:material-integration-error)
      (json "unexpected-material-failure.json" (obj "reason" (mc:integration-error-reason condition)
        "diagnostic" (mc:integration-error-diagnostic condition))))))
(json "result.json" (obj "passed" (if *failure* 'yason:false t) "workers" cl-user::*wb-workers*
  "passedGroups" (coerce (reverse *groups*) 'vector) "failure" (or *failure* "")
  "mpmUpdatesAccepted" *updates* "counters" (when *attempted* (counters))
  "timings" (coerce (reverse *times*) 'vector) "observations" *observations*
  "nativeBackend" (cl-user::snapshot-native-proof)
  "scope" "NEW source-frozen bounded worker experiment, not full60s slope, measured equilibrium, actual damage onset, old suite or scientific validation"
  "timingLimits" "Instrumented native-call per-ID counters shared by both counts; compilation/output/signature/correctness outside timed USF blocks; early MPM near elastic; plastic fixture measured separately; active simulation contention may bias speed; no guaranteed4x/ETA"))
(setf cl-user::*wb-exit* (if *failure* 1 0))
