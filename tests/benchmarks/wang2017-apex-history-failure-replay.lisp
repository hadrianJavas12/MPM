;;;; Replay ONE retained actual failure against the FAILED run's copied sources.
;;;; Output/source and capsule are prepared externally and SHA-256 verified first.
(in-package :cl-user)
(require :asdf)
(ql:quickload :yason :silent t)
(setf *read-default-float-format* 'double-float)
(defparameter *soil2-replay-directory*
  (uiop:ensure-directory-pathname (merge-pathnames (first (cl-mpm-script-args)))))
(load (merge-pathnames "source/scripts/lisp/native-source-snapshot.lisp" *soil2-replay-directory*))
(defparameter *soil2-replay-records*
  (with-open-file (stream (merge-pathnames "source/source-manifest.json" *soil2-replay-directory*))
    (coerce (gethash "files" (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)) 'list)))
(snapshot-require-fresh-runtime)
(defparameter *native-snapshot-context*
  (snapshot-register-native *soil2-replay-directory* *soil2-replay-records*))
(snapshot-check-plan "cl-mpm/settings")
(ql:quickload :cl-mpm/settings :silent t)
(setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
      '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
(dolist (system '("cl-mpm" "cl-mpm/models/wang2017-apex"))
  (snapshot-check-plan system) (ql:quickload system :silent t))
(write-case-source-provenance *soil2-replay-directory*
  (mapcar (lambda (row) (merge-pathnames (gethash "path" row) *soil2-replay-directory*)) *soil2-replay-records*) nil)
(rename-file (merge-pathnames "source-provenance.json" *soil2-replay-directory*)
             (merge-pathnames "source-provenance-before.json" *soil2-replay-directory*))

(defpackage :cl-mpm/tests/apex-history-failure-replay
  (:use :cl)
  (:local-nicknames (:point :cl-mpm/models/wang2017-point)
                    (:paper :cl-mpm/models/wang2017)
                    (:native :cl-mpm/models/wang2017-native)
                    (:apex :cl-mpm/models/wang2017-apex)))
(in-package :cl-mpm/tests/apex-history-failure-replay)
(defun object (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun json-boolean (value) (if value t 'yason:false))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*soil2-replay-directory*)
                          :direction :output :if-exists :error)
    (yason:encode value stream)))
(defun basis-array (rows)
  (let ((result (make-array '(3 3) :element-type 'double-float)))
    (dotimes (i 3 result) (dotimes (j 3) (setf (aref result i j) (elt (elt rows i) j))))))
(defparameter *capsule-path* (merge-pathnames "mc-integration-failure.json" cl-user::*soil2-replay-directory*))
(defparameter *capsule-sha-before* (cl-user::snapshot-sha256 *capsule-path*))
(defparameter *capsule* (with-open-file (stream *capsule-path*)
                        (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *replay-count* 0)
(defparameter *variant-dispatch-count* 0)
(defparameter *captured-projection* nil)
;; Capture the actual result inside the ONE production replay. No second
;; projection/constitutive call is made merely to recover the rejected result.
(defmethod native:project-point-variant :around ((variant (eql :composite-apex)) trial e nu j history basis)
  (incf *variant-dispatch-count*)
  (setf *captured-projection* (call-next-method)))
(defparameter *replay-condition*
  (handler-case
      (progn (incf *replay-count*) (native:replay-native-diagnostic *capsule*) nil)
    (mc-evolution:material-integration-error (condition) condition)))
(assert (= *replay-count* 1))
(assert (= *variant-dispatch-count* 1))
(assert *captured-projection*)
(assert *replay-condition*)
(assert (string= (gethash "reason" *capsule*) (mc-evolution:integration-error-reason *replay-condition*)))
(let* ((result *captured-projection*)
       (old-k (paper:paper-kps (gethash "committedPlasticTensor" *capsule*)))
       (new-k (point:paper-projection-kps result))
       (law (native:make-soil2-law))
       (old-values (multiple-value-list (mc-evolution:law-values law old-k)))
       (new-values (multiple-value-list (mc-evolution:law-values law new-k)))
       (plastic (point:paper-projection-plastic-increment result))
       (j (gethash "deformationJacobian" *capsule*)))
  (assert (< new-k (- old-k 1d-13)))
  (assert (and (>= old-k .02d0) (>= new-k .02d0)))
  (assert (equalp old-values new-values))
  (write-json "replay-result.json"
    (object "passed" t "actualCapsuleReplayCalls" *replay-count*
     "actualVariantDispatchCalls" *variant-dispatch-count* "physicalUpdates" 0
     "expectedRejection" t "materialVariant" (gethash "materialVariant" *capsule*)
     "reason" (mc-evolution:integration-error-reason *replay-condition*)
     "details" (prin1-to-string (mc-evolution:integration-error-details *replay-condition*))
     "oldKps" old-k "rotatedOldKps" (paper:paper-kps (gethash "rotatedPlasticTensor" *capsule*))
     "newKps" new-k "kpsChange" (- new-k old-k)
     "oldStrengthCohesionPhiPsi" (coerce old-values 'vector)
     "newStrengthCohesionPhiPsi" (coerce new-values 'vector)
     "strengthValuesExactlyUnchanged" t "bothOnResidualPlateau" t
     "projectionBranch" (string (point:paper-projection-branch result))
     "kirchhoffPrincipalPa" (point:paper-projection-tau result)
     "plasticPrincipalIncrement" plastic
     "plasticSpatialIncrement" (point:paper-projection-fixed-increment result)
     "newSignedPlasticTensor" (paper:history-tensor (point:paper-projection-history result))
     "apexVolumetricIncrement" (point:paper-projection-apex-multiplier result)
     "totalVolumetricIncrement" (reduce #'+ plastic)
     "independentJ2Increment" (mc-evolution::plastic-kappa-increment plastic)
     "plasticWorkKirchhoffPa" (point:paper-projection-work result)
     "plasticWorkCauchyProxyPa" (/ (point:paper-projection-work result) j)
     "maxYieldResidualPa" (point:paper-projection-max-residual result)
     "yieldResidualsPa" (point:paper-projection-residuals result)
     "multipliers" (point:paper-projection-multipliers result)
     "historyResidual" (point:paper-projection-history-residual result)
     "capsuleSha256" *capsule-sha-before*
     "rollback" (object "pureInputFileUnchanged" t
       "particleReplay" "NOT_EXECUTED: capsule has no full particle/kinematic state; one pure replay only"
       "nativeCommitOrdering" "Static failed-source review: guard precedes all material writes; outer transaction restores registered state on error"
       "scope" "Actual full-MPM rollback is not independently proven by this single material-input capsule"))))

(defun candidate-report (candidate old basis k branch tolerance)
  (unless candidate (return-from candidate-report (object "excluded" "Singular candidate")))
  (let* ((delta (point::fixed-increment (mc-evolution:projection-plastic-increment candidate) basis))
         (next (paper:advance-history old delta))
         (history-residual (- k (paper:history-kps next)))
         (tau (mc-evolution:projection-tau candidate)))
    (object "branch" branch "kps" k "kpsFromTensor" (paper:history-kps next)
     "unsquaredHistoryResidual" history-residual "historyChange" (- k (paper:history-kps old))
     "kirchhoffSortedPa" tau "plasticPrincipalIncrement" (mc-evolution:projection-plastic-increment candidate)
     "plasticSpatialIncrement" delta "multipliers" (mc-evolution:projection-multipliers candidate)
     "yieldResidualsPa" (mc-evolution:projection-residuals candidate)
     "maxYieldResidualPa" (mc-evolution:projection-max-residual candidate)
     "orderingHolds" (json-boolean (and (>= (aref tau 0) (- (aref tau 1) tolerance))
                                       (>= (aref tau 1) (- (aref tau 2) tolerance))))
     "plasticWorkKirchhoffPa" (mc-evolution:projection-work candidate)
     "productionAdmissible" (json-boolean (mc-evolution::admissible-candidate-p candidate history-residual tolerance)))))
(let* ((trial (gethash "trialKirchhoffPa" *capsule*))
       (e (gethash "youngsModulusPa" *capsule*)) (nu (gethash "poissonRatio" *capsule*))
       (j (gethash "deformationJacobian" *capsule*))
       (old (paper:make-paper-history (gethash "rotatedPlasticTensor" *capsule*)))
       (basis (basis-array (gethash "principalToSpatialBasis" *capsule*))))
  (multiple-value-bind (roots context) (point::%collect-paper-candidates trial e nu j old basis)
    (assert (not (getf context :elastic)))
    (let* ((sorted (getf context :sorted)) (sq (getf context :basis))
           (g (getf context :shear)) (bulk (getf context :bulk))
           (law (getf context :law)) (tol (getf context :tolerance))
           (apex (apex::%apex-candidate context)) (reports nil))
      (dolist (active mc-evolution::+active-bases+)
        (labels ((evaluate-at (k) (mc-evolution::fixed-kappa-candidate sorted g bulk j law 0d0 k active)))
          (let ((zero (evaluate-at 0d0)) (end (evaluate-at .02d0)))
            (if (not (and zero end))
                (push (object "active" (coerce active 'vector) "status" "SINGULAR_ACTIVE_LINEAR_SYSTEM") reports)
                (let* ((d0 (point::fixed-increment (mc-evolution:projection-plastic-increment zero) sq))
                       (d1 (point::fixed-increment (mc-evolution:projection-plastic-increment end) sq))
                       (a (point::tensor-dev (map 'vector #'+ (paper:history-tensor old) d0)))
                       (b (point::tensor-dev (map 'vector (lambda (x y) (/ (- x y) .02d0)) d1 d0)))
                       (qa (- 1d0 (* .5d0 (point::tensor-dot b b))))
                       (qb (- (point::tensor-dot a b))) (qc (* -.5d0 (point::tensor-dot a a)))
                       (coordinates (point::real-quadratic-roots qa qb qc))
                       (tail-k (paper:history-kps (paper:advance-history old d1))))
                  (push (object "active" (coerce active 'vector) "status" "ALL_QUADRATIC_ROOTS_AND_TAIL_EXAMINED"
                    "quadraticCoefficients" (vector qa qb qc)
                    "quadraticRoots" (map 'vector (lambda (k)
                      (object "kps" k "eligibleSofteningCoordinate" (json-boolean (<= 0d0 k .02d0))
                              "candidate" (when (>= k 0d0) (candidate-report (evaluate-at k) old sq k "softening" tol)))) coordinates)
                    "residualTailCoordinate" tail-k "residualTailEligible" (json-boolean (>= tail-k .02d0))
                    "residualTailCandidate" (when (>= tail-k .02d0) (candidate-report (evaluate-at tail-k) old sq tail-k "residual" tol))) reports))))))
      (write-json "candidate-admissibility.json"
        (object "scope" "Existing pure primitives only, separate diagnostic enumeration; no second production replay or constitutive call"
         "stressTolerancePa" tol "regularAdmissibleRootCount" (length roots)
         "regularRootSummaries" (map 'vector (lambda (r) (object "branch" (string (fifth r)) "kps" (mc-evolution:projection-kappa (first r)) "tau" (mc-evolution:projection-tau (first r)))) roots)
         "compositeApexCandidateExists" (json-boolean apex)
         "compositeApexSummary" (when apex (prin1-to-string (apex::%root-summary apex)))
         "apexPrincipalDelta" (when apex (mc-evolution:projection-plastic-increment (first apex)))
         "apexHistoryResidual" (when apex (fourth apex))
         "apexVolumetricIncrement" (when apex (sixth apex))
         "activeSetReports" (coerce (nreverse reports) 'vector))))))
(assert (string= *capsule-sha-before* (cl-user::snapshot-sha256 *capsule-path*)))
(dolist (row cl-user::*soil2-replay-records*)
  (cl-user::snapshot-verify-file (merge-pathnames (gethash "path" row) cl-user::*soil2-replay-directory*)))
(cl-user::write-case-source-provenance cl-user::*soil2-replay-directory*
 (mapcar (lambda (row) (merge-pathnames (gethash "path" row) cl-user::*soil2-replay-directory*)) cl-user::*soil2-replay-records*) nil)
(rename-file (merge-pathnames "source-provenance.json" cl-user::*soil2-replay-directory*)
             (merge-pathnames "source-provenance-after.json" cl-user::*soil2-replay-directory*))
(format t "~&COMPOSITE APEX ACTUAL HISTORY FAILURE: one replay, one variant dispatch, same residual strengths, zero MPM updates.~%")
(uiop:quit 0)
