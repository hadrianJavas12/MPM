;;;; Focused Windows native Soil2/output integration; exactly two real MPM updates.
;;;; windows\cl-mpm.cmd tests\benchmarks\wang2017-soil2-output.lisp output\FRESH
;;;; Optional second argument: composite-apex or composite-apex-residual (default strict).
;;;; The standard CLI helper freezes every selected project source/DLL BEFORE load.
(in-package :cl-user)
(require :asdf)
(defvar *soil2-output-frozen* nil)
(defvar *soil2-output-output* nil)
(defvar *soil2-output-exit* 1)
(defvar *soil2-output-variant* (or (second (cl-mpm-script-args)) "strict"))
(unless (member *soil2-output-variant* '("strict" "composite-apex" "composite-apex-residual") :test #'string=)
  (error "Expected strict, composite-apex or composite-apex-residual output control variant."))
;; Load in a separate top-level form so the helper's DEFVAR is established
;; BEFORE the following bootstrap form compiles its dynamic context binding.
(unless *soil2-output-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *soil2-output-frozen*
  (let* ((output (first (cl-mpm-script-args)))
         (directory (and output (uiop:ensure-directory-pathname (merge-pathnames output)))))
    (unless directory (error "Provide a fresh control output directory."))
    (when (and (probe-file directory)
               (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Control output already contains files: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (required '("source/materials/models/plastic/wang2017/native-package.lisp"
                          "source/materials/models/plastic/wang2017/transport.lisp"
                          "source/materials/models/plastic/wang2017/state.lisp"
                          "source/materials/models/plastic/wang2017/material.lisp"
                          "source/materials/models/plastic/wang2017/apex-package.lisp"
                          "source/materials/models/plastic/wang2017/apex-projection.lisp"
                          "source/materials/models/plastic/wang2017/apex-native.lisp"
                          "source/materials/models/plastic/wang2017/apex-residual-history.lisp"
                          "source/materials/models/plastic/mohr-coulomb-evolution/state.lisp"
                          "source/materials/adapters/wang2017.lisp"
                          "source/materials/adapters/wang2017-apex.lisp"
                          "source/scenarios/slope-descent/wang2017-output.lisp"
                          "source/cl-mpm.asd" "source/case.lisp"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required native source not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Copied before any first-party project load; case.lisp is this exact control source"
                                            "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*soil2-output-frozen* t) (*soil2-output-output* directory))
        (snapshot-check-plan "cl-mpm/settings")
        (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                             (snapshot-object "files" (coerce
                              (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory)
                                                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))
        (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
        (load (merge-pathnames "source/case.lisp" directory))
        (dolist (path copied) (snapshot-verify-file path))
        (write-case-source-provenance directory copied nil)
        (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                             (snapshot-object "files" (coerce
                              (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory)
                                                                     "sha256" (snapshot-sha256 path))) copied) 'vector))))))
  (uiop:quit *soil2-output-exit*))

(defpackage :cl-mpm/tests/wang2017-output
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework)
                    (:slope :cl-mpm/scenario/slope-descent)
                    (:native :cl-mpm/models/wang2017-native)
                    (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/wang2017-output)
(defvar *passed* nil)
(defvar *failure* nil)
(defvar *updates* 0)
(defvar *observations* (make-hash-table :test #'equal))
(defparameter *labels*
  '("Dedicated diagnostic adapter and unambiguous fields"
    "Initial native VTK and CSV do not mutate material or kinematics"
    "Two genuine bounded native USF updates and second read-only state"
    "Material CSV reconstructs full F/J, paper Ep/kps, cohesion and rotation"
    "Contact CSV reconstructs surface descent, gap and geometric spring energy"
    "Reader ownership and repeated diagnostic access preserve state"
    "Soil1 output helper is a filesystem no-op"
    "Duplicate frame, mixed material and invalid audit state reject honestly"))

(defmacro control (label &body body)
  `(handler-case
       (progn ,@body (push ,label *passed*) (format t "~&PASS: ~A~%" ,label))
     (error (condition)
       (setf *failure* (list ,label (princ-to-string condition)))
       (format t "~&FAIL: ~A: ~A~%" ,label condition)
       (return-from run-controls nil))))

(defun near (actual expected &optional (tolerance 1d-12))
  (unless (and (slope::finite-p actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G, got ~,17G (tolerance ~G)." expected actual tolerance)))

(defun fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value))
               (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value)) (fingerprint (cdr value))))
        ((arrayp value)
         (list :array (array-dimensions value)
               (loop for i below (array-total-size value)
                     collect (fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
               (loop for slot in (sb-mop:class-slots (class-of value))
                     for name = (sb-mop:slot-definition-name slot)
                     collect (list name (fingerprint (slot-value value name))))))
        (t (error "Unexpected snapshot value ~S." (type-of value)))))

(defun state-fingerprint (sim)
  (loop for mp across (cl-mpm:sim-mps sim)
        collect (list (fingerprint (native:snapshot-particle mp))
                      (fingerprint (cl-mpm/particle:mp-position mp))
                      (fingerprint (cl-mpm/particle:mp-velocity mp))
                      (fingerprint (cl-mpm/particle::mp-acceleration mp))
                      (cl-mpm/particle:mp-mass mp))))

(defun small-case (&optional (soil2 t))
  (fw:make-simulation
   :scenario :slope-descent
   :material (fw:make-material
              :native :youngs-modulus 20d6 :poisson-ratio .25d0
              :density (/ 20000d0 9.80665d0)
              :particle-class (cond ((not soil2) 'mc:particle-mc-evolution)
                                    ((string= cl-user::*soil2-output-variant* "composite-apex-residual")
                                     'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex-residual)
                                    ((string= cl-user::*soil2-output-variant* "composite-apex")
                                     'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex)
                                    (t 'native:particle-wang2017-soil2))
              :initargs (list :evolution-law
                             (cond
                               ((and soil2 (string= cl-user::*soil2-output-variant* "composite-apex-residual"))
                                (cl-mpm/models/wang2017-apex:make-soil2-apex-residual-law))
                               ((and soil2 (string= cl-user::*soil2-output-variant* "composite-apex"))
                                (cl-mpm/models/wang2017-apex:make-soil2-apex-law))
                               (soil2 (native:make-soil2-law))
                               (t (mc:make-evolution-law :variant :perfect
                                  :points '((0d0 35d0)) :cohesion 30000d0 :psi 0d0
                                  :stress-measure :cauchy
                                  :strain-assumption "Declared constant-strength Soil1 fixture; no evolving history coordinate fitted")))))
   :geometry (fw:make-geometry :slope :width 4d0 :height 1d0 :base-height 1d0
                              :crest-length 2d0 :slope 60d0)
   :boundary (fw:make-boundary :rollers)
   :loading (fw:make-loading :prescribed-descent :velocity .01d0
                            :target-displacement 2d-7 :patch-start .5d0 :patch-length 1d0)
   :solver (fw:make-solver :explicit :mesh-size 1d0 :mps-per-cell 2
                          :workers 1 :time-step-scale .2d0 :frames 2 :max-updates 2)))

(defun setup (recipe)
  (let* ((material (fw:simulation-material recipe))
         (config (slope:compile-configuration recipe)))
    (multiple-value-bind (sim top-row) (slope:make-slope material config)
      (let ((intervals (make-hash-table :test #'eq)))
        (map nil (lambda (mp)
                   (let ((x (slope::component (cl-mpm/particle:mp-position mp) 0))
                         (half (* .5d0 (slope::component (cl-mpm/particle::mp-domain-size mp) 0))))
                     (setf (gethash mp intervals) (cons (- x half) (+ x half))))) top-row)
        (let ((bc (slope:make-strip top-row config intervals)))
          (cl-mpm:add-bcs-force-list sim (vector bc))
          (setf (cl-mpm:sim-damping-factor sim) 0d0)
          (values sim bc config (fw:material-diagnostics material)))))))

(defun csv (path)
  (with-open-file (stream path)
    (let ((header (uiop:split-string (read-line stream) :separator ",")))
      (values header
              (loop for line = (read-line stream nil nil) while line
                    collect (mapcar (lambda (value)
                                      (let ((*read-eval* nil)) (read-from-string value)))
                                    (uiop:split-string line :separator ",")))))))
(defun value (header row key)
  (let ((index (position key header :test #'string=)))
    (unless index (error "Missing CSV field ~A." key))
    (nth index row)))
(defun det3 (a)
  (+ (* (aref a 0 0) (- (* (aref a 1 1) (aref a 2 2)) (* (aref a 1 2) (aref a 2 1))))
     (- (* (aref a 0 1) (- (* (aref a 1 0) (aref a 2 2)) (* (aref a 1 2) (aref a 2 0)))))
     (* (aref a 0 2) (- (* (aref a 1 0) (aref a 2 1)) (* (aref a 1 1) (aref a 2 0))))))
(defun matrix-from-row (header row prefix)
  (let ((matrix (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3)
      (setf (aref matrix i j) (value header row (format nil "~A~D~D" prefix i j))))) matrix))
(defun reconstructed-kps (v)
  (let ((mean (/ (+ (elt v 0) (elt v 1) (elt v 2)) 3d0)))
    (sqrt (* .5d0 (+ (loop for i below 3 sum (expt (- (elt v i) mean) 2))
                      (* 2d0 (loop for i from 3 below 6 sum (expt (elt v i) 2))))))))
(defun rejected-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))

(defun run-controls (directory)
  (cl-mpm/utils:set-workers 1)
  (let* ((recipe (small-case))
         (output (merge-pathnames "observations/" directory))
         (vtk (merge-pathnames "vtk/" output)))
    (ensure-directories-exist vtk)
    (multiple-value-bind (sim bc config adapter) (setup recipe)
      (let* ((count (length (cl-mpm:sim-mps sim)))
             (context (slope::make-wang2017-audit-context sim bc))
             (soil1-for-negative nil)
             (mass0 (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass))
             (start-positions (map 'vector (lambda (mp) (cl-mpm/utils:vector-copy
                                                        (cl-mpm/particle:mp-position mp)))
                                  (cl-mpm:sim-mps sim))))
        (setf (gethash "particleCount" *observations*) count
              (gethash "contactCount" *observations*) (length (slope:strip-contacts bc))
              (gethash "massKgPerM" *observations*) mass0
              (gethash "config" *observations*) config)
        (control (first *labels*)
          (assert (typep adapter 'fw::wang2017-material-diagnostics))
          (let ((names (mapcar #'first (fw:diagnostics-fields adapter))))
            (assert (= (length names) (length (remove-duplicates names :test #'equal))))
            (assert (member "wang-paper-kps" names :test #'equal))
            (assert (not (member "mc-kappa" names :test #'equal))))
          (fw:validate-material-diagnostics adapter (cl-mpm:sim-mps sim) "mpm")
          (fw:configure-material-output adapter sim)
          (assert (< 0 count 40)))
        (control (second *labels*)
          (let ((before (state-fingerprint sim)))
            (cl-mpm/output:save-vtk (merge-pathnames "particles_0000.vtk" vtk) sim)
            (slope::write-wang2017-frame-audit output sim bc 0 0d0 0d0 context)
            (assert (equalp before (state-fingerprint sim)))))
        (control (third *labels*)
          (assert (< 1d-5 (slope::stable-dt sim config)))
          (dotimes (i 2)
            (setf (cl-mpm:sim-dt sim) 1d-5
                  (slope:strip-target bc) (* .01d0 (* (1+ i) 1d-5)))
            (cl-mpm:update-sim sim) (incf *updates*))
          (near (cl-mpm::sim-time sim) 2d-5 1d-18)
          (let ((before (state-fingerprint sim)))
            (cl-mpm/output:save-vtk (merge-pathnames "particles_0001.vtk" vtk) sim)
            (slope::write-wang2017-frame-audit output sim bc 1 (cl-mpm::sim-time sim)
                                              (slope:strip-target bc) context)
            (assert (equalp before (state-fingerprint sim))))
          (let ((movement (loop for mp across (cl-mpm:sim-mps sim) for origin across start-positions
                                maximize (loop for axis below 3 maximize
                                           (abs (- (slope::component (cl-mpm/particle:mp-position mp) axis)
                                                   (slope::component origin axis)))))))
            (assert (> movement 0d0)) (setf (gethash "maxPositionChangeM" *observations*) movement))
          (near (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass) mass0 1d-10))
        (control (fourth *labels*)
          (multiple-value-bind (header rows) (csv (merge-pathnames "wang2017-material-history.csv" output))
            (assert (= (length rows) (* 2 count)))
            (when (member cl-user::*soil2-output-variant* '("composite-apex" "composite-apex-residual") :test #'string=)
              (dolist (name '("wang-apex-active" "wang-plastic-volume"
                              "wang-plastic-volume-increment" "wang-Ep-trace"))
                (assert (member name header :test #'string=)))
              (dolist (row rows)
                (near (value header row "wang-Ep-trace")
                      (+ (value header row "wang-Ep-xx") (value header row "wang-Ep-yy")
                         (value header row "wang-Ep-zz")))
                (near (value header row "wang-Ep-trace") (value header row "wang-plastic-volume"))))
            (let ((ids0 nil) (ids1 nil) (max-j-error 0d0) (max-ep-error 0d0) (f-changed nil))
              (dolist (row rows)
                (assert (every #'slope::finite-p row))
                (if (zerop (value header row "frame"))
                    (push (value header row "particle_id") ids0)
                    (push (value header row "particle_id") ids1))
                (let* ((f (matrix-from-row header row "wang-F-"))
                       (r (matrix-from-row header row "wang-R-"))
                       (j (det3 f))
                       (ep (mapcar (lambda (suffix) (value header row (concatenate 'string "wang-Ep-" suffix)))
                                   '("xx" "yy" "zz" "yz" "zx" "xy")))
                       (k (reconstructed-kps ep)))
                  (assert (> j 0d0))
                  (setf max-j-error (max max-j-error (abs (- j (value header row "wang-det-f"))))
                        max-ep-error (max max-ep-error (abs (- k (value header row "wang-paper-kps")))))
                  (near j (value header row "wang-det-f"))
                  (near k (value header row "wang-paper-kps"))
                  (near (value header row "wang-cohesion-pa")
                        (if (>= k .02d0) 15000d0 (- 30000d0 (* 750000d0 k))) 1d-8)
                  (near (det3 r) 1d0 1d-10)
                  (dotimes (i 3) (dotimes (j 3)
                    (near (loop for a below 3 sum (* (aref r a i) (aref r a j)))
                          (if (= i j) 1d0 0d0) 1d-10)
                    (when (/= (aref f i j) (if (= i j) 1d0 0d0)) (setf f-changed t))))))
              (assert (= (length (remove-duplicates ids0)) count))
              (assert (equal (sort ids0 #'<) (sort ids1 #'<)))
              (assert f-changed)
              (setf (gethash "materialCsvRows" *observations*) (length rows)
                    (gethash "maxJReadbackResidual" *observations*) max-j-error
                    (gethash "maxPaperInvariantReadbackResidual" *observations*) max-ep-error
                    (gethash "nonidentityActualDeformationRecorded" *observations*) t))))
        (control (fifth *labels*)
          (multiple-value-bind (header rows) (csv (merge-pathnames "wang2017-contact-history.csv" output))
            (assert (= (length rows) (* 2 (length (slope:strip-contacts bc)))))
            (let ((sum 0d0) (area 0d0) (largest 0d0) (max-identity 0d0))
              (dolist (row rows)
                (assert (every #'slope::finite-p row))
                (let* ((centre (- (value header row "loading_origin_centre_y_m") (value header row "centre_y_m")))
                       (half (- (value header row "loading_origin_half_height_m") (value header row "half_height_m")))
                       (surface (+ centre half))
                       (command (value header row "commanded_settlement_m"))
                       (gap (- command surface)) (width (value header row "overlap_width_m")))
                  (setf max-identity (max max-identity (abs (- surface (value header row "top_surface_descent_m")))))
                  (near surface (value header row "top_surface_descent_m"))
                  (near gap (value header row "geometric_gap_m"))
                  (near (value header row "geometric_spring_energy_J_per_m")
                        (* .5d0 (value header row "spring_stiffness_N_per_m2") gap gap))
                  (when (= 1 (value header row "frame"))
                    (incf sum (* width surface)) (incf area width) (setf largest (max largest (abs gap))))))
              (multiple-value-bind (mean max-gap rms-gap) (slope:strip-measurements bc)
                (declare (ignore rms-gap)) (near (/ sum area) mean) (near largest max-gap))
              (setf (gethash "contactCsvRows" *observations*) (length rows)
                    (gethash "maxSurfaceGeometryIdentityResidualM" *observations*) max-identity))))
        (control (sixth *labels*)
          (let* ((mp (aref (cl-mpm:sim-mps sim) 0))
                 (before (state-fingerprint sim)) (ep (native:particle-paper-tensor mp))
                 (r (native:particle-rotation mp)))
            (incf (aref ep 0) 1d0) (incf (magicl:tref r 0 0) 1d0)
            (dotimes (i 2)
              (map nil (lambda (particle) (fw:material-state adapter particle)) (cl-mpm:sim-mps sim)))
            (assert (equalp before (state-fingerprint sim)))))
        (control (seventh *labels*)
          (multiple-value-bind (soil1 soil1-bc) (setup (small-case nil))
            (setf soil1-for-negative soil1)
            (assert (null (slope::make-wang2017-audit-context soil1 soil1-bc)))
            (let ((unused (merge-pathnames "soil1-no-op/" directory)))
              (assert (not (probe-file unused)))
              (assert (null (slope::write-wang2017-frame-audit unused soil1 soil1-bc 0 0d0 0d0 nil)))
              (assert (not (probe-file unused))))))
            (control (eighth *labels*)
              (let* ((file (merge-pathnames "wang2017-material-history.csv" output))
                     (before (cl-user::snapshot-sha256 file)))
                (assert (rejected-p (lambda () (slope::write-wang2017-frame-audit
                                                output sim bc 1 2d-5 2d-7 context))))
                (assert (string= before (cl-user::snapshot-sha256 file))))
              (let ((mixed (cl-mpm/setup:make-simple-sim 1d0 '(2 2)
                              :sim-type 'slope::slope-sim)))
                (setf (cl-mpm:sim-mps mixed)
                      (vector (aref (cl-mpm:sim-mps sim) 0) (aref (cl-mpm:sim-mps soil1-for-negative) 0)))
                (assert (rejected-p (lambda () (slope::make-wang2017-audit-context mixed bc)))))
              (when (member cl-user::*soil2-output-variant* '("composite-apex" "composite-apex-residual") :test #'string=)
                (let ((mixed (cl-mpm/setup:make-simple-sim 1d0 '(2 2) :sim-type 'slope::slope-sim)))
                  (setf (cl-mpm:sim-mps mixed)
                        (vector (aref (cl-mpm:sim-mps sim) 0)
                                (make-instance 'native:particle-wang2017-soil2)))
                  (assert (rejected-p (lambda () (slope::make-wang2017-audit-context mixed bc))))))
              (let ((isolated (make-instance 'native:particle-wang2017-soil2)))
                (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient isolated) 0 0) -1d0)
                (assert (rejected-p (lambda () (fw::validate-wang2017-audit-particle isolated))))
                (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient isolated) 0 0) 1d0
                      (mc:particle-kappa isolated) .001d0)
                (assert (rejected-p (lambda () (fw::validate-wang2017-audit-particle isolated))))))))))

(run-controls cl-user::*soil2-output-output*)
(let ((report (make-hash-table :test #'equal)))
  (setf (gethash "passed" report) (if (null *failure*) t 'yason:false)
        (gethash "materialVariant" report) cl-user::*soil2-output-variant*
        (gethash "passedCount" report) (length *passed*)
        (gethash "failedCount" report) (if *failure* 1 0)
        (gethash "notRunCount" report) (- (length *labels*) (length *passed*) (if *failure* 1 0))
        (gethash "passedControls" report) (coerce (reverse *passed*) 'vector)
        (gethash "failure" report) (and *failure* (coerce *failure* 'vector))
        (gethash "physicalUpdatesExecuted" report) *updates*
        (gethash "intendedSavedStates" report) 2
        (gethash "actualSavedStates" report)
        (length (directory (merge-pathnames "observations/vtk/particles_*.vtk" cl-user::*soil2-output-output*)))
        (gethash "observations" report) *observations*
        (gethash "scope" report) "Bounded microgeometry MPM/output integration, no gravity equilibration and no plastic-flow/landslide/paper validation claim; existing material-point controls own plastic-path verification")
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*soil2-output-output*)
                          :direction :output :if-exists :error)
    (yason:encode report stream))
  (setf cl-user::*soil2-output-exit* (if *failure* 1 0)))
