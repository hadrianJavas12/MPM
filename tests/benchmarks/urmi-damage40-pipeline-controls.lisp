;;;; FIRST owned point controls only; no MPM, old suites or physical validation.
;;;; windows\cl-mpm.cmd tests\benchmarks\urmi-damage40-pipeline-controls.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *up-frozen* nil) (defvar *up-directory* nil) (defvar *up-exit* 1)
(unless *up-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *up-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide fresh point-control output."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve existing point evidence."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (relative '("research/notes/urmi-mc-damage40-2026-10-26/recipe-plan.md"
                          "cases/benchmarks/urmi-damage40.lisp"))
        (let* ((from (cl-mpm-path relative)) (to (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
               (bytes (case-source-bytes from)))
          (ensure-directories-exist to) (uiop:copy-file from to)
          (assert (equalp bytes (case-source-bytes to))) (push to copied)
          (push (snapshot-object "path" (enough-namestring to directory) "originalPath" (namestring (truename from))
                 "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (dolist (required '("source/materials/models/plastic/urmi-strength-damage/package.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/law.lisp"
                          "source/materials/models/plastic/urmi-strength-damage/particle.lisp"
                          "source/scenarios/urmi-damage40/package.lisp"
                          "source/scenarios/urmi-damage40/transfer.lisp"
                          "source/scenarios/urmi-damage40/runner.lisp"
                          "source/inputs/studio/reference/urmi-damage40.json"
                          "source/inputs/cases/benchmarks/urmi-damage40.lisp"))
        (assert (find required records :key (lambda (row) (gethash "path" row)) :test #'string=)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "New optional S1 bounded native pipeline controls and recipe plan; all selected first-party/DLL bytes frozen before load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*up-frozen* t) (*up-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/urmi-damage40"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory) "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *up-exit*))

(defpackage :cl-mpm/tests/urmi-pipeline
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:mc :cl-mpm/models/mc-evolution)
                    (:usd :cl-mpm/models/urmi-strength-damage)
                    (:tr :cl-mpm/scenario/urmi-damage40/transfer)
                    (:recipe :cl-mpm/scenario/urmi-damage40)))
(in-package :cl-mpm/tests/urmi-pipeline)
(defvar *passed* nil) (defvar *failures* nil) (defvar *stage* nil)
(defvar *updates* 0) (defvar *attempted* (make-hash-table)) (defvar *accepted* (make-hash-table))
(defvar *observations* (make-hash-table :test #'equal))
(defvar *timings* (make-hash-table :test #'equal))
(defmacro timed (name &body body)
  `(let ((started (get-internal-real-time)))
     (unwind-protect (progn ,@body)
       (incf (gethash ,name *timings* 0d0)
             (/ (- (get-internal-real-time) started) (float internal-time-units-per-second 1d0))))))
(defmethod cl-mpm:update-sim :around ((sim recipe:urmi-damage40-sim))
  (multiple-value-prog1 (call-next-method) (incf *updates*)))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (declare (ignore strain))
  (assert (member *stage* '(:drained :transfer :undrained)))
  (when (eq *stage* :transfer) (assert (zerop dt)))
  (incf (gethash *stage* *attempted* 0))
  (multiple-value-prog1 (call-next-method) (incf (gethash *stage* *accepted* 0))))
(defmacro control (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (push (list ,name (princ-to-string condition)) *failures*)
       (format t "~&FAIL: ~A: ~A~%" ,name condition))))
(defun near (a b &optional (tolerance 1d-10))
  (assert (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tolerance))))
(defun bytes-contain-p (path text)
  (search (map '(vector (unsigned-byte 8)) #'char-code text) (cl-user::case-source-bytes path)))
(defun signature (sim) (map 'vector #'tr:particle-signature (cl-mpm:sim-mps sim)))
(defun save-observation (sim context config path frame phase updates history particles)
  (let ((before (signature sim)))
    (timed "output" (recipe:save-state sim context config path frame phase updates history particles))
    (assert (equalp before (signature sim)))))
(defun force-fixture ()
  (let* ((sim (cl-mpm/setup:make-simple-sim .5d0 '(2 2) :sim-type 'recipe:urmi-damage40-sim))
         (nodes (cl-mpm/mesh::mesh-nodes (cl-mpm:sim-mesh sim)))
         (a (row-major-aref nodes 0)) (b (row-major-aref nodes 1)))
    (dotimes (i (array-total-size nodes)) (setf (cl-mpm/mesh:node-active (row-major-aref nodes i)) nil))
    (setf (cl-mpm/mesh:node-active a) t (cl-mpm/mesh:node-active b) t
          (cl-mpm/mesh:node-mass a) 2d0 (cl-mpm/mesh:node-mass b) 3d0
          (cl-mpm/mesh::node-bcs a) (cl-mpm/utils:vector-from-list '(0d0 1d0 0d0))
          (cl-mpm/mesh::node-bcs b) (cl-mpm/utils:vector-from-list '(1d0 0d0 0d0))
          (cl-mpm/mesh::node-external-force a) (cl-mpm/utils:vector-from-list '(1d9 4d0 0d0))
          (cl-mpm/mesh::node-internal-force a) (cl-mpm/utils:vector-from-list '(1d9 -3d0 0d0))
          (cl-mpm/mesh::node-external-force b) (cl-mpm/utils:vector-from-list '(12d0 1d9 0d0))
          (cl-mpm/mesh::node-internal-force b) (cl-mpm/utils:vector-from-list '(-5d0 1d9 0d0))
          (cl-mpm/mesh:node-velocity a) (cl-mpm/utils:vector-from-list '(999d0 2d0 999d0))
          (cl-mpm/mesh:node-velocity b) (cl-mpm/utils:vector-from-list '(3d0 999d0 999d0)))
    (multiple-value-bind (rf numerator denominator) (recipe:force-measures sim)
      (near numerator 50d0 0d0) (near denominator 160d0 0d0) (near rf (sqrt (/ 50d0 160d0))))
    (multiple-value-bind (ke mass) (recipe:kinetic-measures sim) (near ke 17.5d0 0d0) (near mass 5d0 0d0))
    (setf (magicl:tref (cl-mpm/mesh::node-external-force a) 1 0) 0d0
          (magicl:tref (cl-mpm/mesh::node-external-force b) 0 0) 0d0)
    (assert (null (recipe:force-measures sim)))
    (assert (> (recipe::force-numerator2 sim) 0d0))))
(defun controls ()
  (let* ((fw::*input-root* (merge-pathnames "source/inputs/" cl-user::*up-directory*))
         (cl-mpm/framework/config::*schema-path* (merge-pathnames "studio/schema.json" fw::*input-root*))
         (fw:*simulation* nil) (case-path (merge-pathnames "cases/benchmarks/urmi-damage40.lisp" fw::*input-root*))
         (case nil) (config nil) (sim nil) (context nil) (count 0) (ledger nil))
    (cl-user::snapshot-verify-file case-path) (load case-path)
    (setf case fw:*simulation* config (fw:compile-scenario :urmi-damage40 case))
    (control "serial-masked-force-and-KE-with-zero-denominator-ineligible"
      (force-fixture))
    (control "actual-native-full-case-geometry-and-active-soil-foundation"
      (cl-mpm/utils:set-workers 1)
      (setf sim (timed "build" (recipe:build-slope (fw:simulation-material case) config))
            context (recipe:capture-reference sim config) count (length (cl-mpm:sim-mps sim)))
      (recipe::configure-output sim)
      (near (recipe:surface-height config 12d0) 14d0)
      (near (recipe:surface-height config (+ 12d0 (/ 10d0 (tan (* pi (/ 40d0 180d0)))))) 4d0)
      (let ((expected (loop for ix below 240 sum (loop for iy below 56
             for x = (* .25d0 (+ ix .5d0)) for y = (* .25d0 (+ iy .5d0))
             count (<= y (+ 4d0 (max 0d0 (- 10d0 (* (tan (* pi (/ 40d0 180d0))) (max 0d0 (- x 12d0)))))))))))
        (assert (= count expected)))
      (assert (= (count-if (lambda (mp) (< (recipe::component (cl-mpm/particle:mp-position mp) 1) 4d0)) (cl-mpm:sim-mps sim)) 3840))
      (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
        (assert (eq (class-name (class-of mp)) 'mc:particle-mc-evolution))
        (assert (cl-mpm/particle::mp-enable-plasticity mp))
        (assert (= (cl-mpm/particle::mp-unique-index mp) id))
        (near (mc:particle-cohesion mp) 3700d0 0d0)
        (assert (<= (recipe::component (cl-mpm/particle:mp-position mp) 1)
                    (recipe:surface-height config (recipe::component (cl-mpm/particle:mp-position mp) 0)))))
      (recipe::audit-state sim context config)
      (setf (gethash "particleCount" *observations*) count
            (gethash "foundationParticleCount" *observations*) 3840
            (gethash "massKgPerM" *observations*) (loop for mp across (cl-mpm:sim-mps sim) sum (cl-mpm/particle:mp-mass mp))
            (gethash "drainedStableDtS" *observations*) (recipe::stable-dt sim config)))
    (control "two-drained-plus-transfer-plus-two-undrained-native-updates-and-three-VTK"
      (let ((history-path (merge-pathnames "history.csv" cl-user::*up-directory*))
            (particle-path (merge-pathnames "material-state.csv" cl-user::*up-directory*)))
        (with-open-file (history history-path :direction :output :if-exists :error)
          (with-open-file (particles particle-path :direction :output :if-exists :error)
            (recipe::write-headers history particles)
            (save-observation sim context config (merge-pathnames "particles_0000.vtk" cl-user::*up-directory*) 0 0 0 history particles)
            (setf *stage* :drained)
            (timed "twoDrainedUsf" (dotimes (i 2) (recipe::preparation-step sim config)))
            (save-observation sim context config (merge-pathnames "particles_0001.vtk" cl-user::*up-directory*) 1 1 2 history particles)
            (setf *stage* :transfer (recipe::observation-context-preparation-updates context) 2)
            (let ((clock (cl-mpm::sim-time sim)))
              (setf ledger (timed "cloneTransfer" (tr:transfer! sim))) (near (cl-mpm::sim-time sim) clock 0d0))
            (recipe:rebind-reference-after-transfer sim context ledger)
            (setf (gethash "undrainedStableDtS" *observations*) (recipe::stable-dt sim config))
            (setf *stage* :undrained (cl-mpm:sim-damping-factor sim) 0d0
                  (cl-mpm:sim-gravity sim) (gethash "gravity" config))
            (timed "twoUndrainedUsf" (dotimes (i 2)
              (setf (cl-mpm:sim-dt sim) (recipe::stable-dt sim config)) (cl-mpm:update-sim sim)))
            (save-observation sim context config (merge-pathnames "particles_0002.vtk" cl-user::*up-directory*) 2 3 4 history particles)))
        (assert (= *updates* 4))
        (dolist (stage '(:drained :transfer :undrained))
          (assert (= (gethash stage *attempted*) (gethash stage *accepted*) (* count (if (eq stage :transfer) 1 2)))))
        (loop for mp across (cl-mpm:sim-mps sim) do
          (assert (typep mp 'usd:particle-urmi-strength-damage))
          (assert (cl-mpm/particle::mp-enable-plasticity mp))
          (near (usd:particle-strength-damage mp) (- 1d0 (/ (mc:particle-cohesion mp) 40500d0))))
        (dotimes (i 3)
          (let ((path (merge-pathnames (format nil "particles_~4,'0D.vtk" i) cl-user::*up-directory*)))
            (dolist (name '("mc-strength-damage" "mc-damage-active" "mc-kappa-origin" "mc-logical-id"))
              (assert (bytes-contain-p path (format nil "SCALARS ~A " name))))))
        (with-open-file (stream history-path)
          (let ((lines (loop for line = (read-line stream nil) while line collect line))) (assert (= (length lines) 4))))
        (with-open-file (stream particle-path)
          (let ((lines 0)) (loop while (read-line stream nil) do (incf lines)) (assert (= lines (1+ (* 3 count))))))
        (setf (gethash "ledger" *observations*) ledger
              (gethash "nativeTimeS" *observations*) (cl-mpm::sim-time sim)
              (gethash "dynamicTimeS" *observations*) (recipe::dynamic-time sim context))))
    (control "readonly-frame-audit-output-and-current-global-reference-volume"
      (let ((before (signature sim)))
        (recipe::audit-state sim context config)
        (assert (equalp before (signature sim))))
      (assert (= (length *passed*) 3)))
    (assert (= *updates* 4))
    (assert (= (length *passed*) 4))
    t))
(handler-case (controls)
  (error (condition) (push (list "harness" (princ-to-string condition)) *failures*)))
(with-open-file (stream (merge-pathnames "result.json" cl-user::*up-directory*) :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object "passed" (if *failures* 'yason:false t)
    "passedGroups" (coerce (reverse *passed*) 'vector)
    "failures" (coerce (mapcar (lambda (x) (coerce x 'vector)) (reverse *failures*)) 'vector)
    "nativeMpmUpdatesAccepted" *updates* "drainedConstitutiveAttempted" (gethash :drained *attempted* 0)
    "drainedConstitutiveAccepted" (gethash :drained *accepted* 0)
    "instantaneousTransferConstitutiveAttempted" (gethash :transfer *attempted* 0)
    "instantaneousTransferConstitutiveAccepted" (gethash :transfer *accepted* 0)
    "undrainedConstitutiveAttempted" (gethash :undrained *attempted* 0)
    "undrainedConstitutiveAccepted" (gethash :undrained *accepted* 0)
    "stageElapsedRealSeconds" *timings*
    "timingScope" "Build and actual two-step drained/undrained USF/clone transfer/output intervals; excludes compilation and before/after output-signature guards; not a long-run ETA"
    "observations" *observations* "nativeBackend" (cl-user::snapshot-native-proof)
    "scope" "FIRST bounded full-geometry path gate only: two drained USF updates, actual clone transfer, two undrained USF updates, three unique VTK states, real numeric CSV; NOT elastic/plastic equilibrium, damage onset, completed60s, prior suite or scientific validation") stream))
(setf cl-user::*up-exit* (if *failures* 1 0))


