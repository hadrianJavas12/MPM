;;;; Replay ONE retained actual failure against the FAILED run's copied sources.
;;;; Output/source and capsule are prepared externally and SHA-256 verified first.
(in-package :cl-user)
(require :asdf)
(ql:quickload :yason :silent t)
(setf *read-default-float-format* 'double-float)
(defparameter *soil2-replay-directory*
  (uiop:ensure-directory-pathname (merge-pathnames (first (cl-mpm-script-args)))))
(load (merge-pathnames "source/scripts/lisp/native-source-snapshot.lisp" *soil2-replay-directory*))
(defparameter *soil2-replay-records*
  (with-open-file (stream (merge-pathnames "source/source-manifest.json" *soil2-replay-directory*))
    (coerce (gethash "files" (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)) 'list)))
(snapshot-require-fresh-runtime)
(defparameter *native-snapshot-context*
  (snapshot-register-native *soil2-replay-directory* *soil2-replay-records*))
(snapshot-check-plan "cl-mpm/settings")
(ql:quickload :cl-mpm/settings :silent t)
(setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
      '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
(dolist (system '("cl-mpm" "cl-mpm/models/wang2017-native"))
  (snapshot-check-plan system) (ql:quickload system :silent t))
(write-case-source-provenance *soil2-replay-directory*
  (mapcar (lambda (row) (merge-pathnames (gethash "path" row) *soil2-replay-directory*)) *soil2-replay-records*) nil)
(rename-file (merge-pathnames "source-provenance.json" *soil2-replay-directory*)
             (merge-pathnames "source-provenance-before.json" *soil2-replay-directory*))

(defpackage :cl-mpm/tests/soil2-failure-replay
  (:use :cl)
  (:local-nicknames (:point :cl-mpm/models/wang2017-point)
                    (:paper :cl-mpm/models/wang2017)))
(in-package :cl-mpm/tests/soil2-failure-replay)
(defun object (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun json-boolean (value) (if value t 'yason:false))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*soil2-replay-directory*)
                          :direction :output :if-exists :error)
    (yason:encode value stream)))
(defun basis-array (rows)
  (let ((result (make-array '(3 3) :element-type 'double-float)))
    (dotimes (i 3 result) (dotimes (j 3) (setf (aref result i j) (elt (elt rows i) j))))))
(defparameter *capsule-path* (merge-pathnames "mc-integration-failure.json" cl-user::*soil2-replay-directory*))
(defparameter *capsule-sha-before* (cl-user::snapshot-sha256 *capsule-path*))
(defparameter *capsule* (with-open-file (stream *capsule-path*)
                        (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *replay-count* 0)
(defparameter *replay-condition*
  (handler-case
      (progn (incf *replay-count*)
             (cl-mpm/models/wang2017-native:replay-native-diagnostic *capsule*) nil)
    (mc-evolution:material-integration-error (condition) condition)))
(assert (= *replay-count* 1))
(assert *replay-condition*)
(assert (string= (gethash "reason" *capsule*) (mc-evolution:integration-error-reason *replay-condition*)))
(write-json "replay-result.json"
  (object "passed" t "actualCapsuleReplayCalls" *replay-count* "physicalUpdates" 0
          "expectedRejection" t "reason" (mc-evolution:integration-error-reason *replay-condition*)
          "details" (prin1-to-string (mc-evolution:integration-error-details *replay-condition*))
          "capsuleSha256" *capsule-sha-before*
          "scope" "One actual failed native Soil2 input replay; rejection reproduced, no solver or test suite rerun"))

(let* ((trial (gethash "trialKirchhoffPa" *capsule*))
       (e (gethash "youngsModulusPa" *capsule*)) (nu (gethash "poissonRatio" *capsule*))
       (j (gethash "deformationJacobian" *capsule*))
       (old (gethash "rotatedPlasticTensor" *capsule*)) (old-k (paper:paper-kps old))
       (q (basis-array (gethash "principalToSpatialBasis" *capsule*)))
       (perm (mc-evolution::sort-trial-permutation trial))
       (sorted (map 'vector (lambda (i) (aref trial i)) perm))
       (sq (make-array '(3 3) :element-type 'double-float))
       (g (/ e (* 2d0 (+ 1d0 nu)))) (bulk (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
       (law (point::soil2-point-law))
       (tol (+ mc-evolution::+stress-atol+ (* mc-evolution::+stress-rtol+ (mc-evolution::max-abs3 sorted))))
       (mean (/ (reduce #'+ sorted) 3d0)) (phi (* 35d0 (/ pi 180d0)))
       (max-k (/ (- 30000d0 (/ (* mean (tan phi)) j)) 750000d0))
       (reports nil))
  (dotimes (i 3) (dotimes (a 3) (setf (aref sq i a) (aref q i (aref perm a)))))
  (dolist (active mc-evolution::+active-bases+)
    (labels ((evaluate-at (k)
               (mc-evolution::fixed-kappa-candidate sorted g bulk j law 0d0 k active))
             (candidate-report (k branch)
               (if (< k 0d0)
                   (object "kps" k "excluded" "Negative squared-equation root cannot equal a tensor norm")
                   (let* ((candidate (evaluate-at k))
                          (delta (point::fixed-increment (mc-evolution:projection-plastic-increment candidate) sq))
                          (new-k (paper:paper-kps (map 'vector #'+ old delta)))
                          (residual (- k new-k))
                          (tau (mc-evolution:projection-tau candidate))
                          (work-tol (* tol (max 1d-12 (mc-evolution::max-abs3 (mc-evolution:projection-plastic-increment candidate))))))
                     (object "branch" branch "kps" k "kpsFromTensor" new-k
                      "unsquaredHistoryResidual" residual "historyChange" (- k old-k)
                      "inSofteningInterval" (json-boolean (<= 0d0 k .02d0))
                      "kirchhoffSortedPa" tau
                      "plasticPrincipalIncrement" (mc-evolution:projection-plastic-increment candidate)
                      "plasticSpatialIncrement" delta
                      "multipliers" (mc-evolution:projection-multipliers candidate)
                      "yieldResidualsPa" (mc-evolution:projection-residuals candidate)
                      "maxYieldResidualPa" (mc-evolution:projection-max-residual candidate)
                      "orderingHolds" (json-boolean (and (>= (aref tau 0) (- (aref tau 1) tol))
                                                    (>= (aref tau 1) (- (aref tau 2) tol))))
                      "nonnegativeMultipliers" (json-boolean (every (lambda (x) (>= x (- mc-evolution::+multiplier-tol+)))
                                                                  (mc-evolution:projection-multipliers candidate)))
                      "plasticWorkKirchhoff" (mc-evolution:projection-work candidate)
                      "workTolerance" work-tol
                      "workAdmissible" (json-boolean (>= (mc-evolution:projection-work candidate) (- work-tol)))
                      "fixedMeanApexExcessPa" (- mean (/ (* j (mc-evolution:projection-cohesion candidate)) (tan phi)))
                      "productionAdmissible" (json-boolean (mc-evolution::admissible-candidate-p candidate residual tol)))))))
      (let ((zero (evaluate-at 0d0)) (end (evaluate-at .02d0)))
        (if (not (and zero end))
            (push (object "active" (coerce active 'vector) "status" "SINGULAR_ACTIVE_LINEAR_SYSTEM"
                          "explanation" "Zero-dilation flow vectors are trace-free; three independent volumetric constraints cannot be regularized") reports)
            (let* ((d0 (point::fixed-increment (mc-evolution:projection-plastic-increment zero) sq))
                   (d1 (point::fixed-increment (mc-evolution:projection-plastic-increment end) sq))
                   (a (point::tensor-dev (map 'vector #'+ old d0)))
                   (b (point::tensor-dev (map 'vector (lambda (x y) (/ (- x y) .02d0)) d1 d0)))
                   (qa (- 1d0 (* .5d0 (point::tensor-dot b b))))
                   (qb (- (point::tensor-dot a b))) (qc (* -.5d0 (point::tensor-dot a a)))
                   (roots (point::real-quadratic-roots qa qb qc))
                   (tail-k (paper:paper-kps (map 'vector #'+ old d1))))
              (push (object "active" (coerce active 'vector) "status" "ALL_QUADRATIC_ROOTS_EXAMINED"
                            "quadraticCoefficients" (vector qa qb qc)
                            "roots" (map 'vector (lambda (k) (candidate-report k "softening")) roots)
                            "residualTailCoordinate" tail-k "residualTailEligible" (json-boolean (>= tail-k .02d0))) reports))))))
  (let* ((apex-plastic (map 'vector (lambda (x) (/ (- x mean) (* 2d0 g))) sorted))
         (apex-delta (point::fixed-increment apex-plastic sq))
         (apex-k (paper:paper-kps (map 'vector #'+ old apex-delta))))
    (write-json "candidate-admissibility.json"
      (object "scope" "Diagnostic evaluation of exact existing point equations, not another replay or a modified material model"
              "stressTolerancePa" tol "oldKps" old-k "trialMeanKirchhoffPa" mean
              "oldStrengthApexBoundPa" (/ (* j (paper:soil2-cohesion old-k)) (tan phi))
              "maxFeasibleSofteningKpsAtFixedMean" max-k
              "remainingKpsBudgetAtFixedMean" (- max-k old-k)
              "apexUniquePrincipalPlasticIncrement" apex-plastic
              "apexHistoryRequiredKps" apex-k "apexHistoryMismatch" (- apex-k max-k)
              "residualStrengthApexMeanExcessPa" (- mean (/ (* j 15000d0) (tan phi)))
              "activeSetReports" (coerce (nreverse reports) 'vector)))))

(assert (string= *capsule-sha-before* (cl-user::snapshot-sha256 *capsule-path*)))
(dolist (row cl-user::*soil2-replay-records*)
  (cl-user::snapshot-verify-file (merge-pathnames (gethash "path" row) cl-user::*soil2-replay-directory*)))
(cl-user::write-case-source-provenance cl-user::*soil2-replay-directory*
 (mapcar (lambda (row) (merge-pathnames (gethash "path" row) cl-user::*soil2-replay-directory*)) cl-user::*soil2-replay-records*) nil)
(rename-file (merge-pathnames "source-provenance.json" cl-user::*soil2-replay-directory*)
             (merge-pathnames "source-provenance-after.json" cl-user::*soil2-replay-directory*))
(format t "~&SOIL2 ACTUAL FAILURE REPLAY: one rejection reproduced; all source hashes retained; zero MPM updates.~%")
(uiop:quit 0)
