;;;; Explicit apex convention; identical numerical inputs to retained strict run.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(flet ((read-case (path)
         (let ((cl-mpm/framework:*simulation* nil))
           (load (cl-mpm-path path)) cl-mpm/framework:*simulation*)))
  (let* ((strict (read-case "cases/benchmarks/wang2017-soil2-fast-010.lisp"))
         (apex (read-case "cases/benchmarks/wang2017-soil2-apex-fast-010.lisp"))
         (a (cl-mpm/scenario/slope-descent:compile-configuration strict))
         (b (cl-mpm/scenario/slope-descent:compile-configuration apex))
         (material (cl-mpm/framework:simulation-material apex))
         (law (getf (cl-mpm/framework:material-particle-initargs material) :evolution-law))
         (report (make-hash-table :test 'equal))
         (output (first (cl-mpm-script-args))))
    (assert (= (hash-table-count b) (1+ (hash-table-count a))))
    (maphash (lambda (key value)
               (unless (string= key "materialModel")
                 (multiple-value-bind (other present) (gethash key b)
                   (assert present) (assert (equalp value other))))) a)
    (assert (equal (gethash "materialModel" b) "wang2017-soil2-apex"))
    (assert (equal (gethash "apexPolicy" b) "hydrostatic-volumetric"))
    (format t "~&PASS: All numerical inputs unchanged; explicit material/apex metadata differ.~%")
    (assert (cl-mpm/models/wang2017-native:soil2-law-p law))
    (loop for k in '(0d0 .01d0 .02d0 .04d0)
          for expected in '(30000d0 22500d0 15000d0 15000d0) do
      (multiple-value-bind (c phi psi) (cl-mpm/models/mc-evolution:law-values law k)
        (assert (< (abs (- c expected)) 1d-8))
        (assert (< (abs (- phi (* 35d0 (/ pi 180d0)))) 1d-13))
        (assert (zerop psi))))
    (format t "~&PASS: Cauchy cohesion curve and regular shear angles unchanged.~%")
    (let* ((mp (apply #'make-instance (cl-mpm/framework:material-particle-class material)
                      (cl-mpm/framework:material-particle-initargs material)))
           (adapter (cl-mpm/framework:material-diagnostics material))
           (fields (cl-mpm/framework:diagnostics-fields adapter)))
      (assert (typep mp 'cl-mpm/models/wang2017-apex:particle-wang2017-soil2-apex))
      (cl-mpm/framework:validate-material-diagnostics adapter (vector mp) "mpm")
      (dolist (name '("wang-paper-kps" "wang-apex-active" "wang-plastic-volume" "wang-Ep-trace"))
        (assert (find name fields :key #'first :test #'string=)))
      (assert (not (find "mc-kappa" fields :key #'first :test #'string=))))
    (format t "~&PASS: Native opt-in class and explicit apex-volume output adapter construct.~%")
    (setf (gethash "passed" report) t (gethash "controlsCount" report) 3
          (gethash "strictConfig" report) a (gethash "apexConfig" report) b
          (gethash "physicalUpdatesExecuted" report) 0
          (gethash "scope" report) "Native configuration/adapter controls only; new explicit volumetric apex convention, no slope result")
    (assert output) (ensure-directories-exist output)
    (with-open-file (stream output :direction :output :if-exists :error)
      (yason:encode report stream))))
(uiop:quit 0)
