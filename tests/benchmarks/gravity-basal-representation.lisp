;;;; Read-only actual native GIMP diagnostic; zero constitutive/MPM calls.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-basal-representation.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *basal-frozen* nil)
(defvar *basal-directory* nil)
(defvar *basal-exit* 1)
(unless *basal-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let ((directory (uiop:ensure-directory-pathname
                    (merge-pathnames (or (first (cl-mpm-script-args)) (error "Fresh output required."))))))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (relative '("cases/benchmarks/gravity-slope-mc-composite-apex-srf-1p6.lisp"
                          "research/references/unnotched-mc-ssr/basal-representation-contract.json"
                          "output/unnotched-statics-2026-10-25/search-001/result.json"))
        (let* ((from (cl-mpm-path relative))
               (to (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
               (bytes (case-source-bytes from)))
          (ensure-directories-exist to) (uiop:copy-file from to)
          (assert (equalp bytes (case-source-bytes to)))
          (push to copied)
          (push (snapshot-object "path" (enough-namestring to directory)
                 "originalPath" (namestring (truename from)) "bytes" (length bytes)
                 "sha256" (snapshot-sha256-bytes bytes)) records)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "Read-only GIMP fixture, actual case, frozen protocol and retained static result copied before load"
                         "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*basal-frozen* t) (*basal-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/mc-composite-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                   (snapshot-object "files" (coerce (mapcar (lambda (path)
                     (snapshot-object "path" (enough-namestring path directory)
                                      "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *basal-exit*))

(defpackage :cl-mpm/tests/gravity-basal-representation
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:gs :cl-mpm/scenario/gravity-slope)
                    (:mc :cl-mpm/models/mc-evolution) (:ap :cl-mpm/models/mc-composite-apex)))
(in-package :cl-mpm/tests/gravity-basal-representation)
(defvar *mpm-attempts* 0)
(defvar *material-attempts* 0)
(defvar *passed* nil)
(defvar *failure* nil)
(defvar *summaries* nil)
(defvar *circle* nil)
(defvar *contract* nil)
(defvar *stencils* nil)
(defvar *lock* (sb-thread:make-mutex :name "read-only basal diagnostic counters"))
(defmethod cl-mpm:update-sim :around ((sim gs::gravity-slope-sim))
  (sb-thread:with-mutex (*lock*) (incf *mpm-attempts*))
  (error "Read-only basal diagnostic forbids update-sim."))
(defmethod cl-mpm/particle:constitutive-model :around ((mp ap:particle-mc-composite-apex) strain dt)
  (declare (ignore strain dt))
  (sb-thread:with-mutex (*lock*) (incf *material-attempts*))
  (error "Read-only basal diagnostic forbids constitutive-model."))
(defun object (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun truth (value) (if value t 'yason:false))
(defun component (matrix i) (magicl:tref matrix i 0))
(defun near (actual expected &optional (tolerance 1d-10))
  (assert (and (mc::finite-real-p actual) (<= (abs (- actual expected)) tolerance))
          () "Expected ~S, got ~S, tolerance ~S" expected actual tolerance))
(defun input (relative) (merge-pathnames (concatenate 'string "source/inputs/" relative) cl-user::*basal-directory*))
(defun json-read (path) (with-open-file (stream path) (yason:parse stream)))
(defun json-write (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*basal-directory*) :direction :output :if-exists :error)
    (yason:encode value stream)))
(defun circle-value (name) (gethash name *circle*))
(defun surface (x) (max 0d0 (- 10d0 (* .5d0 (max 0d0 (- x 12d0))))))
(defun arc (x)
  (let ((radicand (- (expt (circle-value "radius") 2) (expt (- x (circle-value "centerX")) 2))))
    (assert (>= radicand 0d0))
    (- (circle-value "centerY") (sqrt radicand))))
(defun tangent-field (x y)
  "Hypothetical circle-cap field only; never assigned to native grid velocities."
  (if (and (<= (circle-value "entry") x (circle-value "exit")) (< (arc x) y) (<= y (surface x)))
      (values (/ (- (circle-value "centerY") y) (circle-value "radius"))
              (/ (- x (circle-value "centerX")) (circle-value "radius")))
      (values 0d0 0d0)))
(defun boundary-masks (sim)
  (let ((masks (make-hash-table :test #'equal)))
    (loop for bc across (cl-mpm:sim-bcs sim) do
      (assert (eq (class-name (class-of bc)) 'cl-mpm/bc::bc-fixed))
      (let* ((index (cl-mpm/bc:bc-index bc)) (old (or (gethash index masks) (list nil nil nil))))
        (loop for value in (cl-mpm/bc:bc-value bc) for axis from 0 do
          ;; NIL alone is free. Common Lisp integer zero is true/constrained.
          (when value (assert (zerop value)) (setf (nth axis old) value)))
        (setf (gethash (copy-list index) masks) old)))
    masks))
(defun stencil (sim mp masks)
  "Actual uncached engine dispatch and non-Fbar gradients; preserve raw signed data."
  (let ((rows nil))
    (cl-mpm::iterate-over-neighbours-shape-gimp-2d (cl-mpm:sim-mesh sim) mp
      (lambda (node weight gradient fbar-weight fbar-gradient)
        (declare (ignore fbar-weight fbar-gradient))
        (let* ((index (cl-mpm/mesh:node-index node)) (p (cl-mpm/mesh::node-position node)))
          (push (list (copy-list index) (component p 0) (component p 1)
                      weight (cl-mpm/utils::gradients-dx gradient) (cl-mpm/utils::gradients-dy gradient)
                      (copy-list (gethash index masks))) rows))))
    (nreverse rows)))
(defun interpolate (rows field &optional masked)
  (let ((u 0d0) (v 0d0) (ux 0d0) (uy 0d0) (vx 0d0) (vy 0d0))
    (dolist (row rows)
      (destructuring-bind (id x y w gx gy mask) row
        (declare (ignore id))
        (multiple-value-bind (a b) (funcall field x y)
          (when masked (when (first mask) (setf a 0d0)) (when (second mask) (setf b 0d0)))
          (incf u (* w a)) (incf v (* w b))
          (incf ux (* gx a)) (incf uy (* gy a)) (incf vx (* gx b)) (incf vy (* gy b)))))
    (list u v ux uy vx vy)))
(defun kernel-sums (rows)
  (loop for row in rows sum (fourth row) into w sum (fifth row) into gx sum (sixth row) into gy
        finally (return (list w gx gy))))
(defun probe (material h)
  (aref (apply #'cl-mpm/setup:make-block-mps '(0d0 0d0) (list (/ h 2d0) (/ h 2d0)) '(1 1)
               1d0 (fw:material-particle-class material) (fw:material-particle-initargs material)) 0))
(defun place-probe (mp x y half-size)
  (setf (magicl:tref (cl-mpm/particle:mp-position mp) 0 0) (float x 1d0)
        (magicl:tref (cl-mpm/particle:mp-position mp) 1 0) (float y 1d0)
        (magicl:tref (cl-mpm/particle::mp-domain-size mp) 0 0) (* 2d0 half-size)
        (magicl:tref (cl-mpm/particle::mp-domain-size mp) 1 0) (* 2d0 half-size)) mp)
(defun particle-state (sim)
  ;; Snapshot actual solution-bearing arrays/scalars; diagnostic only mutates its separate probe.
  (loop for mp across (cl-mpm:sim-mps sim) collect
    (list mp (cl-mpm/particle:mp-mass mp) (cl-mpm/particle:mp-volume mp)
          (mc:particle-kappa mp) (mc:particle-kappa-committed mp)
          (loop for matrix in (list (cl-mpm/particle:mp-position mp) (cl-mpm/particle::mp-domain-size mp)
                  (cl-mpm/particle:mp-velocity mp) (cl-mpm/particle:mp-stress mp)
                  (cl-mpm/particle:mp-deformation-gradient mp))
                collect (coerce (cl-mpm/utils:fast-storage matrix) 'list)))))
(defun configuration-pair ()
  (let ((fw:*simulation* nil) (path (input (gethash "case" *contract*))))
    (cl-user::snapshot-verify-file path) (load path)
    (let* ((case fw:*simulation*) (coarse (gs:compile-configuration case)) (fine (make-hash-table :test #'equal)))
      (maphash (lambda (key value) (setf (gethash key fine) value)) coarse)
      (setf (gethash "meshSize" fine) .5d0)
      (assert (equal (loop for key being the hash-keys of coarse
                          unless (equalp (gethash key coarse) (gethash key fine)) collect key) '("meshSize")))
      (near (gethash "strengthReductionFactor" coarse) 1.6d0)
      (values (fw:simulation-material case) (list coarse fine)))))
(defun controls (sim mp masks h)
  (place-probe mp (* 4.125d0 h) (* 4.375d0 h) (/ h 4d0))
  (let* ((rows (stencil sim mp masks)) (sums (kernel-sums rows))
         (x (component (cl-mpm/particle:mp-position mp) 0)) (y (component (cl-mpm/particle:mp-position mp) 1)))
    (near (first sums) 1d0) (near (second sums) 0d0) (near (third sums) 0d0)
    (loop for a in (interpolate rows (lambda (x y) (declare (ignore x y)) (values 2d0 -3d0)))
          for b in '(2d0 -3d0 0d0 0d0 0d0 0d0) do (near a b))
    (loop for a in (interpolate rows (lambda (x y) (values (+ 2d0 (* .3d0 x) (* -.7d0 y))
                                                                (+ -1d0 (* .2d0 x) (* .4d0 y)))))
          for b in (list (+ 2d0 (* .3d0 x) (* -.7d0 y)) (+ -1d0 (* .2d0 x) (* .4d0 y))
                         .3d0 -.7d0 .2d0 .4d0) do (near a b))
    (push (object "meshSizeM" h "kind" "FULL_SUPPORT_CONTROL" "rows" (coerce rows 'vector)) *stencils*))
  (let ((limits nil) (previous most-positive-double-float))
    (dolist (ratio (gethash "zeroBaseHalfDomainOverH" (gethash "controls" *contract*)))
      (let* ((l (* h ratio)) (rows (stencil sim (place-probe mp (* 20.375d0 h) 0d0 l) masks))
             (sums (kernel-sums rows))
             (base-weight (loop for row in rows when (zerop (third row)) sum (fourth row)))
             (values (interpolate rows (lambda (x y) (declare (ignore x)) (values y 0d0)) t)))
        (near (first sums) (- 1d0 (/ l (* 4d0 h))))
        (near base-weight (- 1d0 (/ l (* 2d0 h))))
        (near (first values) (/ l 4d0)) (near (fourth values) .5d0)
        (assert (< (first values) previous)) (setf previous (first values))
        (push (object "halfDomainM" l "sumWeight" (first sums) "baseWeight" base-weight
                      "representedUxMPerS" (first values) "gradientUyPerS" (fourth values)
                      "classification" "HYPOTHETICAL_FLOOR_CROSSING_NOT_AN_ACTUAL_INITIAL_MP") limits)))
    (push (object "meshSizeM" h "zeroBaseControls" (coerce (nreverse limits) 'vector)) *stencils*)))

(defparameter *columns*
  '("kind" "id" "mesh_m" "arc_x_m" "normal_offset_m" "x_m" "y_m" "domain_half_m"
    "domain_edge_margin_m" "actual_initial_mp" "initial_admissible_grid_domain" "center_inside_soil"
    "physical_upper_cohort" "sum_w" "sum_grad_x" "sum_grad_y" "base_w" "base_signed_grad_x"
    "base_signed_grad_y" "base_abs_gradient_norm" "fixed_x_w" "fixed_y_w" "raw_ux" "raw_uy"
    "masked_ux" "masked_uy" "masked_grad_ux_x" "masked_grad_ux_y" "masked_grad_uy_x" "masked_grad_uy_y"
    "point_ux" "point_uy" "point_error_norm" "raw_minus_masked_norm" "status"))
(defun csv-row (stream values)
  (loop for value in values for first = t then nil do
    (unless first (write-char #\, stream))
    (typecase value (double-float (let ((*read-default-float-format* 'double-float)) (format stream "~,17G" value)))
      (t (princ value stream)))) (terpri stream))
(defun observe (stream sim mp masks kind id h arc-x offset actual)
  (let* ((p (cl-mpm/particle:mp-position mp)) (x (component p 0)) (y (component p 1))
         (l (* .5d0 (component (cl-mpm/particle::mp-domain-size mp) 0)))
         (margin (min (- x l) (- y l) (- 80d0 x l) (- 15d0 y l)))
         (inside (and (<= 0d0 x 80d0) (<= 0d0 y 15d0)))
         (admissible (>= margin 0d0)) (in-soil (and (<= 0d0 x 32d0) (<= 0d0 y (surface x))))
         (prefix (list kind id h arc-x offset x y l margin (if actual 1 0) (if admissible 1 0)
                       (if in-soil 1 0) (if (and actual (> x 2d0) (> y 2d0)) 1 0))))
    (if (not inside)
        (csv-row stream (append prefix (make-list 21 :initial-element "") '("NOT_EVALUATED_CENTER_OUTSIDE_GRID")))
        (let* ((rows (stencil sim mp masks)) (sums (kernel-sums rows))
               (base (remove-if-not (lambda (row) (zerop (third row))) rows))
               (raw (interpolate rows #'tangent-field)) (masked (interpolate rows #'tangent-field t)))
          (multiple-value-bind (a b) (tangent-field x y)
            (csv-row stream (append prefix sums
              (list (reduce #'+ base :key #'fourth :initial-value 0d0)
                    (reduce #'+ base :key #'fifth :initial-value 0d0)
                    (reduce #'+ base :key #'sixth :initial-value 0d0)
                    (loop for row in base sum (sqrt (+ (expt (fifth row) 2) (expt (sixth row) 2))))
                    (loop for row in rows when (first (seventh row)) sum (fourth row))
                    (loop for row in rows when (second (seventh row)) sum (fourth row))
                    (first raw) (second raw)) masked (list a b
                    (sqrt (+ (expt (- (first masked) a) 2) (expt (- (second masked) b) 2)))
                    (sqrt (+ (expt (- (first raw) (first masked)) 2) (expt (- (second raw) (second masked)) 2)))
                    (if admissible "GRID_DOMAIN_INSIDE" "NON_ADMISSIBLE_AS_INITIAL_MP_GRID_DOMAIN_CROSSES_BOUNDARY")))))
          (values (first sums) (not (null base)) margin)))))
(defun diagnostic ()
  (setf *contract* (json-read (input "research/references/unnotched-mc-ssr/basal-representation-contract.json"))
        *circle* (gethash "circle" *contract*))
  (assert (string= (cl-user::snapshot-sha256 (input (gethash "case" *contract*))) (gethash "caseSha256" *contract*)))
  (let* ((saved-path (input (gethash "retainedStaticResult" *contract*)))
         (saved (json-read saved-path))
         (selected (find-if (lambda (row) (and (string= (gethash "name" (gethash "search" row)) "fine-400")
                                              (= (gethash "strengthReductionFactor" row) 1)))
                            (gethash "summaries" saved))))
    (assert (string= (cl-user::snapshot-sha256 saved-path) (gethash "retainedStaticResultSha256" *contract*)))
    (assert selected)
    (maphash (lambda (key value)
      (let ((retained (gethash key (gethash "restrictedFamilyMinimum" selected))))
        (if (numberp value) (near retained value) (assert (equal value retained))))) *circle*))
  (near (arc (circle-value "entry")) (surface (circle-value "entry")))
  (near (arc (circle-value "exit")) (surface (circle-value "exit")))
  (near (arc (circle-value "arcMinimumX")) (circle-value "arcMinimumY"))
  (assert (> (circle-value "arcMinimumY") 0d0))
  (push "retained-circle-binding-endpoints-and-exact-positive-minimum" *passed*)
  (multiple-value-bind (material configs) (configuration-pair)
    (with-open-file (actual (merge-pathnames "actual-initial-mp-footprints.csv" cl-user::*basal-directory*)
                           :direction :output :if-exists :error)
      (with-open-file (profiles (merge-pathnames "hypothetical-arc-profiles.csv" cl-user::*basal-directory*)
                               :direction :output :if-exists :error)
        (csv-row actual *columns*) (csv-row profiles *columns*)
        (loop for config in configs for expected in '(880 3520) do
          (let* ((h (gethash "meshSize" config)) (sim (gs:build-slope material config))
                 (before (particle-state sim)) (masks (boundary-masks sim)) (mp (probe material h))
                 (count 0) (base-count 0) (min-w most-positive-double-float) (min-margin most-positive-double-float))
            (assert (= (length (cl-mpm:sim-mps sim)) expected))
            (controls sim mp masks h)
            (push (format nil "native-constant-affine-and-independent-zero-base-h~F" h) *passed*)
            (loop for particle across (cl-mpm:sim-mps sim) for id from 0 do
              (multiple-value-bind (sum-w base-p margin) (observe actual sim particle masks "ACTUAL_INITIAL_MP" id h "" "" t)
                (near sum-w 1d0) (when base-p (incf base-count))
                (setf min-w (min min-w sum-w) min-margin (min min-margin margin)) (incf count)))
            (let* ((a (circle-value "entry")) (b (circle-value "exit"))
                   (xs (loop for i from 0 to 100 collect (+ a (* (- b a) (/ i 100d0))))))
              (pushnew (circle-value "arcMinimumX") xs :test #'=)
              (loop for x in (sort xs #'<) for id from 0 do
                (let* ((y (arc x)) (nx (/ (- (circle-value "centerX") x) (circle-value "radius")))
                       (ny (/ (- (circle-value "centerY") y) (circle-value "radius"))))
                  (dolist (offset (gethash "normalOffsetsM" (gethash "arcSampling" *contract*)))
                    (place-probe mp (+ x (* offset nx)) (+ y (* offset ny)) (/ h 4d0))
                    (observe profiles sim mp masks "HYPOTHETICAL_ARC_NORMAL_PROBE" id h x offset nil))
                  (place-probe mp x 0d0 (/ h 4d0))
                  (observe profiles sim mp masks "HYPOTHETICAL_BASE_PROBE" id h x "" nil)))
              (place-probe mp (circle-value "arcMinimumX") (circle-value "arcMinimumY") (/ h 4d0))
              (push (object "meshSizeM" h "kind" "EXACT_ARC_MINIMUM_HYPOTHETICAL_FLOOR_CROSSING"
                            "rows" (coerce (stencil sim mp masks) 'vector)) *stencils*))
            (assert (equalp before (particle-state sim)))
            (push (object "meshSizeM" h "actualInitialParticleCount" count "actualInitialMassKgPerM"
                          (loop for particle across (cl-mpm:sim-mps sim) sum (cl-mpm/particle:mp-mass particle))
                          "actualInitialMPsWithBaseNodeFootprint" base-count "minimumActualSumWeight" min-w
                          "minimumActualDomainEdgeMarginM" min-margin "actualInitialParticleStateUnchanged" t) *summaries*)
            (push (format nil "actual-initial-mps-and-hypothetical-probes-separated-h~F" h) *passed*))))))
  (assert (= *mpm-attempts* *material-attempts* 0))
  (push "zero-native-material-and-mpm-attempts" *passed*)
  (json-write "selected-native-stencils.json" (coerce (nreverse *stencils*) 'vector)))
(handler-case (diagnostic) (error (condition) (setf *failure* (princ-to-string condition))))
(json-write "result.json" (object "status" (if *failure* "FAILED" "READ_ONLY_KINEMATIC_DIAGNOSTIC_COMPLETE")
  "failure" *failure* "passedControls" (coerce (reverse *passed*) 'vector)
  "meshSummaries" (coerce (nreverse *summaries*) 'vector)
  "mpmCallsAttempted" *mpm-attempts* "constitutiveCallsAttempted" *material-attempts*
  "actualNativeKernel" "cl-mpm::iterate-over-neighbours-shape-gimp-2d"
  "simdFeature" (truth (member :sb-simd *features*)) "nativeBackend" (cl-user::snapshot-native-proof)
  "physicalResult" "NOT_EVALUATED_PRESCRIBED_KINEMATICS_ONLY" "scientificallyValidated" 'yason:false
  "scope" "No MPM steps, material updates, force/velocity changes, static search, trajectory or slide validation"))
(setf cl-user::*basal-exit* (if *failure* 1 0))
