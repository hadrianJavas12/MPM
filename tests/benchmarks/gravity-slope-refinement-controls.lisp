;;;; Fresh frozen grid-specific gate; no old test file or old groups are loaded.
;;;; windows\cl-mpm.cmd THIS OUTPUT [all|case-delta,grid-contract,runner,csv-vtk] [SAVED_OBSERVATIONS]
(in-package :cl-user)
(require :asdf)
(defvar *refinement-frozen* nil)
(defvar *refinement-output* nil)
(defvar *refinement-exit* 1)
(unless *refinement-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let ((directory (uiop:ensure-directory-pathname
                    (merge-pathnames (or (first (cl-mpm-script-args)) (error "Fresh output required."))))))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (relative '("cases/benchmarks/gravity-slope-mc-srf-1p4.lisp"
                           "cases/benchmarks/gravity-slope-mc-srf-1p4-h05.lisp"
                           "research/references/unnotched-mc-ssr/refinement-contract.json"))
        (let* ((original (cl-mpm-path relative)) (target (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
               (bytes (case-source-bytes original)))
          (ensure-directories-exist target) (uiop:copy-file original target)
          (unless (equalp bytes (case-source-bytes target)) (error "Input byte mismatch."))
          (push target copied)
          (push (snapshot-object "path" (enough-namestring target directory) "originalPath" (namestring (truename original))
                                 "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)) records)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Both executable meshes, refinement contract and complete project sources copied before load"
                                            "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*refinement-frozen* t) (*refinement-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory) (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name) (snapshot-write-json (merge-pathnames name directory)
                (snapshot-object "files" (coerce (mapcar (lambda (p) (snapshot-object
                   "path" (enough-namestring p directory) "sha256" (snapshot-sha256 p))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (p copied) (snapshot-verify-file p))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *refinement-exit*))

(defpackage :cl-mpm/tests/gravity-refinement
  (:use :cl) (:local-nicknames (:fw :cl-mpm/framework) (:gs :cl-mpm/scenario/gravity-slope)
                             (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/gravity-refinement)
(defvar *groups* '("case-delta" "grid-contract" "runner" "csv-vtk"))
(defvar *selected* (let ((arg (or (second (cl-user::cl-mpm-script-args)) "all")))
                     (if (string= arg "all") *groups* (uiop:split-string arg :separator ","))))
(unless (every (lambda (g) (member g *groups* :test #'string=)) *selected*) (error "Unknown refinement group."))
(defvar *passed* nil) (defvar *failure* nil)
(defvar *enabled* nil) (defvar *updates* 0) (defvar *attempts* 0) (defvar *accepted* 0)
(defvar *lock* (sb-thread:make-mutex :name "refinement counters"))
(defvar *observed* (make-hash-table :test #'equal))
(defmethod cl-mpm:update-sim :around ((sim gs::gravity-slope-sim))
  (multiple-value-prog1 (call-next-method) (sb-thread:with-mutex (*lock*) (when *enabled* (incf *updates*)))))
(defmethod cl-mpm/particle:constitutive-model :around ((mp mc:particle-mc-evolution) strain dt)
  (sb-thread:with-mutex (*lock*) (when *enabled* (incf *attempts*)))
  (multiple-value-prog1 (call-next-method) (sb-thread:with-mutex (*lock*) (when *enabled* (incf *accepted*)))))
(defmacro group (name &body body)
  `(when (member ,name *selected* :test #'string=)
     (handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
       (error (e) (setf *failure* (list ,name (princ-to-string e))) (return-from controls nil)))))
(defun near (a b &optional (tol 1d-10)) (assert (and (gs::finite-p a) (<= (abs (- a b)) tol))))
(defun input-path (directory relative) (merge-pathnames (concatenate 'string "source/inputs/" relative) directory))
(defun case-input (directory name)
  (let ((fw:*simulation* nil) (path (input-path directory (concatenate 'string "cases/benchmarks/" name))))
    (cl-user::snapshot-verify-file path) (load path) fw:*simulation*))
(defun csv (path)
  (with-open-file (s path)
    (values (uiop:split-string (read-line s) :separator ",")
      (loop for line = (read-line s nil) while line collect
        (mapcar (lambda (text) (let ((*read-eval* nil) (*read-default-float-format* 'double-float))
                               (read-from-string text))) (uiop:split-string line :separator ","))))))
(defun cell (header row key) (nth (or (position key header :test #'string=) (error "Missing ~A" key)) row))
(defun det-row (h row)
  (flet ((f (i j) (cell h row (format nil "F_~D~D" i j))))
    (+ (* (f 0 0) (- (* (f 1 1) (f 2 2)) (* (f 1 2) (f 2 1))))
       (- (* (f 0 1) (- (* (f 1 0) (f 2 2)) (* (f 1 2) (f 2 0)))))
       (* (f 0 2) (- (* (f 1 0) (f 2 1)) (* (f 1 1) (f 2 0)))))))
;; Independent binary reader, scoped from the earlier verified writer-format
;; reader; the old test file and its automatic groups are never loaded.
(defun byte-line (s)
  (let ((bytes (loop for b = (read-byte s nil) while (and b (/= b 10)) collect b)))
    (when bytes (string-right-trim '(#\Return) (map 'string #'code-char bytes)))))
(defun double-be (s)
  (let* ((bits (loop repeat 8 for b = (read-byte s) for acc = b then (+ (ash acc 8) b) finally (return acc)))
         (e (ldb (byte 11 52) bits)) (f (ldb (byte 52 0) bits)))
    (assert (/= e 2047))
    (* (if (logbitp 63 bits) -1d0 1d0)
       (if (zerop e) (scale-float (float f 1d0) -1074) (scale-float (+ 1d0 (/ f (expt 2 52))) (- e 1023))))))
(defun vtk (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (assert (search "vtk" (byte-line s))) (byte-line s)
    (assert (string= (byte-line s) "BINARY")) (assert (string= (byte-line s) "DATASET UNSTRUCTURED_GRID"))
    (let* ((declaration (uiop:split-string (byte-line s) :separator " "))
           (n (parse-integer (second declaration))) (points (make-array (* 3 n))) (fields (make-hash-table :test #'equal)))
      (assert (equal (list (first declaration) (third declaration)) '("POINTS" "double")))
      (dotimes (i (* 3 n)) (setf (aref points i) (double-be s))) (assert (= (read-byte s) 10))
      (assert (string= (byte-line s) (format nil "POINT_DATA ~D" n)))
      (loop while (listen s) for line = (byte-line s) when (and line (plusp (length line))) do
        (let ((words (uiop:split-string line :separator " ")) (values (make-array n)))
          (assert (equal (list (first words) (third words) (fourth words)) '("SCALARS" "double" "1")))
          (assert (string= (byte-line s) "LOOKUP_TABLE default"))
          (dotimes (i n) (setf (aref values i) (double-be s)))
          (setf (gethash (second words) fields) values) (assert (= (read-byte s) 10))))
      (values n points fields))))

(defun controls (directory)
  (let* ((coarse (case-input directory "gravity-slope-mc-srf-1p4.lisp"))
         (fine (case-input directory "gravity-slope-mc-srf-1p4-h05.lisp"))
         (old (gs:compile-configuration coarse)) (new (gs:compile-configuration fine))
         (obs (if (member "runner" *selected* :test #'string=) (merge-pathnames "observations/" directory)
                  (let ((given (third (cl-user::cl-mpm-script-args))))
                    (if given (uiop:ensure-directory-pathname (merge-pathnames given)) (merge-pathnames "observations/" directory))))))
    (group "case-delta"
      (let ((contract (fw::read-parameter-json (input-path directory "research/references/unnotched-mc-ssr/refinement-contract.json"))))
        (assert (equal (gethash "schema" contract) "cl-mpm.gravity-refinement.v1"))
        (assert (equal (gethash "expectedParticleCount" contract) '(880 3520))))
      (assert (= (hash-table-count old) (hash-table-count new)))
      (assert (eq (fw:simulation-scenario coarse) (fw:simulation-scenario fine)))
      (maphash (lambda (key value) (unless (equal key "meshSize") (assert (equalp value (gethash key new))))) old)
      (near (gethash "meshSize" old) 1d0) (near (gethash "meshSize" new) .5d0)
      (dolist (getter (list #'fw:simulation-material #'fw:simulation-geometry #'fw:simulation-boundary #'fw:simulation-loading))
        (assert (equalp (fw:component-options (funcall getter coarse)) (fw:component-options (funcall getter fine)))))
      (assert (equalp (alexandria:remove-from-plist (fw:component-options (fw:simulation-solver coarse)) :mesh-size)
                      (alexandria:remove-from-plist (fw:component-options (fw:simulation-solver fine)) :mesh-size)))
      (setf (gethash "onlyConfigDifference" *observed*) "meshSize"))
    (group "grid-contract"
      (cl-mpm/utils:set-workers 1)
      (let ((before (gs:build-slope (fw:simulation-material coarse) old)) (after (gs:build-slope (fw:simulation-material fine) new)))
        (assert (= (length (cl-mpm:sim-mps before)) 880)) (assert (= (length (cl-mpm:sim-mps after)) 3520))
        (near (reduce #'+ (cl-mpm:sim-mps after) :key #'cl-mpm/particle:mp-volume) 220d0)
        (near (reduce #'+ (cl-mpm:sim-mps before) :key #'cl-mpm/particle:mp-mass)
              (reduce #'+ (cl-mpm:sim-mps after) :key #'cl-mpm/particle:mp-mass) 1d-6)
        (assert (null (cl-mpm::sim-bcs-force-list after)))
        (loop for mp across (cl-mpm:sim-mps after) do
          (let ((x (gs::component (cl-mpm/particle:mp-position mp) 0)) (y (gs::component (cl-mpm/particle:mp-position mp) 1)))
            (assert (and (> x 0d0) (< x 32d0) (> y 0d0) (<= y (min 10d0 (- 16d0 (* .5d0 x))))))
            (near (cl-mpm/particle:mp-volume mp) .0625d0)))
        (dolist (sim (list before after))
          (let* ((h (cl-mpm/mesh:mesh-resolution (cl-mpm:sim-mesh sim))) (seen (make-hash-table :test #'equal)))
            (loop for bc across (cl-mpm:sim-bcs sim) do
              (let* ((index (cl-mpm/bc:bc-index bc)) (x (* h (first index))) (y (* h (second index))) (mask (cl-mpm/bc:bc-value bc)))
                (assert (eq (class-name (class-of bc)) 'cl-mpm/bc::bc-fixed))
                (assert (or (= x 0) (= x 80) (= y 0) (= y 15)))
                (setf (gethash (list x y) seen) (cons mask (gethash (list x y) seen)))))
            (assert (member '(0 0 nil) (gethash '(40d0 0d0) seen) :test #'equal))
            (assert (member '(0 nil nil) (gethash '(0d0 5d0) seen) :test #'equal))
            (assert (member '(nil nil nil) (gethash '(40d0 15d0) seen) :test #'equal)))))
      (assert (= *updates* *attempts* 0)) (setf (gethash "refinedParticleCount" *observed*) 3520))
    (group "runner"
      (let ((config (alexandria:copy-hash-table new)))
        (setf (gethash "duration" config) 2d-5 (gethash "gravityRampDuration" config) 1d-5
              (gethash "frames" config) 3 (gethash "maxUpdates" config) 2)
        (unwind-protect (progn (setf *enabled* t) (gs:run (fw:simulation-material fine) config obs)) (setf *enabled* nil)))
      (assert (= *updates* 2)) (assert (= *attempts* *accepted* 7040))
      (let ((m (fw::read-parameter-json (merge-pathnames "manifest.json" obs))))
        (assert (eq (gethash "complete" m) t)) (assert (= (gethash "savedFrames" m) 3))
        (assert (not (eq (gethash "landslideVerified" m) t)))))
    (group "csv-vtk"
      (multiple-value-bind (header rows) (csv (merge-pathnames "particles.csv" obs))
        (assert (= (length rows) 10560))
        (dotimes (frame 3)
          (let ((selected (remove-if-not (lambda (row) (= (cell header row "frame") frame)) rows)))
            (multiple-value-bind (count points fields) (vtk (merge-pathnames (format nil "vtk/particles_~4,'0D.vtk" frame) obs))
              (assert (= count (length selected) 3520))
              (loop for row in selected for id from 0 do
                (assert (every #'gs::finite-p row)) (assert (= (cell header row "particle_id") id))
                (near (cell header row "mass_kg_per_m") (* .0625d0 (gethash "density" new)))
                (let ((j (det-row header row)))
                  (assert (> j 0d0)) (near j (cell header row "J"))
                  (near (cell header row "volume_m3_per_m") (* j (cell header row "reference_volume_m3_per_m"))))
                (near (aref points (* id 3)) (cell header row "x_m"))
                (near (aref points (+ 1 (* id 3))) (cell header row "y_m"))
                (loop for (vtk-key csv-key) in '(("mass" "mass_kg_per_m") ("volume" "volume_m3_per_m")
                            ("sig_yy" "sig_yy_pa") ("mc-kappa" "mc_kappa") ("mc-cohesion-pa" "cohesion_pa")) do
                  (near (aref (gethash vtk-key fields) id) (cell header row csv-key) 1d-9))))))
        (setf (gethash "savedRows" *observed*) (length rows)))))
  t)
(handler-case (controls cl-user::*refinement-output*) (error (e) (setf *failure* (list "harness" (princ-to-string e)))))
(with-open-file (s (merge-pathnames "result.json" cl-user::*refinement-output*) :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object "passed" (if *failure* 'yason:false t) "passedGroups" (coerce (reverse *passed*) 'vector)
    "failure" (and *failure* (coerce *failure* 'vector)) "selectedGroups" (coerce *selected* 'vector)
    "skippedGroups" (coerce (set-difference *groups* *selected* :test #'string=) 'vector)
    "sourceProofBefore" "source-proof-before.json" "sourceProofAfter" "source-proof-after.json"
    "physicalUpdatesExecuted" *updates* "materialCallsAttempted" *attempts* "materialCallsAccepted" *accepted*
    "observations" *observed* "nativeBackend" (cl-user::snapshot-native-proof)
    "scope" "New grid-specific gate; tiny fixture overrides duration/ramp/frames/cap explicitly; only fine grid advances; no full refined slope or scientific PASS") s))
(setf cl-user::*refinement-exit* (if *failure* 1 0))
