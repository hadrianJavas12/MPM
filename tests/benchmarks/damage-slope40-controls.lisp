;;;; New owned controls only. No equilibrium/collapse/scientific validation.
;;;; windows\cl-mpm.cmd THIS FRESH [input|all]; all makes exactly two native updates.
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *damage40-frozen* nil)
(defvar *damage40-directory* nil)
(defvar *damage40-exit* 1)
(defvar *damage40-mode* (or (second (cl-mpm-script-args)) "all"))
(unless (member *damage40-mode* '("input" "all") :test #'string=)
  (error "Expected input or all."))
(unless *damage40-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let ((directory (uiop:ensure-directory-pathname
                    (merge-pathnames (or (first (cl-mpm-script-args)) (error "Fresh output required."))))))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve existing gate output."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      ;; The new JSON is automatically included with all studio/reference inputs.
      (let* ((from (cl-mpm-path "cases/benchmarks/damage-slope40.lisp"))
             (to (merge-pathnames "source/inputs/cases/benchmarks/damage-slope40.lisp" directory))
             (bytes (case-source-bytes from)))
        (ensure-directories-exist to) (uiop:copy-file from to)
        (assert (equalp bytes (case-source-bytes to)))
        (push to copied)
        (push (snapshot-object "path" (enough-namestring to directory)
               "originalPath" (namestring (truename from)) "bytes" (length bytes)
               "sha256" (snapshot-sha256-bytes bytes)) records))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "Owned40-degree fixture, optional adapter, actual case/config and project/native bytes frozen before load"
                         "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*damage40-frozen* t) (*damage40-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm-framework/damage-slope40"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                   (snapshot-object "files" (coerce (mapcar (lambda (path)
                     (snapshot-object "path" (enough-namestring path directory)
                                      "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *damage40-exit*))

(defpackage :cl-mpm/tests/damage-slope40
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:joss :cl-mpm/framework/cliff)))
(in-package :cl-mpm/tests/damage-slope40)
(defvar *passed* nil) (defvar *failure* nil)
(defvar *counting* nil) (defvar *updates* 0) (defvar *damage-passes* 0)
(defvar *material-attempted* 0) (defvar *material-accepted* 0)
(defvar *damage-attempted* 0) (defvar *damage-accepted* 0)
(defvar *observations* (make-hash-table :test #'equal))
(defparameter +groups+ '("exact40-straight-unnotched-input-and-rejections"
                        "native-damage-initialization-and-protected-base"
                        "two-real-native-damage-enabled-usf-updates-and-vtk"))
(defmethod cl-mpm:update-sim :around ((sim joss::joss-reference-sim))
  (multiple-value-prog1 (call-next-method) (when *counting* (incf *updates*))))
(defmethod cl-mpm/damage::calculate-damage :around ((sim joss::joss-reference-sim) dt)
  (multiple-value-prog1 (call-next-method)
    (when (and *counting* (cl-mpm::sim-enable-damage sim)) (incf *damage-passes*))))
(defmethod cl-mpm/particle:constitutive-model :around ((mp joss::joss-reference-chalk) strain dt)
  (when *counting* (incf *material-attempted*))
  (multiple-value-prog1 (call-next-method) (when *counting* (incf *material-accepted*))))
(defmethod cl-mpm/damage::update-damage :around ((mp joss::joss-reference-chalk) dt)
  (let ((active (and *counting* (cl-mpm/particle::mp-enable-damage mp))))
    (when active (incf *damage-attempted*))
    (multiple-value-prog1 (call-next-method) (when active (incf *damage-accepted*)))))
(defmacro control (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (setf *failure* (list ,name (princ-to-string condition)))
       (format t "~&FAIL: ~A: ~A~%" ,name condition) (return-from controls nil))))
(defun near (actual expected &optional (tolerance 1d-10))
  (assert (and (realp actual) (not (sb-ext:float-nan-p (float actual 1d0)))
               (not (sb-ext:float-infinity-p (float actual 1d0)))
               (<= (abs (- actual expected)) tolerance))))
(defun rejects (function)
  (let ((rejected nil)) (handler-case (funcall function) (error () (setf rejected t)))
    (assert rejected)))
(defun mass (sim)
  (loop for mp across (cl-mpm:sim-mps sim) sum (cl-mpm/particle:mp-mass mp)))
(defun assert-base (sim)
  (loop for mp across (cl-mpm:sim-mps sim) when (= (cl-mpm/particle::mp-index mp) 1) do
    (assert (zerop (cl-mpm/particle:mp-damage mp)))
    (assert (not (cl-mpm/particle::mp-enable-damage mp)))
    (assert (not (cl-mpm/particle::mp-enable-plasticity mp)))))
(defun assert-state (sim)
  (joss::reference-check-finite sim)
  (loop for mp across (cl-mpm:sim-mps sim) do
    (let ((f (cl-mpm/particle::mp-deformation-gradient mp)))
      (loop for value across (cl-mpm/utils:fast-storage f) do
        (assert (joss::reference-finite-p value)))
      (assert (> (magicl:det f) 0d0)))))
(defun vtk-field-p (path field)
  (search (map '(vector (unsigned-byte 8)) #'char-code (format nil "SCALARS ~A " field))
          (cl-user::case-source-bytes path)))

(defun controls (directory)
  (let* ((fw::*input-root* (merge-pathnames "source/inputs/" directory))
         (cl-mpm/framework/config::*schema-path*
           (merge-pathnames "studio/schema.json" fw::*input-root*))
         (fw:*simulation* nil)
         (path (merge-pathnames "cases/benchmarks/damage-slope40.lisp" fw::*input-root*))
         (case nil) (config nil) (sim nil) (count 0) (base 0) (initial-mass 0d0))
    (cl-user::snapshot-verify-file path) (load path)
    (setf case fw:*simulation* config (fw:compile-scenario :damage-slope40 case))
    (control "exact40-straight-unnotched-input-and-rejections"
      (assert (= (gethash "cliffSlope" config) 40d0))
      (near (joss::reference-face-x config 1d0) 23.9175359259421d0)
      (near (joss::reference-face-x config 11d0) 12d0)
      (near (* 10d0 (+ (gethash "shelfAspect" config) (gethash "runoutAspect" config))) 60d0)
      (loop for y from 1d0 to 11d0 by .5d0 do
        (let ((face (- 23.9175359259421d0 (/ (- y 1d0) (tan (* pi (/ 40d0 180d0)))))))
          (near (joss::reference-face-x config y) face)
          (assert (joss::reference-solid-p config (- face 1d-7) y))
          (when (> y 1d0) (assert (not (joss::reference-solid-p config (+ face 1d-7) y))))))
      (near (joss::reference-surface-height config 12d0) 11d0)
      (near (joss::reference-surface-height config 23.9175359259421d0) 1d0)
      (let ((schema (cl-mpm/framework/config:schema)))
        (assert (= (gethash "min" (gethash "cliffSlope" schema)) 45)))
      (dolist (angle '(39d0 41d0 45d0 78d0))
        (let ((changed (alexandria:copy-hash-table (fw:simulation-parameters case))))
          (setf (gethash "cliffSlope" changed) angle)
          (rejects (lambda () (fw:compile-scenario :damage-slope40
            (fw:make-simulation :scenario :damage-slope40 :parameters changed
             :material (fw:simulation-material case) :geometry (fw:simulation-geometry case)
             :boundary (fw:simulation-boundary case) :loading (fw:simulation-loading case)
             :solver (fw:simulation-solver case)))))))
      (let ((smoke (fw::damage-slope40-smoke-case case)))
        (assert (= (gethash "simulationTime" (fw:compile-scenario :damage-slope40 smoke)) 4d0))
        (assert (= (gethash "simulationTime" config) 60d0))))
    (control "native-damage-initialization-and-protected-base"
      (cl-mpm/utils:set-workers 1)
      (setf sim (joss:make-joss-reference-sim config)
            count (length (cl-mpm:sim-mps sim)) initial-mass (mass sim)
            base (count 1 (cl-mpm:sim-mps sim) :key #'cl-mpm/particle::mp-index))
      (assert (and (> count base 0) (> initial-mass 0d0)))
      (assert (typep sim 'joss::joss-reference-aggregate-sim))
      (assert (typep sim 'cl-mpm/damage::mpm-sim-damage))
      (assert (not (cl-mpm::sim-enable-damage sim)))
      (assert (cl-mpm::sim-nonlocal-damage sim))
      (assert-state sim) (assert-base sim)
      (loop for mp across (cl-mpm:sim-mps sim) do
        (assert (typep mp 'joss::joss-reference-chalk))
        (assert (zerop (cl-mpm/particle:mp-damage mp)))
        (assert (not (cl-mpm/particle::mp-enable-damage mp)))
        (assert (not (cl-mpm/particle::mp-enable-plasticity mp)))
        (let* ((position (cl-mpm/particle:mp-position mp))
               (x (cl-mpm/utils:varef position 0)) (y (cl-mpm/utils:varef position 1)))
          (assert (<= 0d0 x 60d0)) (assert (<= 0d0 y 11d0))
          (assert (joss::reference-solid-p config x y))))
      (let ((effective (joss::reference-effective-material sim)))
        (dolist (entry '(("E" . 1d9) ("nu" . .24d0) ("plasticCohesion" . 1965600d0)
                         ("damageInitiationStress" . 18926.452181842527d0)
                         ("ductility" . 53.59975505618717d0) ("nonlocalLength" . .5d0)
                         ("delayTime" . 10d0) ("damageDelayExponent" . 2d0)
                         ("residualTensileRatio" . 1d0) ("residualCompressionRatio" . 0d0)
                         ("residualShearRatio" . .51d0)))
          (near (gethash (car entry) effective) (cdr entry) (* 1d-11 (max 1d0 (abs (cdr entry))))))
        (near (gethash "plasticFrictionRadians" effective) (* pi (/ 50d0 180d0)))
        (near (gethash "damageFrictionRadians" effective) (* pi (/ 50d0 180d0)))
        (setf (gethash "effectiveMaterial" *observations*) effective))
      (cl-mpm/output:save-vtk (merge-pathnames "initial.vtk" directory) sim)
      (setf (gethash "particles" *observations*) count
            (gethash "protectedBaseParticles" *observations*) base
            (gethash "initialMass" *observations*) initial-mass))
    (when (string= cl-user::*damage40-mode* "all")
      (control "two-real-native-damage-enabled-usf-updates-and-vtk"
        ;; Explicit path smoke only: this does NOT claim elastic equilibrium.
        ;; Enable exactly the same initial-material cohort as the native runner.
        (setf (cl-mpm::sim-enable-damage sim) t (cl-mpm::sim-mass-scale sim) 1d0
              (cl-mpm:sim-damping-factor sim) (joss::reference-viscous-damping config 1d-4))
        (loop for mp across (cl-mpm:sim-mps sim) do
          (let ((cliff (/= (cl-mpm/particle::mp-index mp) 1)))
            (setf (cl-mpm/particle::mp-enable-damage mp) cliff
                  (cl-mpm/particle::mp-enable-plasticity mp) cliff)))
        (let ((before-time (cl-mpm::sim-time sim)) (elapsed 0d0))
          (unwind-protect
               (progn (setf *counting* t)
                 (dotimes (i 2)
                   (setf (cl-mpm:sim-dt sim)
                         (cl-mpm/setup:estimate-elastic-dt sim :dt-scale .5d0))
                   (assert (> (cl-mpm:sim-dt sim) 0d0))
                   (incf elapsed (cl-mpm:sim-dt sim))
                   (cl-mpm:update-sim sim)))
            (setf *counting* nil))
          (near (- (cl-mpm::sim-time sim) before-time) elapsed))
        (assert (= *updates* *damage-passes* 2))
        (assert (= *material-attempted* *material-accepted* (* 2 count)))
        (assert (= *damage-attempted* *damage-accepted* (* 2 (- count base))))
        (assert (= (length (cl-mpm:sim-mps sim)) count))
        (near (mass sim) initial-mass (* 1d-12 initial-mass))
        (assert-state sim) (assert-base sim)
        (let ((path (merge-pathnames "after-two-updates.vtk" directory)))
          (cl-mpm/output:save-vtk path sim)
          (dolist (field '("damage" "damage-y" "damage-ybar" "damage-k"))
            (assert (vtk-field-p path field))))
        (setf (gethash "timeAfterTwoUpdates" *observations*) (cl-mpm::sim-time sim)
              (gethash "maximumActualDamage" *observations*)
              (loop for mp across (cl-mpm:sim-mps sim) maximize (cl-mpm/particle:mp-damage mp))))))
  t)
(handler-case (controls cl-user::*damage40-directory*)
  (error (condition) (setf *failure* (list "harness" (princ-to-string condition)))))
(with-open-file (stream (merge-pathnames "result.json" cl-user::*damage40-directory*)
                        :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object "passed" (if *failure* 'yason:false t)
    "passedGroups" (coerce (reverse *passed*) 'vector) "failure" (and *failure* (coerce *failure* 'vector))
    "physicalUpdatesExecuted" *updates* "nativeDamagePasses" *damage-passes*
    "materialCallsAttempted" *material-attempted* "materialCallsAccepted" *material-accepted*
    "enabledDamageCallsAttempted" *damage-attempted* "enabledDamageCallsAccepted" *damage-accepted*
    "observations" *observations* "nativeBackend" (cl-user::snapshot-native-proof)
    "scope" "Owned40-degree geometry and native damage initialization; optional two actual USF updates with real damage path enabled, without equilibrium/onset/collapse/scientific validation") stream))
(setf cl-user::*damage40-exit* (if *failure* 1 0))
