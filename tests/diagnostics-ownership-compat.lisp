;;;; Fresh Windows process; compatibility reloads only, no solver timestep.
;;;; windows\cl-mpm.cmd tests\diagnostics-ownership-compat.lisp [legacy]
(in-package :cl-user)
(defparameter *diagnostic-ownership-mode* (or (first (cl-mpm-script-args)) "normal"))
(if (string= *diagnostic-ownership-mode* "legacy")
    (progn
      (ql:quickload :cl-mpm/setup :silent t)
      (dolist (path '("framework/config/package.lisp" "framework/package.lisp"
                      "framework/components/specifications.lisp" "framework/components/materials.lisp"
                      "framework/components/diagnostics.lisp"))
        (load (cl-mpm-path path))))
    (progn (assert (string= *diagnostic-ownership-mode* "normal"))
           (ql:quickload :cl-mpm-framework :silent t)))
(in-package :cl-mpm/framework)
(defun diagnostic-method-signatures (generic)
  (mapcar (lambda (method)
            (list (sb-mop:method-qualifiers method) (sb-mop:method-specializers method)))
          (sb-mop:generic-function-methods generic)))
(let* ((adapters (mapcar #'material-diagnostics
                        (list (make-material :von-mises)
                              (make-material :native :particle-class 'cl-mpm/particle::particle-mc)
                              (make-material :native :particle-class 'cl-mpm/particle::particle-elastic))))
       (classes (mapcar #'class-of adapters))
       (table (diagnostics-output-ownership (second adapters)))
       (key (gensym "OWNERSHIP"))
       (protocol '(material-diagnostics diagnostics-particle-type diagnostics-modes
                   diagnostics-conventions diagnostics-fields diagnostics-legacy-values))
       (generics (mapcar (lambda (name) (let ((fn (fdefinition name)))
                                        (list name fn (diagnostic-method-signatures fn)))) protocol))
       (metadata (mapcar (lambda (adapter)
                          (list (diagnostics-particle-type adapter) (diagnostics-modes adapter)
                                (diagnostics-conventions adapter)
                                (mapcar (lambda (field) (append (subseq field 0 3) (last field)))
                                        (diagnostics-fields adapter)))) adapters)))
  (setf (gethash key table) :retained)
  (let ((*default-pathname-defaults* (uiop:temporary-directory)))
    (loop repeat 2 do (load (cl-user::cl-mpm-path "framework/components/diagnostics.lisp"))))
  (assert (equal classes (mapcar #'class-of adapters)))
  (assert (eq table (diagnostics-output-ownership (second adapters))))
  (assert (eq :retained (gethash key table)))
  (format t "~&PASS: Existing adapters, class objects and per-simulation ownership survive legacy reload.~%")
  (dolist (entry generics)
    (assert (eq (second entry) (fdefinition (first entry))))
    (assert (null (set-exclusive-or (third entry)
                                  (diagnostic-method-signatures (fdefinition (first entry)))
                                  :test #'equal))))
  (format t "~&PASS: Generic identity and exact method signatures remain compatible.~%")
  (assert (equal metadata
                 (mapcar (lambda (adapter)
                           (list (diagnostics-particle-type adapter) (diagnostics-modes adapter)
                                 (diagnostics-conventions adapter)
                                 (mapcar (lambda (field) (append (subseq field 0 3) (last field)))
                                         (diagnostics-fields adapter)))) adapters)))
  (format t "~&PASS: Native types, modes, conventions and diagnostic descriptors retain values.~%")
  (unless (string= cl-user::*diagnostic-ownership-mode* "legacy")
    (dolist (entry '(("components/diagnostics" "materials/core/diagnostics-interface.lisp")
                     ("components/native-diagnostics" "materials/diagnostics/native.lisp")
                     ("components/material-output" "src/measurements/material-output.lisp")))
      (assert (equal (truename (asdf:component-pathname
                               (asdf:find-component (asdf:find-system "cl-mpm-framework") (first entry))))
                     (truename (cl-user::cl-mpm-path (second entry)))))))
  (format t "~&DIAGNOSTICS OWNERSHIP (~A): 3 passed; no solver run.~%" cl-user::*diagnostic-ownership-mode*))
(uiop:quit 0)
