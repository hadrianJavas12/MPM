(asdf:defsystem "cl-mpm-framework"
  :description "Composable, headless native CL-MPM simulation recipes"
  :depends-on ("cl-mpm" "cl-mpm/setup" "cl-mpm/damage" "cl-mpm/models/chalk"
               "cl-mpm/output" "cl-mpm/penalty" "cl-mpm/plotter" "vgplot"
               "jonathan" "yason" "alexandria" "uiop")
  :serial t
  :components
  (
   (:file "config/package" :pathname "../src/simulation/config/package")
   (:file "config/parameters" :pathname "../src/simulation/config/parameters")
   (:file "package" :pathname "../src/simulation/package")
   (:file "components/base" :pathname "../src/simulation/components/base")
   (:file "components/material-definition" :pathname "../materials/core/definition")
   (:file "components/specifications" :pathname "../src/simulation/components/specifications")
   (:file "components/materials" :pathname "../materials/adapters/native")
   (:file "components/diagnostics" :pathname "../materials/core/diagnostics-interface")
   (:file "components/native-diagnostics" :pathname "../materials/diagnostics/native")
   (:file "components/material-output" :pathname "../src/measurements/material-output")
   (:file "components/geometry" :pathname "../src/simulation/components/geometry")
   (:file "simulation" :pathname "../src/simulation/lifecycle")
   (:file "scenarios/cliff/settings" :pathname "../scenarios/cliff/settings")
   (:file "scenarios/cliff/settings-p4-owner-2" :pathname "../src/numerics/angles")
   (:file "scenarios/cliff/settings-p4-owner-3" :pathname "../scenarios/cliff/solver")
   (:file "materials/chalk" :pathname "../materials/models/chalk/joss-reference")
   (:file "materials/chalk-p4-owner-2" :pathname "../materials/adapters/chalk")
   (:file "scenarios/cliff/geometry" :pathname "../framework/scenarios/cliff/geometry")
   (:file "scenarios/cliff/build" :pathname "../framework/scenarios/cliff/build")
   (:file "output/plotting" :pathname "../src/output/plotting/legacy-particle")
   (:file "scenarios/joss/classes" :pathname "../framework/scenarios/joss/classes")
   (:file "scenarios/joss/statistics" :pathname "../framework/scenarios/joss/statistics")
   (:file "scenarios/joss/phases" :pathname "../framework/scenarios/joss/phases")
   (:file "scenarios/joss/geometry" :pathname "../framework/scenarios/joss/geometry")
   (:file "scenarios/joss/build" :pathname "../framework/scenarios/joss/build")
   (:file "scenarios/joss/measurements" :pathname "../framework/scenarios/joss/measurements")
   (:file "scenarios/joss/output" :pathname "../framework/scenarios/joss/output")
   (:file "scenarios/joss/run" :pathname "../framework/scenarios/joss/run")
   (:file "scenarios/cliff/run" :pathname "../framework/scenarios/cliff/run")
   (:file "scenarios/triaxial/package" :pathname "../framework/scenarios/triaxial/package")
   (:file "scenarios/triaxial/config" :pathname "../framework/scenarios/triaxial/config")
   (:file "scenarios/triaxial/tensors" :pathname "../framework/scenarios/triaxial/tensors")
   (:file "scenarios/triaxial/material" :pathname "../framework/scenarios/triaxial/material")
   (:file "scenarios/triaxial/geometry" :pathname "../framework/scenarios/triaxial/geometry")
   (:file "scenarios/triaxial/boundaries" :pathname "../framework/scenarios/triaxial/boundaries")
   (:file "scenarios/triaxial/measurements" :pathname "../framework/scenarios/triaxial/measurements")
   (:file "scenarios/triaxial/mpm" :pathname "../framework/scenarios/triaxial/mpm")
   (:file "scenarios/triaxial/homogeneous" :pathname "../framework/scenarios/triaxial/homogeneous")
   (:file "scenarios/triaxial/controls" :pathname "../framework/scenarios/triaxial/controls")
   (:file "scenarios/triaxial/runner" :pathname "../framework/scenarios/triaxial/runner")
   (:file "scenarios/triaxial/adapter" :pathname "../framework/scenarios/triaxial/adapter")
   (:file "scenarios/cliff/adapter" :pathname "../framework/scenarios/cliff/adapter")))
