;;;; Native triaxial scenario: config.lisp
(in-package :cl-mpm/calibration/triaxial)

(defun value (config key default)
  (gethash key config default))
(defun num (config key default)
  (let ((v (value config key default)))
    (unless (and (realp v) (not (sb-ext:float-nan-p (float v 1d0)))
                 (not (sb-ext:float-infinity-p (float v 1d0))))
      (error "~A must be finite" key))
    (float v 1d0)))
(defun finite-p (v)
  (and (realp v) (not (sb-ext:float-nan-p (float v 1d0)))
       (not (sb-ext:float-infinity-p (float v 1d0)))))

(defparameter *config-rules*
  '(("mode" :mode "mpm")
    ("diameterMm" :positive 70) ("heightMm" :positive 140)
    ("youngsModulusPa" :positive 5d6) ("poissonRatio" :poisson 0.49d0)
    ("undrainedStrengthPa" :positive 25d3) ("cellPressurePa" :nonnegative 50d3)
    ("densityKgM3" :positive 1800) ("enablePlasticity" :boolean t)
    ("meshSizeMm" :positive 10) ("mpsPerCell" :particle-count 1)
    ("targetAxialStrainPct" :compression-percent 10)
    ("loadingDurationS" :positive 0.2d0) ("rampDurationS" :nonnegative 0.01d0)
    ("timeStepScale" :positive 0.25d0) ("dampingPerS" :nonnegative 100)
    ("frames" :frame-count 51) ("maxUpdates" :positive-integer 100000)
    ("workers" :positive-integer 4) ("penaltyModulusScale" :positive 10)
    ("spatialDimensions" :dimensions 3) ("increments" :positive-integer 1000))
  "Registered backend inputs and historical defaults. New material inputs must be explicit.")

(defun config-value-valid-p (input rule)
  (let* ((finite (handler-case (finite-p input) (arithmetic-error () nil)))
         (integer (and finite (= input (truncate input)))))
    (case rule
      (:mode (and (stringp input) (member input '("mpm" "homogeneous" "controls") :test #'string=)))
      (:boolean (or (eq input t) (null input)))
      (:positive (and finite (> input 0)))
      (:nonnegative (and finite (>= input 0)))
      (:poisson (and finite (< -1 input 0.5d0)))
      (:compression-percent (and finite (< 0 input 30)))
      (:positive-integer (and integer (> input 0)))
      (:frame-count (and integer (>= input 2)))
      (:particle-count (and integer (<= 1 input 3)))
      (:dimensions (and integer (member input '(2 3) :test #'=))))))

(defun validate-config (config)
  "Reject unsupported or invalid backend inputs without changing CONFIG or its defaults."
  (unless (hash-table-p config) (error "Triaxial configuration must be a JSON object/hash table."))
  (maphash (lambda (key input)
             (declare (ignore input))
             (unless (and (stringp key) (assoc key *config-rules* :test #'string=))
               (error "Unknown triaxial parameter ~S" key)))
           config)
  (dolist (entry *config-rules*)
    (destructuring-bind (key rule default) entry
      (let ((input (value config key default)))
        (unless (config-value-valid-p input rule)
          (error "Invalid triaxial parameter ~A: ~S; expected ~A" key input rule)))))
  (let ((mode (value config "mode" "mpm")))
    (when (and (= (value config "spatialDimensions" 3) 2) (not (string= mode "mpm")))
      (error "2D plane strain requires spatial MPM mode; homogeneous/controls require dimensions 3."))
    (when (and (string= mode "mpm")
               (> (value config "rampDurationS" 0.01d0) (value config "loadingDurationS" 0.2d0)))
      (error "rampDurationS must not exceed loadingDurationS in spatial MPM mode."))
    (when (and (string= mode "homogeneous")
               (> (value config "frames" 51) (1+ (value config "increments" 1000))))
      (error "Homogeneous frames must not exceed increments + 1.")))
  config)

(defun json-file (path object)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (yason:encode object stream)))
(defun object (&rest entries)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (k v) on entries by #'cddr do (setf (gethash k h) v)) h))

(defun material-diagnostic-call (name &rest arguments)
  "Optional framework protocol; the historical standalone VM loader stays independent."
  (let* ((package (find-package :cl-mpm/framework))
         (function (and package (find-symbol name package))))
    (unless (and function (fboundp function))
      (error "Material diagnostics require the native framework protocol ~A." name))
    (apply function arguments)))
