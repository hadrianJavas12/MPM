;;;; Native triaxial scenario: homogeneous.lisp
(in-package :cl-mpm/calibration/triaxial)

(defun homogeneous-step (mp axial-log-increment pressure)
  (let* ((old-strain (cl-mpm/utils::voigt-copy (cl-mpm/particle:mp-strain mp)))
         (old-plastic (cl-mpm/particle::mp-strain-plastic-vm mp))
         (old-f (cl-mpm/particle:mp-deformation-gradient mp))
         (old-j (j-of mp)))
    (labels ((trial (radial-log-increment)
               (cl-mpm/utils::voigt-copy-into old-strain (cl-mpm/particle:mp-strain mp))
               (setf (cl-mpm/particle::mp-strain-plastic-vm-1 mp) old-plastic)
               (incf (component (cl-mpm/particle:mp-strain mp) 0) radial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 1) axial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 2) radial-log-increment)
               (let* ((j (* old-j (exp (+ (* 2d0 radial-log-increment) axial-log-increment))))
                      (stress (cl-mpm/particle::constitutive-model
                               mp (cl-mpm/particle:mp-strain mp) 1d0)))
                 (values (+ (/ (component stress 0) j) pressure) j stress))))
      (let ((lo -0.1d0) (hi 0.1d0) (mid 0d0))
        (assert (< (trial lo) 0d0 (trial hi)))
        (dotimes (iteration 70)
          (setf mid (* 0.5d0 (+ lo hi)))
          (if (> (trial mid) 0d0) (setf hi mid) (setf lo mid)))
        (multiple-value-bind (residual j stress) (trial mid)
          (assert (< (abs residual) 1d-5))
          (cl-mpm/utils::voigt-copy-into stress (cl-mpm/particle::mp-stress-kirchoff mp))
          (cl-mpm/fastmaths:fast-scale! stress (/ 1d0 j))
          (setf (magicl:tref old-f 0 0) (* (magicl:tref old-f 0 0) (exp mid))
                (magicl:tref old-f 1 1) (* (magicl:tref old-f 1 1) (exp axial-log-increment))
                (magicl:tref old-f 2 2) (* (magicl:tref old-f 2 2) (exp mid)))
          j)))))

(defun run-homogeneous (sim config directory offset center height)
  (declare (ignore height))
  (let* ((representative (aref (cl-mpm:sim-mps sim) 0))
         (p (num config "cellPressurePa" 50d3))
         (target (* 0.01d0 (num config "targetAxialStrainPct" 10)))
         (increments (round (num config "increments" 1000)))
         (frames (round (num config "frames" 51)))
         (initial (loop for mp across (cl-mpm:sim-mps sim)
                        collect (list (cl-mpm/utils::vector-copy (cl-mpm/particle:mp-position mp))
                                      (cl-mpm/particle:mp-volume mp))))
         (mass (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass))
         (frame 1) (data nil) (previous-log 0d0) (work 0d0))
    (assert (and (<= 2 frames (1+ increments)) (< 0d0 target 0.3d0)))
    (write-frame sim directory 0 0d0 0d0 0 0d0)
    (dotimes (index increments)
      (let* ((engineering (* target (/ (1+ index) increments)))
             (new-log (log (- 1d0 engineering)))
             (increment (- new-log previous-log))
             (j (homogeneous-step representative increment p))
             (f (cl-mpm/particle:mp-deformation-gradient representative)))
        ;; Isotropic cell-pressure traction acts on every face, as in MPM;
        ;; the added platen work therefore uses sigma_yy - (-p), not sigma_yy.
        (incf work (* *initial-volume* j
                      (+ p (component (cl-mpm/particle:mp-stress representative) 1)) increment))
        (setf previous-log new-log)
        (loop for mp across (cl-mpm:sim-mps sim) for saved in initial do
          (unless (eq mp representative)
            (cl-mpm/utils::copy-into f (cl-mpm/particle:mp-deformation-gradient mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-stress representative) (cl-mpm/particle:mp-stress mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle::mp-stress-kirchoff representative)
                                          (cl-mpm/particle::mp-stress-kirchoff mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-strain representative) (cl-mpm/particle:mp-strain mp))
            (setf (cl-mpm/particle::mp-strain-plastic-vm mp)
                  (cl-mpm/particle::mp-strain-plastic-vm representative)
                  (cl-mpm/particle::mp-yield-func mp)
                  (cl-mpm/particle::mp-yield-func representative)
                  (cl-mpm/particle::mp-p-modulus-0 mp)
                  (cl-mpm/particle::mp-p-modulus-0 representative)))
          (setf (cl-mpm/particle:mp-volume mp) (* (second saved) j))
          (dotimes (axis 3)
            (let ((origin (if (= axis 1) offset center)))
              (setf (component (cl-mpm/particle:mp-position mp) axis)
                    (+ origin (* (magicl:tref f axis axis)
                                 (- (component (first saved) axis) origin))))
              (setf (component (cl-mpm/particle::mp-displacement mp) axis)
                    (- (component (cl-mpm/particle:mp-position mp) axis)
                       (component (first saved) axis)))))
          (dotimes (axis 3)
            (setf (component (cl-mpm/particle::mp-domain-size mp) axis)
                  (* (component (cl-mpm/particle::mp-domain-size-0 mp) axis)
                     (magicl:tref f axis axis))
                  (magicl:tref (cl-mpm/particle::mp-true-domain mp) axis axis)
                  (component (cl-mpm/particle::mp-domain-size mp) axis)))
          (cl-mpm/utils::vector-copy-into (cl-mpm/particle:mp-position mp)
                                         (cl-mpm/particle::mp-position-trial mp))
          (cl-mpm/particle::new-loadstep-mp mp))
        (when (>= (1+ index) (* (/ frame (1- frames)) increments))
          (validate-particles sim mass)
          (setf data (write-frame sim directory frame (* engineering 100d0)
                                  0d0 (1+ index) work))
          (incf frame))))
    (values data increments (1- frame))))
