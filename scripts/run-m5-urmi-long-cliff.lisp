;;;; Batch runner for elongated Urmi-geometry long-duration 2D MPM Cliff simulations (L-URMI-LONG-H vs L-URMI-LONG-HS)
(in-package :cl-user)
(require :asdf)
(ql:quickload :cl-mpm-framework :silent t)

(defun run-urmi-long-cliff-batch ()
  (let* ((root (uiop:ensure-directory-pathname (uiop:getcwd)))
         (cases '(("L-URMI-LONG-H"  "cases/cliff/cliff-urmi-long-mc-h.lisp"  "research/cliff/l-urmi-long-h/")
                  ("L-URMI-LONG-HS" "cases/cliff/cliff-urmi-long-mc-hs.lisp" "research/cliff/l-urmi-long-hs/"))))
    (dolist (entry cases)
      (destructuring-bind (id case-rel out-rel) entry
        (let* ((case-path (merge-pathnames case-rel root))
               (out-dir (merge-pathnames out-rel root))
               (manifest-path (merge-pathnames "manifest.json" out-dir)))
          (when (probe-file out-dir)
            (uiop:delete-directory-tree out-dir :validate t :if-does-not-exist :ignore))
          (format t "~&============================================================~%")
          (format t "[M5-URMI-LONG] Starting ~A: ~A -> ~A~%" id case-rel out-rel)
          (finish-output)
          (let ((cl-mpm/framework:*simulation* nil))
            (load case-path)
            (unless cl-mpm/framework:*simulation*
              (error "Case ~A did not set *SIMULATION*" case-path))
            (cl-mpm/framework:run-simulation cl-mpm/framework:*simulation* :output out-dir))
          (unless (probe-file manifest-path)
            (error "Run ~A did not produce manifest.json" id))
          (format t "~&[M5-URMI-LONG] Completed ~A~%" id)
          (finish-output))))
    (format t "~&[M5-URMI-LONG] Both elongated long-duration cliff simulations completed successfully.~%")
    (finish-output)))

(run-urmi-long-cliff-batch)
