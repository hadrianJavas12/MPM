;;;; Execute original existing MC point suite from immutable copied bytes.
;;;; Its UIOP exit is caught only to retain after-source proof; numerical tests unchanged.
(in-package :cl-user)
(require :asdf)
(load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
(let* ((argument (first (cl-mpm-script-args)))
       (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument))))
       (test (cl-mpm-path "tests/materials/mc-evolution-points.lisp")))
  (unless directory (error "Provide fresh output directory."))
  (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
    (error "Output must be fresh."))
  (snapshot-require-fresh-runtime)
  (multiple-value-bind (copied records) (snapshot-case-sources directory test)
    (let* ((target (merge-pathnames "source/control-bootstrap.lisp" directory))
           (bytes (case-source-bytes *load-truename*)))
      (uiop:copy-file *load-truename* target)
      (assert (equalp bytes (case-source-bytes target)))
      (setf copied (append copied (list target))
            records (append records (list (snapshot-object "path" "source/control-bootstrap.lisp"
              "originalPath" (namestring (truename *load-truename*))
              "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes))))))
    (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                         (snapshot-object "scope" "Existing test bytes and full project copied before load; temporary UIOP exit catcher only"
                                          "files" (coerce records 'vector)))
    (let ((*native-snapshot-context* (snapshot-register-native directory records))
          (exit-code 1) (failure nil))
      (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
      (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
            '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
      (snapshot-check-plan "cl-mpm-framework") (ql:quickload :cl-mpm-framework :silent t)
      (write-case-source-provenance directory copied nil)
      (rename-file (merge-pathnames "source-provenance.json" directory)
                   (merge-pathnames "source-provenance-before.json" directory))
      (let ((original-quit (symbol-function 'uiop:quit)))
        (unwind-protect
             (handler-case
                 (setf exit-code
                       (catch 'suite-exit
                         (setf (symbol-function 'uiop:quit)
                               (lambda (&optional (code 0) &rest ignored)
                                 (declare (ignore ignored)) (throw 'suite-exit code)))
                         (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
                         (load (merge-pathnames "source/case.lisp" directory))
                         (error "Suite did not report its exit status.")))
               (error (condition) (setf failure (princ-to-string condition) exit-code 1)))
          (setf (symbol-function 'uiop:quit) original-quit)))
      (dolist (path copied) (snapshot-verify-file path))
      (write-case-source-provenance directory copied nil)
      (let* ((package (find-package "CL-MPM/TESTS/MC-EVOLUTION-POINTS"))
             (checks (and package (find-symbol "*CHECKS*" package)))
             (failures (and package (find-symbol "*FAILURES*" package))))
        (snapshot-write-json (merge-pathnames "result.json" directory)
          (snapshot-object "exitCode" exit-code "passed" (= exit-code 0)
            "passedCount" (if (and checks (boundp checks)) (symbol-value checks) 0)
            "failedCount" (if (and failures (boundp failures)) (length (symbol-value failures)) 0)
            "harnessError" failure "originalTestSha256" (snapshot-sha256 test)
            "copiedTestSha256" (snapshot-sha256 (merge-pathnames "source/case.lisp" directory))
            "copiedSourceCount" (length records) "allSourceHashesVerifiedAfter" t
            "scope" "Existing material-point suite; unchanged numerical test bytes, temporary exit catcher restored; no full slope simulation")))
      (uiop:quit exit-code))))
