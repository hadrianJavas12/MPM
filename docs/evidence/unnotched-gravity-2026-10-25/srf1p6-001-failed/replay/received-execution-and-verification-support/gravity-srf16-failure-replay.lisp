;;;; ONE actual perfect-MC failure replay; zero MPM steps; production returns unchanged.
;;;; windows\cl-mpm.cmd tests\benchmarks\gravity-slope-failure-replay.lisp OUTPUT FAILED_RUN
(in-package :cl-user)
(require :asdf)
(defvar *gravity-replay-frozen* nil)
(defvar *gravity-replay-directory* nil)
(defvar *gravity-replay-records* nil)
(defvar *gravity-replay-exit-code* 0)
(unless *gravity-replay-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let* ((args (cl-mpm-script-args))
         (directory (and (first args) (uiop:ensure-directory-pathname (merge-pathnames (first args)))))
         (failed (and (second args) (uiop:ensure-directory-pathname (merge-pathnames (second args))))))
    (unless (and directory failed) (error "Provide fresh OUTPUT and existing FAILED_RUN."))
    (when (and (probe-file directory)
               (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Replay output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((original (merge-pathnames "mc-integration-failure.json" failed))
             (target (merge-pathnames "source/inputs/mc-integration-failure.json" directory))
             (bytes (case-source-bytes original))
             (comparisons nil))
        (ensure-directories-exist target) (uiop:copy-file original target)
        (unless (equalp bytes (case-source-bytes target)) (error "Capsule copy changed bytes."))
        (setf copied (append copied (list target))
              records (append records (list (snapshot-object
                       "path" (enough-namestring target directory)
                       "originalPath" (namestring (truename original))
                       "bytes" (length bytes) "sha256" (snapshot-sha256-bytes bytes)))))
        ;; Every MC module and the mapped backend must match the actual failed
        ;; run, before any project package or first-party FASL is loaded.
        (dolist (row records)
          (let ((relative (gethash "path" row)))
            (when (and (not (equal relative "source/case.lisp"))
                       (probe-file (merge-pathnames relative failed)))
              (let* ((old (merge-pathnames relative failed))
                     (before (snapshot-sha256 old)) (after (gethash "sha256" row)))
                (unless (string= before after) (error "Replay source differs from failed bytes: ~A" relative))
                (push (snapshot-object "path" relative "failedSha256" before "replaySha256" after) comparisons)))))
        (unless (= (length comparisons) 281) (error "Incomplete failed MC source comparison."))
        (snapshot-write-json (merge-pathnames "failed-source-comparison.json" directory)
                             (snapshot-object "allComparedBytesIdentical" t
                              "files" (coerce (nreverse comparisons) 'vector)))
        (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                             (snapshot-object "scope" "Copied before first-party load; actual failed MC bytes and DLL matched"
                                              "files" (coerce records 'vector)))
        (let ((*native-snapshot-context* (snapshot-register-native directory records))
              (*gravity-replay-frozen* t) (*gravity-replay-directory* directory)
              (*gravity-replay-records* records))
          (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
          (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
                '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
          (dolist (system '("yason" "cl-mpm" "cl-mpm/models/mc-evolution"))
            (snapshot-check-plan system) (ql:quickload system :silent t))
          (snapshot-native-proof)
          (write-case-source-provenance directory copied nil)
          (rename-file (merge-pathnames "source-provenance.json" directory)
                       (merge-pathnames "source-provenance-before.json" directory))
          (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                               (snapshot-object "files" (coerce (mapcar (lambda (path)
                                (snapshot-object "path" (enough-namestring path directory)
                                                 "sha256" (snapshot-sha256 path))) copied) 'vector)))
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (rename-file (merge-pathnames "source-provenance.json" directory)
                       (merge-pathnames "source-provenance-after.json" directory))
          (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                               (snapshot-object "files" (coerce (mapcar (lambda (path)
                                (snapshot-object "path" (enough-namestring path directory)
                                                 "sha256" (snapshot-sha256 path))) copied) 'vector)))))))
  (uiop:quit *gravity-replay-exit-code*))


;;;; New tensile/apex diagnostic body follows.
(defpackage :cl-mpm/tests/gravity-tensile-replay
  (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution)))
(in-package :cl-mpm/tests/gravity-tensile-replay)
(setf *read-default-float-format* 'double-float)
(defun object (&rest entries) (apply #'cl-user::snapshot-object entries))
(defun json-boolean (value) (if value t 'yason:false))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*gravity-replay-directory*)
                          :direction :output :if-exists :error)
    (yason:encode value stream)))
(defparameter *capsule-path* (merge-pathnames "source/inputs/mc-integration-failure.json"
                                             cl-user::*gravity-replay-directory*))
(defparameter *capsule-before* (cl-user::case-source-bytes *capsule-path*))
(defparameter *capsule* (with-open-file (stream *capsule-path*)
                        (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defparameter *calls* 0)
(defparameter *physical-updates* 0)
(defparameter *frame-observations* nil)
(defparameter *candidate-observations* nil)
(defparameter *admissibility-observations* nil)
(defparameter *negative-bound-observations* nil)
(defparameter *condition* nil)
(defparameter *returned* nil)
(defparameter *restored* nil)

(defun candidate-data (candidate)
  (if (null candidate) (object "present" 'yason:false)
      (object "present" t "active" (coerce (mc:projection-active candidate) 'vector)
       "tauSortedKirchhoffPa" (copy-seq (mc:projection-tau candidate))
       "meanKirchhoffPa" (/ (reduce #'+ (mc:projection-tau candidate)) 3d0)
       "plasticPrincipalIncrement" (copy-seq (mc:projection-plastic-increment candidate))
       "plasticIncrementTrace" (reduce #'+ (mc:projection-plastic-increment candidate))
       "multipliers" (copy-seq (mc:projection-multipliers candidate))
       "allPlaneResidualsPa" (copy-seq (mc:projection-residuals candidate))
       "maximumPlaneResidualPa" (mc:projection-max-residual candidate)
       "kappa" (mc:projection-kappa candidate) "workKirchhoffPa" (mc:projection-work candidate)
       "cohesionPa" (mc:projection-cohesion candidate)
       "phiRad" (mc:projection-phi candidate) "psiRad" (mc:projection-psi candidate))))

;; Wrappers observe only calls made by this ONE unchanged principal return.
;; They preserve all values/booleans and are restored before proof/output.
(let ((frame-function (symbol-function 'mc::eval-frame-active))
      (candidate-function (symbol-function 'mc::fixed-kappa-candidate))
      (admissible-function (symbol-function 'mc::admissible-candidate-p))
      (negative-function (symbol-function 'mc::negative-multiplier-backward-error))
      (project-function (symbol-function 'mc:project-principal))
      (update-function (symbol-function 'cl-mpm:update-sim)))
  (unwind-protect
       (progn
         (setf (symbol-function 'mc::eval-frame-active)
               (lambda (frame old active)
                 (let ((answer (multiple-value-list (funcall frame-function frame old active))))
                   (push (object "active" (coerce active 'vector)
                          "kappaCoordinate" (mc::kappa-frame-kappa frame)
                          "oldKappa" old "rhs6Pa" (copy-seq (mc::kappa-frame-rhs frame))
                          "activeStressMatrixPa"
                          (coerce (loop for a in active collect
                            (coerce (loop for b in active collect
                              (aref (mc::kappa-frame-g frame) a b)) 'vector)) 'vector)
                          "historyResidual" (first answer)
                          "localMultipliers" (and (second answer) (copy-seq (second answer)))
                          "linearSolveReturnedValues" (json-boolean (and (first answer) (second answer))))
                         *frame-observations*)
                   (values-list answer)))
               (symbol-function 'mc::fixed-kappa-candidate)
               (lambda (&rest arguments)
                 (let ((answer (multiple-value-list (apply candidate-function arguments))))
                   (push (object "requestedActive" (coerce (eighth arguments) 'vector)
                          "kappaCoordinate" (seventh arguments)
                          "historyResidual" (second answer) "candidate" (candidate-data (first answer)))
                         *candidate-observations*)
                   (values-list answer)))
               (symbol-function 'mc::admissible-candidate-p)
               (lambda (candidate residual tolerance)
                 (let ((answer (funcall admissible-function candidate residual tolerance)))
                   (push (object "acceptedByUnchangedPredicate" (json-boolean answer)
                          "historyResidual" residual "stressTolerancePa" tolerance
                          "candidate" (candidate-data candidate)) *admissibility-observations*)
                   answer))
               (symbol-function 'mc::negative-multiplier-backward-error)
               (lambda (candidate shear bulk)
                 (let ((answer (funcall negative-function candidate shear bulk)))
                   (push (object "errorPa" answer "candidate" (candidate-data candidate))
                         *negative-bound-observations*)
                   answer))
               (symbol-function 'mc:project-principal)
               (lambda (&rest arguments) (incf *calls*) (apply project-function arguments))
               (symbol-function 'cl-mpm:update-sim)
               (lambda (&rest arguments)
                 (declare (ignore arguments)) (incf *physical-updates*)
                 (error "This pure diagnostic forbids MPM updates.")))
         (handler-case (setf *returned* (mc:replay-integration-diagnostic *capsule*))
           (mc:material-integration-error (condition) (setf *condition* condition))))
    (setf (symbol-function 'mc::eval-frame-active) frame-function
          (symbol-function 'mc::fixed-kappa-candidate) candidate-function
          (symbol-function 'mc::admissible-candidate-p) admissible-function
          (symbol-function 'mc::negative-multiplier-backward-error) negative-function
          (symbol-function 'mc:project-principal) project-function
          (symbol-function 'cl-mpm:update-sim) update-function)
    (setf *restored* (and (eq (symbol-function 'mc::eval-frame-active) frame-function)
                         (eq (symbol-function 'mc::fixed-kappa-candidate) candidate-function)
                         (eq (symbol-function 'mc::admissible-candidate-p) admissible-function)
                         (eq (symbol-function 'mc::negative-multiplier-backward-error) negative-function)
                         (eq (symbol-function 'mc:project-principal) project-function)
                         (eq (symbol-function 'cl-mpm:update-sim) update-function)))))

(let* ((law (gethash "law" *capsule*))
       (trial (gethash "trialKirchhoffPa" *capsule*))
       (j (gethash "deformationJacobian" *capsule*))
       (e (gethash "youngsModulusPa" *capsule*))
       (nu (gethash "poissonRatio" *capsule*))
       (g (/ e (* 2d0 (+ 1d0 nu)))) (bulk (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
       (cohesion (aref (aref (gethash "cohesionPoints" law) 0) 1))
       (phi (* pi (/ (aref (aref (gethash "points" law) 0) 1) 180d0)))
       (mean (/ (reduce #'+ trial) 3d0))
       (apex (/ (* j cohesion (cos phi)) (sin phi)))
       (excess (- mean apex))
       (tolerance (+ mc::+stress-atol+ (* mc::+stress-rtol+ (max 1d0 (mc::max-abs3 trial)))))
       (tolerance-mean-bound (/ tolerance (* 2d0 (sin phi))))
       (hypothetical-volume (/ excess bulk))
       (hypothetical-plastic
         (map 'vector (lambda (value) (+ (/ (- value mean) (* 2d0 g))
                                          (/ hypothetical-volume 3d0))) trial))
       (capsule-unchanged (equalp *capsule-before* (cl-user::case-source-bytes *capsule-path*)))
       (expected (and (= *calls* 1) (zerop *physical-updates*) *restored* capsule-unchanged
                      *condition* (string= (gethash "reason" *capsule*)
                                          (mc:integration-error-reason *condition*)))))
  (write-json "tensile-apex-math.json"
   (object "scope" "Algebra on captured pure-return inputs; hypothetical apex is NOT an executed or approved constitutive return"
    "trialKirchhoffPa" (copy-seq trial) "youngsModulusPa" e "poissonRatio" nu
    "suppliedJ" j "cohesionCauchyPa" cohesion "phiRad" phi "psiRad" 0d0
    "shearModulusPa" g "bulkModulusPa" bulk "trialTraceKirchhoffPa" (reduce #'+ trial)
    "trialMeanKirchhoffPa" mean "cauchyApexMeanBoundPa" (/ apex j)
    "kirchhoffApexMeanBoundPa" apex "meanAboveApexBoundPa" excess
    "unchangedStressTolerancePa" tolerance "necessaryMeanToleranceAllowancePa" tolerance-mean-bound
    "meanExcessBeyondTolerancePa" (- excess tolerance-mean-bound)
    "sumSixPlaneResidualsNecessaryPa" (* 12d0 (sin phi) excess)
    "permittedSumIfAllPlanesAdmissiblePa" (* 6d0 tolerance)
    "regularPsiZeroFlowTraces" (map 'vector (lambda (flow) (reduce #'+ flow)) (mc::plane-vectors 0d0))
    "proof" "Every psi0 regular flow has zero trace; tau=trial-D*dep preserves trial mean. Sum of six MC plane residuals is12*sin(phi)*(p-J*c*cot(phi)). Positive excess beyond stress tolerance excludes every psi0 regular return, independently of root search."
    "hypotheticalFullComplianceApexTauPa" (vector apex apex apex)
    "hypotheticalRequiredPlasticVolume" hypothetical-volume
    "hypotheticalPlasticPrincipalIncrement" hypothetical-plastic
    "hypotheticalApexPlasticWorkKirchhoffPa" (* apex hypothetical-volume)
    "flowLimitation" "Positive volumetric plastic flow is required to reach this apex; regular psi0 forbids it. Positive work alone does not authorize an added apex flow, clamp, tensile cap or altered strength."))
  (write-json "replay-result.json"
   (object "passed" (json-boolean expected) "expectedRejection" (json-boolean expected)
    "actualPrincipalReplayCalls" *calls* "physicalUpdates" *physical-updates*
    "productionFunctionsRestored" (json-boolean *restored*) "capsuleUnchanged" (json-boolean capsule-unchanged)
    "actualInputs" *capsule* "capsuleSha256" (cl-user::snapshot-sha256 *capsule-path*)
    "reason" (and *condition* (mc:integration-error-reason *condition*))
    "details" (and *condition* (prin1-to-string (mc:integration-error-details *condition*)))
    "unexpectedReturnedProjection" (and *returned* (candidate-data *returned*))
    "nativeBackend" (cl-user::snapshot-native-proof)
    "frameObservations" (coerce (nreverse *frame-observations*) 'vector)
    "candidateObservations" (coerce (nreverse *candidate-observations*) 'vector)
    "admissibilityObservations" (coerce (nreverse *admissibility-observations*) 'vector)
    "negativeMultiplierFilterObservations" (coerce (nreverse *negative-bound-observations*) 'vector)
    "rollback" "Pure input bytes unchanged. Whole-MPM/particle rollback NOT_EXECUTED: capsule has no full material-point/simulation state."
    "scope" "ONE original frozen production principal return; observation wrappers preserve all values and are restored; zero MPM steps; no numerical/model/tolerance changes"))
  (setf cl-user::*gravity-replay-exit-code* (if expected 0 1))
  (format t "~&SRF1.6 ORIGINAL REPLAY: principalCalls=~D MPM=~D expectedRejection=~S meanExcess=~,12E Pa.~%"
          *calls* *physical-updates* expected excess))
