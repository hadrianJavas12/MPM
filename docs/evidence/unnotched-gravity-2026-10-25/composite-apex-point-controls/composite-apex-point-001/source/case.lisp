;;;; Opt-in perfect-Cauchy composite-apex controls; no mesh or MPM updates.
;;;; windows\cl-mpm.cmd tests\materials\mc-composite-apex.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *ca-frozen* nil)
(defvar *ca-output* nil)
(defvar *ca-exit* 1)
(unless *ca-frozen* (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *ca-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh control output directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (let* ((from (cl-mpm-path "output/unnotched-gravity-2026-10-25/srf1p6-001/mc-integration-failure.json"))
             (to (merge-pathnames "source/inputs/strict-srf16-capsule.json" directory))
             (bytes (case-source-bytes from))
             (sha "d557e0d82e1f1a2dd11e4365db0794076ea6397b6eab1257caec0ad101f6ef17"))
        (assert (string= sha (snapshot-sha256-bytes bytes)))
        (ensure-directories-exist to)
        (with-open-file (stream to :direction :output :if-exists :error :element-type '(unsigned-byte 8))
          (write-sequence bytes stream))
        (assert (equalp bytes (case-source-bytes to)))
        (push to copied)
        (push (snapshot-object "path" "source/inputs/strict-srf16-capsule.json"
               "originalPath" (namestring (truename from)) "bytes" (length bytes) "sha256" sha) records))
      (dolist (required '("source/materials/models/plastic/mc-composite-apex/package.lisp"
                          "source/materials/models/plastic/mc-composite-apex/projection.lisp"
                          "source/materials/models/plastic/mc-composite-apex/native.lisp"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required new model was not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "New optional model/test and actual strict capsule data copied before project load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*ca-frozen* t) (*ca-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/mc-composite-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory)
                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (rename-file (merge-pathnames "source-provenance.json" directory)
                       (merge-pathnames "source-provenance-after.json" directory))
          (proof "source-proof-after.json")))))
  (uiop:quit *ca-exit*))

(defpackage :cl-mpm/tests/mc-composite-apex (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution)
                    (:ap :cl-mpm/models/mc-composite-apex)))
(in-package :cl-mpm/tests/mc-composite-apex)
(defvar *passed* nil)
(defvar *failures* nil)
(defvar *point-calls* 0)
(defvar *strict-calls* 0)
(defvar *native-calls* 0)
(defvar *physical-updates* 0)
(defvar *observations* (make-hash-table :test #'equal))
(defconstant +e+ 1d8)
(defconstant +nu+ .3d0)
(defparameter *pairs* '((0 1) (0 2) (1 0) (1 2) (2 0) (2 1)))
(defmacro control (name &body body)
  `(handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
     (error (condition) (push (list ,name (princ-to-string condition)) *failures*)
       (format t "~&FAIL: ~A: ~A~%" ,name condition))))
(defun near (actual expected &optional (tol 1d-12))
  (unless (and (mc::finite-real-p actual) (<= (abs (- actual expected)) tol))
    (error "Expected ~,17G actual ~,17G tolerance ~G" expected actual tol)))
(defun near-vector (actual expected tolerance)
  (assert (= (length actual) (length expected)))
  (dotimes (i (length actual)) (near (elt actual i) (elt expected i) tolerance)))
(defun maxabs (v) (reduce #'max v :key #'abs))
(defun tolerance (trial) (+ mc::+stress-atol+ (* mc::+stress-rtol+ (max 1d0 (maxabs trial)))))
(defun shear (e nu) (/ e (* 2d0 (+ 1d0 nu))))
(defun bulk (e nu) (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
(defun mean3 (v) (/ (+ (elt v 0) (elt v 1) (elt v 2)) 3d0))
(defun kappa-increment (v)
  (let ((p (mean3 v)))
    (sqrt (* (/ 2d0 3d0) (loop for i below 3 sum (expt (- (elt v i) p) 2))))))
(defun law (&key (variant :perfect) (c 1d4) (phi 30d0) (psi 0d0) (measure :cauchy))
  (mc:make-evolution-law :variant variant
    :points (if (eq variant :h) (list (list 0d0 phi) (list .037d0 phi)) (list (list 0d0 phi)))
    :cohesion c :psi psi :stress-measure measure
    :strain-assumption "Synthetic perfect-MC composite-apex control; no laboratory calibration"))
(defun project (trial material &optional (j 1d0) (old 0d0) (e +e+) (nu +nu+))
  (incf *point-calls*) (ap:project-principal-with-apex trial e nu j material old))
(defun strict (trial material &optional (j 1d0) (old 0d0))
  (incf *strict-calls*) (mc:project-principal trial +e+ +nu+ j material old))
(defun capture (thunk)
  (handler-case (list :returned (funcall thunk))
    (mc:material-integration-error (condition)
      (list :rejected (mc:integration-error-reason condition)
            (mc:integration-error-details condition)))))
(defun fingerprint (value &optional seen)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value)) (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value) seen) (fingerprint (cdr value) seen)))
        ((arrayp value) (list :array (array-dimensions value)
                         (loop for i below (array-total-size value)
                               collect (fingerprint (row-major-aref value i) seen))))
        ((or (typep value 'structure-object) (typep value 'standard-object))
         (if (member value seen :test #'eq) :cycle
             (list (class-name (class-of value))
              (loop for slot in (sb-mop:class-slots (class-of value))
                    for name = (sb-mop:slot-definition-name slot)
                    collect (list name (if (slot-boundp value name)
                      (fingerprint (slot-value value name) (cons value seen)) :unbound))))))
        (t (error "Unhandled owned-state value ~S" (type-of value)))))
(defun hooke (increment e nu)
  (let ((g (shear e nu)) (lame (/ (* e nu) (* (+ 1d0 nu) (- 1d0 (* 2d0 nu)))))
        (trace (reduce #'+ increment)))
    (map 'vector (lambda (x) (+ (* 2d0 g x) (* lame trace))) increment)))
(defun verify-apex (result trial material j old &optional (e +e+) (nu +nu+))
  "Independent six-plane, compliance, flow, volume, work and energy checks."
  (assert (typep result 'ap:apex-projection))
  (assert (eq (ap:apex-projection-branch result) :hydrostatic-apex))
  (multiple-value-bind (c phi psi) (mc:law-values material old)
    (near psi 0d0 0d0)
    (let* ((g (shear e nu)) (k (bulk e nu)) (p (mean3 trial))
           (apex (/ (* j c (cos phi)) (sin phi))) (q (/ (- p apex) k))
           (dev (map 'vector (lambda (x) (/ (- x p) (* 2d0 g))) trial))
           (expected (map 'vector (lambda (x) (+ x (/ q 3d0))) dev))
           (plastic (mc:projection-plastic-increment result)) (tau (mc:projection-tau result))
           (tol (tolerance trial)) (flow (vector 0d0 0d0 0d0))
           (residuals (map 'vector (lambda (pair)
             (- (* (+ 1d0 (sin phi)) (elt tau (first pair)))
                (* (- 1d0 (sin phi)) (elt tau (second pair))) (* 2d0 j c (cos phi)))) *pairs*))
           (work (loop for a below 3 sum (* (elt tau a) (elt plastic a))))
           (release (+ (* apex q) (* .5d0 k q q)
                       (* g (loop for x across dev sum (* x x))))))
      (assert (>= q 0d0))
      (near-vector tau (vector apex apex apex) tol)
      (near-vector plastic expected 1d-13)
      (near-vector tau (map 'vector #'- trial (hooke plastic e nu)) tol)
      (near (ap:apex-projection-apex-multiplier result) q 1d-13)
      (near (reduce #'+ plastic) q 1d-13)
      (near (mc:projection-kappa result) (+ old (kappa-increment plastic)) 1d-13)
      (near (mc:projection-cohesion result) c 0d0)
      (near (mc:projection-phi result) phi 0d0)
      (near (mc:projection-psi result) 0d0 0d0)
      (near-vector (mc:projection-residuals result) residuals tol)
      (near (mc:projection-max-residual result) (reduce #'max residuals) tol)
      (assert (every (lambda (x) (<= x tol)) residuals))
      (near (mc:projection-work result) work (* tol (max 1d-12 (maxabs plastic))))
      (near work (* apex q) (* tol (max 1d-12 (maxabs plastic))))
      (assert (>= work (- (* tol (max 1d-12 (maxabs plastic))))))
      (assert (>= (- release work) (- (* tol (max 1d-12 (maxabs plastic))))))
      (assert (= (length (mc:projection-multipliers result)) 6))
      (loop for pair in *pairs* for multiplier across (mc:projection-multipliers result) do
        (assert (>= multiplier 0d0))
        (incf (aref flow (first pair)) multiplier)
        (decf (aref flow (second pair)) multiplier))
      (near-vector flow dev 1d-13)
      result)))
(defun mp (&optional (material (law)) (class 'ap:particle-mc-composite-apex))
  (make-instance class :E +e+ :nu +nu+ :evolution-law material :enable-plasticity t))
(defun native-values (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
(defun strain-from-tau (tau)
  (cl-mpm/utils:voigt-from-list
   (loop for i below 6 collect
     (if (< i 3) (/ (- (elt tau i) (* +nu+ (loop for k below 3 unless (= k i) sum (elt tau k)))) +e+)
         (/ (elt tau i) (shear +e+ +nu+))))))
(defun native-return (particle tau)
  (let* ((strain (strain-from-tau tau)) (before (native-values strain)))
    (incf *native-calls*)
    (let ((returned (cl-mpm/particle:constitutive-model particle strain 1d-4)))
      (near-vector (native-values strain) before 0d0)
      (native-values returned))))
(defun install-j (particle j)
  (let ((f (cl-mpm/particle:mp-deformation-gradient particle)))
    (dotimes (i 3) (dotimes (k 3) (setf (magicl:tref f i k) (if (= i k) 1d0 0d0))))
    (setf (magicl:tref f 0 0) j)) particle)
(defun mutate-projection (particle)
  (let ((p (mc:particle-last-projection particle)))
    (assert (typep p 'ap:apex-projection))
    (incf (aref (mc:projection-tau p) 0) 123d0)
    (incf (aref (mc:projection-plastic-increment p) 1) .25d0)
    (incf (aref (mc:projection-multipliers p) 2) .5d0)
    (setf (ap:apex-projection-apex-multiplier p) 99d0
          (ap:apex-projection-branch p) :mutated)))

(defun run-controls ()
  (control "actual-failed-inputs-new-model"
    (let* ((capsule (with-open-file (stream (merge-pathnames "source/inputs/strict-srf16-capsule.json" cl-user::*ca-output*))
                      (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
           (input-law (gethash "law" capsule))
           (material (law :c (aref (aref (gethash "cohesionPoints" input-law) 0) 1)
                          :phi (aref (aref (gethash "points" input-law) 0) 1)))
           (trial (gethash "trialKirchhoffPa" capsule))
           (j (gethash "deformationJacobian" capsule)) (old (gethash "oldKappa" capsule))
           (result (project trial material j old (gethash "youngsModulusPa" capsule) (gethash "poissonRatio" capsule))))
      (verify-apex result trial material j old)
      (setf (gethash "actualNewModel" *observations*)
        (cl-user::snapshot-object "tauKirchhoffPa" (mc:projection-tau result)
          "plasticPrincipalIncrement" (mc:projection-plastic-increment result)
          "lambdaA" (ap:apex-projection-apex-multiplier result)
          "kappa" (mc:projection-kappa result) "workKirchhoffPa" (mc:projection-work result)
          "scope" "One NEW-model call on retained failed input; no original-projector replay"))))
  (control "hydrostatic-tension-keeps-shear-history"
    (let* ((material (law)) (trial #(4d4 4d4 4d4)) (result (project trial material 1d0 .012d0)))
      (verify-apex result trial material 1d0 .012d0)
      (near (mc:projection-kappa result) .012d0 1d-13)
      (assert (> (ap:apex-projection-apex-multiplier result) 0d0))))
  (control "deviatoric-apex-all-six-permutations"
    (let ((material (law)))
      (dolist (permutation '((0 1 2) (0 2 1) (1 0 2) (1 2 0) (2 0 1) (2 1 0)))
        (let ((trial (map 'vector (lambda (i) (elt #(5d4 4d4 3d4) i)) permutation)))
          (verify-apex (project trial material 1d0 .005d0) trial material 1d0 .005d0)))))
  (control "current-J-and-stiffness-scale"
    (let ((material (law)))
      (dolist (j '(.8d0 1d0 1.5d0))
        (dolist (e '(2d7 1d8))
          (let ((trial #(8d4 5d4 5d4)))
            (verify-apex (project trial material j .003d0 e .25d0) trial material j .003d0 e .25d0))))))
  (control "elastic-and-regular-are-exact-strict-projections"
    (let ((material (law)))
      (dolist (trial '(#(-8d4 -1d5 -9d4) #(-2d4 -12d4 -8d4) #(-2d4 -16d4 -2d4)))
        (let ((expected (strict trial material 1d0 .007d0)) (actual (project trial material 1d0 .007d0)))
          (assert (not (typep actual 'ap:apex-projection)))
          (assert (equalp (fingerprint actual) (fingerprint expected)))))))
  (control "certified-domain-boundary-and-no-rejection-fallback"
    (let* ((material (law :c 0d0)) (phi (nth-value 1 (mc:law-values material 0d0)))
           (tol (tolerance #(0d0 0d0 0d0))) (bound (/ tol (* 2d0 (sin phi))))
           (centre (vector (* 3d0 bound) 0d0 0d0)))
      ;; All stresses remain below 1Pa, so the actual native tolerance is constant.
      (near (tolerance centre) tol 0d0)
      (near (mean3 centre) bound 0d0)
      (dolist (factor '(0.5d0 1d0))
        (let* ((trial (map 'vector (lambda (x) (* factor x)) centre))
               (expected (capture (lambda () (strict trial material))))
               (actual (capture (lambda () (project trial material)))))
          (assert (equalp (fingerprint expected) (fingerprint actual)))
          ;; Inside the band, retain either actual strict success or rejection.
          ;; At equality no zero-residual active regular return can satisfy all
          ;; six residual bounds; rejection must propagate without an apex.
          (when (= factor 1d0) (assert (eq (first actual) :rejected)))))
      (let ((trial (map 'vector (lambda (x) (* 1.5d0 x)) centre)))
        (verify-apex (project trial material) trial material 1d0 0d0))
      (let* ((trial (vector (* .25d0 bound) (* .25d0 bound) (* .25d0 bound)))
             (actual (project trial material)) (expected (strict trial material)))
        (assert (not (typep actual 'ap:apex-projection)))
        (assert (equalp (fingerprint actual) (fingerprint expected))))))
  (control "unsupported-laws-and-invalid-inputs-reject"
    (dolist (material (list (law :variant :hs) (law :variant :h)
                           (law :psi 5d0) (law :psi :associated)
                           (law :measure :kirchhoff) (law :phi 0d0)))
      (assert (eq (first (capture (lambda () (project #(4d4 4d4 4d4) material)))) :rejected)))
    (let ((material (law)) (trial (vector 4d4 4d4 4d4)))
      (dolist (parameters '((0d0 .3d0 1d0 0d0) (1d8 .5d0 1d0 0d0)
                            (1d8 -1d0 1d0 0d0) (1d8 .3d0 0d0 0d0)
                            (1d8 .3d0 -1d0 0d0) (1d8 .3d0 1d0 -1d0)))
        (destructuring-bind (e nu j old) parameters
          (assert (eq (first (capture (lambda () (project trial material j old e nu)))) :rejected))))
      (dolist (bad-trial '(nil #(1d0 2d0) "invalid"))
        (assert (eq (first (capture (lambda () (project bad-trial material)))) :rejected)))))
  (control "pure-return-input-and-output-ownership"
    (let* ((material (law)) (trial (vector 5d4 4d4 3d4))
           (before (fingerprint (list trial material))) (first (project trial material)))
      (incf (aref (mc:projection-tau first) 0) 1d3)
      (incf (aref (mc:projection-plastic-increment first) 1) .1d0)
      (assert (equalp before (fingerprint (list trial material))))
      (verify-apex (project trial material) trial material 1d0 0d0)))
  (control "native-current-J-volume-work-and-engineering-shear"
    (let* ((particle (install-j (mp) 1.5d0)) (trial #(6d4 5d4 4d4 0d0 0d0 4d3))
           (tau (native-return particle trial)) (projection (mc:particle-last-projection particle))
           (plastic (native-values (mc:particle-plastic-increment particle)))
           (q (ap:particle-last-apex-multiplier particle))
           (p (/ (* 1.5d0 1d4 (cos (/ pi 6d0))) (sin (/ pi 6d0))))
           (normal-mean (mean3 plastic))
           (equivalent (sqrt (* (/ 2d0 3d0)
            (+ (loop for i below 3 sum (expt (- (elt plastic i) normal-mean) 2))
               (* .5d0 (loop for i from 3 below 6 sum (expt (elt plastic i) 2))))))))
      (assert (typep projection 'ap:apex-projection)) (assert (ap:particle-last-apex-active particle))
      (near-vector tau (vector p p p 0d0 0d0 0d0) (tolerance trial))
      (near (reduce #'+ (subseq plastic 0 3)) q 1d-13)
      (near (elt plastic 5) (/ 4d3 (shear +e+ +nu+)) 1d-13)
      (near (mc:particle-kappa particle) equivalent 1d-13)
      (near (mc:particle-plastic-volume particle) q 1d-13)
      (near (mc:particle-plastic-work particle) (/ (* p q) 1.5d0) 1d-11)
      (near (cl-mpm/particle::mp-strain-plastic-vm particle) (* 1.5d0 equivalent) 1d-13)))
  (control "native-repeated-trials-use-committed-history"
    (let ((particle (mp)) (trial #(5d4 4d4 3d4 0d0 0d0 0d0)))
      (native-return particle trial)
      (let ((before (fingerprint (mc:snapshot-particle particle))))
        (native-return particle trial)
        (assert (equalp before (fingerprint (mc:snapshot-particle particle)))))))
  (control "derived-projection-deep-copy-and-reusable-restore"
    (let ((source (mp)) (target (mp)))
      (native-return source #(5d4 4d4 3d4 0d0 0d0 0d0))
      (cl-mpm/particle::new-loadstep-mp source)
      (let* ((before (fingerprint (mc:snapshot-particle source))) (saved (mc:snapshot-particle source)))
        (mc:copy-particle-state source target)
        (assert (equalp before (fingerprint (mc:snapshot-particle target))))
        (mutate-projection target)
        (assert (equalp before (fingerprint (mc:snapshot-particle source))))
        (dotimes (i 2)
          (declare (ignore i)) (mutate-projection source)
          (mc:restore-particle source saved)
          (assert (equalp before (fingerprint (mc:snapshot-particle source))))))))
  (control "native-commit-reset-retains-apex-scalar-and-owned-arrays"
    (let ((particle (mp)))
      (native-return particle #(5d4 4d4 3d4 0d0 0d0 0d0))
      (cl-mpm/particle::new-loadstep-mp particle)
      (let ((before (fingerprint (mc:snapshot-particle particle)))
            (q (ap:particle-last-apex-multiplier particle)))
        (assert (> q 0d0)) (assert (ap:particle-last-apex-active particle))
        (near (- (mc:particle-plastic-volume particle) (mc:particle-plastic-volume-committed particle)) 0d0 0d0)
        (native-return particle #(7d4 5d4 4d4 0d0 0d0 0d0))
        (mutate-projection particle)
        (cl-mpm/particle::reset-loadstep-mp particle)
        (assert (equalp before (fingerprint (mc:snapshot-particle particle))))
        (near (ap:particle-last-apex-multiplier particle) q 0d0))))
  (control "rejected-native-law-retains-complete-owned-state"
    (let ((particle (mp)))
      (native-return particle #(5d4 4d4 3d4 0d0 0d0 0d0))
      (cl-mpm/particle::new-loadstep-mp particle)
      (setf (mc:particle-evolution-law particle) (law :variant :hs))
      (let ((before (fingerprint (mc:snapshot-particle particle))))
        (assert (eq (first (capture (lambda () (native-return particle #(6d4 5d4 4d4 0d0 0d0 0d0))))) :rejected))
        (assert (equalp before (fingerprint (mc:snapshot-particle particle)))))))
  (control "native-initialization-and-reinitialization-validate-before-mutation"
    (dolist (arguments (list (list :E 0d0 :nu +nu+ :evolution-law (law))
                             (list :E +e+ :nu .5d0 :evolution-law (law))
                             (list :E +e+ :nu +nu+ :evolution-law (law :variant :hs))))
      (assert (eq (first (capture (lambda ()
        (apply #'make-instance 'ap:particle-mc-composite-apex arguments)))) :rejected)))
    (let ((particle (mp)))
      (native-return particle #(5d4 4d4 3d4 0d0 0d0 0d0))
      (let ((before (fingerprint (mc:snapshot-particle particle))))
        (dolist (arguments (list (list :E 0d0) (list :evolution-law (law :variant :hs))))
          (assert (eq (first (capture (lambda () (apply #'reinitialize-instance particle arguments)))) :rejected))
          (assert (equalp before (fingerprint (mc:snapshot-particle particle))))))))
  (control "derived-class-opt-in-and-elastic-only-native-mode"
    (let ((particle (mp)))
      (assert (typep particle 'mc:particle-mc-evolution))
      (assert (not (typep particle 'cl-mpm/particle::particle-mc)))
      (setf (cl-mpm/particle::mp-enable-plasticity particle) nil)
      (near-vector (native-return particle #(6d4 5d4 4d4 0d0 0d0 0d0)) #(6d4 5d4 4d4 0d0 0d0 0d0) 1d-6)
      (near (mc:particle-kappa particle) 0d0 0d0)
      (near (ap:particle-last-apex-multiplier particle) 0d0 0d0)
      (assert (not (ap:particle-last-apex-active particle))))))

(let ((original (symbol-function 'cl-mpm:update-sim)))
  (unwind-protect
       (progn
         (setf (symbol-function 'cl-mpm:update-sim)
               (lambda (&rest arguments) (declare (ignore arguments))
                 (incf *physical-updates*) (error "Point gate forbids MPM updates.")))
         (run-controls))
    (setf (symbol-function 'cl-mpm:update-sim) original)))
(let ((report (cl-user::snapshot-object
  "passed" (if *failures* 'yason:false t) "passedGroups" (coerce (reverse *passed*) 'vector)
  "failedGroups" (coerce (reverse *failures*) 'vector)
  "explicitNewPureProjectorCalls" *point-calls* "explicitStrictComparatorCalls" *strict-calls*
  "nativeConstitutiveCalls" *native-calls* "physicalUpdateAttempts" *physical-updates*
  "oldOriginalFailureReplayCalls" 0 "nativeBackend" (cl-user::snapshot-native-proof)
  "observations" *observations*
  "scope" "New separate perfect-Cauchy composite-apex material controls; zero MPM; actual strict capsule is input data, not an original-model replay; no landslide or scientific validation")))
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*ca-output*) :direction :output :if-exists :error)
    (yason:encode report stream)))
(setf cl-user::*ca-exit* (if (or *failures* (plusp *physical-updates*)) 1 0))
