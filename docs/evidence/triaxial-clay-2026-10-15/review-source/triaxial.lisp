;;;; Native triaxial compression harness. Units: m, Pa, kg, s.
;;;; No material law, damage field or curve is replaced here.
(defpackage :cl-mpm/calibration/triaxial
  (:use :cl)
  (:export :main))
(in-package :cl-mpm/calibration/triaxial)
(declaim (optimize (speed 2) (safety 1) (debug 1)))
(defvar *initial-height* 0.14d0)
(defvar *initial-volume* 1d0)
(defvar *pressure* 50000d0)

(defun value (config key default)
  (gethash key config default))
(defun num (config key default)
  (let ((v (value config key default)))
    (unless (and (realp v) (not (sb-ext:float-nan-p (float v 1d0)))
                 (not (sb-ext:float-infinity-p (float v 1d0))))
      (error "~A must be finite" key))
    (float v 1d0)))
(defun finite-p (v)
  (and (realp v) (not (sb-ext:float-nan-p (float v 1d0)))
       (not (sb-ext:float-infinity-p (float v 1d0)))))
(defun json-file (path object)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (yason:encode object stream)))
(defun object (&rest entries)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (k v) on entries by #'cddr do (setf (gethash k h) v)) h))
(defun vec (mp key)
  (funcall key mp))
(defun component (matrix i)
  (cl-mpm/utils:varef matrix i))
(defun (setf component) (new-value matrix i)
  (setf (cl-mpm/utils:varef matrix i) new-value))
(defun j-of (mp)
  (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))
(defun q-of (stress)
  (- (* -1d0 (component stress 1))
     (* -0.5d0 (+ (component stress 0) (component stress 2)))))
(defun qj2-of (stress)
  (sqrt (* 3d0 (cl-mpm/fastmaths::voigt-j2
               (cl-mpm/utils::deviatoric-voigt stress)))))

(defun setup (config)
  (let* ((h (* 1d-3 (num config "meshSizeMm" 10)))
         (diameter (* 1d-3 (num config "diameterMm" 70)))
         (height (* 1d-3 (num config "heightMm" 140)))
         (density (num config "densityKgM3" 1800))
         (e (num config "youngsModulusPa" 5d6))
         (nu (num config "poissonRatio" 0.49d0))
         (su (num config "undrainedStrengthPa" 25d3))
         (p (num config "cellPressurePa" 50d3))
         (mps (round (num config "mpsPerCell" 1)))
         (offset (* 3d0 h))
         (center (+ offset (* 0.5d0 diameter)))
         (sim (cl-mpm/setup:make-simple-sim
               h (list (ceiling (+ diameter (* 6 h)) h)
                       (ceiling (+ height (* 6 h)) h)
                       (ceiling (+ diameter (* 6 h)) h))
               :args-list (list :enable-fbar nil :enable-damage nil
                                :ghost-factor nil :enable-split nil))))
    (assert (and (> h 0d0) (> diameter 0d0) (> height 0d0) (> density 0d0)
                 (> e 0d0) (> su 0d0) (>= p 0d0) (< -1d0 nu 0.5d0)
                 (<= 1 mps 3)))
    (cl-mpm:add-mps
     sim (remove-if-not (lambda (mp) (typep mp 'cl-mpm/particle:particle))
          (cl-mpm/setup:make-block-mps
          (list offset offset offset) (list diameter height diameter)
          (mapcar (lambda (length) (* (ceiling length h) mps))
                  (list diameter height diameter))
          density 'cl-mpm/particle::particle-vm
          :E e :nu nu :rho (* (sqrt (/ 8d0 3d0)) su)
          :rho-r (* (sqrt (/ 8d0 3d0)) su) :softening 0d0
          :enable-plasticity (value config "enablePlasticity" t)
          :clip-func (lambda (x y z)
                       (declare (ignore y))
                       (<= (+ (expt (- x center) 2) (expt (- z center) 2))
                           (expt (* diameter 0.5d0) 2))))))
    ;; Initial total isotropic stress is supported by an elastic prestress;
    ;; F=I defines the measured specimen after cell-pressure application.
    (loop for mp across (cl-mpm:sim-mps sim) do
      (dotimes (i 3)
        (setf (component (cl-mpm/particle:mp-strain mp) i)
              (/ (* (- p) (- 1d0 (* 2d0 nu))) e)
              (component (cl-mpm/particle:mp-strain-n mp) i)
              (/ (* (- p) (- 1d0 (* 2d0 nu))) e)
              (component (cl-mpm/particle:mp-stress mp) i) (- p)
              (component (cl-mpm/particle::mp-stress-kirchoff mp) i) (- p))))
    (setf (cl-mpm:sim-gravity sim) 0d0
          (cl-mpm:sim-enable-fbar sim) nil
          (cl-mpm:sim-enable-damage sim) nil
          (cl-mpm:sim-damping-factor sim) (num config "dampingPerS" 100)
          (cl-mpm::sim-velocity-algorithm sim) :FLIP)
    (cl-mpm/setup::set-mass-filter sim density :proportion 1d-12)
    (values sim offset center height diameter)))

;; The virtual constant stress -p I produces the natural pressure traction
;; integral int_boundary N (-p n) dA = int_volume (-p I) grad(N) dV.
;; Thus hydrostatic internal stress cancels exactly in the same quadrature.
(defclass isotropic-pressure (cl-mpm/bc::bc)
  ((pressure :initarg :pressure :reader pressure)))
(defmethod cl-mpm/bc::apply-sim-bc (sim (bc isotropic-pressure) dt)
  (declare (ignore dt))
  (loop for mp across (cl-mpm:sim-mps sim) do
    (let ((scale (* (- (pressure bc)) (cl-mpm/particle:mp-volume mp))))
      (cl-mpm:iterate-over-neighbours
       (cl-mpm:sim-mesh sim) mp
       (lambda (node svp grads fsvp fgrads)
         (declare (ignore svp fsvp fgrads))
         (let ((force (cl-mpm/mesh::node-external-force node)))
           (incf (component force 0) (* scale (cl-mpm/utils::gradients-dx grads)))
           (incf (component force 1) (* scale (cl-mpm/utils::gradients-dy grads)))
           (incf (component force 2) (* scale (cl-mpm/utils::gradients-dz grads)))))))))

(defun validate-particles (sim initial-mass)
  (let ((mass 0d0))
    (loop for mp across (cl-mpm:sim-mps sim) do
      (incf mass (cl-mpm/particle:mp-mass mp))
      (assert (and (> (j-of mp) 0d0) (> (cl-mpm/particle:mp-volume mp) 0d0)))
      (assert (< (abs (- (/ (cl-mpm/particle:mp-volume mp)
                             (cl-mpm/particle::mp-volume-0 mp)) (j-of mp))) 1d-9)
              () "Native volume ratio and det(F) disagree with Fbar disabled")
      (dolist (matrix (list (cl-mpm/particle:mp-position mp)
                            (cl-mpm/particle:mp-velocity mp)
                            (cl-mpm/particle:mp-stress mp)
                            (cl-mpm/particle:mp-deformation-gradient mp)))
        (loop for v across (cl-mpm/utils::fast-storage matrix) do
          (assert (finite-p v) () "Nonfinite native particle field"))))
    (assert (< (abs (- mass initial-mass)) (* 1d-12 initial-mass))) t))

(defun stats (sim)
  (let ((volume 0d0) (mass 0d0) (q 0d0) (qj2 0d0) (axial 0d0)
        (lateral 0d0) (ke 0d0) (elastic 0d0) (plastic 0d0) (jmean 0d0)
        (yield-excess 0d0))
    (loop for mp across (cl-mpm:sim-mps sim) do
      (let* ((v (cl-mpm/particle:mp-volume mp))
             (m (cl-mpm/particle:mp-mass mp))
             (stress (cl-mpm/particle:mp-stress mp))
             (strain (cl-mpm/particle:mp-strain mp))
             (vel (cl-mpm/particle:mp-velocity mp)))
        (incf volume v) (incf mass m)
        (incf q (* v (q-of stress))) (incf qj2 (* v (qj2-of stress)))
        (incf axial (* (- v) (component stress 1)))
        (incf lateral (* -0.5d0 v (+ (component stress 0) (component stress 2))))
        (incf jmean (* v (j-of mp)))
        (incf plastic (* v (cl-mpm/particle::mp-strain-plastic-vm mp)))
        (dotimes (i 3) (incf ke (* 0.5d0 m (expt (component vel i) 2))))
        (dotimes (i 6) (incf elastic (* 0.5d0 v (component stress i) (component strain i))))
        (setf yield-excess (max yield-excess
                               (- (/ (* (qj2-of stress) (j-of mp))
                                     (* (sqrt 1.5d0) (cl-mpm/particle::mp-rho mp))) 1d0)))))
    (list (/ q volume 1000d0) (/ qj2 volume 1000d0) (/ axial volume 1000d0)
          (/ lateral volume 1000d0) volume mass ke elastic (/ plastic volume)
          (/ jmean volume) yield-excess)))

(defun write-frame (sim directory frame strain time update work)
  (let* ((data (stats sim))
         (vtk-name (format nil "particles_~4,'0D.vtk" frame))
         (height (- (loop for mp across (cl-mpm:sim-mps sim)
                          maximize (+ (component (cl-mpm/particle:mp-position mp) 1)
                                      (* 0.5d0 (component (cl-mpm/particle::mp-domain-size mp) 1))))
                    (loop for mp across (cl-mpm:sim-mps sim)
                          minimize (- (component (cl-mpm/particle:mp-position mp) 1)
                                      (* 0.5d0 (component (cl-mpm/particle::mp-domain-size mp) 1)))))))
    (cl-mpm/output:save-vtk (merge-pathnames vtk-name directory) sim)
    (with-open-file (csv (merge-pathnames "stress-strain.csv" directory)
                         :direction :output :if-exists :append)
      (format csv "~D,~D,~,12F,~,12F" frame update strain time)
      (dolist (v data) (format csv ",~,14F" v))
      (format csv ",~,14F,~,12F,~,12F,~,14F~%" work
              (* 100d0 (- 1d0 (/ height *initial-height*)))
              (* 100d0 (- (/ (fifth data) *initial-volume*) 1d0))
              (* (- *pressure*) (- (fifth data) *initial-volume*))))
    (format t "~&TRIAXIAL frame=~D updates=~D strain=~,5F% q=~,5F kPa lateral=~,5F kPa KE=~,4E J~%"
            frame update strain (first data) (fourth data) (seventh data))
    (force-output)
    data))


(defun run-mpm (sim config directory offset height)
  (declare (ignore offset))
  (let* ((p (num config "cellPressurePa" 50d3))
         (e (num config "youngsModulusPa" 5d6))
         (nu (num config "poissonRatio" 0.49d0))
         (epsilon (* (num config "penaltyModulusScale" 10)
                     (cl-mpm/particle::calculate-p-wave-modulus e nu)))
         (top (cl-mpm/penalty::make-bc-penalty-displacment
               sim (cl-mpm/utils:vector-from-list '(0d0 1d0 0d0)) epsilon))
         (bottom (cl-mpm/penalty::make-bc-penalty-displacment
                  sim (cl-mpm/utils:vector-from-list '(0d0 -1d0 0d0)) epsilon))
         (duration (num config "loadingDurationS" 0.2d0))
         (ramp (num config "rampDurationS" 0.01d0))
         (target (* 0.01d0 (num config "targetAxialStrainPct" 10)))
         (frames (round (num config "frames" 51)))
         (max-updates (round (num config "maxUpdates" 100000)))
         (initial-mass (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass))
         (dt (* (num config "timeStepScale" 0.25d0)
                (cl-mpm/setup:estimate-elastic-dt sim)))
         (work 0d0) (last-disp 0d0) (frame 1) (update 0) (data nil))
    (assert (and (> duration 0d0) (<= 0d0 ramp duration) (< 0d0 target 0.3d0)
                 (>= frames 2) (> dt 0d0)))
    (setf (cl-mpm:sim-dt sim) dt)
    (cl-mpm:add-bcs-force-list sim
                             (vector (make-instance 'isotropic-pressure :index nil :pressure p)
                                     top bottom))
    (write-frame sim directory 0 0d0 0d0 0 0d0)
    (format t "~&Native3D particles=~D dt=~E planned-updates=~D~%"
            (length (cl-mpm:sim-mps sim)) dt (ceiling duration dt))
    (loop while (< (cl-mpm::sim-time sim) duration) do
      (when (>= update max-updates) (error "Bounded update cap reached at t=~E" (cl-mpm::sim-time sim)))
      (let* ((next-time (min duration (+ (cl-mpm::sim-time sim) dt)))
             ;; Smooth velocity startup with analytic normalization; final
             ;; prescribed engineering strain is exactly the requested target.
             (progress (/ (if (< next-time ramp)
                              (* 0.5d0 (/ (expt next-time 2) (max ramp 1d-30)))
                              (- next-time (* 0.5d0 ramp)))
                          (- duration (* 0.5d0 ramp))))
             (disp (* (- height) target progress)))
        (setf (cl-mpm:sim-dt sim) (- next-time (cl-mpm::sim-time sim)))
        (cl-mpm/penalty::bc-set-displacement
         top (cl-mpm/utils:vector-from-list (list 0d0 disp 0d0)))
        (cl-mpm:update-sim sim)
        ;; Additional platen work (cell pressure acts separately on all faces).
        (incf work (* (abs (cl-mpm/penalty::resolve-load top)) (- last-disp disp)))
        (setf last-disp disp)
        (incf update)
        (when (or (>= next-time (* (/ frame (1- frames)) duration))
                  (>= next-time duration))
          (validate-particles sim initial-mass)
          (setf data (write-frame sim directory frame (* 100d0 target progress)
                                  next-time update work))
          (incf frame))))
    (values data update (1- frame))))

;; Coaxial homogeneous material-point forward model for fast constitutive fits.
;; Each lateral strain increment is solved so computed CAUCHY sigma_xx=-p.
;; Visualization is the affine F of that constitutive state, not a spatial solve.
(defun homogeneous-step (mp axial-log-increment pressure)
  (let* ((old-strain (cl-mpm/utils::voigt-copy (cl-mpm/particle:mp-strain mp)))
         (old-plastic (cl-mpm/particle::mp-strain-plastic-vm mp))
         (old-f (cl-mpm/particle:mp-deformation-gradient mp))
         (old-j (j-of mp)))
    (labels ((trial (radial-log-increment)
               (cl-mpm/utils::voigt-copy-into old-strain (cl-mpm/particle:mp-strain mp))
               (setf (cl-mpm/particle::mp-strain-plastic-vm-1 mp) old-plastic)
               (incf (component (cl-mpm/particle:mp-strain mp) 0) radial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 1) axial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 2) radial-log-increment)
               (let* ((j (* old-j (exp (+ (* 2d0 radial-log-increment) axial-log-increment))))
                      (stress (cl-mpm/particle::constitutive-model
                               mp (cl-mpm/particle:mp-strain mp) 1d0)))
                 (values (+ (/ (component stress 0) j) pressure) j stress))))
      (let ((lo -0.1d0) (hi 0.1d0) (mid 0d0))
        (assert (< (trial lo) 0d0 (trial hi)))
        (dotimes (iteration 70)
          (setf mid (* 0.5d0 (+ lo hi)))
          (if (> (trial mid) 0d0) (setf hi mid) (setf lo mid)))
        (multiple-value-bind (residual j stress) (trial mid)
          (assert (< (abs residual) 1d-5))
          (cl-mpm/utils::voigt-copy-into stress (cl-mpm/particle::mp-stress-kirchoff mp))
          (cl-mpm/fastmaths:fast-scale! stress (/ 1d0 j))
          (setf (magicl:tref old-f 0 0) (* (magicl:tref old-f 0 0) (exp mid))
                (magicl:tref old-f 1 1) (* (magicl:tref old-f 1 1) (exp axial-log-increment))
                (magicl:tref old-f 2 2) (* (magicl:tref old-f 2 2) (exp mid)))
          j)))))

(defun run-homogeneous (sim config directory offset center height)
  (declare (ignore height))
  (let* ((representative (aref (cl-mpm:sim-mps sim) 0))
         (p (num config "cellPressurePa" 50d3))
         (target (* 0.01d0 (num config "targetAxialStrainPct" 10)))
         (increments (round (num config "increments" 1000)))
         (frames (round (num config "frames" 51)))
         (initial (loop for mp across (cl-mpm:sim-mps sim)
                        collect (list (cl-mpm/utils::vector-copy (cl-mpm/particle:mp-position mp))
                                      (cl-mpm/particle:mp-volume mp))))
         (mass (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass))
         (frame 1) (data nil) (previous-log 0d0) (work 0d0))
    (assert (and (<= 2 frames (1+ increments)) (< 0d0 target 0.3d0)))
    (write-frame sim directory 0 0d0 0d0 0 0d0)
    (dotimes (index increments)
      (let* ((engineering (* target (/ (1+ index) increments)))
             (new-log (log (- 1d0 engineering)))
             (increment (- new-log previous-log))
             (j (homogeneous-step representative increment p))
             (f (cl-mpm/particle:mp-deformation-gradient representative)))
        ;; Isotropic cell-pressure traction acts on every face, as in MPM;
        ;; the added platen work therefore uses sigma_yy - (-p), not sigma_yy.
        (incf work (* *initial-volume* j
                      (+ p (component (cl-mpm/particle:mp-stress representative) 1)) increment))
        (setf previous-log new-log)
        (loop for mp across (cl-mpm:sim-mps sim) for saved in initial do
          (unless (eq mp representative)
            (cl-mpm/utils::copy-into f (cl-mpm/particle:mp-deformation-gradient mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-stress representative) (cl-mpm/particle:mp-stress mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle::mp-stress-kirchoff representative)
                                          (cl-mpm/particle::mp-stress-kirchoff mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-strain representative) (cl-mpm/particle:mp-strain mp))
            (setf (cl-mpm/particle::mp-strain-plastic-vm mp)
                  (cl-mpm/particle::mp-strain-plastic-vm representative)
                  (cl-mpm/particle::mp-yield-func mp)
                  (cl-mpm/particle::mp-yield-func representative)
                  (cl-mpm/particle::mp-p-modulus-0 mp)
                  (cl-mpm/particle::mp-p-modulus-0 representative)))
          (setf (cl-mpm/particle:mp-volume mp) (* (second saved) j))
          (dotimes (axis 3)
            (let ((origin (if (= axis 1) offset center)))
              (setf (component (cl-mpm/particle:mp-position mp) axis)
                    (+ origin (* (magicl:tref f axis axis)
                                 (- (component (first saved) axis) origin))))
              (setf (component (cl-mpm/particle::mp-displacement mp) axis)
                    (- (component (cl-mpm/particle:mp-position mp) axis)
                       (component (first saved) axis)))))
          (dotimes (axis 3)
            (setf (component (cl-mpm/particle::mp-domain-size mp) axis)
                  (* (component (cl-mpm/particle::mp-domain-size-0 mp) axis)
                     (magicl:tref f axis axis))
                  (magicl:tref (cl-mpm/particle::mp-true-domain mp) axis axis)
                  (component (cl-mpm/particle::mp-domain-size mp) axis)))
          (cl-mpm/utils::vector-copy-into (cl-mpm/particle:mp-position mp)
                                         (cl-mpm/particle::mp-position-trial mp))
          (cl-mpm/particle::new-loadstep-mp mp))
        (when (>= (1+ index) (* (/ frame (1- frames)) increments))
          (validate-particles sim mass)
          (setf data (write-frame sim directory frame (* engineering 100d0)
                                  0d0 (1+ index) work))
          (incf frame))))
    (values data increments (1- frame))))

(defun run-controls (config directory)
  "Analytical constitutive checks and native3D hydrostatic equilibrium control."
  (let ((results (make-hash-table :test 'equal))
        (p (num config "cellPressurePa" 50d3))
        (e (num config "youngsModulusPa" 5d6))
        (su (num config "undrainedStrengthPa" 25d3)))
    (setf (gethash "enablePlasticity" config) nil)
    (let* ((sim (setup config)) (mp (aref (cl-mpm:sim-mps sim) 0))
           (strain 1d-6))
      (homogeneous-step mp (log (- 1d0 strain)) p)
      (let* ((q (q-of (cl-mpm/particle:mp-stress mp)))
             (relative (abs (- (/ q (* e strain)) 1d0))))
        (assert (< relative 1d-4) () "Native elastic tangent differs from E: ~E" relative)
        (setf (gethash "elasticTangentRelativeError" results) relative)))
    (setf (gethash "enablePlasticity" config) t)
    (let* ((sim (setup config)) (mp (aref (cl-mpm:sim-mps sim) 0))
           (previous-log 0d0) (max-pressure-error 0d0))
      (dotimes (index 100)
        (let ((next-log (log (- 1d0 (* 0.05d0 (/ (1+ index) 100d0))))))
          (homogeneous-step mp (- next-log previous-log) p)
          (setf previous-log next-log)
          (setf max-pressure-error
                (max max-pressure-error
                     (abs (+ p (component (cl-mpm/particle:mp-stress mp) 0)))))))
      (let* ((q-tau (* (j-of mp) (qj2-of (cl-mpm/particle:mp-stress mp))))
             (relative (abs (- (/ q-tau (* 2d0 su)) 1d0))))
        (assert (< relative 1d-7) () "Native Kirchhoff yield radius mismatch ~E" relative)
        (assert (< max-pressure-error 1d-5))
        (setf (gethash "plasticYieldRelativeError" results) relative
              (gethash "lateralStressControlMaxErrorPa" results) max-pressure-error
              (gethash "finalPlasticStrain" results) (cl-mpm/particle::mp-strain-plastic-vm mp)
              (gethash "finalJHomogeneous" results) (j-of mp))))
    (let* ((sim (setup config))
           (mass (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-mass))
           (positions (loop for mp across (cl-mpm:sim-mps sim)
                            collect (cl-mpm/utils:vector-copy (cl-mpm/particle:mp-position mp)))))
      (setf (cl-mpm:sim-dt sim) (* 0.25d0 (cl-mpm/setup:estimate-elastic-dt sim)))
      (cl-mpm:add-bcs-force-list sim
                               (vector (make-instance 'isotropic-pressure :index nil :pressure p)))
      (dotimes (index 20) (cl-mpm:update-sim sim))
      (validate-particles sim mass)
      (let ((max-displacement 0d0) (max-q 0d0) (max-volume-f-error 0d0))
        (loop for mp across (cl-mpm:sim-mps sim) for original in positions do
          (dotimes (axis 3)
            (setf max-displacement (max max-displacement
                                        (abs (- (component (cl-mpm/particle:mp-position mp) axis)
                                                (component original axis))))))
          (setf max-q (max max-q (qj2-of (cl-mpm/particle:mp-stress mp)))
                max-volume-f-error (max max-volume-f-error
                                        (abs (- (/ (cl-mpm/particle:mp-volume mp)
                                                   (cl-mpm/particle::mp-volume-0 mp))
                                                (j-of mp))))))
        (assert (< max-displacement 1d-12))
        (assert (< max-q 1d-6))
        (assert (< max-volume-f-error 1d-12))
        (setf (gethash "hydrostatic3DUpdates" results) 20
              (gethash "hydrostatic3DParticles" results) (length (cl-mpm:sim-mps sim))
              (gethash "hydrostaticMaxDisplacementM" results) max-displacement
              (gethash "hydrostaticMaxDeviatoricStressPa" results) max-q
              (gethash "hydrostaticMaxVolumeFRelativeError" results) max-volume-f-error)))
    (setf (gethash "passed" results) t
          (gethash "scope" results) "analytical elastic tangent, native Kirchhoff VM yield, constant Cauchy lateral stress, native3D hydrostatic pressure balance; not scientific validation")
    (json-file (merge-pathnames "controls.json" directory) results)
    (format t "~&TRIAXIAL NATIVE CONTROLS PASSED~%")
    results))

(defun main (args)
  (let* ((config-path (or (first args) (cl-user::cl-mpm-path "calibration/triaxial-demo.json")))
         (config (with-open-file (in config-path) (yason:parse in)))
         (directory (uiop:ensure-directory-pathname
                     (or (second args) (cl-user::cl-mpm-path "output/triaxial-demo/"))))
         (mode (value config "mode" "mpm"))
         (start (get-internal-real-time)))
    (when (probe-file (merge-pathnames "stress-strain.csv" directory))
      (error "Output already contains a run: ~A. Choose a fresh directory." directory))
    (ensure-directories-exist directory)
    (json-file (merge-pathnames "effective-config.json" directory) config)
    (cl-mpm/utils:set-workers (round (num config "workers" 4)))
    (when (string= mode "controls")
      (run-controls config directory)
      (return-from main t))
    (multiple-value-bind (sim offset center height diameter) (setup config)
      (declare (ignore diameter))
      (setf *initial-height* height
            *initial-volume* (reduce #'+ (cl-mpm:sim-mps sim) :key #'cl-mpm/particle:mp-volume)
            *pressure* (num config "cellPressurePa" 50d3))
      (with-open-file (csv (merge-pathnames "stress-strain.csv" directory)
                           :direction :output :if-exists :supersede)
        (format csv "frame,updates,axial_strain_pct,time_s,deviatoric_stress_kpa,q_j2_kpa,axial_stress_kpa,lateral_stress_kpa,volume_m3,mass_kg,kinetic_energy_j,elastic_strain_energy_j,plastic_strain,J_mean,max_yield_excess,platen_work_j,particle_extents_axial_strain_pct,volume_drift_pct,cell_pressure_work_j~%"))
      (multiple-value-bind (data updates frame)
          (cond ((string= mode "mpm") (run-mpm sim config directory offset height))
                ((string= mode "homogeneous") (run-homogeneous sim config directory offset center height))
                (t (error "Unknown triaxial mode ~A" mode)))
        (json-file (merge-pathnames "manifest.json" directory)
                   (object "complete" t "mode" mode "nativeModel" "cl-mpm/particle::particle-vm"
                           "geometry" "70mm diameter x 140mm height defaults; see config"
                           "stressConvention" "compression positive CSV; native tension positive Cauchy stress"
                           "axialStrainConvention" "MPM: prescribed platen engineering strain; separate measured particle-domain extent diagnostic; homogeneous: computed F_yy"
                           "plasticStrainConvention" "native sqrt(3 J2 of deviatoric plastic strain increment); 1.5 times conventional von Mises equivalent plastic strain"
                           "platenWorkConvention" (if (string= mode "mpm")
                                                       "rectified added platen force work, with cell-pressure work separate; not signed energy closure"
                                                       "signed added platen work integral V*(sigma_yy+p)*dlog(F_yy), with cell-pressure work separate")
                           "yieldConvention" "rho=sqrt(8/3)*su; q_kirchhoff_yield=2su; q_cauchy_yield=2su/J"
                           "drainage" "assumed total-stress undrained surrogate; no pore fluid or pore pressure"
                           "spatialMPM" (if (string= mode "mpm") t 'yason:false)
                           "deformationSource" (if (string= mode "mpm") "native 3D grid/particle momentum solve"
                                                   "homogeneous native constitutive solve; affine F visualization")
                           "damageEnabled" 'yason:false "fbarEnabled" 'yason:false
                           "aggregationEnabled" 'yason:false "gravity" 0
                           "particleCount" (length (cl-mpm:sim-mps sim))
                           "updates" updates "lastFrame" frame
                           "wallSeconds" (/ (- (get-internal-real-time) start)
                                            (float internal-time-units-per-second 1d0))
                           "finalDeviatoricStressKpa" (first data)
                           "finalLateralStressKpa" (fourth data)))))))
