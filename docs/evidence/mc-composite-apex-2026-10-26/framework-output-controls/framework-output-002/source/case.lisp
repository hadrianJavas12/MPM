;;;; New optional-framework output gate; no full slope or scientific validation.
;;;; windows\cl-mpm.cmd tests\framework\mc-composite-apex-output.lisp output\FRESH [all|remaining]
;;;; One separate native apex fixture; exactly two genuine USF updates on 32 MPs.
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *apex-output-frozen* nil)
(defvar *apex-output-directory* nil)
(defvar *apex-output-exit* 1)
(defvar *apex-output-mode* (or (second (cl-mpm-script-args)) "all"))
(unless (member *apex-output-mode* '("all" "remaining") :test #'string=)
  (error "Expected all or remaining output-control mode."))
(unless *apex-output-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *apex-output-frozen*
  (let* ((argument (first (cl-mpm-script-args)))
         (directory (and argument (uiop:ensure-directory-pathname (merge-pathnames argument)))))
    (unless directory (error "Provide a fresh output directory."))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Output must be fresh."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (name '("PERFECT_MC_APEX_PLAN.md" "PERFECT_MC_APEX_REVIEW.md"))
        (let* ((from (cl-mpm-path (concatenate 'string "research/notes/unnotched-landslide-2026-10-24/" name)))
               (to (merge-pathnames (concatenate 'string "source/inputs/" name) directory))
               (bytes (case-source-bytes from)))
          (ensure-directories-exist to) (uiop:copy-file from to)
          (assert (equalp bytes (case-source-bytes to)))
          (when (string= name "PERFECT_MC_APEX_PLAN.md")
            (assert (string= (snapshot-sha256-bytes bytes)
                     "e21ba6e29a85890ae4ae56f0b24df0d644111f5c9b2e6d18d9fd6bc7a510d3c3")))
          (push to copied)
          (push (snapshot-object "path" (enough-namestring to directory)
                 "originalPath" (namestring (truename from)) "bytes" (length bytes)
                 "sha256" (snapshot-sha256-bytes bytes)) records)))
      (dolist (required '("source/materials/models/plastic/mc-composite-apex/package.lisp"
                          "source/materials/models/plastic/mc-composite-apex/projection.lisp"
                          "source/materials/models/plastic/mc-composite-apex/native.lisp"
                          "source/materials/adapters/mc-composite-apex.lisp"))
        (assert (find required records :key (lambda (row) (gethash "path" row)) :test #'string=)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
       (snapshot-object "scope" "Exact new gate/model/adapter, approved design and project/native sources frozen before load"
                        "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*apex-output-frozen* t) (*apex-output-directory* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm-framework/mc-composite-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                  (snapshot-object "files" (coerce (mapcar (lambda (path)
                    (snapshot-object "path" (enough-namestring path directory)
                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *apex-output-exit*))

(defpackage :cl-mpm/tests/mc-composite-apex-output
  (:use :cl)
  (:local-nicknames (:fw :cl-mpm/framework) (:mc :cl-mpm/models/mc-evolution)
                    (:ap :cl-mpm/models/mc-composite-apex)))
(in-package :cl-mpm/tests/mc-composite-apex-output)
(defvar *passed* nil)
(defvar *failure* nil)
(defvar *phase* nil)
(defvar *updates* 0)
(defvar *mpm-attempts* 0)
(defvar *mpm-accepted* 0)
(defvar *point-attempts* 0)
(defvar *point-accepted* 0)
(defvar *lock* (sb-thread:make-mutex :name "apex output counters"))
(defvar *observations* (make-hash-table :test #'equal))
(defparameter *groups*
  '("optional-framework-loading-and-unique-diagnostics"
    "point-apex-diagnostic-storage-and-postcommit-q"
    "two-genuine-usf-updates-with-readonly-exports"
    "independent-vtk-csv-finite-F-J-mass-IDs-and-q"))
(defparameter *selected-groups*
  (if (string= cl-user::*apex-output-mode* "remaining") (rest *groups*) *groups*))
(defparameter *base-columns*
  (append '("frame" "time_s" "particle_id" "unique_id" "x_m" "y_m" "vx_m_per_s" "vy_m_per_s"
            "mass_kg_per_m" "volume_m3_per_m" "reference_volume_m3_per_m" "J")
          (loop for i below 3 append (loop for j below 3 collect (format nil "F_~D~D" i j)))
          '("sig_xx_pa" "sig_yy_pa" "sig_zz_pa" "sig_yz_pa" "sig_xz_pa" "sig_xy_pa")))

(defmethod cl-mpm:update-sim :around ((sim cl-mpm::mpm-sim-usf))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*lock*) (when (eq *phase* :mpm) (incf *updates*)))))
(defmethod cl-mpm/particle:constitutive-model :around
    ((mp ap:particle-mc-composite-apex) strain dt)
  (sb-thread:with-mutex (*lock*)
    (case *phase* (:mpm (incf *mpm-attempts*)) (:point (incf *point-attempts*))))
  (multiple-value-prog1 (call-next-method)
    (sb-thread:with-mutex (*lock*)
      (case *phase* (:mpm (incf *mpm-accepted*)) (:point (incf *point-accepted*))))))
(defmacro control (name &body body)
  `(when (member ,name *selected-groups* :test #'string=)
     (handler-case (progn ,@body (push ,name *passed*) (format t "~&PASS: ~A~%" ,name))
       (error (condition) (setf *failure* (list ,name (princ-to-string condition)))
         (format t "~&FAIL: ~A: ~A~%" ,name condition) (return-from controls nil)))))
(defmacro in-phase (phase &body body)
  `(unwind-protect
       (progn (sb-thread:with-mutex (*lock*) (setf *phase* ,phase)) ,@body)
     (sb-thread:with-mutex (*lock*) (setf *phase* nil))))
(defun near (a b &optional (tol 1d-11))
  (assert (and (mc::finite-real-p a) (mc::finite-real-p b) (<= (abs (- a b)) tol))))
(defun component (matrix i) (magicl:tref matrix i 0))
(defun fingerprint (value)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float) (list :matrix (copy-list (magicl:shape value))
                                                     (coerce (cl-mpm/utils:fast-storage value) 'list)))
        ((consp value) (cons (fingerprint (car value)) (fingerprint (cdr value))))
        ((arrayp value) (list :array (array-dimensions value)
                         (loop for i below (array-total-size value) collect (fingerprint (row-major-aref value i)))))
        ((typep value 'structure-object)
         (list (class-name (class-of value))
           (loop for slot in (sb-mop:class-slots (class-of value)) for name = (sb-mop:slot-definition-name slot)
                 collect (list name (fingerprint (slot-value value name))))))
        (t (error "Unsupported owned snapshot value ~S" (type-of value)))))
(defun material ()
  (fw:make-material :native :particle-class 'ap:particle-mc-composite-apex
   :youngs-modulus 1d8 :poisson-ratio .3d0 :density 2000d0 :plasticity t
   :initargs (list :evolution-law (mc:make-evolution-law
    :variant :perfect :points '((0d0 30d0)) :cohesion 10000d0 :psi 0d0 :stress-measure :cauchy
    :strain-assumption "Declared output-contract fixture; no slope loading or calibration"))))
(defun build (material)
  (let* ((sim (cl-mpm/setup:make-simple-sim .01d0 '(8 10)
               :args-list (list :enable-fbar nil :enable-damage nil :enable-split nil :ghost-factor nil)))
         (particles (apply #'cl-mpm/setup:make-block-mps '(.03d0 .03d0) '(.02d0 .04d0) '(4 8)
                           2000d0 (fw:material-particle-class material) (fw:material-particle-initargs material))))
    (cl-mpm:add-mps sim particles)
    (setf (cl-mpm:sim-gravity sim) 0d0 (cl-mpm:sim-damping-factor sim) 0d0
          (cl-mpm::sim-velocity-algorithm sim) :FLIP (cl-mpm::sim-mass-scale sim) 1d0)
    ;; Test-local read-only scalars expose actual F/J to the production writer.
    (setf (cl-mpm::sim-output-list-scalar sim)
      (append (cl-mpm::sim-output-list-scalar sim)
       (list (list "control-J" (lambda (mp)
                 (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))))
       (loop for i below 3 append (loop for j below 3 collect
         (let ((row i) (column j))
           (list (format nil "control-F-~D~D" row column)
                 (lambda (mp) (magicl:tref (cl-mpm/particle:mp-deformation-gradient mp) row column))))))))
    ;; A tiny declared affine compressive velocity produces genuine deformation.
    ;; No trajectory/strain is imposed after initialization; the native grid solves it.
    (loop for mp across (cl-mpm:sim-mps sim) do
      (setf (magicl:tref (cl-mpm/particle:mp-velocity mp) 1 0)
            (* -.01d0 (- (component (cl-mpm/particle:mp-position mp) 1) .05d0))))
    sim))
(defun field-values (adapter particle)
  (mapcar (lambda (field) (funcall (fourth field) particle)) (fw:diagnostics-fields adapter)))
(defun state-row (mp id frame time)
  (let ((f (cl-mpm/particle:mp-deformation-gradient mp)))
    (append (list frame time id (cl-mpm/particle::mp-unique-index mp)
                  (component (cl-mpm/particle:mp-position mp) 0) (component (cl-mpm/particle:mp-position mp) 1)
                  (component (cl-mpm/particle:mp-velocity mp) 0) (component (cl-mpm/particle:mp-velocity mp) 1)
                  (cl-mpm/particle:mp-mass mp) (cl-mpm/particle:mp-volume mp)
                  (cl-mpm/particle::mp-volume-0 mp) (cl-mpm/fastmaths:det-3x3 f))
            (loop for i below 3 append (loop for j below 3 collect (magicl:tref f i j)))
            (loop for i below 6 collect (component (cl-mpm/particle:mp-stress mp) i)))))
(defun save-state (sim adapter directory stream frame time)
  (let ((before (map 'list (lambda (mp) (fingerprint (mc:snapshot-particle mp))) (cl-mpm:sim-mps sim))))
    (cl-mpm/output:save-vtk (merge-pathnames (format nil "particles_~4,'0D.vtk" frame) directory) sim)
    (loop for mp across (cl-mpm:sim-mps sim) for id from 0 do
      (fw:validate-material-state adapter mp)
      (if (ap:particle-last-apex-active mp)
          (let* ((projection (mc:particle-last-projection mp))
                 (q (ap:particle-last-apex-multiplier mp))
                 (j (cl-mpm/fastmaths:det-3x3 (cl-mpm/particle:mp-deformation-gradient mp)))
                 (pressure (/ (* j (mc:particle-cohesion mp) (cos (mc:particle-phi mp)))
                              (sin (mc:particle-phi mp)))))
            (assert (>= q 0d0))
            (near (reduce #'+ (mc:projection-plastic-increment projection)) q)
            (near (mc:projection-work projection) (* pressure q) 1d-9))
          (near (ap:particle-last-apex-multiplier mp) 0d0 0d0))
      (let ((row (append (state-row mp id frame time) (field-values adapter mp))))
        (assert (every #'mc::finite-real-p row)) (format stream "~{~,17E~^,~}~%" row)))
    (let ((cl-mpm/calibration/triaxial::*material-diagnostics* adapter))
      (cl-mpm/calibration/triaxial::write-material-frame sim directory frame time))
    (assert (equalp before (map 'list (lambda (mp) (fingerprint (mc:snapshot-particle mp))) (cl-mpm:sim-mps sim))))))
(defun csv (path)
  (with-open-file (stream path)
    (values (uiop:split-string (read-line stream) :separator ",")
      (loop for line = (read-line stream nil nil) while line collect
        (mapcar (lambda (text) (let ((*read-eval* nil)) (read-from-string text)))
                (uiop:split-string line :separator ","))))))
(defun cell (header row name)
  (let ((index (position name header :test #'string=))) (assert index) (nth index row)))
(defun det-row (header row)
  (flet ((f (i j) (cell header row (format nil "F_~D~D" i j))))
    (+ (* (f 0 0) (- (* (f 1 1) (f 2 2)) (* (f 1 2) (f 2 1))))
       (- (* (f 0 1) (- (* (f 1 0) (f 2 2)) (* (f 1 2) (f 2 0)))))
       (* (f 0 2) (- (* (f 1 0) (f 2 1)) (* (f 1 1) (f 2 0)))))))
;; Independent legacy binary VTK reader; no production parser is invoked.
(defun byte-line (s)
  (let ((bytes (loop for b = (read-byte s nil nil) while (and b (/= b 10)) collect b)))
    (when bytes (string-right-trim '(#\Return) (map 'string #'code-char bytes)))))
(defun double-be (s)
  (let* ((bits (loop repeat 8 for b = (read-byte s) for bits = b then (+ (ash bits 8) b) finally (return bits)))
         (exponent (ldb (byte 11 52) bits)) (fraction (ldb (byte 52 0) bits)))
    (assert (/= exponent 2047))
    (* (if (logbitp 63 bits) -1d0 1d0)
       (if (= exponent 0) (scale-float (float fraction 1d0) -1074)
           (scale-float (+ 1d0 (/ fraction (expt 2 52))) (- exponent 1023))))))
(defun vtk (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (assert (search "vtk" (byte-line s))) (byte-line s)
    (assert (equal (list (byte-line s) (byte-line s)) '("BINARY" "DATASET UNSTRUCTURED_GRID")))
    (let* ((declaration (uiop:split-string (byte-line s) :separator " "))
           (n (parse-integer (second declaration))) (points (make-array (* n 3)))
           (fields (make-hash-table :test #'equal)))
      (assert (equal (list (first declaration) (third declaration)) '("POINTS" "double")))
      (dotimes (i (length points)) (setf (aref points i) (double-be s))) (assert (= (read-byte s) 10))
      (let ((data (uiop:split-string (byte-line s) :separator " ")))
        (assert (and (string= (first data) "POINT_DATA") (= n (parse-integer (second data))))))
      (loop while (listen s) for line = (byte-line s) when line do
        (let* ((words (uiop:split-string line :separator " ")) (values (make-array n)))
          (assert (equal (list (first words) (third words) (fourth words)) '("SCALARS" "double" "1")))
          (assert (string= (byte-line s) "LOOKUP_TABLE default"))
          (assert (not (gethash (second words) fields)))
          (dotimes (i n) (setf (aref values i) (double-be s)))
          (setf (gethash (second words) fields) values) (assert (= (read-byte s) 10))))
      (values n points fields))))

(defun controls (directory)
  (cl-mpm/utils:set-workers 1)
  (let* ((material (material)) (adapter (fw:material-diagnostics material))
         (sim (build material)) (particles (cl-mpm:sim-mps sim))
         (observations (merge-pathnames "observations/" directory))
         (names (mapcar #'first (fw:diagnostics-fields adapter))) (dt nil))
    ;; Required fresh-simulation setup is independent of the already-passed
    ;; adapter assertions. REMAINING skips those assertions, not configuration.
    (fw:configure-material-output adapter sim)
    (control "optional-framework-loading-and-unique-diagnostics"
      (assert (asdf:find-system "cl-mpm-framework/mc-composite-apex" nil))
      (assert (eq (fw:diagnostics-particle-type adapter) 'ap:particle-mc-composite-apex))
      (assert (= (length particles) 32))
      (assert (equal (loop for (key value) on (fw:diagnostics-conventions adapter) by #'cddr
                          when (string= key "materialVariant") return value)
                     "perfect-mc-composite-apex"))
      (fw:validate-material-diagnostics adapter particles "mpm")
      (fw:configure-material-output adapter sim)
      (assert (= (length names) (length (remove-duplicates names :test #'string=))))
      (dolist (name '("mc-apex-active-last" "mc-apex-lambda-last"))
        (assert (= (count name (cl-mpm::sim-output-list-scalar sim) :key #'first :test #'string=) 1))))
    (control "point-apex-diagnostic-storage-and-postcommit-q"
      (let* ((mp (make-instance 'ap:particle-mc-composite-apex :E 1d8 :nu .3d0 :enable-plasticity t
                 :evolution-law (getf (fw:material-particle-initargs material) :evolution-law)))
             (strain (cl-mpm/utils:voigt-from-list '(.00029d0 .00016d0 .00003d0 0d0 0d0 0d0)))
             (tau (in-phase :point (cl-mpm/particle:constitutive-model mp strain 1d-5)))
             (q (ap:particle-last-apex-multiplier mp))
             (pressure (/ (* 1d4 (cos (/ pi 6d0))) (sin (/ pi 6d0))))
             (before nil))
        (assert (= *point-attempts* *point-accepted* 1)) (assert (> q 0d0))
        ;; The native constitutive method returns tau; its caller stores sigma.
        ;; This isolated fixture supplies J=1, without inventing an MPM state.
        (cl-mpm/utils:voigt-copy-into tau (cl-mpm/particle:mp-stress mp))
        (setf before (fingerprint (mc:snapshot-particle mp)))
        (near (component tau 0) pressure 1d-6)
        (near (mc:particle-plastic-volume mp) q)
        (near (mc:particle-plastic-work mp) (* pressure q) 1d-9)
        (near (nth (position "mc-apex-active-last" names :test #'string=) (field-values adapter mp)) 1d0 0d0)
        (near (nth (position "mc-apex-lambda-last" names :test #'string=) (field-values adapter mp)) q 0d0)
        (assert (equalp before (fingerprint (mc:snapshot-particle mp))))
        (cl-mpm/particle::new-loadstep-mp mp)
        (near (- (mc:particle-plastic-volume mp) (mc:particle-plastic-volume-committed mp)) 0d0 0d0)
        (near (ap:particle-last-apex-multiplier mp) q 0d0)
        (assert (ap:particle-last-apex-active mp))
        ;; The bootstrap manifest writer intentionally supports only a restricted
        ;; value set. Runtime floating-point diagnostics use the project encoder.
        (with-open-file (stream (merge-pathnames "point-apex-diagnostics.json" directory)
                                :direction :output :if-exists :error)
          (yason:encode
           (cl-user::snapshot-object "nativeConstitutiveCalls" 1 "physicalUpdates" 0 "lambdaA" q
            "plasticVolume" (mc:particle-plastic-volume mp) "plasticWorkCauchyPa" (mc:particle-plastic-work mp)
            "postCommitCurrentMinusCommittedVolume" 0d0 "lastActiveAfterCommit" t
            "diagnosticFieldNames" (coerce names 'vector) "diagnosticFieldValues" (coerce (field-values adapter mp) 'vector)
            "scope" "Separate constitutive fixture and adapter storage; not an MPM kinematic state or slope trajectory") stream))))
    (control "two-genuine-usf-updates-with-readonly-exports"
      (ensure-directories-exist observations)
      (setf dt (* .2d0 (cl-mpm/setup:estimate-elastic-dt sim)))
      (assert (and (mc::finite-real-p dt) (> dt 0d0)))
      (setf (cl-mpm:sim-dt sim) dt)
      (cl-mpm/output/history:with-retained-history
          (stream (merge-pathnames "particles.csv" observations) :direction :output :if-exists :error)
        (format stream "~{~A~^,~}~%" (append *base-columns* names))
        (save-state sim adapter observations stream 0 0d0)
        (dotimes (step 2)
          (in-phase :mpm (cl-mpm:update-sim sim))
          (near (cl-mpm::sim-time sim) (* (1+ step) dt) 1d-16)
          (save-state sim adapter observations stream (1+ step) (cl-mpm::sim-time sim))))
      (assert (= *updates* 2)) (assert (= *mpm-attempts* *mpm-accepted* 64))
      (setf (gethash "stepSizeS" *observations*) dt))
    (control "independent-vtk-csv-finite-F-J-mass-IDs-and-q"
      (multiple-value-bind (header rows) (csv (merge-pathnames "particles.csv" observations))
        (assert (= (length rows) 96))
        (let ((reference-ids nil) (moved nil) (strain-changed nil))
          (dotimes (frame 3)
            (let* ((selected (remove-if-not (lambda (row) (= (cell header row "frame") frame)) rows))
                   (ids (mapcar (lambda (row) (cell header row "unique_id")) selected)) (mass 0d0))
              (if reference-ids (assert (equalp ids reference-ids)) (setf reference-ids ids))
              (assert (= (length (remove-duplicates ids :test #'=)) 32))
              (multiple-value-bind (count points fields) (vtk (merge-pathnames (format nil "particles_~4,'0D.vtk" frame) observations))
                (assert (= count (length selected) 32))
                (loop for row in selected for id from 0 do
                  (assert (every #'mc::finite-real-p row)) (near (cell header row "particle_id") id 0d0)
                  (incf mass (cell header row "mass_kg_per_m"))
                  (let ((j (det-row header row)))
                    (assert (> j 0d0)) (near j (cell header row "J"))
                    (near j (aref (gethash "control-J" fields) id))
                    (near (cell header row "volume_m3_per_m") (* j (cell header row "reference_volume_m3_per_m"))))
                  (dotimes (i 3) (dotimes (j 3)
                    (near (aref (gethash (format nil "control-F-~D~D" i j) fields) id)
                          (cell header row (format nil "F_~D~D" i j)))))
                  (near (aref points (* id 3)) (cell header row "x_m"))
                  (near (aref points (+ 1 (* id 3))) (cell header row "y_m"))
                  (near (aref (gethash "unique-id" fields) id) (cell header row "unique_id") 0d0)
                  (loop for (vtk-name csv-name) in '(("mass" "mass_kg_per_m") ("volume" "volume_m3_per_m")
                           ("vel_x" "vx_m_per_s") ("vel_y" "vy_m_per_s")
                           ("sig_xx" "sig_xx_pa") ("sig_yy" "sig_yy_pa") ("sig_xy" "sig_xy_pa")) do
                    (near (aref (gethash vtk-name fields) id) (cell header row csv-name) 1d-9))
                  (dolist (name names) (near (aref (gethash name fields) id) (cell header row name) 1d-9))
                  (assert (>= (cell header row "mc-apex-lambda-last") 0d0))
                  (when (> frame 0)
                    (when (/= (cell header row "y_m") (cell header (nth id rows) "y_m")) (setf moved t))
                    (when (/= (cell header row "F_11") 1d0) (setf strain-changed t)))))
              (near mass (* .02d0 .04d0 2000d0) 1d-12)))
          (assert moved) (assert strain-changed)))
      (multiple-value-bind (header rows) (csv (merge-pathnames "material-diagnostics.csv" observations))
        (assert (= (length rows) 3))
        (dolist (row rows) (assert (every #'mc::finite-real-p row)))
        (dolist (name '("max_mc-apex-active-last" "max_mc-apex-lambda-last"))
          (assert (= (count name header :test #'string=) 1))))
      (setf (gethash "savedVtkStates" *observations*) 3
            (gethash "savedParticleRows" *observations*) 96
            (gethash "savedAggregateRows" *observations*) 3
            (gethash "tinyMpmApexActivationRequired" *observations*) 'yason:false)))
  t)
(handler-case (controls cl-user::*apex-output-directory*)
  (error (condition) (setf *failure* (list "harness" (princ-to-string condition)))))
(with-open-file (stream (merge-pathnames "result.json" cl-user::*apex-output-directory*)
                        :direction :output :if-exists :error)
  (yason:encode (cl-user::snapshot-object
   "passed" (if *failure* 'yason:false t) "passedGroups" (coerce (reverse *passed*) 'vector)
   "mode" cl-user::*apex-output-mode* "selectedGroups" (coerce *selected-groups* 'vector)
   "skippedGroups" (coerce (set-difference *groups* *selected-groups* :test #'string=) 'vector)
   "failure" (and *failure* (coerce *failure* 'vector)) "physicalUpdatesExecuted" *updates*
   "materialCallsAttempted" *mpm-attempts* "materialCallsAccepted" *mpm-accepted*
   "pointNativeCallsAttempted" *point-attempts* "pointNativeCallsAccepted" *point-accepted*
   "observations" *observations* "nativeBackend" (cl-user::snapshot-native-proof)
   "scope" "New optional-framework output smoke: declared tiny32-MP affine-velocity fixture/two native USF updates, separate one native apex diagnostic call; no full slope, guaranteed MPM apex activation or scientific PASS") stream))
(setf cl-user::*apex-output-exit* (if *failure* 1 0))
