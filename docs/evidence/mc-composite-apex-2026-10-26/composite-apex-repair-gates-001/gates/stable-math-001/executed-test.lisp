;;;; Focused SYNTHETIC stable-deviator controls; actual failed trial unavailable.
;;;; windows\cl-mpm.cmd tests\materials\mc-composite-apex-stable-math.lisp output\FRESH
(in-package :cl-user)
(require :asdf)
(setf *read-default-float-format* 'double-float)
(defvar *sm-frozen* nil) (defvar *sm-output* nil) (defvar *sm-exit* 1)
(unless *sm-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp"))
  (let ((directory (uiop:ensure-directory-pathname
                    (merge-pathnames (or (first (cl-mpm-script-args)) (error "Fresh output required."))))))
    (when (and (probe-file directory) (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Preserve existing stable-math output."))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (fixture
                '(("tests/materials/mc-composite-apex-stable-math.protocol.json" "source/inputs/protocol.json" nil)
                  ("output/mc-composite-apex-2026-10-26/synthetic-roundoff-witness-001/result.json"
                   "source/inputs/original-SYNTHETIC-witness.json"
                   "fa04bc5d5551c0b715805637b0fd996959fbb163f633fd1e2506b46d91d5b571")))
        (destructuring-bind (relative destination expected) fixture
          (let* ((from (cl-mpm-path relative)) (to (merge-pathnames destination directory))
                 (bytes (case-source-bytes from)) (sha (snapshot-sha256-bytes bytes)))
            (when expected (assert (string= expected sha)))
            (ensure-directories-exist to) (uiop:copy-file from to)
            (assert (equalp bytes (case-source-bytes to)))
            (push to copied)
            (push (snapshot-object "path" destination "originalPath" (namestring (truename from))
                                   "bytes" (length bytes) "sha256" sha) records))))
      (assert (not (string= "0468832da6087b854563cacebdb61b2581ae224f627ccc8cd7fe69ba2e7c0d86"
                           (snapshot-sha256 (merge-pathnames "source/materials/models/plastic/mc-composite-apex/projection.lisp" directory)))))
      (assert (string= "e26b736914a8fa2cc3f4eb7f6619c1331e787f72d365d5bb7c0a5b3f4d8ceda1"
                       (snapshot-sha256 (merge-pathnames "source/materials/models/plastic/mohr-coulomb-evolution/projection.lisp" directory))))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
        (snapshot-object "scope" "New stable-math test/protocol, current optional projector, unchanged shared projector and native payload frozen before project load; original witness result is immutable DATA only"
                         "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*sm-frozen* t) (*sm-output* directory))
        (snapshot-check-plan "cl-mpm/settings") (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/mc-composite-apex"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (flet ((proof (name)
                 (snapshot-write-json (merge-pathnames name directory)
                   (snapshot-object "files" (coerce (mapcar (lambda (path)
                     (snapshot-object "path" (enough-namestring path directory)
                                      "sha256" (snapshot-sha256 path))) copied) 'vector)))))
          (proof "source-proof-before.json")
          (let ((runtime (or (snapshot-module-path "sbcl.exe") (error "Actual mapped SBCL executable unavailable."))))
            (snapshot-write-json (merge-pathnames "runtime-before.json" directory)
              (snapshot-object "implementation" (lisp-implementation-type) "version" (lisp-implementation-version)
                               "mappedExecutable" (namestring runtime) "sha256" (snapshot-sha256 runtime)
                               "scope" "Actual mapped executable hash; installed SBCL core and third-party dependencies remain external")))
          (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
          (load (merge-pathnames "source/case.lisp" directory))
          (dolist (path copied) (snapshot-verify-file path))
          (write-case-source-provenance directory copied nil)
          (proof "source-proof-after.json")))))
  (uiop:quit *sm-exit*))

(defpackage :cl-mpm/tests/composite-apex-stable-math (:use :cl)
  (:local-nicknames (:mc :cl-mpm/models/mc-evolution) (:ap :cl-mpm/models/mc-composite-apex)))
(in-package :cl-mpm/tests/composite-apex-stable-math)
(defvar *calls* 0) (defvar *updates* 0) (defvar *failures* nil) (defvar *results* nil)
(defun obj (&rest pairs) (apply #'cl-user::snapshot-object pairs))
(defun yes (value) (if value t 'yason:false))
(defun maxabs (v) (reduce #'max v :key #'abs))
(defun exact-text (v) (princ-to-string v))
(defun write-json (name value)
  (with-open-file (stream (merge-pathnames name cl-user::*sm-output*)
                          :direction :output :if-exists :error :external-format :utf-8)
    (yason:encode value stream)))
(defun read-input (name)
  (with-open-file (stream (merge-pathnames (concatenate 'string "source/inputs/" name) cl-user::*sm-output*))
    (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
(defun law-state (law)
  (list (copy-tree (mc:evolution-law-points law)) (copy-tree (mc:evolution-law-cohesion-points law))
        (mc:evolution-law-variant law) (mc:evolution-law-psi law) (mc:evolution-law-stress-measure law)
        (copy-seq (mc:evolution-law-strain-assumption law)) (mc:evolution-law-peak-kappa law)))
(defun hooke (b g k)
  "Independent rational isotropic response, not production d-times."
  (let ((trace (reduce #'+ b)))
    (map 'vector (lambda (x) (+ (* 2 g x) (* (- k (/ (* 2 g) 3)) trace))) b)))
(defun near-cap-trial (p offset h)
  (let* ((start (+ p offset)) (sig (nth-value 0 (integer-decode-float start)))
         (exponent (nth-value 1 (integer-decode-float start)))
         (centre (scale-float (float (+ sig (mod (- 2 sig) 4)) 1d0) exponent))
         (ulp (scale-float 1d0 exponent)))
    (vector (+ centre h) centre (+ (- centre h) ulp))))

(defun verify-result (result trial e nu j law old row)
  "Independent rational identities; q retains its unchanged rounded-mean contract."
  (multiple-value-bind (c phi psi) (mc:law-values law 0d0)
    (declare (ignore psi))
    (let* ((g (/ e (* 2d0 (+ 1d0 nu)))) (k (/ e (* 3d0 (- 1d0 (* 2d0 nu)))))
           (p (/ (* j c (cos phi)) (sin phi))) (q (ap:apex-projection-apex-multiplier result))
           (tol (+ 1d-6 (* 1d-11 (max 1d0 (maxabs trial)))))
           (plastic (mc:projection-plastic-increment result)) (tau (mc:projection-tau result))
           (multipliers (mc:projection-multipliers result)) (work (mc:projection-work result))
           (wtol (* tol (max 1d-12 (maxabs plastic))))
           (rt (map 'vector #'rational trial)) (b (map 'vector #'rational plastic))
           (rg (rational g)) (rk (rational k)) (rp (rational p)) (rq (rational q))
           (mean (/ (reduce #'+ rt) 3))
           (dev (map 'vector (lambda (x) (/ (- x mean) (* 2 rg))) rt))
           (reference (map 'vector (lambda (x) (+ x (/ rq 3))) dev))
           (returned (map 'vector #'- rt (hooke b rg rk)))
           (compliance (maxabs (map 'vector (lambda (x) (- x rp)) returned)))
           (strain-error (maxabs (hooke (map 'vector #'- b reference) rg rk)))
           (trace (reduce #'+ b)) (volume-error (* rk (abs (- trace rq))))
           (target-work (* rp rq)) (exact-plastic-work (* rp trace))
           (work-error (- (rational work) target-work))
           (work-sum-error (- (rational work) exact-plastic-work))
           (dev-square (reduce #'+ (map 'vector (lambda (x) (* x x)) dev)))
           (energy (+ (* rg dev-square) target-work (* 1/2 rk rq rq)))
           (energy-margin (- energy (rational work)))
           (shear-flow (make-array 3 :initial-element 0))
           (s (rational (sin phi))) (co (rational (cos phi)))
           (r-tau (map 'vector #'rational tau))
           (yield (loop for i below 3 append
                    (loop for axis below 3 unless (= i axis) collect
                      (- (* (+ 1 s) (aref r-tau i)) (* (- 1 s) (aref r-tau axis))
                         (* 2 (rational j) (rational c) co)))))
           (exact-mean-q (/ (- mean rp) rk)))
      (loop for (i axis) in mc:+plane-pairs+ for value across multipliers do
        (incf (aref shear-flow i) (rational value)) (decf (aref shear-flow axis) (rational value)))
      (let* ((flow-error (* 2 rg (maxabs (map 'vector #'- shear-flow dev))))
             (checks (list
               (cons "finite-result" (every #'mc::finite-real-p
                 (append (coerce plastic 'list) (coerce tau 'list) (coerce multipliers 'list)
                         (list q work (mc:projection-kappa result)))))
               (cons "hydrostatic-cap" (every (lambda (x) (= x p)) tau))
               (cons "unchanged-q-formula" (= q (/ (- (/ (reduce #'+ trial) 3d0) p) k)))
               (cons "certified-apex-domain" (> (- (/ (reduce #'+ trial) 3d0) p) (/ tol (* 2d0 (sin phi)))))
               (cons "nonnegative-multipliers" (and (>= q 0d0) (every (lambda (x) (>= x 0d0)) multipliers)))
               (cons "nondecreasing-kappa" (>= (mc:projection-kappa result) old))
               (cons "exact-reference-zero-deviator-trace" (= (reduce #'+ dev) 0))
               (cons "exact-reference-q-trace" (= (reduce #'+ reference) rq))
               (cons "rational-compliance" (<= compliance (rational tol)))
               (cons "rational-plastic-reference" (<= strain-error (rational tol)))
               (cons "rational-shear-flow" (<= flow-error (rational tol)))
               (cons "rational-plastic-volume" (<= volume-error (rational tol)))
               (cons "rational-yield-all-six" (every (lambda (x) (<= (abs x) (rational tol))) yield))
               (cons "rational-work-identity" (<= (abs work-error) (rational wtol)))
               (cons "rational-work-sum" (<= (abs work-sum-error) (rational wtol)))
               (cons "nonnegative-work" (>= (rational work) (- (rational wtol))))
               (cons "rational-energy-inequality" (>= energy-margin (- (rational wtol)))))))
        (setf (gethash "checks" row)
                (map 'vector (lambda (x) (obj "name" (car x) "passed" (yes (cdr x)))) checks)
              (gethash "metrics" row)
                (obj "stressTolerancePa" tol "workTolerancePa" wtol "capPa" p "q" q "workPa" work
                     "plastic" (copy-seq plastic) "multipliers" (copy-seq multipliers) "tauKirchhoffPa" (copy-seq tau)
                     "compliancePaExact" (exact-text compliance) "plasticReferenceErrorPaExact" (exact-text strain-error)
                     "volumeErrorPaExact" (exact-text volume-error) "shearFlowErrorPaExact" (exact-text flow-error)
                     "yieldResidualsPaExact" (map 'vector #'exact-text yield)
                     "workIdentityErrorPaExact" (exact-text work-error) "workSumErrorPaExact" (exact-text work-sum-error)
                     "energyMarginPaExact" (exact-text energy-margin)
                     "exactMeanQ" (exact-text exact-mean-q)
                     "fullExactMeanWorkDifferencePa" (exact-text (- (rational work) (* rp exact-mean-q)))
                     "referenceScope" "Exact rational deviator and supplied binary64 q; full exact-mean q/work discrepancy is reported separately"))
        (assert (every #'cdr checks))))))

(defun call-case (fixture e nu law old)
  (let* ((trial (gethash "trialKirchhoffPa" fixture)) (before (copy-seq trial))
         (law-before (law-state law)) (j (gethash "j" fixture))
         (row (obj "fixture" fixture "accepted" 'yason:false)))
    (unwind-protect
         (handler-case
             (let ((result (progn (incf *calls*) (ap:project-principal-with-apex trial e nu j law old))))
               (setf (gethash "accepted" row) t)
               (assert (and (typep result 'ap:apex-projection)
                            (eq (ap:apex-projection-branch result) :hydrostatic-apex)))
               (verify-result result trial e nu j law old row)
               (assert (and (equalp trial before) (equalp (law-state law) law-before)))
               (setf (gethash "passed" row) t))
           (error (condition)
             (setf (gethash "passed" row) 'yason:false (gethash "failure" row) (princ-to-string condition))
             (when (typep condition 'mc:material-integration-error)
               (setf (gethash "materialDiagnostic" row) (mc:integration-error-diagnostic condition)))
             (push (gethash "name" fixture) *failures*)))
      (setf (gethash "inputUnchanged" row) (yes (and (equalp trial before) (equalp (law-state law) law-before))))
      (push row *results*))))

(defun run-controls ()
  (let* ((protocol (read-input "protocol.json")) (witness (read-input "original-SYNTHETIC-witness.json"))
         (witness-data (gethash "observations" witness)) (witness-fixture (gethash "fixture" witness-data))
         (original-trial (gethash "trialKirchhoffPa" witness-fixture))
         (e (float (gethash "youngsModulusPa" protocol) 1d0)) (nu (gethash "poissonRatio" protocol))
         (old (gethash "oldKappa" protocol)) (c (float (gethash "cohesionPa" protocol) 1d0))
         (degrees (* (/ 180d0 pi) (atan (/ (tan (* (gethash "unreducedFrictionDegrees" protocol) (/ pi 180d0)))
                                                        (gethash "strengthReduction" protocol)))))
         (law (mc:make-evolution-law :variant :perfect :points (list (list 0d0 degrees)) :cohesion c :psi 0d0
                                    :stress-measure :cauchy :strain-assumption "SYNTHETIC stable-deviator arithmetic controls"))
         (phi (nth-value 1 (mc:law-values law 0d0))) (fixtures nil))
    (assert (and (= (gethash "schemaVersion" protocol) 1) (= (gethash "explicitProductionProjectorCalls" witness) 1)
                 (= (gethash "physicalUpdateAttempts" witness) 0)))
    (assert (string= (gethash "reason" (gethash "productionOutcome" witness-data))
                     "Composite apex compliance, flow, yield or work identity failed"))
    (loop for perm across (gethash "permutations" protocol) for index from 0 do
      (push (obj "name" (format nil "retained-synthetic-witness-permutation-~D" index) "j" 1d0
                 "trialKirchhoffPa" (map 'vector (lambda (i) (aref original-trial i)) perm)) fixtures))
    (loop for j-value across (gethash "jacobians" protocol) for j = (float j-value 1d0) do
      (loop for offset-power across (gethash "meanOffsetPowersOfTwo" protocol) do
        (loop for scale in (cons nil (coerce (gethash "deviatorPowersOfTwo" protocol) 'list)) do
          (push (obj "name" (format nil "J~A-offset2^~D-deviator~A" j offset-power (or scale "zero")) "j" j
                     "trialKirchhoffPa" (near-cap-trial (/ (* j c (cos phi)) (sin phi))
                                            (scale-float 1d0 offset-power) (if scale (scale-float 1d0 scale) 0d0))) fixtures))))
    (setf fixtures (nreverse fixtures))
    (assert (= (length fixtures) (gethash "expectedProductionProjectorCalls" protocol) 33))
    ;; Freeze resolved finite input set before any projector call, with no adaptive search.
    (write-json "planned-fixtures.json" (obj "protocol" protocol "fixtures" (coerce fixtures 'vector)))
    (dolist (fixture fixtures) (call-case fixture e nu law old))))

(let ((original (symbol-function 'cl-mpm:update-sim)))
  (unwind-protect
       (progn (setf (symbol-function 'cl-mpm:update-sim)
                    (lambda (&rest arguments) (declare (ignore arguments))
                      (incf *updates*) (error "Stable-math controls forbid MPM updates.")))
              (handler-case (run-controls)
                (error (condition) (push (princ-to-string condition) *failures*))))
    (setf (symbol-function 'cl-mpm:update-sim) original)))
(let ((passed (and (null *failures*) (= *calls* 33) (zerop *updates*))))
  (write-json "result.json"
    (obj "passed" (yes passed) "failures" (coerce (reverse *failures*) 'vector)
         "explicitProductionProjectorCalls" *calls* "physicalUpdateAttempts" *updates*
         "nativeConstitutiveCalls" 0 "oldControlsCalled" 0 "unchangedOldProjectorCalls" 0 "actualFailedTrialReplayCalls" 0
         "nativeBackend" (cl-user::snapshot-native-proof) "cases" (coerce (reverse *results*) 'vector)
         "scope" "Focused SYNTHETIC stable-deviator arithmetic; retained witness is DATA, actual fine-run failed trial unavailable; zero MPM/scientific validation"))
  (format t "~&Stable-math controls: ~A; calls ~D; MPM attempts ~D; failures ~D~%"
          (if passed "PASS" "FAIL") *calls* *updates* (length *failures*))
  (setf cl-user::*sm-exit* (if passed 0 1)))
