;;;; Bounded native material-point comparison; zero spatial/MPM updates.
;;;; windows\cl-mpm.cmd tests\materials\mc-legacy-apex-comparison.lisp CAPSULE.json FRESH-result.json
;;;; This observes legacy behavior; it does not change the strict psi=0 contract.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)

(defpackage :cl-mpm/tests/mc-legacy-apex-comparison
  (:use :cl :cl-mpm/models/mc-evolution))
(in-package :cl-mpm/tests/mc-legacy-apex-comparison)

(defparameter *controls* nil)
(defparameter *report* (make-hash-table :test 'equal))
(defconstant +stress-tolerance+ 1d-3)
(defconstant +strain-tolerance+ 1d-11)

(defun object (&rest entries)
  (let ((result (make-hash-table :test 'equal)))
    (loop for (key value) on entries by #'cddr do (setf (gethash key result) value))
    result))
(defun close-value (actual expected tolerance)
  (assert (and (realp actual) (= actual actual) (<= (abs (- actual expected)) tolerance))
          () "Expected ~,16G, obtained ~,16G (tolerance ~G)." expected actual tolerance))
(defun close-vector (actual expected tolerance)
  (assert (= (length actual) (length expected)))
  (dotimes (i (length actual)) (close-value (elt actual i) (elt expected i) tolerance)))
(defun values-of (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
(defun voigt (values) (cl-mpm/utils:voigt-from-list (coerce values 'list)))
(defun mean3 (values) (/ (loop for i below 3 sum (elt values i)) 3d0))
(defun trace3 (values) (loop for i below 3 sum (elt values i)))
(defun compliance (stress e nu)
  (let ((answer (make-array 6 :element-type 'double-float :initial-element 0d0))
        (g (/ e (* 2d0 (+ 1d0 nu)))))
    (dotimes (i 3)
      (setf (aref answer i)
            (/ (- (elt stress i) (* nu (loop for k below 3 unless (= k i) sum (elt stress k)))) e)))
    (loop for i from 3 below 6 do (setf (aref answer i) (/ (elt stress i) g)))
    (voigt answer)))
(defun max-residual (principal c phi)
  (let ((sine (sin phi)) (offset (* 2d0 c (cos phi))))
    (loop for i below 3 maximize
      (loop for k below 3 unless (= i k) maximize
        (- (* (+ 1d0 sine) (elt principal i)) (* (- 1d0 sine) (elt principal k)) offset)))))
(defun principal-stress (stress)
  (coerce (cl-mpm/utils:eig (cl-mpm/utils:voight-to-matrix stress)) 'vector))
(defun expected-error (thunk)
  (handler-case (progn (funcall thunk) (error "Expected strict material rejection."))
    (material-integration-error (condition) condition)))
(defmacro control (label &body forms)
  `(progn ,@forms (push (object "label" ,label "passed" t) *controls*)
          (format t "~&PASS: ~A~%" ,label)))

#+win32 (cffi:define-foreign-library comparison-kernel32 (t (:default "kernel32")))
#+win32 (cffi:use-foreign-library comparison-kernel32)
(defun native-module-path ()
  "Resolve the actual Windows module, rather than relying on a CFFI path hint."
  #-win32 (error "This control requires native Windows SBCL.")
  #+win32
  (cffi:with-foreign-string (name "kirchoff.dll" :encoding :utf-16le)
    (let ((handle (cffi:foreign-funcall ("GetModuleHandleW" :library comparison-kernel32 :convention :stdcall)
                    :pointer name :pointer)))
      (assert (not (cffi:null-pointer-p handle)) () "Native kirchoff.dll is not mapped.")
      (cffi:with-foreign-object (buffer :uint16 32768)
        (let ((count (cffi:foreign-funcall ("GetModuleFileNameW" :library comparison-kernel32 :convention :stdcall)
                       :pointer handle :pointer buffer :uint32 32768 :uint32)))
          (assert (< 0 count 32768))
          (namestring (truename (cffi:foreign-string-to-lisp buffer :encoding :utf-16le :count (* 2 count)))))))))

(defun legacy-return (trial de e nu phi psi cohesion)
  ;; The bridge mutates the strain argument. Every comparison owns its copies.
  (let* ((strain (compliance trial e nu))
         (initial-strain (values-of strain))
         (stress (cl-mpm/constitutive::linear-elastic-mat strain de)))
    (close-vector (values-of stress) trial +stress-tolerance+)
    (multiple-value-bind (returned-strain-stress returned-strain initial-yield increment pmod)
        (cl-mpm/ext::constitutive-mohr-coulomb stress de strain e nu phi psi cohesion)
      (let* ((tau (values-of returned-strain-stress))
             (principal (principal-stress returned-strain-stress))
             (plastic (map 'vector #'- initial-strain (values-of returned-strain))))
        (object "cohesionKirchhoffArgumentPa" cohesion "trialKirchhoffVoigtPa" trial
                "returnedKirchhoffVoigtPa" tau "returnedPrincipalKirchhoffPa" principal
                "meanKirchhoffPa" (mean3 principal)
                "maxOwnYieldResidualPa" (max-residual principal cohesion phi)
                "plasticStrainIncrementEngineeringVoigt" plastic
                "plasticVolumetricIncrement" (trace3 plastic)
                "initialYieldNativeFloatPa" initial-yield "reportedEquivalentIncrementNativeFloat" increment
                "reportedPModulusNativeFloatPa" pmod)))))

(defun compare-implementations (capture-path)
  (let* ((record (with-open-file (stream capture-path)
                   (yason:parse stream :object-as :hash-table :json-arrays-as-vectors t)))
         (law-record (gethash "law" record))
         (trial (gethash "trialKirchhoffPa" record))
         (trial6 (concatenate 'vector trial #(0d0 0d0 0d0)))
         (e (gethash "youngsModulusPa" record)) (nu (gethash "poissonRatio" record))
         (j (gethash "deformationJacobian" record)) (old-kappa (gethash "oldKappa" record))
         (c (elt (elt (gethash "cohesionPoints" law-record) 0) 1))
         (phi (* (/ pi 180d0) (elt (elt (gethash "points" law-record) 0) 1)))
         (psi (gethash "psi" law-record))
         (law (make-evolution-law :variant :perfect :points (list (list 0d0 (* phi (/ 180d0 pi))))
                                  :cohesion c :psi psi :stress-measure :cauchy
                                  :strain-assumption "Comparison of captured Wang Soil1 return only"))
         (strict (make-instance 'particle-mc-evolution :E e :nu nu :evolution-law law :kappa old-kappa
                                                       :enable-plasticity t))
         (legacy (make-instance 'cl-mpm/particle::particle-mc :E e :nu nu :phi phi :psi psi :c c
                                                            :enable-plasticity t))
         (de (cl-mpm/particle::mp-elastic-matrix legacy)))
    (setf (gethash "capturedDiagnostic" *report*) record)
    (control "Native DLL, captured law and actual native particle elasticity agree"
      (assert (string= (gethash "variant" law-record) "perfect"))
      (assert (string= (gethash "stressMeasure" law-record) "cauchy"))
      (assert (= psi 0d0))
      (assert (fboundp 'cl-mpm/ext::CppMohrCoulomb))
      (assert (not (cffi:null-pointer-p (cffi:foreign-symbol-pointer "CppMohrCoulomb" :library 'cl-mpm/ext::cl-mpm-cpp))))
      (setf (gethash "nativeBackend" *report*)
            (object "modulePath" (native-module-path) "verifiedBy" "GetModuleHandleW/GetModuleFileNameW"
                    "entryPoint" "CppMohrCoulomb" "nativeEntryPresent" t))
      (close-vector (values-of de) (values-of (cl-mpm/particle::mp-elastic-matrix strict)) 1d-8)
      (close-vector (values-of (cl-mpm/constitutive::linear-elastic-mat (compliance trial6 e nu) de))
                    trial6 +stress-tolerance+)
      (setf (gethash "matchedElasticMatrix6x6RowMajor" *report*) (values-of de)))
    (control "Exact captured strict rejection also rejects through the native point adapter"
      (let* ((failure (expected-error (lambda () (replay-integration-diagnostic record))))
             (strain (compliance trial6 e nu)) (before (values-of strain))
             (stress-before (values-of (cl-mpm/particle:mp-stress strict))))
        (assert (equalp (integration-error-diagnostic failure) record))
        (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient strict) 0 0) j)
        (let* ((native-failure (expected-error (lambda () (cl-mpm/particle:constitutive-model strict strain 1d-4))))
               (native-record (integration-error-diagnostic native-failure)))
          (assert (string= (integration-error-reason failure) (integration-error-reason native-failure)))
          (close-vector (gethash "trialKirchhoffPa" native-record) trial 1d-7)
          (close-value (gethash "deformationJacobian" native-record) j 1d-15)
          (assert (equalp before (values-of strain)))
          (assert (equalp stress-before (values-of (cl-mpm/particle:mp-stress strict))))
          (setf (gethash "strictRejection" *report*)
                (object "reason" (integration-error-reason failure) "exactCapturedReplayMatches" t
                        "nativeAdapterReasonMatches" t "nativeInputStrainAndStressUnchanged" t
                        "trialMeanKirchhoffPa" (mean3 trial) "cauchyLawApexKirchhoffPa" (* j (/ c (tan phi)))
                        "meanExcessPa" (- (mean3 trial) (* j (/ c (tan phi)))))))))
    (control "Legacy raw cohesion accepts an apex with positive plastic volume"
      (let ((result (legacy-return trial6 de e nu phi psi c)))
        (setf (gethash "legacyRawCohesion" *report*) result)
        (close-vector (gethash "returnedPrincipalKirchhoffPa" result)
                      (make-array 3 :initial-element (/ c (tan phi))) +stress-tolerance+)
        (close-value (gethash "maxOwnYieldResidualPa" result) 0d0 +stress-tolerance+)
        (assert (> (gethash "plasticVolumetricIncrement" result) +strain-tolerance+))))
    (control "Legacy J-scaled cohesion also accepts by changing the psi=0 flow contract"
      (let ((result (legacy-return trial6 de e nu phi psi (* j c))))
        (setf (gethash "legacyCauchyMeasureMatched" *report*) result)
        (close-vector (gethash "returnedPrincipalKirchhoffPa" result)
                      (make-array 3 :initial-element (* j (/ c (tan phi)))) +stress-tolerance+)
        (close-value (gethash "maxOwnYieldResidualPa" result) 0d0 +stress-tolerance+)
        (assert (> (gethash "plasticVolumetricIncrement" result) +strain-tolerance+))
        (close-value (gethash "plasticVolumetricIncrement" result)
                     (* (/ (* 3d0 (- 1d0 (* 2d0 nu))) e)
                        (- (mean3 trial) (* j (/ c (tan phi))))) +strain-tolerance+)))
    (control "Admissible plastic pure-shear reference agrees and preserves zero plastic volume"
      (let* ((shear-trial #(0d0 0d0 0d0 50d3 0d0 0d0))
             (result (legacy-return shear-trial de e nu phi psi (* j c)))
             (strict-result (project-principal #(50d3 0d0 -50d3) e nu j law old-kappa))
             (strict-tau (sort (copy-seq (projection-tau strict-result)) #'<))
             (native-tau (sort (copy-seq (gethash "returnedPrincipalKirchhoffPa" result)) #'<)))
        (setf (gethash "pureShearReference" *report*)
              (object "legacy" result "strictPrincipalKirchhoffPa" (projection-tau strict-result)
                      "strictPlasticVolumetricIncrement" (trace3 (projection-plastic-increment strict-result))))
        (close-vector native-tau strict-tau +stress-tolerance+)
        (close-vector native-tau (vector (- (* j c (cos phi))) 0d0 (* j c (cos phi))) +stress-tolerance+)
        (close-value (gethash "maxOwnYieldResidualPa" result) 0d0 +stress-tolerance+)
        (close-value (gethash "plasticVolumetricIncrement" result) 0d0 +strain-tolerance+)
        (close-value (trace3 (projection-plastic-increment strict-result)) 0d0 +strain-tolerance+)))))

(let* ((args (cl-user::cl-mpm-script-args)) (input (first args)) (output (second args)) (failure nil))
  (unless (= (length args) 2) (error "Supply captured JSON and fresh result JSON paths."))
  (when (probe-file output) (error "Comparison output must be fresh: ~A" output))
  (setf (gethash "scope" *report*) "Native material-point implementation comparison only; zero MPM updates"
        (gethash "capturePath" *report*) (namestring (truename input))
        (gethash "physicalUpdatesExecuted" *report*) 0
        (gethash "strictDefaultChanged" *report*) 'yason:false
        (gethash "scientificallyValidated" *report*) 'yason:false
        (gethash "interpretation" *report*)
        "Legacy apex success introduces plastic volume at psi=0; it is a different apex rule, not a fix preserving strict zero-dilation flow. Raw legacy c is Kirchhoff; J-scaled c matches the captured Cauchy strength.")
  (handler-case (compare-implementations input)
    (error (condition) (setf failure (princ-to-string condition)) (format t "~&FAIL: ~A~%" condition)))
  (setf (gethash "passed" *report*) (if failure 'yason:false t)
        (gethash "controlsCount" *report*) (length *controls*)
        (gethash "controls" *report*) (coerce (reverse *controls*) 'vector))
  (when failure (setf (gethash "error" *report*) failure))
  (ensure-directories-exist output)
  (with-open-file (stream output :direction :output :if-exists :error :external-format :utf-8)
    (yason:encode *report* stream) (terpri stream))
  (format t "~&MC LEGACY APEX COMPARISON: ~D controls passed; zero MPM updates.~%" (length *controls*))
  (uiop:quit (if failure 1 0)))
