;;;; Configuration/command/work controls only; no gravity or physical timesteps.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(in-package :cl-mpm/scenario/slope-creep)

(defvar *drive-hold-checks* 0)
(defmacro drive-hold-check (label &body body)
  `(progn ,@body (incf *drive-hold-checks*) (format t "~&PASS: ~A~%" ,label)))
(defun drive-hold-close (actual expected)
  (assert (< (abs (- actual expected)) (* 1d-12 (max 1d0 (abs expected))))))
(defun drive-hold-expects-error (thunk)
  (assert (handler-case (progn (funcall thunk) nil) (error () t))))
(defun load-drive-hold-control-case (path)
  (let ((cl-mpm/framework:*simulation* nil))
    (load path)
    (or cl-mpm/framework:*simulation* (error "Case did not declare a simulation."))))
(defun case-with-loading (case loading)
  (cl-mpm/framework:make-simulation
   :scenario (cl-mpm/framework:simulation-scenario case)
   :material (cl-mpm/framework:simulation-material case)
   :geometry (cl-mpm/framework:simulation-geometry case)
   :boundary (cl-mpm/framework:simulation-boundary case)
   :loading loading :solver (cl-mpm/framework:simulation-solver case)
   :parameters (cl-mpm/framework:simulation-parameters case)))
(defun drive-hold-native-state (sim)
  (map 'vector
       (lambda (mp)
         (list (mapcar (lambda (matrix) (copy-seq (cl-mpm/utils:fast-storage matrix)))
                       (list (cl-mpm/particle:mp-position mp)
                             (cl-mpm/particle:mp-velocity mp)
                             (cl-mpm/particle:mp-stress mp)
                             (cl-mpm/particle:mp-strain mp)
                             (cl-mpm/particle:mp-deformation-gradient mp)))
               (cl-mpm/models/clay-creep:particle-kappa mp)
               (cl-mpm/models/clay-creep:particle-work mp)))
       (cl-mpm:sim-mps sim)))

(let* ((arguments (cl-mpm-script-args))
       (baseline (load-drive-hold-control-case
                  (or (first arguments)
                      (cl-mpm-path "cases/benchmarks/clay-creep-pusher-pilot.lisp"))))
       (scheduled (load-drive-hold-control-case
                   (or (second arguments)
                       (cl-mpm-path "cases/benchmarks/clay-creep-pusher-drive-hold.lisp"))))
       (baseline-config (compile-configuration baseline))
       (scheduled-config (compile-configuration scheduled)))
  (drive-hold-check "Actual case configurations preserve material/geometry/solver physics"
    (let ((allowed '("duration" "frames" "maxUpdates" "pusherVelocity" "pusherTravelM")))
      (assert (= (hash-table-count scheduled-config) (1+ (hash-table-count baseline-config))))
      (maphash (lambda (key value)
                 (unless (member key allowed :test #'equal)
                   (multiple-value-bind (actual present-p) (gethash key scheduled-config)
                     (assert present-p) (assert (equalp value actual)))))
               baseline-config)
      (maphash (lambda (key value)
                 (declare (ignore value))
                 (assert (or (member key allowed :test #'equal)
                             (nth-value 1 (gethash key baseline-config)))))
               scheduled-config))
    (assert (= (gethash "duration" baseline-config) 1d0))
    (assert (= (gethash "frames" baseline-config) 11))
    (assert (= (gethash "maxUpdates" baseline-config) 10000))
    (assert (= (gethash "pusherVelocity" baseline-config) .005d0))
    (assert (= (gethash "duration" scheduled-config) 10d0))
    (assert (= (gethash "frames" scheduled-config) 101))
    (assert (= (gethash "maxUpdates" scheduled-config) 30000))
    (assert (= (gethash "pusherVelocity" scheduled-config) .02d0))
    (assert (= (gethash "pusherTravelM" scheduled-config) .1d0)))
  (drive-hold-check "Omitted travel preserves unlimited command and adds no config key"
    (assert (not (nth-value 1 (gethash "pusherTravelM" baseline-config))))
    (dolist (time '(0d0 .1d0 1d0 5d0 10d0 120d0))
      (assert (= (pusher-target-at-time baseline-config time)
                 (* (gethash "pusherVelocity" baseline-config) time)))))
  (drive-hold-check "Finite travel drives to 0.1m at 5s and holds without a soil clamp"
    (dolist (sample '((0d0 0d0) (1d0 .02d0) (4d0 .08d0)
                      (5d0 .1d0) (6d0 .1d0) (10d0 .1d0)))
      (drive-hold-close (pusher-target-at-time scheduled-config (first sample))
                        (second sample))))
  (drive-hold-check "Invalid time and malformed/zero/negative travel are rejected"
    (dolist (time '(-1d0 nil "invalid"))
      (drive-hold-expects-error (lambda () (pusher-target-at-time scheduled-config time))))
    (dolist (travel '(0d0 -1d0 nil "invalid"))
      (let ((invalid (alexandria:copy-hash-table scheduled-config)))
        (setf (gethash "pusherTravelM" invalid) travel)
        (drive-hold-expects-error (lambda () (pusher-target-at-time invalid 1d0))))
      (drive-hold-expects-error
       (lambda ()
         (compile-configuration
          (case-with-loading baseline
            (cl-mpm/framework:make-loading :crest-pusher :velocity .02d0 :travel travel)))))))
  ;; Tiny native state sentinels, but no contact application or physical update.
  (let ((small-config (alexandria:copy-hash-table baseline-config)))
    (setf (gethash "width" small-config) 2d0
          (gethash "height" small-config) 1d0
          (gethash "baseHeight" small-config) 1d0
          (gethash "crestLength" small-config) 1d0)
    (multiple-value-bind (sim crest)
        (make-slope (cl-mpm/framework:simulation-material baseline) small-config)
      (declare (ignore crest))
      (let* ((bc (make-instance 'one-way-pusher :index nil :contacts #() :epsilon 1d0
                               :patch-left 0d0 :patch-right 1d0))
             (before (drive-hold-native-state sim)))
        (drive-hold-check "Rectangle work rises under moving compression and is constant on hold"
          (setf (cl-mpm/scenario/slope-descent:strip-reaction bc) 100d0)
          (set-pusher-target bc .04d0)
          (accumulate-pusher-command-work bc 0d0)
          (drive-hold-close (pusher-command-work bc) 4d0)
          (setf (cl-mpm/scenario/slope-descent:strip-reaction bc) 200d0)
          (set-pusher-target bc .1d0)
          (accumulate-pusher-command-work bc .04d0)
          (drive-hold-close (pusher-command-work bc) 16d0)
          (setf (cl-mpm/scenario/slope-descent:strip-reaction bc) 900d0)
          (accumulate-pusher-command-work bc .1d0)
          (drive-hold-close (pusher-command-work bc) 16d0)
          (assert (equalp before (drive-hold-native-state sim))))
        (drive-hold-check "Unloaded driver motion does no work; invalid diagnostic inputs fail"
          (setf (cl-mpm/scenario/slope-descent:strip-reaction bc) 0d0)
          (set-pusher-target bc .12d0)
          (accumulate-pusher-command-work bc .1d0)
          (drive-hold-close (pusher-command-work bc) 16d0)
          (drive-hold-expects-error (lambda () (accumulate-pusher-command-work bc .13d0)))
          (setf (cl-mpm/scenario/slope-descent:strip-reaction bc) -1d0)
          (drive-hold-expects-error (lambda () (accumulate-pusher-command-work bc .12d0)))
          (drive-hold-close (pusher-command-work bc) 16d0)
          (assert (equalp before (drive-hold-native-state sim))))))))

(format t "~&SLOPE CREEP DRIVE/HOLD CONTROLS: ~D passed; no physical updates executed.~%"
        *drive-hold-checks*)
(uiop:quit 0)
