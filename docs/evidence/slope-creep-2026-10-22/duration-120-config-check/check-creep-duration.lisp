(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(load (cl-mpm-path "cases/benchmarks/clay-creep-slope.lisp"))
(let* ((before (cl-mpm/framework:compile-scenario :slope-creep cl-mpm/framework:*simulation*))
       (before-material (copy-tree (cl-mpm/framework:component-options
                                   (cl-mpm/framework:simulation-material cl-mpm/framework:*simulation*)))))
  (declare (ignore before-material))
  (load (cl-mpm-path "cases/benchmarks/clay-creep-slope-120s.lisp"))
  (let ((after (cl-mpm/framework:compile-scenario :slope-creep cl-mpm/framework:*simulation*)))
    (assert (= 120d0 (gethash "duration" after)))
    (assert (= 241 (gethash "frames" after)))
    (maphash (lambda (key value)
               (unless (member key '("duration" "frames") :test #'equal)
                 (assert (eql value (gethash key after))))) before)
    (assert (= (/ (gethash "duration" before) (1- (gethash "frames" before)))
               (/ (gethash "duration" after) (1- (gethash "frames" after)))))
    (cl-mpm/scenario/slope-descent::write-json
     (cl-mpm-path "output/slope-creep-2026-10-22/duration-120-config.json") after)
    (format t "~&PASS: only duration30->120s and frames61->241 changed; all other compiled physical/solver values identical.~%")))
(uiop:quit 0)
