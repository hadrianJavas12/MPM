;;;; Zero-update native configuration gate; retained with exact executed bytes.
(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(flet ((read-case (path)
         (let ((cl-mpm/framework:*simulation* nil))
           (load (cl-mpm-path path)) cl-mpm/framework:*simulation*)))
  (let* ((previous (read-case "cases/benchmarks/wang2017-soil2-apex-fast-010.lisp"))
         (next (read-case "cases/benchmarks/wang2017-soil2-apex-100mm.lisp"))
         (a (cl-mpm/scenario/slope-descent:compile-configuration previous))
         (b (cl-mpm/scenario/slope-descent:compile-configuration next))
         (allowed '("targetDisplacement" "duration" "frames"))
         (changed nil)
         (report (make-hash-table :test 'equal))
         (output (first (cl-mpm-script-args))))
    (assert (= (hash-table-count a) (hash-table-count b)))
    (maphash (lambda (key value)
               (multiple-value-bind (other present) (gethash key b)
                 (assert present)
                 (unless (equalp value other)
                   (assert (member key allowed :test #'string=))
                   (push key changed)))) a)
    (assert (= (length changed) 3))
    (assert (= (gethash "targetDisplacement" b) .1d0))
    (assert (= (gethash "duration" b) 10d0))
    (assert (= (gethash "velocity" b) .01d0))
    (assert (= (gethash "frames" b) 101))
    (format t "~&PASS: Only target, derived duration and frame count differ.~%")
    (let* ((ma (cl-mpm/framework:simulation-material previous))
           (mb (cl-mpm/framework:simulation-material next))
           (la (getf (cl-mpm/framework:material-particle-initargs ma) :evolution-law))
           (lb (getf (cl-mpm/framework:material-particle-initargs mb) :evolution-law)))
      (assert (eq (cl-mpm/framework:material-particle-class ma)
                  (cl-mpm/framework:material-particle-class mb)))
      (assert (typep lb 'cl-mpm/models/mc-evolution:evolution-law))
      (dolist (k '(0d0 .01d0 .02d0 .04d0))
        (assert (equalp (multiple-value-list (cl-mpm/models/mc-evolution:law-values la k))
                        (multiple-value-list (cl-mpm/models/mc-evolution:law-values lb k))))))
    (format t "~&PASS: Same particle class and declared Cauchy strength law.~%")
    (assert (= (/ (gethash "duration" a) (1- (gethash "frames" a)))
               (/ (gethash "duration" b) (1- (gethash "frames" b)))))
    (format t "~&PASS: Same nominal 0.1s output cadence; exact prefix still requires comparison.~%")
    (setf (gethash "passed" report) t (gethash "controlsCount" report) 3
          (gethash "previousConfig" report) a (gethash "extendedConfig" report) b
          (gethash "changedKeys" report) (coerce (sort changed #'string<) 'vector)
          (gethash "physicalUpdatesExecuted" report) 0
          (gethash "scope" report) "Workspace-loaded native input gate; no solver, point projection or restart")
    (assert output) (ensure-directories-exist output)
    (with-open-file (stream output :direction :output :if-exists :error)
      (yason:encode report stream))))
(uiop:quit 0)
