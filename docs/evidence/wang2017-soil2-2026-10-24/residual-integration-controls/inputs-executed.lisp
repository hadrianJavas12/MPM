(in-package :cl-user)
(ql:quickload :cl-mpm-framework :silent t)
(flet ((read-case (path)
         (let ((cl-mpm/framework:*simulation* nil))
           (load (cl-mpm-path path)) cl-mpm/framework:*simulation*)))
  (let* ((old (read-case "cases/benchmarks/wang2017-soil2-apex-100mm.lisp"))
         (new (read-case "cases/benchmarks/wang2017-soil2-apex-residual-100mm.lisp"))
         (a (cl-mpm/scenario/slope-descent:compile-configuration old))
         (b (cl-mpm/scenario/slope-descent:compile-configuration new))
         (changes nil) (report (make-hash-table :test 'equal))
         (output (first (cl-mpm-script-args))))
    (assert (= (hash-table-count a) (hash-table-count b)))
    (maphash (lambda (key value)
               (multiple-value-bind (other present) (gethash key b)
                 (assert present)
                 (unless (equalp value other)
                   (assert (member key '("materialModel" "historyPolicy") :test #'string=))
                   (push key changes)))) a)
    (assert (= (length changes) 2))
    (assert (equal (gethash "historyPolicy" b) "residual-plateau-only"))
    (format t "~&PASS: All numerical inputs unchanged; only explicit model/history metadata differ.~%")
    (let* ((ma (cl-mpm/framework:simulation-material old))
           (mb (cl-mpm/framework:simulation-material new))
           (la (getf (cl-mpm/framework:material-particle-initargs ma) :evolution-law))
           (lb (getf (cl-mpm/framework:material-particle-initargs mb) :evolution-law))
           (mp (apply #'make-instance (cl-mpm/framework:material-particle-class mb)
                      (cl-mpm/framework:material-particle-initargs mb)))
           (adapter (cl-mpm/framework:material-diagnostics mb)))
      (dolist (k '(0d0 .01d0 .02d0 .03187108863369348d0 .04d0))
        (assert (equalp (multiple-value-list (cl-mpm/models/mc-evolution:law-values la k))
                        (multiple-value-list (cl-mpm/models/mc-evolution:law-values lb k)))))
      (assert (equal (cl-mpm/models/wang2017-native:native-material-variant mp) "composite-apex-residual"))
      (cl-mpm/framework:validate-material-diagnostics adapter (vector mp) "mpm")
      (let* ((conventions (cl-mpm/framework:diagnostics-conventions adapter))
             (keys (loop for (key value) on conventions by #'cddr collect key)))
        (assert (= (length keys) (length (remove-duplicates keys :test #'string=)))))
      (format t "~&PASS: Exact same strength law; new native class/unique-key diagnostics construct.~%"))
    (setf (gethash "passed" report) t (gethash "controlsCount" report) 2
          (gethash "oldConfig" report) a (gethash "newConfig" report) b
          (gethash "physicalUpdatesExecuted" report) 0
          (gethash "scope" report) "Workspace native input/adapter only; explicit residual history scope, no projection or MPM")
    (assert output) (ensure-directories-exist output)
    (with-open-file (stream output :direction :output :if-exists :error)
      (yason:encode report stream))))
(uiop:quit 0)
