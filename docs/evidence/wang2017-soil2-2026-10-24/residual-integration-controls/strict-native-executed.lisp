;;;; Focused Windows native Soil2 adapter controls, no mesh/solver updates.
;;;; windows\cl-mpm.cmd tests\materials\wang2017-native.lisp output\FRESH
;;;; The standard CLI helper freezes every selected project source/DLL BEFORE load.
(in-package :cl-user)
(require :asdf)
(defvar *wang2017-native-frozen* nil)
(defvar *wang2017-native-output* nil)
(defvar *wang2017-native-exit* 1)
;; Load in a separate top-level form so the helper's DEFVAR is established
;; BEFORE the following bootstrap form compiles its dynamic context binding.
(unless *wang2017-native-frozen*
  (load (cl-mpm-path "scripts/lisp/native-source-snapshot.lisp")))
(unless *wang2017-native-frozen*
  (let* ((output (first (cl-mpm-script-args)))
         (directory (and output (uiop:ensure-directory-pathname (merge-pathnames output)))))
    (unless directory (error "Provide a fresh control output directory."))
    (when (and (probe-file directory)
               (or (uiop:directory-files directory) (uiop:subdirectories directory)))
      (error "Control output already contains files: ~A" directory))
    (snapshot-require-fresh-runtime)
    (multiple-value-bind (copied records) (snapshot-case-sources directory *load-truename*)
      (dolist (required '("source/materials/models/plastic/wang2017/native-package.lisp"
                          "source/materials/models/plastic/wang2017/transport.lisp"
                          "source/materials/models/plastic/wang2017/state.lisp"
                          "source/materials/models/plastic/wang2017/material.lisp"
                          "source/materials/models/plastic/mohr-coulomb-evolution/state.lisp"
                          "source/cl-mpm.asd" "source/case.lisp"))
        (unless (find required records :test #'string= :key (lambda (row) (gethash "path" row)))
          (error "Required native source not frozen: ~A" required)))
      (snapshot-write-json (merge-pathnames "source/source-manifest.json" directory)
                           (snapshot-object "scope" "Copied before any first-party project load; case.lisp is this exact control source"
                                            "files" (coerce records 'vector)))
      (let ((*native-snapshot-context* (snapshot-register-native directory records))
            (*wang2017-native-frozen* t) (*wang2017-native-output* directory))
        (snapshot-check-plan "cl-mpm/settings")
        (ql:quickload :cl-mpm/settings :silent t)
        (setf (symbol-value (find-symbol "*OPTIMISE-SETTING*" "CL-MPM/SETTINGS"))
              '(optimize (speed 3) (safety 1) (debug 1) (compilation-speed 0)))
        (dolist (system '("yason" "cl-mpm" "cl-mpm/models/wang2017-native"))
          (snapshot-check-plan system) (ql:quickload system :silent t))
        (snapshot-native-proof)
        (write-case-source-provenance directory copied nil)
        (rename-file (merge-pathnames "source-provenance.json" directory)
                     (merge-pathnames "source-provenance-before.json" directory))
        (snapshot-write-json (merge-pathnames "source-proof-before.json" directory)
                             (snapshot-object "files" (coerce
                              (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory)
                                                                     "sha256" (snapshot-sha256 path))) copied) 'vector)))
        (snapshot-verify-file (merge-pathnames "source/case.lisp" directory))
        (load (merge-pathnames "source/case.lisp" directory))
        (dolist (path copied) (snapshot-verify-file path))
        (write-case-source-provenance directory copied nil)
        (snapshot-write-json (merge-pathnames "source-proof-after.json" directory)
                             (snapshot-object "files" (coerce
                              (mapcar (lambda (path) (snapshot-object "path" (enough-namestring path directory)
                                                                     "sha256" (snapshot-sha256 path))) copied) 'vector))))))
  (uiop:quit *wang2017-native-exit*))

(defpackage :cl-mpm/tests/wang2017-native (:use :cl))
(in-package :cl-mpm/tests/wang2017-native)
(defvar *passed* nil)
(defvar *failures* nil)
(defvar *not-run* nil)
(defvar *native-calls* 0)
(defconstant +e+ 20d6)
(defconstant +nu+ .25d0)
(defconstant +g+ 8d6)
(defparameter *cos-phi* (cos (* 35d0 (/ pi 180d0))))
(defmacro control (label &body body)
  `(handler-case (progn ,@body (push ,label *passed*) (format t "~&PASS: ~A~%" ,label))
     (error (condition) (push (list ,label (princ-to-string condition)) *failures*)
       (format t "~&FAIL: ~A: ~A~%" ,label condition))))
(defun near (actual expected &optional (tolerance 1d-11))
  (unless (and (= actual actual) (<= (abs (- actual expected)) tolerance))
    (error "Expected ~,17G, actual ~,17G, tolerance ~G" expected actual tolerance)))
(defun near-vector (actual expected &optional (tolerance 1d-11))
  (assert (= (length actual) (length expected)))
  (dotimes (i (length expected)) (near (elt actual i) (elt expected i) tolerance)))
(defun identity3 () #2A((1d0 0d0 0d0) (0d0 1d0 0d0) (0d0 0d0 1d0)))
(defun matrix3 (array)
  (let ((m (cl-mpm/utils:matrix-eye 1d0)))
    (dotimes (i 3) (dotimes (j 3) (setf (magicl:tref m i j) (aref array i j)))) m))
(defun array3 (matrix)
  (let ((a (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3) (setf (aref a i j) (magicl:tref matrix i j)))) a))
(defun multiply (left right)
  (let ((result (make-array '(3 3) :initial-element 0d0)))
    (dotimes (i 3) (dotimes (j 3) (dotimes (k 3)
      (incf (aref result i j) (* (aref left i k) (aref right k j)))))) result))
(defun transpose3 (a)
  (let ((result (make-array '(3 3))))
    (dotimes (i 3) (dotimes (j 3) (setf (aref result i j) (aref a j i)))) result))
(defun rotation-z (degrees)
  (let* ((angle (* degrees (/ pi 180d0))) (c (cos angle)) (s (sin angle)))
    (make-array '(3 3) :initial-contents (list (list c (- s) 0d0) (list s c 0d0) '(0d0 0d0 1d0)))))
(defun rotation-x (degrees)
  (let* ((angle (* degrees (/ pi 180d0))) (c (cos angle)) (s (sin angle)))
    (make-array '(3 3) :initial-contents (list '(1d0 0d0 0d0) (list 0d0 c (- s)) (list 0d0 s c)))))
(defun true6-matrix (v)
  (make-array '(3 3) :initial-contents
              (list (list (elt v 0) (elt v 5) (elt v 4))
                    (list (elt v 5) (elt v 1) (elt v 3))
                    (list (elt v 4) (elt v 3) (elt v 2)))))
(defun matrix-true6 (m)
  (vector (aref m 0 0) (aref m 1 1) (aref m 2 2) (aref m 1 2) (aref m 2 0) (aref m 0 1)))
(defun rotate6 (v rotation)
  (matrix-true6 (multiply (multiply rotation (true6-matrix v)) (transpose3 rotation))))
(defun kps (v)
  (let ((mean (/ (+ (elt v 0) (elt v 1) (elt v 2)) 3d0)))
    (sqrt (* .5d0 (+ (expt (- (elt v 0) mean) 2) (expt (- (elt v 1) mean) 2)
                       (expt (- (elt v 2) mean) 2) (* 2d0 (loop for i from 3 below 6 sum (expt (elt v i) 2))))))))
(defun cohesion (k) (- 30d3 (* 15d3 (min 1d0 (/ k .02d0)))))
(defun mp (&optional (tensor #(0d0 0d0 0d0 0d0 0d0 0d0)))
  (make-instance 'cl-mpm/models/wang2017-native:particle-wang2017-soil2 :paper-tensor tensor :enable-plasticity t))
(defun paper-tensor (particle)
  (cl-mpm/models/wang2017-native:particle-paper-tensor particle))
(defun paper-k (particle)
  (cl-mpm/models/wang2017-native:particle-paper-kps particle))
(defun commit (particle) (cl-mpm/particle::new-loadstep-mp particle))
(defun install-increment (particle array)
  (let ((m (cl-mpm/particle::mp-deformation-gradient-strain-increment particle)))
    (dotimes (i 3) (dotimes (j 3) (setf (magicl:tref m i j) (aref array i j))))) particle)
(defun compliance (tau)
  (let ((result (make-array 6 :element-type 'double-float :initial-element 0d0)))
    (dotimes (i 3)
      (setf (aref result i) (/ (- (elt tau i) (* +nu+ (loop for j below 3 unless (= i j) sum (elt tau j)))) +e+)))
    (loop for i from 3 below 6 do (setf (aref result i) (/ (elt tau i) +g+))) result))
(defun values6 (matrix) (copy-seq (magicl::matrix/double-float-storage matrix)))
(defun native-trial (particle tau)
  (let* ((strain (cl-mpm/utils:voigt-from-list (coerce (compliance tau) 'list))) (before (values6 strain)))
    (incf *native-calls*)
    (let ((answer (values6 (cl-mpm/particle:constitutive-model particle strain 1d-4))))
      (near-vector (values6 strain) before 0d0) answer)))
(defun analytic-trial (p new-k &optional (j 1d0))
  (let ((a (+ (* 2d0 +g+ p) (* j (cohesion new-k) *cos-phi*))))
    (vector a 0d0 (- a) 0d0 0d0 0d0)))
(defun analytic-return (new-k &optional (j 1d0))
  (let ((a (* j (cohesion new-k) *cos-phi*))) (vector a 0d0 (- a) 0d0 0d0 0d0)))
(defun error-from (thunk)
  (handler-case (progn (funcall thunk) nil)
    (cl-mpm/models/mc-evolution:material-integration-error (condition) condition)))
(defun fingerprint (value &optional seen)
  (cond ((or (null value) (numberp value) (symbolp value) (characterp value)) value)
        ((stringp value) (copy-seq value))
        ((typep value 'magicl:matrix/double-float)
         (list :matrix (copy-list (magicl:shape value)) (coerce (values6 value) 'list)))
        ((consp value) (cons (fingerprint (car value) seen) (fingerprint (cdr value) seen)))
        ((arrayp value) (list :array (array-dimensions value)
                              (loop for i below (array-total-size value) collect (fingerprint (row-major-aref value i) seen))))
        ((or (typep value 'standard-object) (typep value 'structure-object))
         (if (member value seen :test #'eq) (list :cycle (class-name (class-of value)))
             (list (class-name (class-of value))
                   ;; Reusable outer transaction scratch cache is not physical
                   ;; current/committed state and is explicitly excluded by API.
                   (loop for slot in (sb-mop:class-slots (class-of value)) for name = (sb-mop:slot-definition-name slot)
                         unless (string= (symbol-name name) "OUTER-TRIAL-STATE")
                         collect (list name (if (slot-boundp value name)
                                               (fingerprint (slot-value value name) (cons value seen)) :unbound))))))
        (t (error "Unhandled fingerprint object: ~S" (type-of value)))))
(defun matching-slot (particle name)
  (or (loop for slot in (sb-mop:class-slots (class-of particle)) for symbol = (sb-mop:slot-definition-name slot)
            when (string= (symbol-name symbol) name) return symbol)
      (error "Expected native slot missing: ~A" name)))
(defun corrupt-current (particle)
  (dolist (slot (sb-mop:class-slots (class-of particle)))
    (let ((name (sb-mop:slot-definition-name slot)))
      (when (and (slot-boundp particle name)
                 (or (member (symbol-package name) (list (find-package :cl-mpm/models/wang2017-native)))
                     (member (symbol-name name) '("STRESS" "STRAIN" "STRESS-KIRCHOFF" "KAPPA" "COHESION" "DEFORMATION-GRADIENT") :test #'string=))
                 (not (search "COMMITTED" (symbol-name name))))
        (let ((value (slot-value particle name)))
          (cond ((typep value 'magicl:matrix/double-float)
                 (let ((storage (magicl::matrix/double-float-storage value)))
                   (dotimes (i (length storage)) (incf (aref storage i) .125d0))))
                ((and (arrayp value) (every #'numberp (coerce value 'list)))
                 (dotimes (i (array-total-size value)) (incf (row-major-aref value i) .125d0)))
                ((floatp value) (setf (slot-value particle name) (+ value .125d0)))
                ((consp value) (setf (car value) :corrupted))))))) particle)
(defun corrupt-committed (particle)
  "Mutate both exposed committed storage and its separately owned baseline."
  (incf (aref (slot-value particle (matching-slot particle "PAPER-TENSOR-COMMITTED")) 0) .125d0)
  (let ((baseline (slot-value particle 'cl-mpm/models/mc-evolution::committed-state)))
    (dolist (entry (cl-mpm/models/mc-evolution::particle-state-slots baseline))
      (when (member (symbol-name (first entry)) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED") :test #'string=)
        (incf (aref (third entry) 0) .125d0)))) particle)

(control "Fixed Soil2 defaults, constructor and reader tensor ownership"
  (let* ((input (vector .002d0 0d0 -.002d0 0d0 0d0 0d0)) (particle (mp input))
         (expected (copy-seq input)))
    (setf (aref input 0) 9d0)
    (near-vector (paper-tensor particle) expected 0d0)
    (setf (aref (paper-tensor particle) 1) 9d0)
    (near-vector (paper-tensor particle) expected 0d0)
    (near (cl-mpm/particle::mp-E particle) +e+ 0d0)
    (near (cl-mpm/particle::mp-nu particle) +nu+ 0d0)
    (near (paper-k particle) .002d0)
    (near (cl-mpm/models/wang2017-native:particle-paper-cohesion particle) 28500d0 1d-7)))

(control "Native elastic trial preserves history and external engineering strain"
  (let ((particle (mp)) (tau #(-10d3 -20d3 -15d3 0d0 0d0 0d0)))
    (near-vector (native-trial particle tau) tau 1d-6)
    (near-vector (paper-tensor particle) #(0d0 0d0 0d0 0d0 0d0 0d0) 0d0)
    (near (paper-k particle) 0d0 0d0)))

(control "Native monotonic plastic return matches independent analytic k and cohesion"
  (let* ((p .003d0) (particle (mp)) (actual (native-trial particle (analytic-trial p p))))
    (near-vector actual (analytic-return p) 1d-6)
    (near-vector (paper-tensor particle) (vector p 0d0 (- p) 0d0 0d0 0d0))
    (near (paper-k particle) p)
    (near (cl-mpm/models/wang2017-native:particle-paper-cohesion particle) 27750d0 1d-7)
    (near (cl-mpm/models/mc-evolution:particle-cohesion particle) 27750d0 1d-7)))

(control "Native residual tail matches independent analytic return"
  (let ((particle (mp)) (p .025d0))
    (near-vector (native-trial particle (analytic-trial p p)) (analytic-return p) 1d-6)
    (near (paper-k particle) p)
    (near (cl-mpm/models/wang2017-native:particle-paper-cohesion particle) 15000d0 1d-7)))

(control "Orthogonal plastic directions use accumulated tensor norm rather than summed J2"
  (let* ((p .003d0) (q .002d0) (next-k (sqrt (+ (* p p) (* q q))))
         (particle (mp)) (r (rotation-z 45d0))
         (swap #2A((1d0 0d0 0d0) (0d0 0d0 1d0) (0d0 -1d0 0d0)))
         (basis (multiply r swap)))
    (native-trial particle (analytic-trial p p)) (commit particle)
    (near-vector (native-trial particle (rotate6 (analytic-trial q next-k) basis))
                 (rotate6 (analytic-return next-k) basis) 1d-6)
    (near-vector (paper-tensor particle) (vector p 0d0 (- p) 0d0 0d0 q))
    (near (paper-k particle) next-k)
    (assert (> (abs (- (paper-k particle) (+ p q))) 1d-4))))

(control "Native stress shear and true tensor history factors remain distinct"
  (let* ((q .002d0) (particle (mp))
         (basis (multiply (rotation-z 45d0) #2A((1d0 0d0 0d0) (0d0 0d0 1d0) (0d0 -1d0 0d0)))))
    (near-vector (native-trial particle (rotate6 (analytic-trial q q) basis))
                 (rotate6 (analytic-return q) basis) 1d-6)
    (near-vector (paper-tensor particle) (vector 0d0 0d0 0d0 0d0 0d0 q))
    (near (paper-k particle) q)))

(control "Cauchy cohesion is converted once into returned Kirchhoff stress"
  (let ((particle (mp)) (p .003d0) (j 1.2d0))
    (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient particle) 0 0) j)
    (near-vector (native-trial particle (analytic-trial p p j)) (analytic-return p j) 1d-6)
    (near (paper-k particle) p)
    (near (cl-mpm/models/wang2017-native:particle-paper-cohesion particle) (cohesion p) 1d-7)))

(control "Proper polar rotation recovers independent rotation from positive nonspherical stretch"
  (let* ((r (multiply (rotation-z 71d0) (rotation-x -29d0)))
         (u #2A((1.3d0 .2d0 0d0) (.2d0 .9d0 .1d0) (0d0 .1d0 1.1d0)))
         (a (matrix3 (multiply r u)))
         (actual (cl-mpm/models/wang2017-native:proper-polar-rotation a)))
    (dotimes (i 3) (dotimes (j 3) (near (magicl:tref actual i j) (aref r i j) 1d-11)))
    (setf (magicl:tref actual 0 0) 9d0)
    (near (magicl:tref a 0 0) (aref (multiply r u) 0 0) 0d0)
    (assert (error-from (lambda () (cl-mpm/models/wang2017-native:proper-polar-rotation
                                    (matrix3 #2A((-1d0 0d0 0d0) (0d0 1d0 0d0) (0d0 0d0 1d0)))))))))

(control "Nonzero plastic history under large pure rotation preserves k and strength"
  (let* ((initial #(.003d0 -.001d0 -.002d0 .001d0 .002d0 -.001d0))
         (particle (mp initial)) (r (multiply (rotation-z 90d0) (rotation-x 43d0)))
         (expected (rotate6 initial r)) (old-k (kps initial)))
    (install-increment particle r)
    (near-vector (native-trial particle (rotate6 #(-10d3 -20d3 -15d3 0d0 0d0 0d0) r))
                 (rotate6 #(-10d3 -20d3 -15d3 0d0 0d0 0d0) r) 1d-6)
    (near-vector (paper-tensor particle) expected)
    (near (paper-k particle) old-k)
    (near (cl-mpm/models/wang2017-native:particle-paper-cohesion particle) (cohesion old-k) 1d-7)))

(control "Plastic path is covariant under time varying superposed 3D observer rotation"
  (let ((base (mp #(.001d0 0d0 -.001d0 0d0 0d0 0d0)))
        (observed (mp #(.001d0 0d0 -.001d0 0d0 0d0 0d0))) (previous (identity3)))
    (loop for step from 1 to 3 for old-p = (* step .001d0) for next-p = (+ old-p .001d0)
          for r = (multiply (rotation-z (* 23d0 step)) (rotation-x (* -17d0 step))) do
      (install-increment base (identity3))
      (install-increment observed (multiply r (transpose3 previous)))
      (let ((plain (native-trial base (analytic-trial .001d0 next-p)))
            (rotated (native-trial observed (rotate6 (analytic-trial .001d0 next-p) r))))
        (near-vector rotated (rotate6 plain r) 1d-6)
        (near-vector (paper-tensor observed) (rotate6 (paper-tensor base) r))
        (near (paper-k observed) (paper-k base)))
      (commit base) (commit observed) (setf previous r))))

(defun rotation-path (increments)
  (let* ((initial #(.003d0 -.001d0 -.002d0 .001d0 0d0 .002d0))
         (particle (mp initial)) (net (identity3)) (tau #(-10d3 -20d3 -15d3 0d0 0d0 0d0)))
    (dolist (r increments)
      (setf net (multiply r net) tau (rotate6 tau r))
      (install-increment particle r) (native-trial particle tau) (commit particle))
    (near-vector (paper-tensor particle) (rotate6 initial net))
    (values (paper-tensor particle) (paper-k particle))))
(control "Sequential noncommuting elastic rotations agree with refined rotation path"
  (multiple-value-bind (coarse coarse-k) (rotation-path (list (rotation-z 70d0) (rotation-x 50d0)))
    (multiple-value-bind (fine fine-k) (rotation-path (list (rotation-z 35d0) (rotation-z 35d0)
                                                          (rotation-x 25d0) (rotation-x 25d0)))
      (near-vector coarse fine) (near coarse-k fine-k))))

(control "Repeated uncommitted plastic trials neither double accumulate nor double rotate history"
  (let* ((particle (mp #(.002d0 0d0 -.002d0 0d0 0d0 0d0))) (r (rotation-z 37d0))
         (trial (rotate6 (analytic-trial .001d0 .003d0) r)))
    (install-increment particle r) (native-trial particle trial)
    (let ((before (fingerprint particle)))
      (native-trial particle trial)
      (assert (equalp before (fingerprint particle)))
      (near-vector (paper-tensor particle) (rotate6 #(.003d0 0d0 -.003d0 0d0 0d0 0d0) r))
      (near-vector (cl-mpm/models/wang2017-native:particle-paper-tensor-committed particle)
                   #(.002d0 0d0 -.002d0 0d0 0d0 0d0) 0d0))))

(control "Rejected zero dilation apex preserves every slot and external strain"
  (let ((particle (mp #(.002d0 0d0 -.002d0 0d0 0d0 0d0))))
    (commit particle)
    (let* ((before (fingerprint particle))
           (strain (cl-mpm/utils:voigt-from-list (coerce (compliance #(100d3 100d3 100d3 0d0 0d0 0d0)) 'list)))
           (input (values6 strain)))
      (assert (error-from (lambda () (cl-mpm/particle:constitutive-model particle strain 1d-4))))
      (assert (equalp before (fingerprint particle)))
      (near-vector (values6 strain) input 0d0))))

(control "Native monotonic scope rejects real signed history decrease atomically"
  (let* ((particle (mp #(.004d0 0d0 -.004d0 0d0 0d0 0d0)))
         (before (fingerprint particle))
         (reverse-trial (map 'vector #'- (analytic-trial .001d0 .003d0)))
         (condition (error-from (lambda () (native-trial particle reverse-trial)))))
    (assert condition)
    (assert (search "decreas" (cl-mpm/models/mc-evolution:integration-error-reason condition) :test #'char-equal))
    (assert (equalp before (fingerprint particle)))
    (assert (not (cl-mpm/models/wang2017-native:particle-history-decrease-p particle)))))

(control "Reusable snapshot restores all new current and committed slots without aliasing"
  (let ((particle (mp)))
    (native-trial particle (analytic-trial .003d0 .003d0)) (commit particle)
    (let ((before (fingerprint particle))
          (snapshot (cl-mpm/models/wang2017-native:snapshot-particle particle)))
      (loop repeat 2 do
        (corrupt-current particle)
        (corrupt-committed particle)
        (cl-mpm/models/wang2017-native:restore-particle particle snapshot)
        (assert (equalp before (fingerprint particle)))))))

(control "Particle copy and no argument reinitialize retain independent current and baseline arrays"
  (let ((source (mp)) (target (mp)))
    (native-trial source (analytic-trial .003d0 .003d0)) (commit source)
    (cl-mpm/models/wang2017-native:copy-particle-state source target)
    (let ((expected (fingerprint target)))
      (assert (equalp expected (fingerprint source)))
      (corrupt-current source)
      (corrupt-committed source)
      (assert (equalp expected (fingerprint target))))
    (let* ((name (matching-slot target "PAPER-TENSOR")) (held (slot-value target name))
           (held-committed (slot-value target (matching-slot target "PAPER-TENSOR-COMMITTED")))
           (held-baseline (slot-value target 'cl-mpm/models/mc-evolution::committed-state))
           (expected (fingerprint target)))
      (reinitialize-instance target)
      (setf (aref held 0) 9d0)
      (setf (aref held-committed 0) 9d0)
      (dolist (entry (cl-mpm/models/mc-evolution::particle-state-slots held-baseline))
        (when (member (symbol-name (first entry)) '("PAPER-TENSOR" "PAPER-TENSOR-COMMITTED") :test #'string=)
          (setf (aref (third entry) 0) 9d0)))
      (assert (equalp (fingerprint target) expected)))))

(control "Loadstep commit and reset restore accepted tensor stress and transport state"
  (let ((particle (mp)))
    (native-trial particle (analytic-trial .003d0 .003d0)) (commit particle)
    (let ((accepted (fingerprint particle)))
      (install-increment particle (rotation-z 31d0))
      (native-trial particle (rotate6 (analytic-trial .001d0 .004d0) (rotation-z 31d0)))
      (corrupt-current particle)
      (cl-mpm/particle::reset-loadstep-mp particle)
      (assert (equalp accepted (fingerprint particle)))
      (near-vector (paper-tensor particle)
                   (cl-mpm/models/wang2017-native:particle-paper-tensor-committed particle) 0d0))))

;; A test-only primary dispatch mutates outer fields before native failure.
;; If production provides a Soil2 :around transaction, this exercises that hook,
;; not an actual mesh/grid kinematic update and not a solver step.
(defclass outer-failure-probe () ())
(defmethod cl-mpm::update-stress-mp ((mesh outer-failure-probe)
                                   (particle cl-mpm/models/wang2017-native:particle-wang2017-soil2) dt fbar)
  (declare (ignore mesh dt fbar))
  (setf (magicl:tref (cl-mpm/particle:mp-deformation-gradient particle) 0 0) 1.2d0
        (magicl:tref (cl-mpm/particle:mp-stress particle) 0 0) 123456d0)
  (native-trial particle #(100d3 100d3 100d3 0d0 0d0 0d0)))
(if (some (lambda (method)
            (and (equal (method-qualifiers method) '(:around))
                 (member (find-class 'cl-mpm/models/wang2017-native:particle-wang2017-soil2)
                         (sb-mop:method-specializers method))))
          (sb-mop:generic-function-methods #'cl-mpm::update-stress-mp))
    (control "Production outer stress transaction restores probe mutated kinematics and stress on failure"
      (let* ((particle (mp #(.002d0 0d0 -.002d0 0d0 0d0 0d0))) (before (fingerprint particle)))
        (assert (error-from (lambda () (cl-mpm::update-stress-mp (make-instance 'outer-failure-probe) particle 1d-4 nil))))
        (assert (equalp before (fingerprint particle)))))
    (push "Production outer stress transaction absent; no actual outer rollback claim" *not-run*))

(let ((record (make-hash-table :test 'equal)))
  (setf (gethash "passed" record) (if *failures* 'yason:false t)
        (gethash "controlsCount" record) (length *passed*)
        (gethash "controlLabels" record) (coerce (reverse *passed*) 'vector)
        (gethash "failures" record) (coerce (reverse *failures*) 'vector)
        (gethash "notRun" record) (coerce (reverse *not-run*) 'vector)
        (gethash "nativeConstitutiveCalls" record) *native-calls*
        (gethash "physicalUpdatesExecuted" record) 0
        (gethash "scope" record) "Native Soil2 material/transaction integration; declared incremental polar signed tensor accumulator with monotonic loading scope gate; no slope, paper agreement, irreversible maximum or mesh objectivity validation"
        (gethash "plasticSubstepInvariantClaim" record) 'yason:false
        (gethash "outerFailureProbeIsActualMeshStep" record) 'yason:false)
  (with-open-file (stream (merge-pathnames "result.json" cl-user::*wang2017-native-output*)
                          :direction :output :if-exists :error)
    (yason:encode record stream)))
(setf cl-user::*wang2017-native-exit* (if *failures* 1 0))
(format t "~&WANG2017 NATIVE: ~D PASS, ~D FAIL, ~D NOT_RUN; zero MPM updates.~%"
        (length *passed*) (length *failures*) (length *not-run*))
