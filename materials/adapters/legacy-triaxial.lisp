(in-package :cl-mpm/calibration/triaxial)

(defun initialize-prestress (sim config)
  "F=I defines the specimen after isotropic cell-pressure application."
  (let ((p (num config "cellPressurePa" 50d3))
        (e (num config "youngsModulusPa" 5d6))
        (nu (num config "poissonRatio" 0.49d0)))
    (loop for mp across (cl-mpm:sim-mps sim) do
      (dotimes (i 3)
        (setf (component (cl-mpm/particle:mp-strain mp) i)
              (/ (* (- p) (- 1d0 (* 2d0 nu))) e)
              (component (cl-mpm/particle:mp-strain-n mp) i)
              (/ (* (- p) (- 1d0 (* 2d0 nu))) e)
              (component (cl-mpm/particle:mp-stress mp) i) (- p)
              (component (cl-mpm/particle::mp-stress-kirchoff mp) i) (- p))))))

(in-package :cl-mpm/calibration/triaxial)

(defun homogeneous-step (mp axial-log-increment pressure)
  (let* ((old-strain (cl-mpm/utils::voigt-copy (cl-mpm/particle:mp-strain mp)))
         (old-plastic (cl-mpm/particle::mp-strain-plastic-vm mp))
         (old-f (cl-mpm/particle:mp-deformation-gradient mp))
         (old-j (j-of mp)))
    (labels ((trial (radial-log-increment)
               (cl-mpm/utils::voigt-copy-into old-strain (cl-mpm/particle:mp-strain mp))
               (setf (cl-mpm/particle::mp-strain-plastic-vm-1 mp) old-plastic)
               (incf (component (cl-mpm/particle:mp-strain mp) 0) radial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 1) axial-log-increment)
               (incf (component (cl-mpm/particle:mp-strain mp) 2) radial-log-increment)
               (let* ((j (* old-j (exp (+ (* 2d0 radial-log-increment) axial-log-increment))))
                      (stress (cl-mpm/particle::constitutive-model
                               mp (cl-mpm/particle:mp-strain mp) 1d0)))
                 (values (+ (/ (component stress 0) j) pressure) j stress))))
      (let ((lo -0.1d0) (hi 0.1d0) (mid 0d0))
        (assert (< (trial lo) 0d0 (trial hi)))
        (dotimes (iteration 70)
          (setf mid (* 0.5d0 (+ lo hi)))
          (if (> (trial mid) 0d0) (setf hi mid) (setf lo mid)))
        (multiple-value-bind (residual j stress) (trial mid)
          (assert (< (abs residual) 1d-5))
          (cl-mpm/utils::voigt-copy-into stress (cl-mpm/particle::mp-stress-kirchoff mp))
          (cl-mpm/fastmaths:fast-scale! stress (/ 1d0 j))
          (setf (magicl:tref old-f 0 0) (* (magicl:tref old-f 0 0) (exp mid))
                (magicl:tref old-f 1 1) (* (magicl:tref old-f 1 1) (exp axial-log-increment))
                (magicl:tref old-f 2 2) (* (magicl:tref old-f 2 2) (exp mid)))
          j)))))

(defun legacy-vm-stats-values (mp stress)
  (values (cl-mpm/particle::mp-strain-plastic-vm mp)
                        (- (/ (* (qj2-of stress) (j-of mp))
                              (* (sqrt 1.5d0) (cl-mpm/particle::mp-rho mp))) 1d0)))

(defun legacy-copy-homogeneous-state (mp representative f)
  (unless (eq mp representative)
            (cl-mpm/utils::copy-into f (cl-mpm/particle:mp-deformation-gradient mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-stress representative) (cl-mpm/particle:mp-stress mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle::mp-stress-kirchoff representative)
                                          (cl-mpm/particle::mp-stress-kirchoff mp))
            (cl-mpm/utils::voigt-copy-into (cl-mpm/particle:mp-strain representative) (cl-mpm/particle:mp-strain mp))
            (setf (cl-mpm/particle::mp-strain-plastic-vm mp)
                  (cl-mpm/particle::mp-strain-plastic-vm representative)
                  (cl-mpm/particle::mp-yield-func mp)
                  (cl-mpm/particle::mp-yield-func representative)
                  (cl-mpm/particle::mp-p-modulus-0 mp)
                  (cl-mpm/particle::mp-p-modulus-0 representative))))
